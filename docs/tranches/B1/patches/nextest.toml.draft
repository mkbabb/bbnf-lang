# ─────────────────────────────────────────────────────────────────────────────
# .config/nextest.toml — bbnf-lang
#
# Successor to the Y.-1.c guards config. Retains the freezing-guard invariants
# (slow-timeout, terminate-after, leak-timeout) and adds explicit profiles for
# the three routine surfaces B1 exposes: `default` (local-dev), `ax-iter`
# (fast-iter; fail-fast), `ci` (retries + junit + verbose), `close` (full
# suite with per-test wall capture for ceremony benchmarks).
#
# Critique of the predecessor (.config/nextest.toml @ master):
#   - Only two profiles (default, ci); missing the dev-iter fast-fail surface
#     that B1.W0 advertises as the primary iter-test alias.
#   - No junit output; CI workflows hand-roll junit generation downstream.
#   - Slow-timeout override on `bench_*` test filters (120s × 2 = 240s) is too
#     generous for divan-migrated benches whose libtest-shim produces no
#     `bench_*` test names; the override is dead configuration.
#
# Invariants kept:
#   - slow-timeout + terminate-after: kills runaway CSP search / pathological
#     backtracking automatically, preventing workspace-test hangs.
#   - leak-timeout: detects detached threads / background workers.
#   - retries = 1: masks flakes without hiding real regressions.
# ─────────────────────────────────────────────────────────────────────────────

# Store path: nextest keeps per-invocation artefacts here (junit, timings,
# snapshots). Rooted inside target/ so `cargo clean` reaps them.
[store]
dir = "target/nextest"

# ── default: local interactive test runs ─────────────────────────────────────
[profile.default]
# Slow test: longer than 30s between ticks. Killed after 3 consecutive slow
# windows (90s total). Leaves legitimate compile-pipeline tests room.
slow-timeout   = { period = "30s", terminate-after = 3 }
leak-timeout   = "100ms"
retries        = { backoff = "fixed", count = 1, delay = "1s" }
status-level   = "pass"
final-status-level = "flaky"
failure-output = "immediate-final"
success-output = "never"

# Overrides: compile-pipeline integration tests exercise the full IR passes on
# large grammars (CSS L4, sheets). Give them more headroom — 3 × 60s = 180s.
[[profile.default.overrides]]
filter       = "test(compile) + test(/pipeline/)"
slow-timeout = { period = "60s", terminate-after = 3 }

# ── ax-iter: fast dev-loop profile ───────────────────────────────────────────
# Invoked by `cargo iter-test*` aliases. Fail-fast is ON so the fleet surfaces
# the first failure immediately; retries DISABLED so flakes aren't re-run
# (the `default` / `ci` profiles handle retries for correctness runs).
[profile.ax-iter]
slow-timeout   = { period = "20s", terminate-after = 2 }
leak-timeout   = "50ms"
retries        = 0
fail-fast      = true
status-level   = "fail"
failure-output = "immediate"
success-output = "never"

# Threads: cap at 4 so parallel nextest runs don't starve the parent cargo
# invocation of CPU; a full workspace test is typically ≤200 binaries and
# fits comfortably inside 4 OS threads on macOS arm64.
test-threads = 4

# ── ci: GitHub Actions runs ──────────────────────────────────────────────────
[profile.ci]
slow-timeout   = { period = "60s", terminate-after = 2 }
leak-timeout   = "200ms"
retries        = { backoff = "fixed", count = 1, delay = "2s" }
fail-fast      = false
status-level   = "pass"
final-status-level = "flaky"
failure-output = "immediate-final"
success-output = "final"

# Emit junit.xml for CI report aggregation. Path is store-dir-relative.
[profile.ci.junit]
path = "junit.xml"
report-name = "bbnf-lang"

# ── close: full-suite ceremony runs (B1.W0.c close-gate) ─────────────────────
# Generates per-test wall timing into `target/nextest/close/...`; consumed by
# `docs/benchmarks/post-B1-W0-proof.txt` row generators. Longer slow-timeout
# because CSS L4 + sheets + full grammar matrix can legitimately take minutes.
[profile.close]
slow-timeout   = { period = "120s", terminate-after = 3 }
leak-timeout   = "500ms"
retries        = 0
fail-fast      = false
status-level   = "pass"
final-status-level = "slow"
failure-output = "immediate-final"
success-output = "final"

[profile.close.junit]
path = "junit.xml"
report-name = "bbnf-lang-close"

# Emit detailed per-test timing for the ceremony artefact.
# NOTE: `overrides` is an array-of-tables in nextest's schema; the double-
# bracket form is required. Single-bracket `[profile.close.overrides]` parses
# as a single table and nextest rejects it as "invalid type: map, expected
# a sequence". B1.W0.c discovered this against the predecessor draft.
[[profile.close.overrides]]
filter = "all()"
# No slow-timeout override; inherits the profile's 120s cap.
