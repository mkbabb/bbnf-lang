// CSS shared tokens — imported by all CSS sub-grammars.
// Avoids name conflicts when multiple CSS grammars are composed.
// selectorIdent handles:
//   - vendor prefixes (leading `-` for -moz-, -webkit-)
//   - CSS escape sequences (\: \. etc.) for Tailwind-style class names

ident  = /[a-zA-Z_\x80-\xff][\w\x80-\xff-]*/ ;
selectorIdent = /(?:-?[a-zA-Z_\x80-\xff]|\\[^\n])(?:[\w\x80-\xff-]|\\[^\n])*/ ;
string = /"(?:[^"\\]|\\[\s\S])*"/ | /'(?:[^'\\]|\\[\s\S])*'/ ;
