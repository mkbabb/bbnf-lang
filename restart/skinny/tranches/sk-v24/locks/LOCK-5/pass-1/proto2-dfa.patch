+/// (2A) Acyclic congruence fast path — one reverse-topological signature pass.
+pub fn congruence_partition_acyclic(dfa: &Dfa) -> Option<(Vec<usize>, usize)> {
+    let n = dfa.states.len();
+    let k = dfa.num_classes as usize;
+    if n == 0 { return Some((vec![], 0)); }
+    if !is_acyclic(dfa) { return None; }
+    let mut order: Vec<usize> = Vec::with_capacity(n);
+    let mut color = vec![0u8; n];
+    for root in 0..n {
+        if color[root] != 0 { continue; }
+        let mut stack: Vec<(usize, usize)> = vec![(root, 0)];
+        color[root] = 1;
+        while let Some(&(u, ci)) = stack.last() {
+            if ci < k {
+                stack.last_mut().unwrap().1 += 1;
+                let t = dfa.states[u].transitions[ci];
+                if t == DEAD { continue; }
+                let t = t as usize;
+                if color[t] == 0 { color[t] = 1; stack.push((t, 0)); }
+            } else {
+                color[u] = 2;
+                order.push(u);
+                stack.pop();
+            }
+        }
+    }
+    let mut block_of = vec![usize::MAX; n];
+    let mut sig_to_block: HashMap<Vec<i64>, usize> = HashMap::new();
+    let mut num_blocks = 0usize;
+    for &u in &order {
+        let mut sig: Vec<i64> = Vec::with_capacity(k + 1);
+        sig.push(dfa.states[u].is_accept as i64);
+        for c in 0..k {
+            let t = dfa.states[u].transitions[c];
+            if t == DEAD { sig.push(-1); } else { sig.push(block_of[t as usize] as i64); }
+        }
+        let bid = *sig_to_block.entry(sig).or_insert_with(|| { let b = num_blocks; num_blocks += 1; b });
+        block_of[u] = bid;
+    }
+    Some((block_of, num_blocks))
+}
+
+pub fn congruence_minimize_acyclic(dfa: &Dfa) -> Option<Dfa> {
+    if dfa.states.len() <= 1 { return Some(dfa.clone()); }
+    let (partition, num_blocks) = congruence_partition_acyclic(dfa)?;
+    Some(rebuild_from_partition(dfa, &partition, num_blocks))
+}
