diff --git a/crates/ir/src/vm/interpreter/apply_fn.rs b/crates/ir/src/vm/interpreter/apply_fn.rs
new file mode 100644
index 000000000..264591593
--- /dev/null
+++ b/crates/ir/src/vm/interpreter/apply_fn.rs
@@ -0,0 +1,165 @@
+//! `Op::ApplyFn` — the value-plane fold at each `IrNode::Map` site.
+//!
+//! The recognizer tape produces a `Value::Span` for the matched input; this
+//! op replaces it with a typed scalar/variant `Value` by evaluating the
+//! `FnDescriptor` (and its `MapExpr` tree) referenced by the `FnId`. This is
+//! the completion of the value plane the recognizer tape leaves open — a
+//! small tree-walk evaluator, not a codegen re-projection.
+
+use super::Interpreter;
+use super::value::Value;
+use crate::{FnDescriptor, MapBinOp, MapExpr, MapUnaryOp};
+
+impl<'prog> Interpreter<'prog> {
+    #[inline]
+    pub(super) fn exec_apply_fn(&mut self, fn_id: u32) {
+        // The recognizer result the projection folds over.
+        let orig = self.values.pop().unwrap_or(Value::Nil);
+        let text: &str = match &orig {
+            Value::Span(s, e) => {
+                let (s, e) = (*s as usize, *e as usize);
+                if e <= self.input.len() { &self.input[s..e] } else { "" }
+            }
+            _ => "",
+        };
+
+        let result = {
+            let desc = &self.program.fns[fn_id as usize];
+            self.eval_descriptor(desc, text, &orig)
+        };
+        self.values.push(result);
+        self.pc += 1;
+    }
+
+    fn eval_descriptor(&self, desc: &FnDescriptor, text: &str, orig: &Value) -> Value {
+        match desc {
+            FnDescriptor::EnumWrap { variant } => Value::Variant {
+                tag: *variant,
+                inner: Box::new(orig.clone()),
+            },
+            FnDescriptor::BoxWrap | FnDescriptor::SpanCapture => orig.clone(),
+            FnDescriptor::NumberConvert { .. } => {
+                Value::F64(text.trim().parse::<f64>().unwrap_or(f64::NAN))
+            }
+            FnDescriptor::HexConvert { .. } => Value::U32(
+                u32::from_str_radix(text.trim_start_matches('#'), 16).unwrap_or(0),
+            ),
+            FnDescriptor::Expr { expr, .. } => self.eval_map_expr(expr, text, orig),
+        }
+    }
+
+    fn eval_map_expr(&self, expr: &MapExpr, text: &str, orig: &Value) -> Value {
+        match expr {
+            MapExpr::IntLit(i) => Value::U32(*i as u32),
+            MapExpr::FloatLit(f) => Value::F64(*f),
+            MapExpr::BoolLit(b) => Value::U32(*b as u32),
+            MapExpr::StringLit(sid) => Value::Str(self.program.strings[*sid as usize].clone()),
+            MapExpr::Input => orig.clone(),
+            MapExpr::InputProp { prop } => {
+                match self.program.strings[*prop as usize].as_str() {
+                    "len" => Value::U32(text.len() as u32),
+                    "as_str" | "str" => Value::Str(text.to_string()),
+                    _ => orig.clone(),
+                }
+            }
+            MapExpr::FnCall { name, args } => {
+                let fname = &self.program.strings[*name as usize];
+                let argv: Vec<Value> =
+                    args.iter().map(|a| self.eval_map_expr(a, text, orig)).collect();
+                eval_builtin(fname, &argv, text)
+            }
+            MapExpr::BinOp { op, lhs, rhs } => {
+                let l = self.eval_map_expr(lhs, text, orig);
+                let r = self.eval_map_expr(rhs, text, orig);
+                eval_binop(*op, &l, &r)
+            }
+            MapExpr::UnaryOp { op, inner } => {
+                let v = self.eval_map_expr(inner, text, orig);
+                eval_unop(*op, &v)
+            }
+        }
+    }
+}
+
+/// Coerce a `Value` to `f64` for numeric ops.
+fn as_f64(v: &Value) -> f64 {
+    match v {
+        Value::F64(f) => *f,
+        Value::U32(u) => *u as f64,
+        Value::Str(s) => s.trim().parse().unwrap_or(f64::NAN),
+        Value::Span(_, _) | Value::Nil | Value::Array(_) | Value::Tagged { .. } => f64::NAN,
+        Value::Variant { inner, .. } => as_f64(inner),
+    }
+}
+
+/// Coerce a `Value` to `u32` for integer/bit ops.
+fn as_u32(v: &Value) -> u32 {
+    match v {
+        Value::U32(u) => *u,
+        Value::F64(f) => *f as u32,
+        Value::Str(s) => s.trim().parse().unwrap_or(0),
+        Value::Variant { inner, .. } => as_u32(inner),
+        _ => 0,
+    }
+}
+
+/// Built-in host functions referenced by `MapExpr::FnCall`.
+fn eval_builtin(name: &str, args: &[Value], text: &str) -> Value {
+    match name {
+        "parse_hex" | "hex" | "from_hex" => {
+            let s = args.first().and_then(str_of).unwrap_or(text);
+            Value::U32(u32::from_str_radix(s.trim().trim_start_matches('#'), 16).unwrap_or(0))
+        }
+        "parse_f64" | "parse_number" | "number" | "to_f64" => {
+            let s = args.first().and_then(str_of).unwrap_or(text);
+            Value::F64(s.trim().parse().unwrap_or(f64::NAN))
+        }
+        "parse_u32" | "to_u32" | "int" => {
+            let s = args.first().and_then(str_of).unwrap_or(text);
+            Value::U32(s.trim().parse().unwrap_or(0))
+        }
+        "to_str" | "str" | "trim" | "ident" => {
+            Value::Str(args.first().and_then(str_of).unwrap_or(text).trim().to_string())
+        }
+        "len" => Value::U32(text.len() as u32),
+        _ => args.first().cloned().unwrap_or(Value::Str(text.to_string())),
+    }
+}
+
+/// Borrow the string payload of a `Value` if it is a `Str`.
+fn str_of(v: &Value) -> Option<&str> {
+    match v {
+        Value::Str(s) => Some(s.as_str()),
+        _ => None,
+    }
+}
+
+fn eval_binop(op: MapBinOp, l: &Value, r: &Value) -> Value {
+    use MapBinOp::*;
+    match op {
+        Add => Value::F64(as_f64(l) + as_f64(r)),
+        Sub => Value::F64(as_f64(l) - as_f64(r)),
+        Mul => Value::F64(as_f64(l) * as_f64(r)),
+        Div => Value::F64(as_f64(l) / as_f64(r)),
+        Mod => Value::F64(as_f64(l) % as_f64(r)),
+        Eq => Value::U32((as_f64(l) == as_f64(r)) as u32),
+        Ne => Value::U32((as_f64(l) != as_f64(r)) as u32),
+        Lt => Value::U32((as_f64(l) < as_f64(r)) as u32),
+        Gt => Value::U32((as_f64(l) > as_f64(r)) as u32),
+        Le => Value::U32((as_f64(l) <= as_f64(r)) as u32),
+        Ge => Value::U32((as_f64(l) >= as_f64(r)) as u32),
+        And => Value::U32(((as_u32(l) != 0) && (as_u32(r) != 0)) as u32),
+        Or => Value::U32(((as_u32(l) != 0) || (as_u32(r) != 0)) as u32),
+        BitAnd => Value::U32(as_u32(l) & as_u32(r)),
+        BitOr => Value::U32(as_u32(l) | as_u32(r)),
+        Shl => Value::U32(as_u32(l) << as_u32(r)),
+        Shr => Value::U32(as_u32(l) >> as_u32(r)),
+    }
+}
+
+fn eval_unop(op: MapUnaryOp, v: &Value) -> Value {
+    match op {
+        MapUnaryOp::Neg => Value::F64(-as_f64(v)),
+        MapUnaryOp::Not => Value::U32((as_u32(v) == 0) as u32),
+    }
+}
