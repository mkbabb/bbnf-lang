# PROTO-A2 P4-v2 LIVE LADDER  uarch=AppleM5Max  iters=6000  blocks=4096(64B)
# LIVE kernels verbatim from crates/simd-scan/src/neon.rs {nibble:193,wide:317,multi:435,movemask:690}
# PMU ri_cycles min-of-7; density=12%

# PARITY: live nibble/wide/multi byte-exact vs scalar over sweep. OK

# LIVE constant-cost kernels (cyc/64B)
KERNEL live_nibble_lut  cyc/64B=13.326  (O(1) in N; the KernelShape::NibbleLut path)
KERNEL live_wide_lut    cyc/64B=17.232  (O(1) in N; the KernelShape::WideLut path)

# LIVE MultiCmp(N) cyc/64B vs N — crossover against nibble/wide constants
MULTI N=1  cyc/64B=9.728  vs_nibble=0.730x[multi<=nibble]  vs_wide=0.565x[multi<=wide]
