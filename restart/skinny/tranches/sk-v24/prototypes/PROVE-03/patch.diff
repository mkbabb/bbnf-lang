+/// Sentinel returned by [`first_string_terminal`] / its scalar anchor when no
+/// byte in the 16-byte block is a terminator, escape, or control byte.
+pub const NO_TERMINAL: u32 = 16;
+
+/// Scalar reference — parity anchor for [`first_string_terminal`].
+///
+/// Returns the index of the first byte that is the terminator, the escape byte,
+/// or a control byte (`< control_limit`), or [`NO_TERMINAL`] if none.
+#[inline]
+pub fn first_string_terminal_scalar(
+    bytes: &[u8; 16],
+    terminator: u8,
+    escape: u8,
+    control_limit: u8,
+) -> u32 {
+    for (index, &byte) in bytes.iter().enumerate() {
+        if byte == terminator || byte == escape || byte < control_limit {
+            return index as u32;
+        }
+    }
+    NO_TERMINAL
+}
+
+/// Fused single-pass terminal scan for a trusted (already-UTF-8) JSON string body.
+///
+/// ORs the terminator / escape / control compares into one predicate vector, then
+/// narrows the 16-byte compare to a 64-bit nibble-mask with a single
+/// `vshrn_n_u16::<4>` (the simdjson/Lemire NEON idiom) and extracts the first
+/// index via `trailing_zeros() >> 2` — no full `movemask` store/scalar-reduce.
+/// Control-byte validation thus rides the same pass that locates the closing
+/// quote and escapes, replacing a `memchr2` + separate control walk with one
+/// NEON stride. Returns the first terminal index, or [`NO_TERMINAL`] if none.
+///
+/// # Safety
+///
+/// `ptr` must point to 16 readable bytes.
+#[inline(always)]
+pub unsafe fn first_string_terminal(
+    ptr: *const u8,
+    terminator: u8,
+    escape: u8,
+    control_limit: u8,
+) -> u32 {
+    let chunk = unsafe { vld1q_u8(ptr) };
+    let special = unsafe {
+        let is_term = vceqq_u8(chunk, vdupq_n_u8(terminator));
+        let is_esc = vceqq_u8(chunk, vdupq_n_u8(escape));
+        let is_ctrl = vcltq_u8(chunk, vdupq_n_u8(control_limit));
+        vorrq_u8(vorrq_u8(is_term, is_esc), is_ctrl)
+    };
+    // Each input byte (0x00 or 0xFF) narrows to a 4-bit nibble in the 64-bit
+    // result; the first set nibble is `trailing_zeros() >> 2`.
+    let narrowed =
+        unsafe { vshrn_n_u16::<4>(vreinterpretq_u16_u8(special)) };
+    let mask = unsafe { vget_lane_u64::<0>(vreinterpret_u64_u8(narrowed)) };
+    if mask == 0 {
+        NO_TERMINAL
+    } else {
+        mask.trailing_zeros() >> 2
+    }
+}
