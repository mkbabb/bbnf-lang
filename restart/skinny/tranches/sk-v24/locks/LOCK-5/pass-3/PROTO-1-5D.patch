 #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
 pub enum SimdMode {
     Exact,
+    /// Membership scan over a 256-bit byte class (four little-endian words).
+    ByteClass([u64; 4]),
+}
+
+/// Build a 256-bit byte-class bitset (four little-endian words) from inclusive
+/// byte ranges — the representation `SimdMode::ByteClass` / `BackendExpr::ByteClass`
+/// carry. `byteset_contains` is the membership test the emitted scan compiles to.
+pub fn byteset_from_ranges(ranges: &[(u8, u8)]) -> [u64; 4] {
+    let mut set = [0u64; 4];
+    for &(lo, hi) in ranges {
+        for b in lo..=hi {
+            set[(b >> 6) as usize] |= 1u64 << (b & 63);
+        }
+    }
+    set
+}
+
+/// Membership test for a 256-bit byte-class bitset.
+pub fn byteset_contains(set: &[u64; 4], byte: u8) -> bool {
+    (set[(byte >> 6) as usize] >> (byte & 63)) & 1 == 1
 }
 
