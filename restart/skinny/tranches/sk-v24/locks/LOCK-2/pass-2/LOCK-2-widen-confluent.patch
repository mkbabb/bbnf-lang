+//! Widening rewrite: `ManufactureDispatchAlt`.
+//!
+//! Every other grammar-tier rule in this crate is *narrowing* — it
+//! shrinks an `Alt` (branch dedup, superset absorption, char-class
+//! union, regex fusion, suffix factoring). None of them ever adds a
+//! second, semantically-distinct child-bearing form to a class, so the
+//! cost model has nothing to choose between (documented null of the
+//! 54-config weight sweep in `egraph::cost_weights::CALIBRATED_WEIGHTS`).
+//!
+//! `ManufactureDispatchAlt` is the missing *widening* dual: for an
+//! `Alt(children, None)` whose branches have pairwise-disjoint FIRST
+//! bytes, it installs the equivalent `Alt(children, Some(dispatch))` —
+//! the constant-time dispatch-table form — *alongside* the original
+//! sequential-trial form. The class then holds two distinct e-nodes
+//! that are semantically identical but structurally different, which is
+//! exactly the precondition a cost-guided extractor needs to discriminate.
+//!
+//! # Confluence with the narrowing set
+//!
+//! `DeduplicateAltBranches` collapses duplicate *branches within one
+//! Alt*; it keys on the branch child set, not on the presence of a
+//! dispatch table. `Alt(cs, None)` and `Alt(cs, Some(d))` share the
+//! same branch set, so dedup never fires between them — the twin
+//! survives. `FuseAltRegexBranches` explicitly skips any Alt already
+//! carrying a dispatch table, and abstains when branches are not all
+//! Regex/Literal leaves.
+//!
+//! # Termination
+//!
+//! `search` matches only the `None` form. Applying it re-adds the
+//! `Some(dispatch)` form, which the hash-cons interns to the same Id on
+//! every subsequent iteration — zero node growth, zero new unions, so
+//! the scheduler reports saturation with margin.
+
+use egraph::{Analysis, EGraph, Id, Rewrite};
+
+use crate::egraph::interner::SharedStrings;
+use crate::egraph::node::GrammarENode;
+use crate::AltDispatch;
+
+/// Widening rule: manufacture a disjoint-FIRST-set dispatch-table form
+/// beside the sequential-trial `Alt`, so the e-class carries both.
+pub struct ManufactureDispatchAlt {
+    pool: SharedStrings,
+}
+
+impl ManufactureDispatchAlt {
+    pub fn new(pool: SharedStrings) -> Self {
+        Self { pool }
+    }
+
+    /// The FIRST byte a branch dispatches on, if it is statically
+    /// determinable and ASCII (`< 128`, the dispatch table's width).
+    ///
+    /// A branch's guard byte is the first byte of its leading literal:
+    /// a bare `Literal("...")`, or a `Seq([Literal("..."), ..])` whose
+    /// leading child class exposes a literal. Mirrors the real dispatch
+    /// pass's FIRST-set derivation for the sentinel-prefixed value
+    /// branches that JSON / CSS-L4 alternations are built from.
+    fn branch_guard_byte<A: Analysis<GrammarENode>>(
+        &self,
+        egraph: &EGraph<GrammarENode, A>,
+        id: Id,
+    ) -> Option<u8> {
+        let leading_literal = |cid: Id| -> Option<u8> {
+            egraph.class(cid).iter().find_map(|n| match n {
+                GrammarENode::Literal(sid) => {
+                    let s = self.pool.get(*sid);
+                    s.bytes().next().filter(|b| *b < 128)
+                }
+                _ => None,
+            })
+        };
+        // Direct literal branch, or Seq whose first child is a literal.
+        egraph.class(id).iter().find_map(|n| match n {
+            GrammarENode::Literal(_) => leading_literal(id),
+            GrammarENode::Seq(children) => children.first().copied().and_then(leading_literal),
+            _ => None,
+        })
+    }
+}
+
+/// Carries the manufactured dispatch table and the branch list it
+/// dispatches over from `search` to `apply`.
+#[derive(Clone, Debug)]
+pub struct DispatchMatch {
+    pub children: Box<[Id]>,
+    pub dispatch: AltDispatch,
+}
+
+impl<A: Analysis<GrammarENode>> Rewrite<GrammarENode, A> for ManufactureDispatchAlt {
+    type Match = DispatchMatch;
+
+    fn name(&self) -> &str {
+        "manufacture-dispatch-alt"
+    }
+
+    fn search(&self, egraph: &EGraph<GrammarENode, A>) -> Vec<(Id, Self::Match)> {
+        let mut matches = Vec::new();
+        for class in egraph.classes() {
+            for node in class.iter() {
+                // Only the sequential-trial form is a candidate. Matching
+                // the `Some` form too would re-fire forever — this guard
+                // is what makes the rule terminate.
+                let GrammarENode::Alt(children, None) = node else {
+                    continue;
+                };
+                if children.len() < 2 {
+                    continue;
+                }
+
+                // Every branch must expose a guard byte, and the bytes
+                // must be pairwise-disjoint (a real FIRST-set partition).
+                let mut table = vec![255u8; 128];
+                let mut ok = true;
+                for (idx, &branch) in children.iter().enumerate() {
+                    let Some(byte) = self.branch_guard_byte(egraph, branch) else {
+                        ok = false;
+                        break;
+                    };
+                    let slot = &mut table[byte as usize];
+                    if *slot != 255 {
+                        // Two branches share a FIRST byte — not disjoint,
+                        // dispatch is unsound. Abstain.
+                        ok = false;
+                        break;
+                    }
+                    *slot = idx as u8;
+                }
+                if !ok {
+                    continue;
+                }
+
+                matches.push((
+                    class.id,
+                    DispatchMatch {
+                        children: children.clone(),
+                        dispatch: AltDispatch {
+                            table,
+                            fallback_idx: None,
+                        },
+                    },
+                ));
+                break;
+            }
+        }
+        matches
+    }
+
+    fn apply(&self, egraph: &mut EGraph<GrammarENode, A>, class_id: Id, m: Self::Match) {
+        let dispatched = egraph.add(GrammarENode::Alt(m.children, Some(m.dispatch)));
+        egraph.union(class_id, dispatched);
+    }
+}
