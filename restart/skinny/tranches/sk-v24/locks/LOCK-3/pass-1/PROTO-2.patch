+//! STEP 1 of the STAGED-RESIDUAL (family 3D) probe — the binding-time analysis
+//! that would drive a split (S0/S1) CSS leaf emitter.
+//!
+//! These tests exercise `binding_times` on a synthetic GrammarIr that MIRRORS the
+//! CSS component-delimiter scan: four STOP-set islands (`;{}`, `{};`, `;}`,
+//! `:{};`) each an `Alt` of single-byte `Literal`s, spliced into a `Repeat` scan
+//! spine. The synthetic mirror is necessary: in this tree the CSS recognizer is a
+//! raw-string template (`CSS_GENERATED_RS`), so the real CSS delimiter literals
+//! never become GrammarIr nodes for `binding_times` to see. The tests therefore
+//! prove the BTA machinery classifies a delimiter island as S0 and the scan as
+//! S1 — the precondition the corollary needs — while the report records that the
+//! actual CSS emit path bypasses the IR entirely.
+
+use ir::{binding_times, residual_islands, stage_leaks, AltMode, CaseSensitivity, ExprKind,
+    GrammarIr, SourceSpan, Stage};
+
+/// Build an `Alt` of single-byte literals — one CSS STOP set.
+fn stop_set(grammar: &mut GrammarIr, bytes: &[u8]) -> ir::ExprId {
+    let branches = bytes
+        .iter()
+        .map(|b| {
+            grammar.add_expr(
+                ExprKind::Literal {
+                    bytes: vec![*b],
+                    case: CaseSensitivity::Sensitive,
+                },
+                SourceSpan::new(0, 1),
+            )
+        })
+        .collect();
+    grammar.add_expr(
+        ExprKind::Alt {
+            branches,
+            mode: AltMode::Dispatch,
+        },
+        SourceSpan::new(0, bytes.len()),
+    )
+}
+
+/// A GrammarIr mirroring the CSS component scan: 4 STOP islands under a Repeat.
+fn css_delimiter_shaped_grammar() -> (GrammarIr, Vec<ir::ExprId>, ir::ExprId) {
+    let mut grammar = GrammarIr::new("css_mirror", "hash");
+    // The four grammar-derived STOP sets (PROVE-12's 5 call sites collapse to 4
+    // distinct sets: `;{}` == `{};` as SETS, plus `;}` and `:{};`).
+    let at_rule = stop_set(&mut grammar, b";{}");
+    let qualified = stop_set(&mut grammar, b"{};");
+    let declaration = stop_set(&mut grammar, b";}");
+    let colon_before = stop_set(&mut grammar, b":{};");
+    let islands = vec![at_rule, qualified, declaration, colon_before];
+
+    // Each STOP set is its OWN scan call site (as PROVE-12's 5 `find_component_delim`
+    // sites are): wrap each island in its own `Repeat` scan spine, then Seq the
+    // four scans into the entry rule. Every Repeat is S1; its Alt body is an S0
+    // island spliced directly into it.
+    let scans: Vec<ir::ExprId> = islands
+        .iter()
+        .map(|island| {
+            grammar.add_expr(
+                ExprKind::Repeat {
+                    body: *island,
+                    min: 0,
+                    max: None,
+                },
+                SourceSpan::new(0, 20),
+            )
+        })
+        .collect();
+    let spine = grammar.add_expr(ExprKind::Seq(scans.clone()), SourceSpan::new(0, 24));
+    grammar.add_rule("stylesheet", spine, SourceSpan::new(0, 28));
+    (grammar, islands, spine)
+}
+
+#[test]
+fn stop_islands_are_comptime_scan_is_runtime() {
+    let (grammar, islands, scan) = css_delimiter_shaped_grammar();
+    let stage = binding_times(&grammar);
+
+    // Every delimiter STOP-set Alt (and every single-byte literal inside it) is S0.
+    for island in &islands {
+        assert_eq!(stage[island.0], Stage::Comptime, "STOP island must be S0");
+        for child in match &grammar.expr(*island).kind {
+            ExprKind::Alt { branches, .. } => branches.clone(),
+            _ => unreachable!(),
+        } {
+            assert_eq!(stage[child.0], Stage::Comptime, "delimiter literal must be S0");
+        }
+    }
+    // The Repeat scan spine is S1 (reads the input cursor).
+    assert_eq!(stage[scan.0], Stage::Runtime, "scan loop must be S1");
+}
+
+#[test]
+fn residual_island_count_matches_the_four_stop_sets() {
+    let (grammar, _islands, _scan) = css_delimiter_shaped_grammar();
+    let stage = binding_times(&grammar);
+    let residuals = residual_islands(&grammar, &stage);
+    // Exactly the 4 STOP-set Alts are lifted: each is a Comptime operand of the
+    // Runtime Seq/Repeat spine. This is the residual-count artifact = 4.
+    assert_eq!(residuals.len(), 4, "expected 4 residualized S0 delimiter islands");
+}
+
+#[test]
+fn clean_delimiter_grammar_has_no_stage_leaks() {
+    // The delimiter island is a clean S0 island: the grammar-constant leaves are
+    // childless, so the no-silent-epsilon leak guard never fires.
+    let (grammar, _islands, _scan) = css_delimiter_shaped_grammar();
+    let stage = binding_times(&grammar);
+    assert!(stage_leaks(&grammar, &stage).is_empty(), "clean delimiter grammar must not leak");
+}
+
+#[test]
+fn a_literal_fed_a_ref_is_a_seq_not_a_leak() {
+    // A Seq combining an S0 literal with an S1 Ref joins to S1 (the combinator
+    // rises), while the literal itself stays a clean S0 leaf — no leak. This is
+    // the monotone-join direction: S0 -> S1 only, never demoting the literal.
+    let mut grammar = GrammarIr::new("mixed", "hash");
+    let lit = grammar.add_expr(
+        ExprKind::Literal { bytes: b";".to_vec(), case: CaseSensitivity::Sensitive },
+        SourceSpan::new(0, 1),
+    );
+    let reference = grammar.add_expr(
+        ExprKind::Ref { name: "other".into(), target: None },
+        SourceSpan::new(0, 5),
+    );
+    let seq = grammar.add_expr(ExprKind::Seq(vec![lit, reference]), SourceSpan::new(0, 6));
+    grammar.add_rule("r", seq, SourceSpan::new(0, 8));
+    let stage = binding_times(&grammar);
+    assert_eq!(stage[lit.0], Stage::Comptime);
+    assert_eq!(stage[reference.0], Stage::Runtime);
+    assert_eq!(stage[seq.0], Stage::Runtime);
+    assert!(stage_leaks(&grammar, &stage).is_empty());
+    // The S0 literal is a residual island spliced into the S1 seq.
+    assert_eq!(residual_islands(&grammar, &stage), vec![lit]);
+}
