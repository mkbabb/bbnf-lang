// CSS Values and Units Level 4 — numeric primitives and dimension types.
// Spec: https://drafts.csswg.org/css-values-4/
// This is the canonical base grammar; other CSS grammars import from here.
//
// Usage: @import "value-unit.bbnf" ;
// Unit literals map to u8 discriminants (matching lightningcss LengthValue layout).

// --- Numeric primitives (§3.1) ---
// AU.2.3 partial: `integer -> i64` activates i64 capture; `number -> f64`
// is held back pending agent-F emitter fix. The current f64 codegen routes
// every Numeric-classified regex through `scan_number_strict_f64`, which
// rejects CSS leading-dot literals (`.5`, `.25`); tailwind.css fails on
// the first `.5` declaration value (`opacity: .5;`, ~379 sites). The
// classifier already records `allow_leading_dot: true` on this regex, so
// the dispatch in `crates/core/src/backend/rust/emitter/leaves.rs:130-141`
// and `crates/core/src/backend/rust/emitter/map_value.rs:38-84` must
// branch on that flag and call `parse_that::scan_number_f64` (generic
// CSS-permissive variant) instead of `scan_number_strict_f64`. Once
// agent F lands that fix, restore `-> f64` here and AU.2.3 / AU.2.5
// activate together.
number = /[-+]?(\d+(\.\d+)?|\.\d+)([eE][-+]?\d+)?/ ;
integer = /[-+]?\d+/ -> i64 ;

// --- Length units (§6) → u8 discriminant ---

absoluteLengthUnit = "px" -> 0u8 | "cm" -> 9u8 | "mm" -> 10u8 | "Q" -> 26u8
                   | "in" -> 11u8 | "pc" -> 13u8 | "pt" -> 12u8 ;

viewportLengthUnit = "vmin" -> 5u8 | "vmax" -> 6u8 | "vh" -> 3u8 | "vw" -> 4u8
                   | "vb" -> 27u8 | "vi" -> 28u8
                   | "svmin" -> 29u8 | "svmax" -> 30u8 | "svw" -> 16u8 | "svh" -> 17u8
                   | "svb" -> 31u8 | "svi" -> 32u8
                   | "lvmin" -> 33u8 | "lvmax" -> 34u8 | "lvw" -> 20u8 | "lvh" -> 21u8
                   | "lvb" -> 35u8 | "lvi" -> 36u8
                   | "dvmin" -> 37u8 | "dvmax" -> 38u8 | "dvw" -> 18u8 | "dvh" -> 19u8
                   | "dvb" -> 39u8 | "dvi" -> 40u8 ;

containerLengthUnit = "cqmin" -> 41u8 | "cqmax" -> 42u8
                    | "cqw" -> 22u8 | "cqh" -> 23u8 | "cqi" -> 24u8 | "cqb" -> 25u8 ;

fontLengthUnit = "rem" -> 2u8 | "em" -> 1u8 | "ex" -> 8u8 | "ch" -> 7u8
               | "lh" -> 14u8 | "rlh" -> 15u8 | "cap" -> 43u8 | "ic" -> 44u8
               | "rcap" -> 45u8 | "rex" -> 46u8 | "rch" -> 47u8 | "ric" -> 48u8 ;

relativeLengthUnit = fontLengthUnit | viewportLengthUnit | containerLengthUnit ;
lengthUnit = absoluteLengthUnit | relativeLengthUnit ;

// --- Angle units (§6.4) → u8 discriminant ---
angleUnit = "deg" -> 0u8 | "grad" -> 2u8 | "rad" -> 1u8 | "turn" -> 3u8 ;

// --- Time units (§6.5) → u8 discriminant ---
timeUnit = "ms" -> 0u8 | "s" -> 1u8 ;

// --- Frequency units (§6.6) → u8 discriminant ---
frequencyUnit = "kHz" -> 1u8 | "Hz" -> 0u8 ;

// --- Resolution units (§6.7) → u8 discriminant ---
resolutionUnit = "dpcm" -> 1u8 | "dppx" -> 2u8 | "dpi" -> 0u8 | "x" -> 3u8 ;

// --- Flex units (Grid L1) → u8 discriminant ---
flexUnit = "fr" -> 0u8 ;

// --- Percentage (§5.1.1) → u8 discriminant (255 marks the "%" tag) ---
percentageUnit = "%" -> 255u8 ;

// --- Dimension types ---

length     = number , lengthUnit ;
angle      = number , angleUnit ;
time       = number , timeUnit ;
frequency  = number , frequencyUnit ;
resolution = number , resolutionUnit ;
flex       = number , flexUnit ;
percentage = number , percentageUnit ;

unitless = number ;

valueUnit = length | angle | time | frequency | resolution | flex | percentage | unitless ;
