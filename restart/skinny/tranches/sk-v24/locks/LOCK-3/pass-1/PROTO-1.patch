+/// Per-pass contract on the single (collapsed) IR — the 3B substitute for a
+/// distinct typed level.
+///
+/// A "projection" node is an `ExprKind::Annotation` that declares a target type
+/// (`value = Some(_)`, i.e. a `->` in the grammar). Its type must survive the
+/// L0->L1 (`layout::types::infer`) pass as a populated `type_ref` in the
+/// `node_types` attribute table — never dropped to `Unit`.
+///
+/// In a typed-level tower (family 3A) this invariant is structural: the second
+/// IR could not be constructed without the type, so a drop is a compile error.
+/// Here there is one IR plus a runtime attribute table (`TypeFacts::node_types`);
+/// a dropped type is *not* a compile error (the table is a `HashMap`, build stays
+/// green), so this per-pass assertion is what localizes the defect — naming the
+/// exact edge (infer) at which the type_ref was lost.
+pub fn verify(grammar: &GrammarIr, type_facts: &layout::types::TypeFacts) -> Result<(), PassError> {
+    for expr in &grammar.exprs {
+        if let ExprKind::Annotation {
+            name,
+            value: Some(declared),
+        } = &expr.kind
+        {
+            let node_ty = type_facts.node_types.get(&expr.id);
+            let populated =
+                matches!(node_ty, Some(ty) if !matches!(ty, Type::Builtin(BuiltinTy::Unit)));
+            if !populated {
+                return Err(PassError::Type(format!(
+                    "L0->L1 (infer) contract violation: projection node #{} (annotation \
+                     `{name} -> {declared}`) reached codegen with a dropped type_ref \
+                     (node_type = {node_ty:?}); the declared type was discarded by \
+                     `layout::types::infer` at the `ExprKind::Annotation` arm. A distinct \
+                     typed level would have made this a compile error; the single-IR per-pass \
+                     contract localizes it to the infer edge instead.",
+                    expr.id.0,
+                )));
+            }
+        }
+    }
+    Ok(())
+}
