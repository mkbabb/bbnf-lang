+// ── classify a both-Ok structural divergence: always an oracle VERDICT ─────
+// (both parsers accepted, host::lower is deterministic + total, opts shared =>
+// the generated PARSE TREE differs => pre-lower). Name the specific wrong
+// parse decision from the AST witness.
+fn classify_struct(ast_dbg: &Option<String>) -> (Class, &'static str) {
+    let ad = ast_dbg.as_deref().unwrap_or("");
+    // `.` routed to a class-literal node (class_atom_0) instead of the dot
+    // metachar (atom_0). Note: substring test is exact — atom_0 as a whole
+    // token would be "atom(atom_0("; the dot mis-parse shows "atom(class_atom_0(".
+    let dot_misparse = ad.contains("atom(class_atom_0(");
+    // `(?flags)` parsed as a PLAIN capturing group (`group(`) wrapping a flag
+    // letter, instead of the bare-flag group_1 that host.rs::apply_flags folds.
+    let flag_misparse = ad.contains("group(class_atom_0(") || ad.contains("group(alternation");
+    match (dot_misparse, flag_misparse) {
+        (true, true) => (
+            Class::OracleVerdict,
+            "grammar: `(?s)` -> plain group (not group_1) AND `.` -> class_atom_0 (not atom_0 dot); host.rs group_1/make_dot never reached",
+        ),
+        (true, false) => (
+            Class::OracleVerdict,
+            "grammar: `.` metachar parsed as class_atom_0 (literal) instead of atom_0 (dot); host.rs::make_dot never reached",
+        ),
+        (false, true) => (
+            Class::OracleVerdict,
+            "grammar: inline-flag `(?flags)` parsed as a plain capturing group, not group_1; host.rs::apply_flags never reached",
+        ),
+        (false, false) => (
+            Class::OracleVerdict,
+            "pre-lower parse-tree divergence (both Ok, deterministic fold => AST differs)",
+        ),
+    }
+}
