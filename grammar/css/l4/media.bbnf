// CSS Media Queries Level 5 — structured media condition grammar.
// Spec: https://drafts.csswg.org/mediaqueries-5/
//
// Covers the real-world subset: media types, feature expressions with
// min/max prefixes, and boolean combinators (and, or, not).

@import "tokens.bbnf" ;

// --- Media types ---
// u8 discriminant for media type — matches lightningcss MediaType:
// All=0, Print=1, Screen=2, Speech=3.
mediaType = "all" -> 0u8 | "print" -> 1u8
          | "screen" -> 2u8 | "speech" -> 3u8 ;

// --- Query qualifier (not / only) ---
mediaQualifier = "not" -> 0u8 | "only" -> 1u8 ;

// --- Media feature: (name: value) or (name) ---
mediaFeatureName = ident ;
mediaFeatureValue = /[^)]+/ ;
mediaFeature = "(" ?w , mediaFeatureName ?w , (":" ?w , mediaFeatureValue ?w) ? , ")" ;

// --- Media condition combinators ---
// TODO typed-aggregate (AU.2.6): mediaCondition is a recursive enum —
// Not/And/Or/InParens — with nested mediaCondition payloads. The grammar
// disambiguates by structure; variant tags compose via the branch-typed
// codegen landing with AU.6.7.
mediaNot       = "not" ?w , mediaInParens ;
mediaAnd       = mediaInParens , ("and" ?w >> mediaInParens) + ;
mediaOr        = mediaInParens , ("or" ?w >> mediaInParens) + ;
mediaInParens  = mediaFeature | "(" ?w >> mediaCondition ?w << ")" ;
mediaCondition = mediaNot | mediaAnd | mediaOr | mediaInParens ;

// --- Full media query ---
// "print", "screen and (min-width: 768px)", "not print", "(prefers-color-scheme: dark)"
mediaQuery     = mediaQualifier ? , mediaType ? , ("and" ?w >> mediaInParens) * ;
mediaQueryList = mediaQuery , ("," ?w >> mediaQuery) * ;
