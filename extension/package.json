{
    "name": "bbnf-language-support",
    "displayName": "BBNF Language",
    "version": "1.0.5",
    "description": "Full language support for BBNF grammars — diagnostics, go-to-definition, references, rename, hover, completion, formatting, and more.",
    "icon": "icons/bbnf.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/mkbabb/bbnf-lang"
    },
    "author": "@mkbabb",
    "publisher": "mkbabb",
    "license": "MIT",
    "keywords": [
        "bbnf",
        "grammar",
        "parser",
        "language-server"
    ],
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters"
    ],
    "engines": {
        "vscode": "^1.105.0"
    },
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "BBNF",
            "properties": {
                "BBNF.server.path": {
                    "type": "string",
                    "default": "",
                    "description": "Custom path to the bbnf-lsp binary. Leave empty to use the bundled binary."
                },
                "BBNF.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VS Code and the BBNF language server."
                }
            }
        },
        "languages": [
            {
                "id": "bbnf",
                "aliases": [
                    "BBNF",
                    "bbnf"
                ],
                "extensions": [
                    ".bbnf"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/bbnf.png",
                    "dark": "./icons/bbnf.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "bbnf",
                "scopeName": "source.bbnf",
                "path": "./syntaxes/bbnf.tmLanguage.json"
            },
            {
                "injectTo": [
                    "source.bbnf"
                ],
                "scopeName": "inline.inlineLanguageString",
                "path": "./syntaxes/inlineLanguageString.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "bbnf.restartServer",
                "title": "BBNF: Restart Language Server"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "ruleDefinition",
                "superType": "function",
                "description": "LHS of a BBNF production rule"
            },
            {
                "id": "ruleReference",
                "superType": "variable",
                "description": "Nonterminal reference in RHS"
            }
        ],
        "breakpoints": [
            {
                "language": "bbnf"
            }
        ],
        "debuggers": [
            {
                "type": "bbnf",
                "label": "BBNF Grammar Debugger",
                "languages": [
                    "bbnf"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "grammar"
                        ],
                        "properties": {
                            "grammar": {
                                "type": "string",
                                "description": "Path to the .bbnf grammar file to debug."
                            },
                            "input": {
                                "type": "string",
                                "description": "Path to the input file to parse."
                            },
                            "inputText": {
                                "type": "string",
                                "description": "Inline input text to parse (alternative to input file)."
                            },
                            "entryRule": {
                                "type": "string",
                                "description": "Override the entry rule name (default: last rule in grammar)."
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "default": true,
                                "description": "Pause on the entry rule before parsing begins."
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "BBNF: Debug Grammar",
                        "description": "Debug a BBNF grammar by stepping through parse execution.",
                        "body": {
                            "type": "bbnf",
                            "request": "launch",
                            "name": "Debug Grammar",
                            "grammar": "${file}",
                            "input": "${workspaceFolder}/test-input.txt",
                            "stopOnEntry": true
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "lint": "tsc --noEmit",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/node": "^25.3.0",
        "@types/vscode": "^1.105.0",
        "@vscode/vsce": "^3.7.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.8.0",
        "vscode-languageclient": "^9.0.0"
    }
}
