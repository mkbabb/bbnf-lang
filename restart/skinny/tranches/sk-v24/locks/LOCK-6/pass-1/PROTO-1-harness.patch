+//! Native (aarch64 NEON) throughput harness for the 6C R-A probe.
+//!
+//! Reads a corpus file, then times `scan_structural` cold-per-parse
+//! (each iteration is an independent scan that allocates a fresh
+//! `StructuralIndex`, matching `benches/stage1_throughput.rs`). Reports
+//! median and best (peak) MB/s over N samples so the wasm driver can be
+//! compared apples-to-apples.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let path = &args[1];
+    let n: usize = args.get(2).map(|s| s.parse().unwrap()).unwrap_or(200);
+
+    let input = std::fs::read(path).unwrap();
+    let len = input.len();
+
+    // Warm the icache/branch predictors a little, but every measured
+    // sample is still an independent cold-per-parse scan.
+    for _ in 0..20 {
+        black_box(probe6c::scan_len(black_box(input.as_slice())));
+    }
+
+    let mut samples: Vec<f64> = Vec::with_capacity(n);
+    let mut acc: u64 = 0;
+    for _ in 0..n {
+        let t = Instant::now();
+        let r = probe6c::scan_len(black_box(input.as_slice()));
+        let dt = t.elapsed().as_secs_f64();
+        acc = acc.wrapping_add(r as u64);
+        samples.push(dt);
+    }
+    black_box(acc);
+
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let best = samples[0];
+    let median = samples[n / 2];
+    let mb = len as f64 / 1_000_000.0;
+    println!(
+        "native len={} n={} idx_sum={} best_us={:.2} median_us={:.2} best_MBps={:.1} median_MBps={:.1}",
+        len,
+        n,
+        acc,
+        best * 1e6,
+        median * 1e6,
+        mb / best,
+        mb / median,
+    );
+}
diff --git a/probe6c/driver.mjs b/probe6c/driver.mjs
new file mode 100644
--- /dev/null	2026-07-16 04:42:07
+++ b/probe6c/driver.mjs
@@ -0,0 +1,48 @@
+// Wasm (SIMD128) throughput driver for the 6C R-A probe.
+//
+// Loads the probe6c cdylib, copies a corpus into linear memory once,
+// then times scan_json cold-per-parse (each call is an independent
+// scan allocating a fresh index inside wasm). Reports median and best
+// MB/s over N samples — identical measurement shape to the native
+// harness, so the two are directly comparable.
+
+import { readFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+
+const [, , wasmPath, corpusPath, nArg] = process.argv;
+const N = nArg ? parseInt(nArg, 10) : 200;
+
+const bytes = readFileSync(wasmPath);
+const corpus = readFileSync(corpusPath);
+const len = corpus.length;
+
+const { instance } = await WebAssembly.instantiate(bytes, {});
+const { memory, walloc, scan_json } = instance.exports;
+
+// Allocate once, then re-fetch the buffer view (walloc may grow memory,
+// which detaches any earlier view).
+const ptr = walloc(len);
+new Uint8Array(memory.buffer, ptr, len).set(corpus);
+
+// Warm.
+let acc = 0;
+for (let i = 0; i < 20; i++) acc += scan_json(ptr, len);
+
+const samples = new Float64Array(N);
+for (let i = 0; i < N; i++) {
+    const t = performance.now();
+    const r = scan_json(ptr, len);
+    const dt = (performance.now() - t) / 1000; // seconds
+    acc += r;
+    samples[i] = dt;
+}
+
+const sorted = Array.from(samples).sort((a, b) => a - b);
+const best = sorted[0];
+const median = sorted[Math.floor(N / 2)];
+const mb = len / 1_000_000;
+console.log(
+    `wasm   len=${len} n=${N} idx_sum=${acc} ` +
+        `best_us=${(best * 1e6).toFixed(2)} median_us=${(median * 1e6).toFixed(2)} ` +
+        `best_MBps=${(mb / best).toFixed(1)} median_MBps=${(mb / median).toFixed(1)}`,
+);
