diff --git a/skinny/crates/runtime/src/grammars/json/path.rs b/skinny/crates/runtime/src/grammars/json/path.rs
new file mode 100644
index 000000000..e4f86e2bd
--- /dev/null
+++ b/skinny/crates/runtime/src/grammars/json/path.rs
@@ -0,0 +1,178 @@
+// JSON-owned stop-early path get; not part of the generated JSON roster.
+//
+// A pointer/path `get` that skip-parses directly over the source bytes, touching
+// only the bytes on the resolved path plus the brackets of the subtrees it steps
+// over. It never builds the offset tape: subtrees are jumped with the NEON
+// structural skip engine (`scan::skip_container`, the dormant jump-to-matching-
+// bracket primitive), strings are bounded with `match_string`, scalars with a
+// delimiter scan. This is the F4 stop-early lazy seam, additive and grammar-side.
+use parse_that_regex::{match_string, StringMode};
+
+use super::scan;
+
+/// One step of a JSON pointer: an object key or an array index.
+#[derive(Copy, Clone, Debug)]
+pub enum Seg<'a> {
+    Key(&'a str),
+    Idx(usize),
+}
+
+/// The located value, as its raw source slice (byte-identical to what a lazy
+/// `get` returns — the caller decodes on demand). Bounded stop-early.
+#[derive(Copy, Clone, Debug, PartialEq)]
+pub enum Located<'i> {
+    Object(&'i str),
+    Array(&'i str),
+    String(&'i str),
+    Number(&'i str),
+    Bool(bool),
+    Null,
+}
+
+impl<'i> Located<'i> {
+    /// The raw source slice of the located value (`""`-quoted for strings,
+    /// `{}`/`[]`-bracketed for containers) — the `as_raw_str` analogue.
+    pub fn as_raw_str(&self) -> &'i str {
+        match *self {
+            Located::Object(s)
+            | Located::Array(s)
+            | Located::String(s)
+            | Located::Number(s) => s,
+            Located::Bool(true) => "true",
+            Located::Bool(false) => "false",
+            Located::Null => "null",
+        }
+    }
+}
+
+/// Resolve `path` against `input`, stopping as soon as the target is located.
+/// Returns `None` when any segment is absent or type-mismatched.
+pub fn get<'i>(input: &'i str, path: &[Seg<'_>]) -> Option<Located<'i>> {
+    let bytes = input.as_bytes();
+    let mut at = skip_ws(bytes, 0);
+    for seg in path {
+        at = match (bytes.get(at)?, seg) {
+            (b'{', Seg::Key(key)) => object_find(bytes, at, key)?,
+            (b'[', Seg::Idx(index)) => array_find(bytes, at, *index)?,
+            _ => return None,
+        };
+        at = skip_ws(bytes, at);
+    }
+    Some(locate(input, bytes, at))
+}
+
+/// Locate the value at `open` (a `{`), returning the start index of the value
+/// bound to `key`, or `None` if the key is absent.
+fn object_find(bytes: &[u8], open: usize, key: &str) -> Option<usize> {
+    let mut at = skip_ws(bytes, open + 1);
+    if bytes.get(at) == Some(&b'}') {
+        return None;
+    }
+    loop {
+        let key_end = match_string(bytes, at, StringMode::Utf8).ok()?.raw_end;
+        let hit = key_eq(bytes, at + 1, key_end - 1, key);
+        let colon = skip_ws(bytes, key_end);
+        let value = skip_ws(bytes, colon + 1);
+        if hit {
+            return Some(value);
+        }
+        let after = skip_ws(bytes, skip_value(bytes, value));
+        match bytes.get(after)? {
+            b',' => at = skip_ws(bytes, after + 1),
+            _ => return None,
+        }
+    }
+}
+
+/// Locate element `index` of the array at `open` (a `[`), or `None`.
+fn array_find(bytes: &[u8], open: usize, index: usize) -> Option<usize> {
+    let mut at = skip_ws(bytes, open + 1);
+    if bytes.get(at) == Some(&b']') {
+        return None;
+    }
+    let mut cursor = 0usize;
+    loop {
+        if cursor == index {
+            return Some(at);
+        }
+        let after = skip_ws(bytes, skip_value(bytes, at));
+        match bytes.get(after)? {
+            b',' => {
+                at = skip_ws(bytes, after + 1);
+                cursor += 1;
+            }
+            _ => return None,
+        }
+    }
+}
+
+/// Advance past a whole value (object/array/string/scalar) starting at `at`.
+#[inline]
+fn skip_value(bytes: &[u8], at: usize) -> usize {
+    match bytes[at] {
+        b'{' | b'[' => scan::skip_container(bytes, at),
+        b'"' => match_string(bytes, at, StringMode::Utf8)
+            .map(|span| span.raw_end)
+            .unwrap_or(at + 1),
+        _ => skip_scalar(bytes, at),
+    }
+}
+
+/// Classify + bound the value at `at` into a `Located` raw slice.
+#[inline]
+fn locate<'i>(input: &'i str, bytes: &[u8], at: usize) -> Located<'i> {
+    match bytes[at] {
+        b'{' => Located::Object(&input[at..scan::skip_container(bytes, at)]),
+        b'[' => Located::Array(&input[at..scan::skip_container(bytes, at)]),
+        b'"' => Located::String(
+            &input[at
+                ..match_string(bytes, at, StringMode::Utf8)
+                    .map(|span| span.raw_end)
+                    .unwrap_or(at + 1)],
+        ),
+        b't' => Located::Bool(true),
+        b'f' => Located::Bool(false),
+        b'n' => Located::Null,
+        _ => Located::Number(&input[at..skip_scalar(bytes, at)]),
+    }
+}
+
+/// Scan a scalar (number/`true`/`false`/`null`) to its delimiter.
+#[inline]
+fn skip_scalar(bytes: &[u8], at: usize) -> usize {
+    let mut cursor = at;
+    while cursor < bytes.len()
+        && !matches!(
+            bytes[cursor],
+            b',' | b']' | b'}' | b' ' | b'\t' | b'\n' | b'\r'
+        )
+    {
+        cursor += 1;
+    }
+    cursor
+}
+
+/// Compare the key body `bytes[start..end]` (between the quotes) to `key`.
+/// Fast path is a raw byte compare; escaped keys fall back to unescape.
+#[inline]
+fn key_eq(bytes: &[u8], start: usize, end: usize, key: &str) -> bool {
+    let body = &bytes[start..end];
+    if !body.contains(&b'\\') {
+        return body == key.as_bytes();
+    }
+    match std::str::from_utf8(body) {
+        Ok(raw) => parse_that_regex::unescape_string(raw)
+            .map(|decoded| decoded == key)
+            .unwrap_or(false),
+        Err(_) => false,
+    }
+}
