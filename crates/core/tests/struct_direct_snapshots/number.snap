// AZ-I.W2.RC — struct-direct Number-shape emission snapshot.
//
// Captures the StructDirect-arm emission of the per-shape Number
// emitter (`crates/core/src/backend/rust/emitter/shapes/number.rs`).
// The snapshot's purpose is to lock in: (a) at least one `builder.*`
// call routes the parsed `f64`; (b) no legacy tape-substrate leaf
// pushes leak into the struct-direct arm. The driver in
// `struct_direct_snapshots.rs` asserts both invariants at every
// test run.
//
// Per-shape source: `emit_parse_number_struct_direct` (number.rs).
// Wire contract: `builder.push_leaf_with_f64(value)` is the sole
// leaf-emission surface; the Eisel-Lemire scan body is identical to
// the TapeDirect arm.

#[inline(always)]
#[allow(non_snake_case, clippy::too_many_arguments, unused_variables)]
pub fn parse_number_JsonParser_number<'p>(
    input: &'p [u8],
    p: &mut usize,
    first_byte: u8,
    builder: &mut ::bbnf::runtime::JsonStructBuilder<'p>,
) -> ::core::result::Result<
    crate::runtime::tape::TapeOffset,
    crate::runtime::tape::DtaError,
> {
    // …Eisel-Lemire mantissa + decimal exponent scan elided…
    let value: f64 = /* compute_f64 / fallback */ 0.0;
    builder.push_leaf_with_f64(value);
    Ok(crate::runtime::tape::TapeOffset::NONE)
}
