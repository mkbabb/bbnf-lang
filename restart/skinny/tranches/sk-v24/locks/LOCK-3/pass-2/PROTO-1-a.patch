+/// Does this recognizer expr consume input? Pure markers
+/// (SpanMark/TapeEmit/DirectBuild/Return) emit only tape bookkeeping and never
+/// advance the cursor, so a `skip_ws` separator adjacent to them is dead.
+fn consumes_input(expr: &SinkOnlyExpr) -> bool {
+    match expr {
+        SinkOnlyExpr::Entry(inner) | SinkOnlyExpr::OptionalBranch(inner) => consumes_input(inner),
+        SinkOnlyExpr::Seq(children) => children.iter().any(consumes_input),
+        SinkOnlyExpr::Alt { branches, .. } => branches.iter().any(consumes_input),
+        SinkOnlyExpr::RepeatLoop { body, .. } => consumes_input(body),
+        SinkOnlyExpr::ValueProject { body, .. } => consumes_input(body),
+        SinkOnlyExpr::CallRule { .. }
+        | SinkOnlyExpr::ByteLiteral(_)
+        | SinkOnlyExpr::RegexProgram { .. } => true,
+        SinkOnlyExpr::SpanMark { .. }
+        | SinkOnlyExpr::TapeEmit
+        | SinkOnlyExpr::DirectBuild(_)
+        | SinkOnlyExpr::Return => false,
+    }
+}
