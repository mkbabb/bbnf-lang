diff --git a/skinny/crates/ir/tests/lock5_nullability_parity.rs b/skinny/crates/ir/tests/lock5_nullability_parity.rs
new file mode 100644
index 000000000..dc30065c3
--- /dev/null
+++ b/skinny/crates/ir/tests/lock5_nullability_parity.rs
@@ -0,0 +1,196 @@
+//! LOCK-5 probe 1, deliverable (B): structural-nullability parity oracle.
+//!
+//! The three json.bbnf leaf patterns — whitespace, quoted-string, number —
+//! are hand-built as `Class`/`Seq`/`Alt`/`Repeat`/`Optional` subtrees (the
+//! family-5A "one HIR" shape: regex atoms folded directly into `ExprKind`,
+//! no separate regex functor). The translation mirrors parse-that's real
+//! `regex::hir` (`Hir::{Class,Concat,Alternation,Repetition,Literal}` with a
+//! `CharClass::Bytes { ranges, negated }`), collapsing byte ranges into
+//! `ByteSet256`.
+//!
+//! We then run the EXTENDED `ir::nullability` (with the new `Class => false`,
+//! `Look => true` arms) and assert the same verdicts the extant regex-string
+//! oracle in `ir::tests::regex_nullability_uses_quantified_atom_shape`
+//! produces: nullable[ws] == true, nullable[string] == false,
+//! nullable[number] == false. Green here ⇒ folding regex into the grammar HIR
+//! preserves nullability parity — 5A does not break the oracle.
+
+use ir::{AltMode, ByteSet256, ExprId, ExprKind, GrammarIr, SourceSpan};
+
+const SP: SourceSpan = SourceSpan { start: 0, end: 0 };
+
+fn class_set(bytes: &[u8]) -> ByteSet256 {
+    let mut set = ByteSet256::default();
+    for &b in bytes {
+        set.insert(b);
+    }
+    set
+}
+
+fn class_range(lo: u8, hi: u8) -> ByteSet256 {
+    let mut set = ByteSet256::default();
+    set.insert_range(lo, hi);
+    set
+}
+
+struct Builder<'a> {
+    g: &'a mut GrammarIr,
+}
+
+impl Builder<'_> {
+    fn add(&mut self, kind: ExprKind) -> ExprId {
+        self.g.add_expr(kind, SP)
+    }
+    fn class(&mut self, set: ByteSet256) -> ExprId {
+        self.add(ExprKind::Class {
+            set,
+            negated: false,
+        })
+    }
+    fn class_neg(&mut self, set: ByteSet256) -> ExprId {
+        self.add(ExprKind::Class { set, negated: true })
+    }
+    fn lit(&mut self, bytes: &[u8]) -> ExprId {
+        self.add(ExprKind::Literal {
+            bytes: bytes.to_vec(),
+            case: ir::CaseSensitivity::Sensitive,
+        })
+    }
+    fn seq(&mut self, kids: Vec<ExprId>) -> ExprId {
+        self.add(ExprKind::Seq(kids))
+    }
+    fn alt(&mut self, branches: Vec<ExprId>) -> ExprId {
+        self.add(ExprKind::Alt {
+            branches,
+            mode: AltMode::Speculative,
+        })
+    }
+    fn star(&mut self, body: ExprId) -> ExprId {
+        self.add(ExprKind::Repeat {
+            body,
+            min: 0,
+            max: None,
+        })
+    }
+    fn plus(&mut self, body: ExprId) -> ExprId {
+        self.add(ExprKind::Repeat {
+            body,
+            min: 1,
+            max: None,
+        })
+    }
+    fn rep(&mut self, body: ExprId, min: u32, max: u32) -> ExprId {
+        self.add(ExprKind::Repeat {
+            body,
+            min,
+            max: Some(max),
+        })
+    }
+    fn opt(&mut self, body: ExprId) -> ExprId {
+        self.add(ExprKind::Optional(body))
+    }
+}
+
+/// `[ \t\n\r]*`  →  Repetition{ sub: Class[ws], min: 0 }
+fn build_ws(b: &mut Builder) -> ExprId {
+    let ws = b.class(class_set(&[b' ', b'\t', b'\n', b'\r']));
+    b.star(ws)
+}
+
+/// `"(?:[^"\\]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"`
+/// → Concat[ Literal(`"`), Repetition{ Alternation[ Class[^"\],
+///          Concat[Literal(`\`), Alternation[ Class["\/bfnrt],
+///          Concat[Literal(`u`), Repetition{Class[hex],4,4}] ]] ], min:0 },
+///   Literal(`"`) ]
+fn build_string(b: &mut Builder) -> ExprId {
+    let normal = b.class_neg(class_set(&[b'"', b'\\']));
+    let simple_escape = b.class_set_escape();
+    let bslash = b.lit(&[b'\\']);
+    let u = b.lit(&[b'u']);
+    let hex = {
+        let mut s = class_range(b'0', b'9');
+        for c in b'a'..=b'f' {
+            s.insert(c);
+        }
+        for c in b'A'..=b'F' {
+            s.insert(c);
+        }
+        b.class(s)
+    };
+    let hex4 = b.rep(hex, 4, 4);
+    let unicode = b.seq(vec![u, hex4]);
+    let escape_body = b.alt(vec![simple_escape, unicode]);
+    let escaped = b.seq(vec![bslash, escape_body]);
+    let content = b.alt(vec![normal, escaped]);
+    let content_star = b.star(content);
+    let open = b.lit(&[b'"']);
+    let close = b.lit(&[b'"']);
+    b.seq(vec![open, content_star, close])
+}
+
+/// `-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?`
+/// → Concat[ Repetition{Literal(`-`),0,1}, Alternation[Literal(`0`),
+///          Concat[Class[1-9], Repetition{Class[0-9],0,inf}]],
+///          Repetition{Concat[Literal(`.`),Repetition{Class[0-9],1,inf}],0,1},
+///          Repetition{Concat[Class[eE],Repetition{Class[+-],0,1},
+///                     Repetition{Class[0-9],1,inf}],0,1} ]
+fn build_number(b: &mut Builder) -> ExprId {
+    let minus = b.lit(&[b'-']);
+    let sign = b.opt(minus);
+
+    let zero = b.lit(&[b'0']);
+    let one_nine = b.class(class_range(b'1', b'9'));
+    let digits0 = {
+        let d = b.class(class_range(b'0', b'9'));
+        b.star(d)
+    };
+    let nonzero = b.seq(vec![one_nine, digits0]);
+    let int_part = b.alt(vec![zero, nonzero]);
+
+    let dot = b.lit(&[b'.']);
+    let frac_digits = {
+        let d = b.class(class_range(b'0', b'9'));
+        b.plus(d)
+    };
+    let frac_body = b.seq(vec![dot, frac_digits]);
+    let frac = b.opt(frac_body);
+
+    let e = b.class(class_set(&[b'e', b'E']));
+    let exp_sign = {
+        let s = b.class(class_set(&[b'+', b'-']));
+        b.opt(s)
+    };
+    let exp_digits = {
+        let d = b.class(class_range(b'0', b'9'));
+        b.plus(d)
+    };
+    let exp_body = b.seq(vec![e, exp_sign, exp_digits]);
+    let exp = b.opt(exp_body);
+
+    b.seq(vec![sign, int_part, frac, exp])
+}
+
+impl Builder<'_> {
+    fn class_set_escape(&mut self) -> ExprId {
+        // `["\\\/bfnrt]`
+        self.class(class_set(&[b'"', b'\\', b'/', b'b', b'f', b'n', b'r', b't']))
+    }
+}
+
+#[test]
+fn folded_regex_atoms_preserve_json_leaf_nullability() {
+    let mut g = GrammarIr::new("json_leaves", "hash");
+    let (ws, string, number) = {
+        let mut b = Builder { g: &mut g };
+        (build_ws(&mut b), build_string(&mut b), build_number(&mut b))
+    };
+
+    let nullable = ir::nullability(&g);
+
+    // Whitespace `[...]*` — the Kleene star admits the empty match.
+    assert!(nullable[ws.0], "nullable[ws] must be true (Kleene star)");
+    // Quoted string opens with a required `\"` byte — never empty.
+    assert!(!nullable[string.0], "nullable[string] must be false");
+    // Number's integer part is a required `0 | [1-9]\\d*` — never empty.
+    assert!(!nullable[number.0], "nullable[number] must be false");
+}
