+// ── Unanchored scan: prefilter vs byte-by-byte (Prefilter tier, PROVE-10) ──
+//
+// A skip-heavy corpus: sparse target tokens embedded in lowercase prose that
+// carries neither '#' nor digits, so a single-byte-prefix pattern's start byte
+// is rare and `memchr` skips whole filler runs. The `_scalar` arm is the
+// pristine caller loop (step `find_at` across every offset); the `_prefilter`
+// arm is `Dfa::find`. Both must yield identical matches — asserted at setup.
+
+const SCAN_PATTERNS: &[&str] = &[
+    r"#[0-9a-fA-F]{3,6}",          // Byte1('#')  — '#' absent from prose → big skip
+    r"0x[0-9a-fA-F]+",             // Byte1('0')  — digits absent from prose → big skip
+    r"https?://[a-zA-Z0-9./-]+",   // Byte1('h')  — 'h' present in prose → modest skip
+    r"(?:foo|bar)[a-z]*",          // Byte2('f','b') — memchr2 tier
+    r"\w+",                        // Prefilter::None — control, ratio ≈ 1.0
+    r"[a-z]+",                     // Prefilter::None — control, ratio ≈ 1.0
+];
+
+const LOREM: &str = "lorem ipsum dolor sit amet consectetur adipiscing elit sed \
+do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim \
+veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo \
+consequat duis aute irure dolor in reprehenderit in voluptate velit esse cillum ";
+
+/// Build a ~128 KB skip-heavy corpus: prose filler with a target token every
+/// few hundred bytes. Same corpus drives every pattern.
+fn build_corpus() -> Vec<u8> {
+    let tokens = [
+        "#ffaacc", "https://example.com/a/b", "0xDEADBEEF", "#1a2b3c", "foobar", "#aaa",
+    ];
+    let mut s = String::with_capacity(160 * 1024);
+    let mut ti = 0usize;
+    while s.len() < 128 * 1024 {
+        s.push_str(LOREM);
+        s.push_str(tokens[ti % tokens.len()]);
+        s.push(' ');
+        ti += 1;
+    }
+    s.into_bytes()
+}
+
+/// Pristine byte-by-byte unanchored scan (no prefilter) — the baseline lane.
+#[inline]
+fn find_scalar(dfa: &Dfa, bytes: &[u8], start: usize) -> Option<(usize, usize)> {
+    let mut pos = start;
+    while pos <= bytes.len() {
+        if let Some(end) = dfa.find_at(bytes, pos) {
+            if end > pos {
+                return Some((pos, end));
+            }
+        }
+        pos += 1;
+    }
+    None
+}
+
+/// Count all non-overlapping matches via the scalar lane.
+fn count_scalar(dfa: &Dfa, bytes: &[u8]) -> usize {
+    let (mut pos, mut n) = (0usize, 0usize);
+    while let Some((s, e)) = find_scalar(dfa, bytes, pos) {
+        n += 1;
+        pos = if e > s { e } else { s + 1 };
+    }
+    n
+}
+
+/// Count all non-overlapping matches via the prefilter lane.
+fn count_prefilter(dfa: &Dfa, bytes: &[u8]) -> usize {
+    let (mut pos, mut n) = (0usize, 0usize);
+    while let Some((s, e)) = dfa.find(bytes, pos) {
+        n += 1;
+        pos = if e > s { e } else { s + 1 };
+    }
+    n
+}
+
+#[divan::bench(args = SCAN_PATTERNS)]
+fn scan_scalar(b: Bencher, pattern: &str) {
+    let dfa = Dfa::compile(pattern).unwrap();
+    let corpus = build_corpus();
+    b.counter(divan::counter::BytesCount::new(corpus.len()))
+        .bench(|| black_box(count_scalar(&dfa, black_box(&corpus))));
+}
+
+#[divan::bench(args = SCAN_PATTERNS)]
+fn scan_prefilter(b: Bencher, pattern: &str) {
+    let dfa = Dfa::compile(pattern).unwrap();
+    let corpus = build_corpus();
+    // Correctness gate: the prefilter must not change the match set.
+    assert_eq!(
+        count_scalar(&dfa, &corpus),
+        count_prefilter(&dfa, &corpus),
+        "prefilter changed match count for /{pattern}/"
+    );
+    b.counter(divan::counter::BytesCount::new(corpus.len()))
+        .bench(|| black_box(count_prefilter(&dfa, black_box(&corpus))));
+}
+
 fn main() {
     divan::main();
 }
