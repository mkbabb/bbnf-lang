@import "css-properties.bbnf" ;
@import "css-selectors.bbnf" ;
@import "css-media.bbnf" ;

@ws /(?s)(?:\s|\/\*.*?\*\/)*/ ;
@token ident ;

blockContent = ((declaration | ruleItem) ?w) * ;
ruleBlock    = "{" >> blockContent ?w << "}" ;

// Typed selectors — full CSS Selectors L4 AST (parity with lightningcss)
qualifiedRule = selectorList ?w , ruleBlock ?w ;

// Typed @-rules
mediaRule     = "@media" ?w , mediaQueryList ?w , ruleBlock ;

keyframeStop  = /\d+%/ | "from" | "to" ;
keyframeSel   = keyframeStop , (/\s*,\s*/ >> keyframeStop) * ;
keyframeBlock = (keyframeSel ?w , "{" >> ((declaration ?w) *) ?w << "}") ?w ;
keyframesRule = "@keyframes" ?w , ident ?w , "{" >> (keyframeBlock *) ?w << "}" ;

// Generic @-rule fallback
atRuleBody    = ruleBlock | ";" ;
genericAtRule = /@[a-zA-Z][\w-]*/ , /[^;{}]*/ , atRuleBody ;

atRule   = mediaRule | keyframesRule | genericAtRule ;
ruleItem = qualifiedRule | atRule ;
ruleList = (ruleItem ?w) * ;
stylesheet = ruleList ?w ;
