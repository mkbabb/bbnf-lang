+//! PROVE-04 — two-block (2×64B) software-pipelined structural/quote scan.
+//!
+//! simdjson stage-1 transcribed onto the NEON stripe scanner: per 64-byte block
+//! classify the structural set `{ } [ ] : ,`, the string delimiter `"`, and the
+//! escape `\`; resolve escapes (odd/even backslash-run parity) and in-string
+//! membership (prefix-xor), then emit the positions of structurals that lie
+//! OUTSIDE a string literal. The three block masks are packed with the certified
+//! `vshrn_n_u16::<4>` mask-narrow idiom (`super::movemask::movemask_u8x16`).
+//!
+//! Three lanes share one `resolve_block` + tail so parity is structural — the only
+//! difference is how the per-block masks are produced and how the block loop is
+//! scheduled:
+//!   * [`scan_scalar_ref`]  — byte-walk classify (the executable parity oracle).
+//!   * [`scan_single`]      — NEON classify, one block per iteration (baseline).
+//!   * [`scan_pipelined`]   — NEON classify staged one block ahead: block N+1's
+//!                            vector loads/compares issue while block N's scalar
+//!                            carry math + compaction retire — two 64B blocks in
+//!                            flight (prologue / steady-state overlap / epilogue).
+
+use core::arch::aarch64::*;
+
+use super::movemask::movemask_u8x16;
+
+/// Cross-block scan carry: backslash-run parity and in-string parity.
+#[derive(Clone, Copy, Default)]
+pub struct ScanCarry {
+    pub bs: bool,
+    pub quote: bool,
+}
+
+/// Raw per-block classification: (structural, quote, backslash) bitmasks.
+type BlockMasks = (u64, u64, u64);
+
+/// Resolve one block's raw masks against the running carry and emit the
+/// positions of structurals not inside a string. Shared by every lane.
+#[inline(always)]
+fn resolve_block(masks: BlockMasks, carry: &mut ScanCarry, base: usize, out: &mut Vec<u32>) {
+    let (struct_raw, quote_raw, bs_raw) = masks;
+    let (escape, new_bs) = crate::escape_mask_64(bs_raw, carry.bs);
+    carry.bs = new_bs;
+    let real_quotes = quote_raw & !escape;
+    let inside = crate::prefix_xor_64(real_quotes, carry.quote);
+    carry.quote = (inside >> 63) & 1 == 1;
+    crate::compact_mask(base, struct_raw & !inside, out);
+}
+
+/// Scalar block classifier — the parity oracle's mask producer.
+#[inline(always)]
+fn classify_block_scalar(block: &[u8; 64]) -> BlockMasks {
+    let (mut s, mut q, mut b) = (0u64, 0u64, 0u64);
+    for (i, &c) in block.iter().enumerate() {
+        let bit = 1u64 << i;
+        match c {
+            b'{' | b'}' | b'[' | b']' | b':' | b',' => s |= bit,
+            b'"' => q |= bit,
+            b'\\' => b |= bit,
+            _ => {}
+        }
+    }
+    (s, q, b)
+}
+
+/// NEON block classifier: vceqq fan (structural) + two vceqq (quote, backslash),
+/// each packed via the vshrn movemask idiom.
+///
+/// # Safety
+/// `ptr..ptr+64` must be readable.
+#[inline(always)]
+unsafe fn classify_block_neon(ptr: *const u8) -> BlockMasks {
+    unsafe {
+        let lbrace = vdupq_n_u8(b'{');
+        let rbrace = vdupq_n_u8(b'}');
+        let lbrack = vdupq_n_u8(b'[');
+        let rbrack = vdupq_n_u8(b']');
+        let colon = vdupq_n_u8(b':');
+        let comma = vdupq_n_u8(b',');
+        let quote = vdupq_n_u8(b'"');
+        let bslash = vdupq_n_u8(b'\\');
+
+        let (mut s, mut q, mut b) = (0u64, 0u64, 0u64);
+        for k in 0..4 {
+            let chunk = vld1q_u8(ptr.add(k * 16));
+            let sc = vorrq_u8(
+                vorrq_u8(
+                    vorrq_u8(vceqq_u8(chunk, lbrace), vceqq_u8(chunk, rbrace)),
+                    vorrq_u8(vceqq_u8(chunk, lbrack), vceqq_u8(chunk, rbrack)),
+                ),
+                vorrq_u8(vceqq_u8(chunk, colon), vceqq_u8(chunk, comma)),
+            );
+            let qc = vceqq_u8(chunk, quote);
+            let bc = vceqq_u8(chunk, bslash);
+            let shift = k * 16;
+            s |= (movemask_u8x16(sc) as u64) << shift;
+            q |= (movemask_u8x16(qc) as u64) << shift;
+            b |= (movemask_u8x16(bc) as u64) << shift;
+        }
+        (s, q, b)
+    }
+}
+
+/// Shared tail: zero-pad the <64-byte remainder into one block and resolve it.
+/// Zero bytes never classify as structural/quote/backslash, so padding is inert.
+#[inline(always)]
+fn scan_tail(input: &[u8], start: usize, carry: &mut ScanCarry, out: &mut Vec<u32>) {
+    if start >= input.len() {
+        return;
+    }
+    let mut pad = [0u8; 64];
+    let rem = &input[start..];
+    pad[..rem.len()].copy_from_slice(rem);
+    resolve_block(classify_block_scalar(&pad), carry, start, out);
+}
+
+/// The executable parity oracle: scalar classify, one block per iteration.
+#[inline(never)]
+pub fn scan_scalar_ref(input: &[u8]) -> Vec<u32> {
+    let mut out = Vec::with_capacity(input.len() / 8 + 8);
+    let mut carry = ScanCarry::default();
+    let mut i = 0;
+    while i + 64 <= input.len() {
+        let block: &[u8; 64] = input[i..i + 64].try_into().unwrap();
+        resolve_block(classify_block_scalar(block), &mut carry, i, &mut out);
+        i += 64;
+    }
+    scan_tail(input, i, &mut carry, &mut out);
+    out
+}
+
+/// Baseline: NEON classify, one 64B block per iteration.
+#[inline(never)]
+pub fn scan_single(input: &[u8]) -> Vec<u32> {
+    let mut out = Vec::with_capacity(input.len() / 8 + 8);
+    let mut carry = ScanCarry::default();
+    let mut i = 0;
+    // SAFETY: loop guard keeps ptr..ptr+64 in bounds.
+    unsafe {
+        while i + 64 <= input.len() {
+            resolve_block(
+                classify_block_neon(input.as_ptr().add(i)),
+                &mut carry,
+                i,
+                &mut out,
+            );
+            i += 64;
+        }
+    }
+    scan_tail(input, i, &mut carry, &mut out);
+    out
+}
+
+/// Classify-only fold (no compaction) — isolates the pure classify-stage
+/// pipeline from the shared carry/compaction. Baseline: one block per iteration.
+#[inline(never)]
+pub fn classify_fold_single(input: &[u8]) -> u64 {
+    let mut acc = 0u64;
+    let mut i = 0;
+    // SAFETY: loop guard keeps ptr..ptr+64 in bounds.
+    unsafe {
+        while i + 64 <= input.len() {
+            let (s, q, b) = classify_block_neon(input.as_ptr().add(i));
+            acc = acc.rotate_left(1) ^ s ^ q.rotate_left(21) ^ b.rotate_left(42);
+            i += 64;
+        }
+    }
+    acc
+}
+
+/// Classify-only fold, 2×64B software-pipelined (block N+1 staged ahead of the
+/// fold of block N). Folds in the same order as [`classify_fold_single`], so an
+/// identical return value is a bonus parity check on the classify masks.
+#[inline(never)]
+pub fn classify_fold_pipelined(input: &[u8]) -> u64 {
+    let mut acc = 0u64;
+    let nblocks = input.len() / 64;
+    // SAFETY: b*64 .. b*64+64 stays in bounds for b < nblocks.
+    unsafe {
+        if nblocks > 0 {
+            let mut staged = classify_block_neon(input.as_ptr());
+            for b in 1..nblocks {
+                let next = classify_block_neon(input.as_ptr().add(b * 64));
+                let (s, q, bb) = staged;
+                acc = acc.rotate_left(1) ^ s ^ q.rotate_left(21) ^ bb.rotate_left(42);
+                staged = next;
+            }
+            let (s, q, bb) = staged;
+            acc = acc.rotate_left(1) ^ s ^ q.rotate_left(21) ^ bb.rotate_left(42);
+        }
+    }
+    acc
+}
+
+/// PROVE-04: 2×64B software-pipelined NEON scan. Block N+1's vector classify is
+/// staged ahead of block N's carry-dependent resolve, keeping two 64B blocks in
+/// flight so the independent vector loads/compares overlap the scalar carry math.
+#[inline(never)]
+pub fn scan_pipelined(input: &[u8]) -> Vec<u32> {
+    let mut out = Vec::with_capacity(input.len() / 8 + 8);
+    let mut carry = ScanCarry::default();
+    let nblocks = input.len() / 64;
+    // SAFETY: b*64 .. b*64+64 stays in bounds for b < nblocks.
+    unsafe {
+        if nblocks > 0 {
+            // Prologue: classify block 0.
+            let mut staged = classify_block_neon(input.as_ptr());
+            // Steady state: classify block b (independent) while resolving b-1.
+            for b in 1..nblocks {
+                let next = classify_block_neon(input.as_ptr().add(b * 64));
+                resolve_block(staged, &mut carry, (b - 1) * 64, &mut out);
+                staged = next;
+            }
+            // Epilogue: resolve the last staged block.
+            resolve_block(staged, &mut carry, (nblocks - 1) * 64, &mut out);
+        }
+    }
+    scan_tail(input, nblocks * 64, &mut carry, &mut out);
+    out
+}
