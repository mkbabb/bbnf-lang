#!/usr/bin/env bash
set -euo pipefail

git_dir=$(git rev-parse --git-dir)
if [ -f "$git_dir/MERGE_HEAD" ] || [ -f "$git_dir/REBASE_HEAD" ] ||
    [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
    exit 0
fi

cargo test --quiet -p bbnf --test w3_replay_public_contract \
    exactly_three_public_instances_compile_twice_to_byte_identical_carriers \
    --locked -- --exact
