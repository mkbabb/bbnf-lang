{
    "name": "@mkbabb/bbnf-lang",
    "version": "0.2.0",
    "description": "BBNF grammar parser and code generator",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/bbnf.js",
            "require": "./dist/bbnf.cjs"
        },
        "./gen": {
            "types": "./dist/src/gen.d.ts",
            "import": "./dist/gen.js",
            "require": "./dist/gen.cjs"
        }
    },
    "bin": {
        "bbnf": "./dist/cli.js"
    },
    "typesVersions": {
        "*": {
            "gen": [
                "dist/src/gen.d.ts"
            ],
            "*": [
                "dist/src/index.d.ts"
            ]
        }
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "vite build"
    },
    "files": [
        "./dist"
    ],
    "dependencies": {
        "@mkbabb/parse-that": "^2.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^3.2.0"
    }
}
