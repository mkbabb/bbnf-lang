+            match next() % 5 {
+                0 => s.push_str(&format!("{}", next() % 1_000_000)),
+                1 => s.push_str("plain text field"),
+                2 => s.push_str(&format!("id-{:x}", next() & 0xffff)),
+                3 => s.push_str("\"quoted, with comma\""),
