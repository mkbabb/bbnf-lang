+//! Minimal stand-in for a shared bbnf-simd kernel home (9A). The producer is
+//! `#[inline]` and lives in a SEPARATE rlib from its consumer — the exact
+//! parse-that <-> bbnf-simd rlib seam Brief 1 gate (3)/(4) interrogates.
+//! Pure `core::arch::aarch64`, no nightly features, no OnceLock.
+use core::arch::aarch64::*;
+
+/// LEAN canonical producer: nibble `vshrn_n_u16::<4>` movemask.
+/// One `shrn.8b`, no reduction op. First-set-position form.
+#[inline]
+pub fn movemask_lean(cmp: uint8x16_t) -> u64 {
+    unsafe {
+        let narrowed = vshrn_n_u16::<4>(vreinterpretq_u16_u8(cmp));
+        vget_lane_u64::<0>(vreinterpret_u64_u8(narrowed))
+    }
+}
+
+/// Classify a 16-byte chunk against a broadcast needle, returning the LEAN mask.
+/// Consumer calls THIS across the rlib boundary in its hot loop.
+#[inline]
+pub fn classify_chunk(chunk: uint8x16_t, needle: uint8x16_t) -> u64 {
+    unsafe { movemask_lean(vceqq_u8(chunk, needle)) }
+}
+
+/// REFUTED idiom, kept as a disasm counterexample: double `vaddvq_u8` reduction.
+/// Present only to contrast reduction-op counts; not on the consumer hot path.
+#[inline]
+pub fn movemask_double_vaddv(cmp: uint8x16_t) -> u64 {
+    unsafe {
+        let bits = vandq_u8(
+            cmp,
+            vld1q_u8(
+                [1u8, 2, 4, 8, 16, 32, 64, 128, 1, 2, 4, 8, 16, 32, 64, 128].as_ptr(),
+            ),
+        );
+        let lo = vaddv_u8(vget_low_u8(bits)) as u64;
+        let hi = vaddv_u8(vget_high_u8(bits)) as u64;
+        (hi << 8) | lo
+    }
+}
