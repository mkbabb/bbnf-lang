// AZ-I.W2.RB — Object struct-direct snapshot.
//
// Captures the expected `builder.*` call set the Object-shape emitter
// produces under `EmitStrategy::StructDirect`. Per the W2-EMITTER-
// REWIRE plan §3 hard gates, the struct-direct body emits zero
// `tape.*` calls; only the typed StructBuilder API is exercised.
//
// Wire contract (one Object rule, e.g. JSON `object`):
//
//   let __layout = ir_struct_registry_layout(<rule_id>)
//       .expect("StructDirect requires populated layout for Object rule");
//   let __handle = builder.begin_compound(__layout);
//   ...key push via #string_fn (calls builder.push_leaf_with_str)...
//   ...value dispatch via #value_call (recurses into a per-shape fn)...
//   builder.end_compound(__handle);

builder.begin_compound(__layout);
builder.end_compound(__handle);
