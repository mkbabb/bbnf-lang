+// ── PLANTED MUTATIONS — all four must TRIP (be detected) ──────────────────
+fn run_planted_mutations(opts: &ParseOptions) {
+    println!("=== PLANTED-MUTATION FALSIFICATION (all 4 must trip) ===");
+    let mut all_tripped = true;
+
+    // M1: swap one quantifier greedy->lazy in a gen copy -> R3 flags.
+    let base = regex::parse_generated_with("a+", opts).expect("a+ parses");
+    let mutant = flip_first_greedy(&base);
+    let m1 = !oracle_eq(&base, &mutant); // oracle DISTINGUISHES them
+    println!("  M1 quantifier greedy->lazy   : tripped={} (R3 preserves `greedy`)", m1);
+    all_tripped &= m1;
+
+    // M2: drop a group -> R3 flags.
+    let g = regex::parse_generated_with("(a)", opts).expect("(a) parses");
+    let ungrouped = strip_first_group(&g); // removes the Group wrapper
+    let m2 = !oracle_eq(&g, &ungrouped);
+    println!("  M2 drop a group              : tripped={} (R3 preserves Group nesting)", m2);
+    all_tripped &= m2;
+
+    // M3: bind the bool twin where the producer is expected -> binding rejected.
+    // The bool twin (generated.rs:2288) returns `bool`; it cannot witness a
+    // structural divergence. Proof of vacuity: two patterns whose HIRs differ
+    // under ORACLE_REL_V1 both map to the SAME bool (true) -> the bool binding
+    // cannot compute the relation, so the anti-vacuity guard REJECTS it.
+    let twin_pattern_a = regex::generated::parse_generated("(a)"); // true
+    let twin_pattern_b = regex::generated::parse_generated("a"); // true
+    let hir_a = norm(&regex::parse_generated_with("(a)", opts).unwrap());
+    let hir_b = norm(&regex::parse_generated_with("a", opts).unwrap());
+    let twin_says_same = twin_pattern_a == twin_pattern_b; // both true — vacuous
+    let hir_says_different = hir_a != hir_b; // Group(a) != Literal(a)
+    let m3 = twin_says_same && hir_says_different; // binding to twin is provably vacuous -> reject
+    println!(
+        "  M3 bool-twin binding rejected: tripped={} (twin: same={}, Hir: different={})",
+        m3, twin_says_same, hir_says_different
+    );
+    all_tripped &= m3;
+
+    // M4: mis-associate an alt arm -> R1 does NOT mask it.
+    let alt = regex::parse_generated_with("a|b|c", opts).expect("a|b|c parses");
+    let misassoc = misassociate_alt(&alt); // Alt([a,b,c]) -> Alt([Alt([a,b]),c])
+    let m4 = !oracle_eq(&alt, &misassoc); // R1 collapses only singletons, so the nesting survives
+    println!("  M4 mis-associate alt arm     : tripped={} (R1 collapses only singletons)", m4);
+    all_tripped &= m4;
+
+    // Idempotence of N (R1 fixpoint sanity).
+    let sample = regex::parse_generated_with(r"(?:[a-z]+\.)+[a-z]+", opts).unwrap();
+    let once = norm(&sample);
+    let twice = norm(&once);
+    let idem = once == twice;
+    println!("  (N idempotent / fixpoint)    : {}", idem);
+    all_tripped &= idem;
+
+    assert!(
+        all_tripped,
+        "FALSIFICATION FAILED: not all planted mutations tripped — oracle is unsound, green cannot be trusted"
+    );
+    println!("  -> ALL planted mutations tripped; oracle is non-vacuous.");
+    println!();
+}
+
+fn flip_first_greedy(h: &Hir) -> Hir {
+    match h {
+        Hir::Repetition(r) => Hir::Repetition(Repetition {
+            sub: r.sub.clone(),
+            min: r.min,
+            max: r.max,
+            greedy: !r.greedy,
+        }),
+        Hir::Concat(v) => Hir::Concat(v.iter().map(flip_first_greedy).collect()),
+        Hir::Group(g) => Hir::Group(Box::new(flip_first_greedy(g))),
+        other => other.clone(),
+    }
+}
+
+fn strip_first_group(h: &Hir) -> Hir {
+    match h {
+        Hir::Group(inner) => (**inner).clone(), // drop the Group wrapper
+        Hir::Concat(v) => Hir::Concat(v.iter().map(strip_first_group).collect()),
+        other => other.clone(),
+    }
+}
+
+fn misassociate_alt(h: &Hir) -> Hir {
+    match h {
+        Hir::Alternation(v) if v.len() >= 3 => {
+            let left = Hir::Alternation(vec![v[0].clone(), v[1].clone()]);
+            let mut rest = vec![left];
+            rest.extend(v[2..].iter().cloned());
+            Hir::Alternation(rest)
+        }
+        other => other.clone(),
+    }
+}
+
+#[allow(dead_code)]
+fn sanity_hir() -> Hir {
+    Hir::Class(CharClass::Bytes {
+        ranges: vec![ByteRange::new(b'a', b'z')],
+        negated: false,
+    })
+}
