+/// PT-SCRATCH PROBE ADDITION (LOCK-7 pass-2 7D oracle) — NOT in the READ-ONLY
+/// origin. Runs ONLY the generated combinator parser (the pre-`host::lower`
+/// stage) and returns its typed AST as a `Debug` string, plus whether the
+/// recognizer consumed the whole input. This is the pre-lower witness used to
+/// partition a divergence into an oracle VERDICT (parser AST differs) vs a
+/// `host.rs` OBLIGATION (parser accepted, fold is wrong). Needs `pub(crate)`
+/// `__RegexParserEnumCtx`, so it must live inside this crate.
+pub fn parse_generated_ast_debug(pattern: &str) -> (bool, usize, Option<String>) {
+    let ctx = generated::__RegexParserEnumCtx::with_capacity(pattern.len().max(64));
+    let parser_fn = generated::RegexParser::regex();
+    let (result, state) = parser_fn.parse_return_state_with_context(pattern, &ctx);
+    let full = result.is_some() && state.offset >= pattern.len();
+    let dbg = result.map(|ast| format!("{:?}", ast));
+    (full, state.offset, dbg)
+}

