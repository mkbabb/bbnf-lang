+//! LOCK-3 pass-1 probe (b): a per-pass contract on the single (collapsed) IR
+//! localizes a dropped type_ref to the L0->L1 (infer) edge — with no distinct
+//! typed level, and while `cargo build` stays green.
+
+use ir::{ExprKind, GrammarIr, SourceSpan};
+use passes::{layout, verify, BuiltinTy, Type};
+
+/// L0 (grammar): a single rule `value` whose body is a `->` projection node
+/// (an annotation declaring the target type `Number`).
+fn projection_grammar() -> GrammarIr {
+    let mut grammar = GrammarIr::new("proj", "test");
+    let ann = grammar.add_expr(
+        ExprKind::Annotation {
+            name: "type".into(),
+            value: Some("Number".into()),
+        },
+        SourceSpan::new(0, 8),
+    );
+    grammar.add_rule("value", ann, SourceSpan::new(0, 8));
+    grammar
+}
+
+#[test]
+fn head_infer_drops_projection_type_ref() {
+    let grammar = projection_grammar();
+    // L0->L1: run the real inference pass unmodified.
+    let facts = layout::types::infer(&grammar).expect("infer");
+    let node_ty = facts.node_types.get(&grammar.exprs[0].id).cloned();
+    // HEAD collapses `ExprKind::Annotation` to `Unit`, discarding `-> Number`.
+    assert_eq!(
+        node_ty,
+        Some(Type::Builtin(BuiltinTy::Unit)),
+        "HEAD infer drops the declared type_ref to Unit"
+    );
+}
+
+#[test]
+fn verify_turns_red_and_names_the_infer_edge() {
+    let grammar = projection_grammar();
+    let facts = layout::types::infer(&grammar).expect("infer");
+    // The single-IR per-pass contract catches the drop that the type table hid.
+    let err = verify(&grammar, &facts).expect_err("verify must turn RED on the dropped type_ref");
+    let msg = err.to_string();
+    assert!(msg.contains("infer"), "violation names the infer edge: {msg}");
+    assert!(msg.contains("L0->L1"), "violation names the L0->L1 edge: {msg}");
+    assert!(msg.contains("type_ref"), "violation names the dropped type_ref: {msg}");
+}
+
+#[test]
+fn verify_is_green_when_type_ref_is_populated() {
+    // Same projection, but with the type_ref preserved (the localized fix at the
+    // infer edge): the same one IR + attribute table now satisfies the contract.
+    let grammar = projection_grammar();
+    let mut facts = layout::types::infer(&grammar).expect("infer");
+    facts
+        .node_types
+        .insert(grammar.exprs[0].id, Type::Builtin(BuiltinTy::Span));
+    verify(&grammar, &facts).expect("verify is GREEN once the type_ref survives infer");
+}
