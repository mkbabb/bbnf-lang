+    /// LUTs (`lo_lut`/`hi_lut`, caller-built from the significant set). Bit `i`
+    /// is set iff `src[i]` is a member. NEON `vqtbl1q` on aarch64; the scalar
+    /// twin applies the identical LUT semantics (the checkasm parity anchor).
+    #[inline]
+    pub fn css_significant_mask_64(src: &[u8; 64], lo_lut: &[u8; 16], hi_lut: &[u8; 16]) -> u64 {
+        #[cfg(target_arch = "aarch64")]
+        unsafe {
+            use core::arch::aarch64::vld1q_u8;
+            let lo = vld1q_u8(lo_lut.as_ptr());
+            let hi = vld1q_u8(hi_lut.as_ptr());
+            return crate::aarch64::classify_tbl4::css_significant_shufti_block_64(
+                src.as_ptr(),
+                lo,
+                hi,
+            );
+        }
+        #[allow(unreachable_code)]
+        {
+            let mut mask = 0u64;
+            for (i, &b) in src.iter().enumerate() {
+                if lo_lut[(b & 0x0f) as usize] & hi_lut[(b >> 4) as usize] != 0 {
+                    mask |= 1u64 << i;
+                }
+            }
+            mask
+        }
+    }
