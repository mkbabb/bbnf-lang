+++ b/crates/ir/tests/vm/live_differential.rs
@@ -0,0 +1,400 @@
+//! LOCK-4 PROTO-2 (pass-3, probe 2) — the McKeeman gate for the 4C value plane.
+//!
+//! The prior probe (`apply_fn_oracle.rs`) asserted the VM's projected `Value`
+//! against an **author-written golden** — self-consistency, not the sharpest
+//! uncertainty. Differential testing forbids a fabricated golden. This module
+//! runs the REAL gate: it evaluates each projection through BOTH
+//!
+//!   (a) `Op::ApplyFn` — the VM value plane (`parse_with_ir` → `Value`), and
+//!   (b) parse-that's shipped closure combinator with a LIVE `.map(closure)`,
+//!
+//! then asserts the two agree scalar-for-scalar / node-for-node. parse-that's
+//! actual `.map` output — not a literal an author typed — is the oracle. If
+//! `Op::ApplyFn` computed a different value than the closure, this fails.
+//!
+//! Plus the hardest case the pass-through STUB could never reach: a NON-STUB
+//! `FnDescriptor::HostClosure` numeric fold (lerp / channel-scale) that the
+//! `ApplyFn` handler EVALUATES (does not forward), matched against the same
+//! fold run as a live parse-that `.map` closure AND against the closure core
+//! (`HostFold::eval`) directly.
+
+use bbnf_ir::compiler::compile;
+use bbnf_ir::interpreter::{Interpreter, Value};
+use bbnf_ir::{
+    AltBranch, FnDescriptor, GrammarIR, HostFold, IrNode, IrRule, MapBinOp, MapExpr, RuleMeta,
+};
+use parse_that::{one_of, regex, string};
+
+// ── VM-side harness (self-contained; mirrors apply_fn_oracle helpers) ────────
+
+fn rule(id: u32, name: u32, body: IrNode) -> IrRule {
+    IrRule { id, name, body, meta: RuleMeta::default(), source_span: None }
+}
+
+/// Single-rule projection grammar: entry rule maps `inner` through `fns[0]`.
+fn ir1(inner: IrNode, fns: Vec<FnDescriptor>, strings: Vec<String>) -> GrammarIR {
+    GrammarIR {
+        entry: 0,
+        rules: vec![rule(0, 0, IrNode::Map { inner: Box::new(inner), fn_id: 0 })],
+        strings,
+        fns,
+        ..Default::default()
+    }
+}
+
+/// Strip the rule's `MakeTagged` wrapper, returning the single projected child.
+fn projected(v: &Value) -> &Value {
+    match v {
+        Value::Tagged { children, .. } => {
+            assert_eq!(children.len(), 1, "expected exactly one projected child");
+            &children[0]
+        }
+        other => other,
+    }
+}
+
+/// Run a single-rule projection grammar and return the projected `Value`.
+fn vm_project(inner: IrNode, fns: Vec<FnDescriptor>, strings: Vec<String>, input: &str) -> Value {
+    let ir = ir1(inner, fns, strings);
+    let program = compile(&ir);
+    let mut interp = Interpreter::new(&program, input);
+    let r = interp.run();
+    assert!(r.success, "VM parse failed for {input:?}");
+    projected(&r.value.expect("no value produced")).clone()
+}
+
+/// A literal-matching single-rule grammar (child = `Span` over the whole input).
+fn lit(input: &str) -> (IrNode, Vec<String>) {
+    (IrNode::Literal(1), vec!["root".into(), input.into()])
+}
+
+fn as_f64(v: &Value) -> f64 {
+    match v {
+        Value::F64(f) => *f,
+        other => panic!("expected F64, got {other:?} (forwarded, not evaluated?)"),
+    }
+}
+fn as_u32(v: &Value) -> u32 {
+    match v {
+        Value::U32(u) => *u,
+        other => panic!("expected U32, got {other:?} (forwarded, not evaluated?)"),
+    }
+}
+
+// ── Clause 1: scalar differential — VM ApplyFn vs parse-that LIVE .map ────────
+
+#[test]
+fn diff_number_convert_f64() {
+    for input in ["3.5", "42", "0", "128", "255"] {
+        // (b) parse-that LIVE .map — the oracle.
+        let pt: f64 = regex("[0-9]+\\.?[0-9]*")
+            .map(|s: &str| s.parse::<f64>().unwrap())
+            .parse(input)
+            .expect("pt parse");
+        // (a) VM Op::ApplyFn.
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::NumberConvert { allow_leading_dot: false }],
+            strings, input);
+        assert_eq!(as_f64(&vm), pt, "NumberConvert diverged for {input:?}");
+    }
+}
+
+#[test]
+fn diff_hex_convert_u32() {
+    for input in ["ff", "00", "1a", "80", "7f"] {
+        let pt: u32 = regex("[0-9a-fA-F]+")
+            .map(|s: &str| u32::from_str_radix(s, 16).unwrap())
+            .parse(input)
+            .expect("pt parse");
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::HexConvert { fn_path: 0 }], strings, input);
+        assert_eq!(as_u32(&vm), pt, "HexConvert diverged for {input:?}");
+    }
+}
+
+#[test]
+fn diff_expr_arithmetic_u32() {
+    // (input * 2) + 1
+    for input in ["10", "0", "7", "255", "100"] {
+        let pt: u32 = regex("[0-9]+")
+            .map(|s: &str| {
+                let n: i64 = s.parse().unwrap();
+                ((n * 2) + 1) as u32
+            })
+            .parse(input)
+            .expect("pt parse");
+        let expr = MapExpr::BinOp {
+            op: MapBinOp::Add,
+            lhs: Box::new(MapExpr::BinOp {
+                op: MapBinOp::Mul,
+                lhs: Box::new(MapExpr::Input),
+                rhs: Box::new(MapExpr::IntLit(2)),
+            }),
+            rhs: Box::new(MapExpr::IntLit(1)),
+        };
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::Expr { expr, return_type: None }], strings,
+            input);
+        assert_eq!(as_u32(&vm), pt, "Expr arithmetic diverged for {input:?}");
+    }
+}
+
+#[test]
+fn diff_expr_float_mul_f64() {
+    // input * 1.5
+    for input in ["4", "10", "0", "255", "2"] {
+        let pt: f64 = regex("[0-9]+")
+            .map(|s: &str| s.parse::<f64>().unwrap() * 1.5)
+            .parse(input)
+            .expect("pt parse");
+        let expr = MapExpr::BinOp {
+            op: MapBinOp::Mul,
+            lhs: Box::new(MapExpr::Input),
+            rhs: Box::new(MapExpr::FloatLit(1.5)),
+        };
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::Expr { expr, return_type: None }], strings,
+            input);
+        assert_eq!(as_f64(&vm), pt, "Expr float-mul diverged for {input:?}");
+    }
+}
+
+#[test]
+fn diff_input_len_u32() {
+    for input in ["hello", "a", "abcdef", "xy", "worldwide"] {
+        let pt: u32 = regex("[a-z]+")
+            .map(|s: &str| s.len() as u32)
+            .parse(input)
+            .expect("pt parse");
+        // strings[2] = "len" for InputProp.
+        let strings = vec!["root".into(), input.into(), "len".into()];
+        let vm = vm_project(IrNode::Literal(1),
+            vec![FnDescriptor::Expr { expr: MapExpr::InputProp { prop: 2 }, return_type: None }],
+            strings, input);
+        assert_eq!(as_u32(&vm), pt, "InputProp len diverged for {input:?}");
+    }
+}
+
+#[test]
+fn diff_string_lit_str() {
+    // Constant string projection: any input -> "HELLO".
+    for input in ["hi", "yo", "gg"] {
+        let pt: &str = regex("[a-z]+").map(|_s: &str| "HELLO").parse(input).expect("pt parse");
+        let strings = vec!["root".into(), input.into(), "HELLO".into()];
+        let vm = vm_project(IrNode::Literal(1),
+            vec![FnDescriptor::Expr { expr: MapExpr::StringLit(2), return_type: None }],
+            strings, input);
+        match &vm {
+            Value::Str(s) => assert_eq!(s.as_ref(), pt, "StringLit diverged for {input:?}"),
+            other => panic!("expected Str, got {other:?}"),
+        }
+    }
+}
