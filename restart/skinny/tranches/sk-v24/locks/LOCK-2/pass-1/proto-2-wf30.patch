diff --git a/crates/ir/tests/lock4_value_plane_probe.rs b/crates/ir/tests/lock4_value_plane_probe.rs
new file mode 100644
index 000000000..1ba25b479
--- /dev/null
+++ b/crates/ir/tests/lock4_value_plane_probe.rs
@@ -0,0 +1,227 @@
+//! LOCK-4 pass-2 probe: value-completed shared VM (`Op::ApplyFn`) vs the
+//! parse-that closure core, on (a) a projection-dense shape (hex-color →
+//! `U32`, the value.js `->` projection shape) and (b) a recognizer-only
+//! shape (JSON free-tape: `Span` push, no projection).
+//!
+//! Method: byte-identical scalar oracle first, then cold paired A,B,A,B
+//! timing — fresh `Interpreter`/closure state per parse (cold per-parse,
+//! no warm reuse), N=400 samples, two windows, both orders, median + IQR.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use bbnf_ir::vm::bytecode::{BytecodeProgram, Op};
+use bbnf_ir::vm::interpreter::{Interpreter, Value};
+use bbnf_ir::FnDescriptor;
+
+// ── Program builders ─────────────────────────────────────────────────────────
+
+/// Projection-dense: `MatchRegex(hex) ; ApplyFn(HexConvert)` → `Value::U32`.
+fn projection_program() -> BytecodeProgram {
+    let mut p = BytecodeProgram {
+        code: vec![Op::MatchRegex(0), Op::ApplyFn(0), Op::Halt],
+        entries: vec![0],
+        strings: vec!["[0-9a-fA-F]+".to_string()],
+        entry: 0,
+        memo_enabled: false,
+        dispatch_tables: Vec::new(),
+        token_dispatch_tables: Vec::new(),
+        compiled_regexes: Vec::new(),
+        follow_sets: Default::default(),
+        rule_names: vec![0],
+        source_map: Vec::new(),
+        fns: vec![FnDescriptor::HexConvert { fn_path: 0 }],
+    };
+    p.prepare_regexes();
+    p
+}
+
+/// Recognizer-only (free-tape): `MatchRegex(hex)` → `Value::Span`, no ApplyFn.
+fn recognizer_program() -> BytecodeProgram {
+    let mut p = BytecodeProgram {
+        code: vec![Op::MatchRegex(0), Op::Halt],
+        entries: vec![0],
+        strings: vec!["[0-9a-fA-F]+".to_string()],
+        entry: 0,
+        memo_enabled: false,
+        dispatch_tables: Vec::new(),
+        token_dispatch_tables: Vec::new(),
+        compiled_regexes: Vec::new(),
+        follow_sets: Default::default(),
+        rule_names: vec![0],
+        source_map: Vec::new(),
+        fns: Vec::new(),
+    };
+    p.prepare_regexes();
+    p
+}
+
+// ── Closure core (parse-that-shaped hand-written combinator) ──────────────────
+
+/// Recognize a run of hex digits at offset 0; returns the matched span end.
+#[inline]
+fn closure_recognize(input: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < input.len() && input[i].is_ascii_hexdigit() {
+        i += 1;
+    }
+    if i > 0 { Some(i) } else { None }
+}
+
+/// Closure core with the value projection: recognize `|> map(parse_hex)`.
+#[inline]
+fn closure_project(input: &str) -> Option<u32> {
+    let end = closure_recognize(input.as_bytes())?;
+    u32::from_str_radix(&input[..end], 16).ok()
+}
+
+// ── Timing harness ────────────────────────────────────────────────────────────
+
+fn median(mut v: Vec<u64>) -> u64 {
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+fn iqr(mut v: Vec<u64>) -> u64 {
+    v.sort_unstable();
+    let q1 = v[v.len() / 4];
+    let q3 = v[(3 * v.len()) / 4];
+    q3 - q1
+}
+
+/// One cold parse of the VM program → projected scalar (or Span for recognizer).
+#[inline]
+fn vm_run(prog: &BytecodeProgram, input: &str) -> Option<Value> {
+    let mut interp = Interpreter::new(prog, input);
+    interp.run().value
+}
+
+const N: usize = 400;
+
+/// Cold paired timing for one shape: two windows (A,B then B,A), median + IQR.
+fn run_case(label: &str, prog: &BytecodeProgram, tokens: &[String], closure_time: impl Fn() -> u64) {
+    let time_vm = || -> u64 {
+        let t0 = Instant::now();
+        for t in tokens {
+            black_box(vm_run(prog, black_box(t)));
+        }
+        t0.elapsed().as_nanos() as u64
+    };
+    let mut vm_samples = Vec::with_capacity(2 * N);
+    let mut cl_samples = Vec::with_capacity(2 * N);
+    for _ in 0..N {
+        vm_samples.push(time_vm()); // window 1: order A,B
+        cl_samples.push(closure_time());
+    }
+    for _ in 0..N {
+        cl_samples.push(closure_time()); // window 2: order B,A
+        vm_samples.push(time_vm());
+    }
+    let vm_med = median(vm_samples.clone());
+    let cl_med = median(cl_samples.clone());
+    let vm_iqr = iqr(vm_samples);
+    let cl_iqr = iqr(cl_samples);
+    let ratio = cl_med as f64 / vm_med as f64;
+    println!("--- {label} ---");
+    println!("  VM(A)      median={vm_med:>8}ns  iqr={vm_iqr:>7}ns  ({} tok/pass)", tokens.len());
+    println!("  CLOSURE(B) median={cl_med:>8}ns  iqr={cl_iqr:>7}ns");
+    println!("  ratio(closure/vm) = {ratio:.4}x  (>=0.98 => shared VM viable)");
+}
+
+#[test]
+fn lock4_value_plane_probe() {
+    // A projection-dense corpus: value.js-shaped hex-color tokens.
+    let tokens: Vec<String> = (0..64u32)
+        .map(|k| format!("{:06x}", (k.wrapping_mul(0x9E3779B1)) & 0xFF_FFFF))
+        .collect();
+
+    let proj = projection_program();
+    let recog = recognizer_program();
+
+    // ── Oracle: byte-identical scalar output ─────────────────────────────────
+    let mut oracle_ok = true;
+    for t in &tokens {
+        let vm = vm_run(&proj, t);
+        let cl = closure_project(t);
+        let vm_u = match vm {
+            Some(Value::U32(u)) => Some(u),
+            _ => None,
+        };
+        if vm_u != cl {
+            oracle_ok = false;
+            eprintln!("ORACLE MISMATCH token={t} vm={vm_u:?} closure={cl:?}");
+        }
+        // recognizer free-tape oracle: same matched span length.
+        let rspan = match vm_run(&recog, t) {
+            Some(Value::Span(s, e)) => Some((e - s) as usize),
+            _ => None,
+        };
+        let cspan = closure_recognize(t.as_bytes());
+        if rspan != cspan {
+            oracle_ok = false;
+            eprintln!("RECOG ORACLE MISMATCH token={t} vm={rspan:?} closure={cspan:?}");
+        }
+    }
+    println!("ORACLE byte_identical_scalar={oracle_ok}");
+    assert!(oracle_ok, "value-output oracle must be byte-identical");
+
+    // ── Cold paired timing: two windows, both orders, median + IQR ───────────
+    run_case(
+        "PROJECTION-DENSE (value.js hex->U32, ApplyFn)",
+        &proj,
+        &tokens,
+        || {
+            let t0 = Instant::now();
+            for t in &tokens {
+                black_box(closure_project(black_box(t)));
+            }
+            t0.elapsed().as_nanos() as u64
+        },
+    );
+    run_case(
+        "RECOGNIZER-ONLY  (JSON free-tape, no ApplyFn)",
+        &recog,
+        &tokens,
+        || {
+            let t0 = Instant::now();
+            for t in &tokens {
+                black_box(closure_recognize(black_box(t).as_bytes()));
+            }
+            t0.elapsed().as_nanos() as u64
+        },
+    );
+
+    // ── Amortized single-parse: ONE interpreter over a long input ────────────
+    // Isolates per-parse SETUP allocation (8 Vecs + memo map in
+    // `Interpreter::new`) from interpret/value-plane throughput. One big hex
+    // token: setup is paid once, the DFA match + ApplyFn run over 384 bytes.
+    let big: String = tokens.concat();
+    let mut vm_amort = Vec::with_capacity(2 * N);
+    let mut cl_amort = Vec::with_capacity(2 * N);
+    for w in 0..(2 * N) {
+        if w % 2 == 0 {
+            let t0 = Instant::now();
+            black_box(vm_run(&proj, black_box(&big)));
+            vm_amort.push(t0.elapsed().as_nanos() as u64);
+            let t1 = Instant::now();
+            black_box(closure_project(black_box(&big)));
+            cl_amort.push(t1.elapsed().as_nanos() as u64);
+        } else {
+            let t1 = Instant::now();
+            black_box(closure_project(black_box(&big)));
+            cl_amort.push(t1.elapsed().as_nanos() as u64);
+            let t0 = Instant::now();
+            black_box(vm_run(&proj, black_box(&big)));
+            vm_amort.push(t0.elapsed().as_nanos() as u64);
+        }
+    }
+    let vm_med = median(vm_amort.clone());
+    let cl_med = median(cl_amort.clone());
+    println!("--- AMORTIZED single-parse ({} bytes, 1 interpreter) ---", big.len());
+    println!("  VM(A)      median={vm_med:>8}ns  iqr={:>7}ns", iqr(vm_amort));
+    println!("  CLOSURE(B) median={cl_med:>8}ns  iqr={:>7}ns", iqr(cl_amort));
+    println!(
+        "  ratio(closure/vm) = {:.4}x  | VM per-parse setup dominates the per-token cases",
+        cl_med as f64 / vm_med as f64
+    );
+}
