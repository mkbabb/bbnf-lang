diff --git a/skinny/crates/bbnf-simd/src/lib.rs b/skinny/crates/bbnf-simd/src/lib.rs
index 87612b855..d0874b008 100644
--- a/skinny/crates/bbnf-simd/src/lib.rs
+++ b/skinny/crates/bbnf-simd/src/lib.rs
@@ -251,6 +251,109 @@ pub mod prim {
     pub use crate::scalar::comment_body_mask_64::CommentCarry;
     pub use crate::scalar::eob_pad_clamp::EobBlock;
 
+    pub use crate::dispatch::{select_prefilter_backend, PrefilterBackend};
+    use crate::scalar::prefilter::{
+        find_member_scalar, membership_table, NibbleLut, WideLut,
+    };
+
+    /// Fused density gate (bytes). The scalar probe scans this many bytes
+    /// before engaging the SIMD block prefilter — dense inputs (a member
+    /// within `PREFILTER_GATE` bytes) never pay the vector setup, so the
+    /// prefilter is neutral on dense corpora; long non-member runs cross the
+    /// gate and skip 64 bytes per NEON block.
+    pub const PREFILTER_GATE: usize = 16;
+
+    /// Productionized shufti/truffle prefilter: a member set compiled to the
+    /// nibble/wide LUTs + the selected [`PrefilterBackend`]. Built once per
+    /// scan; `find_member` is the fused GATE=16 entry point.
+    #[derive(Clone)]
+    pub struct PrefilterSet {
+        membership: [bool; 256],
+        backend: PrefilterBackend,
+        nibble: NibbleLut,
+        wide: WideLut,
+    }
+
+    impl PrefilterSet {
+        /// Compile `members` (the bytes that terminate a scan run) into the
+        /// prefilter. Cost-driven backend from cardinality (see
+        /// [`select_prefilter_backend`]).
+        pub fn new(members: &[u8]) -> Self {
+            Self {
+                membership: membership_table(members),
+                backend: select_prefilter_backend(members),
+                nibble: NibbleLut::from_members(members),
+                wide: WideLut::from_members(members),
+            }
+        }
+
+        #[inline]
+        pub fn backend(&self) -> PrefilterBackend {
+            self.backend
+        }
+
+        /// First index `>= start` where a member occurs, else `input.len()`.
+        ///
+        /// Fused GATE=16: Phase 1 scalar-probes `PREFILTER_GATE` bytes (dense
+        /// fast path, no vector setup); Phase 2 — only reached when the probe
+        /// crosses a long non-member run — engages the NEON shufti/truffle
+        /// block kernel, skipping 64 bytes per iteration; Phase 3 handles the
+        /// sub-block scalar tail. Byte-identical to
+        /// `scalar::prefilter::find_member_scalar`.
+        #[inline]
+        pub fn find_member(&self, input: &[u8], start: usize) -> usize {
+            let n = input.len();
+            let mut i = start;
+
+            // Phase 1 — scalar density probe (fused GATE).
+            let probe_end = start.saturating_add(PREFILTER_GATE).min(n);
+            while i < probe_end {
+                if self.membership[input[i] as usize] {
+                    return i;
+                }
+                i += 1;
+            }
+
+            // Phase 2 — the run crossed the GATE: NEON block prefilter. Each
+            // 64-byte block is rejected with a cheap `vmaxvq` any-member test
+            // (no movemask on the all-miss skip path); a full block classify
+            // runs only on the block that carries a hit, to locate the byte.
+            // 64-byte granularity bounds the boundary cost at the end of a run,
+            // keeping dense corpora neutral, while long non-member runs skip a
+            // block per cheap reject.
+            #[cfg(target_arch = "aarch64")]
+            {
+                use crate::aarch64::prefilter as pf;
+                let base = input.as_ptr();
+                match self.backend {
+                    PrefilterBackend::NeonNibble => {
+                        while i + 64 <= n {
+                            if unsafe { pf::any_member_64_nibble(base.add(i), &self.nibble) } {
+                                let m =
+                                    unsafe { pf::classify_block_nibble(base.add(i), &self.nibble) };
+                                return i + m.trailing_zeros() as usize;
+                            }
+                            i += 64;
+                        }
+                    }
+                    PrefilterBackend::NeonWide => {
+                        while i + 64 <= n {
+                            if unsafe { pf::any_member_64_wide(base.add(i), &self.wide) } {
+                                let m = unsafe { pf::classify_block_wide(base.add(i), &self.wide) };
+                                return i + m.trailing_zeros() as usize;
+                            }
+                            i += 64;
+                        }
+                    }
+                    PrefilterBackend::Scalar => {}
+                }
+            }
+
+            // Phase 3 — scalar tail (< 64 remaining, or scalar backend).
+            find_member_scalar(input, i, &self.membership)
+        }
+    }
+
