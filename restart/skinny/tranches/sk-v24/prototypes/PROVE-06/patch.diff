@@ -0,0 +1,325 @@
+//! PROVE-06 (SK-V24, F4) — cold path-get bench: skinny stop-early `get`
+//! (`runtime::generated_json::get`, the tape-free NEON-skip lazy seam) vs
+//! sonic-rs `get_from_str` on twitter, over shallow / deep / missing path
+//! classes plus a stop-early prefix proof.
+//!
+//! Certified metric: PMU cyc/get (per-process `ri_cycles` HW counter, load-
+//! robust) and the paired per-sample wall ratio (mine vs sonic interleaved in
+//! one sample, load hitting both sides). Ratios are the certified comparison;
+//! absolutes are directional. A `tape_pointer` lane (parse full tape THEN
+//! `JsonValue::pointer`) is reported to contrast the eager-parse cost the
+//! stop-early lane elides.
+//!
+//! Invocation:
+//!     cargo build --release -p bbnf-bench --bin json_path_bench
+//!     ./target/release/json_path_bench [N] [iters]     (default N=200 iters=20000)
+
+use runtime::generated_json as json;
+use sonic_rs::{get_from_str, pointer, PointerNode};
+use std::hint::black_box;
+use std::time::Instant;
+
+// --- PMU via proc_pid_rusage V5 (cycles), mirrors css_canon_bench.rs ---
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct RusageInfoV5 {
+    ri_uuid: [u8; 16],
+    ri_user_time: u64,
+    ri_system_time: u64,
+    ri_pkg_idle_wkups: u64,
+    ri_interrupt_wkups: u64,
+    ri_pageins: u64,
+    ri_wired_size: u64,
+    ri_resident_size: u64,
+    ri_phys_footprint: u64,
+    ri_proc_start_abstime: u64,
+    ri_proc_exit_abstime: u64,
+    ri_child_user_time: u64,
+    ri_child_system_time: u64,
+    ri_child_pkg_idle_wkups: u64,
+    ri_child_interrupt_wkups: u64,
+    ri_child_pageins: u64,
+    ri_child_elapsed_abstime: u64,
+    ri_diskio_bytesread: u64,
+    ri_diskio_byteswritten: u64,
+    ri_cpu_time_qos_default: u64,
+    ri_cpu_time_qos_maintenance: u64,
+    ri_cpu_time_qos_background: u64,
+    ri_cpu_time_qos_utility: u64,
+    ri_cpu_time_qos_legacy: u64,
+    ri_cpu_time_qos_user_initiated: u64,
+    ri_cpu_time_qos_user_interactive: u64,
+    ri_billed_system_time: u64,
+    ri_serviced_system_time: u64,
+    ri_logical_writes: u64,
+    ri_lifetime_max_phys_footprint: u64,
+    ri_instructions: u64,
+    ri_cycles: u64,
+    ri_billed_energy: u64,
+    ri_serviced_energy: u64,
+    ri_interval_max_phys_footprint: u64,
+    ri_runnable_time: u64,
+    ri_flags: u64,
+}
+const RUSAGE_INFO_V5: i32 = 5;
+extern "C" {
+    fn proc_pid_rusage(pid: libc::pid_t, flavor: i32, buffer: *mut u8) -> i32;
+}
+fn cycles_now() -> u64 {
+    let mut ri = RusageInfoV5::default();
+    let rc = unsafe {
+        proc_pid_rusage(
+            libc::getpid(),
+            RUSAGE_INFO_V5,
+            (&mut ri) as *mut RusageInfoV5 as *mut u8,
+        )
+    };
+    if rc != 0 {
+        panic!("proc_pid_rusage failed rc={rc}");
+    }
+    ri.ri_cycles
+}
+
+fn loadavg() -> String {
+    std::process::Command::new("sysctl")
+        .args(["-n", "vm.loadavg"])
+        .output()
+        .ok()
+        .and_then(|o| String::from_utf8(o.stdout).ok())
+        .map(|s| s.trim().trim_matches(|c| c == '{' || c == '}' || c == ' ').to_string())
+        .unwrap_or_else(|| "?".into())
+}
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+struct Case {
+    name: &'static str,
+    class: &'static str,
+    mine: Vec<json::Seg<'static>>,
+    sonic: Vec<PointerNode>,
+}
+
+fn digest_mine(input: &str, segs: &[json::Seg]) -> u64 {
+    match json::get(input, segs) {
+        Some(v) => {
+            let raw = v.as_raw_str().as_bytes();
+            raw.len() as u64 ^ raw.first().copied().unwrap_or(0) as u64
+        }
+        None => 0,
+    }
+}
+
+fn digest_sonic(input: &str, path: &[PointerNode]) -> u64 {
+    match get_from_str(input, path) {
+        Ok(v) => {
+            let raw = v.as_raw_str().as_bytes();
+            raw.len() as u64 ^ raw.first().copied().unwrap_or(0) as u64
+        }
+        Err(_) => 0,
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(200);
+    let iters: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(20_000);
+    const BURST: usize = 256;
+
+    let path = concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../test-fixtures/corpus/json/twitter.json"
+    );
+    let input = std::fs::read_to_string(path).expect("twitter fixture");
+    let nbytes = input.len();
+
+    let cases = vec![
+        Case {
+            name: "statuses[0]",
+            class: "shallow",
+            mine: vec![json::Seg::Key("statuses"), json::Seg::Idx(0)],
+            sonic: pointer!["statuses", 0].to_vec(),
+        },
+        Case {
+            name: "statuses[0].user.screen_name",
+            class: "deep",
+            mine: vec![
+                json::Seg::Key("statuses"),
+                json::Seg::Idx(0),
+                json::Seg::Key("user"),
+                json::Seg::Key("screen_name"),
+            ],
+            sonic: pointer!["statuses", 0, "user", "screen_name"].to_vec(),
+        },
+        Case {
+            name: "statuses[0].nonexistent",
+            class: "missing",
+            mine: vec![
+                json::Seg::Key("statuses"),
+                json::Seg::Idx(0),
+                json::Seg::Key("nonexistent_field"),
+            ],
+            sonic: pointer!["statuses", 0, "nonexistent_field"].to_vec(),
+        },
+        Case {
+            name: "statuses[0].id (prefix)",
+            class: "prefix",
+            mine: vec![
+                json::Seg::Key("statuses"),
+                json::Seg::Idx(0),
+                json::Seg::Key("id"),
+            ],
+            sonic: pointer!["statuses", 0, "id"].to_vec(),
+        },
+    ];
+
+    println!("# PROVE-06 json_path_bench — twitter {nbytes} B, N={n}, iters={iters}, BURST={BURST}");
+    println!("# loadavg {}", loadavg());
+    println!(
+        "# arch {} | sonic-rs=0.5.8 get_from_str (checked)",
+        std::env::consts::ARCH
+    );
+
+    // --- Parity gate (sonic get_unchecked is the raw-slice reference oracle) ---
+    println!("\n## parity (mine.as_raw_str vs sonic get_unchecked.as_raw_str)");
+    for c in &cases {
+        let mine = json::get(&input, &c.mine).map(|v| v.as_raw_str().to_string());
+        let sonic = unsafe { sonic_rs::get_unchecked(&input, &c.sonic) }
+            .ok()
+            .map(|v| v.as_raw_str().to_string());
+        // tape-pointer oracle: parse full tape then JsonValue::pointer
+        let root = json::parse(&input).expect("twitter parses");
+        let tape_raw = root
+            .value()
+            .pointer(&c.mine)
+            .map(|v| input[v.span()].to_string());
+        let ok = mine == sonic;
+        // string spans differ (tape span excludes quotes); compare presence only
+        let tape_ok = tape_raw.is_some() == mine.is_some();
+        println!(
+            "  [{}] {:<32} mine={:?} sonic={:?} parity={} tape_present={}",
+            c.class,
+            c.name,
+            mine.as_deref().map(|s| &s[..s.len().min(24)]),
+            sonic.as_deref().map(|s| &s[..s.len().min(24)]),
+            if ok { "OK" } else { "MISMATCH" },
+            if tape_ok { "OK" } else { "MISMATCH" },
+        );
+        assert!(ok, "parity mismatch on {}", c.name);
+    }
+
+    // --- Stop-early proof: max source offset the prefix get reaches ---
+    let prefix = &cases[3];
+    if let Some(v) = json::get(&input, &prefix.mine) {
+        let end = v.as_raw_str().as_ptr() as usize - input.as_ptr() as usize
+            + v.as_raw_str().len();
+        println!(
+            "\n## stop-early: prefix {:?} resolves at byte {} / {} ({:.3}% of doc scanned)",
+            prefix.name,
+            end,
+            nbytes,
+            100.0 * end as f64 / nbytes as f64
+        );
+    }
+
+    // one out-of-band touch to page in the source
+    black_box(input.as_bytes().iter().fold(0u8, |a, b| a ^ b));
+
+    // --- PMU: certified cyc/get (tight loop, per-process HW counter) ---
+    println!("\n## PMU cyc/get (iters={iters})  [ratio = mine/sonic; <1 ⇒ skinny faster]");
+    println!(
+        "  {:<32} {:>12} {:>12} {:>8} {:>10}",
+        "case", "mine cyc", "sonic cyc", "ratio", "sonic_unck"
+    );
+    for c in &cases {
+        let c0 = cycles_now();
+        for _ in 0..iters {
+            black_box(digest_mine(&input, &c.mine));
+        }
+        let mine_cyc = (cycles_now() - c0) as f64 / iters as f64;
+
+        let c0 = cycles_now();
+        for _ in 0..iters {
+            black_box(digest_sonic(&input, &c.sonic));
+        }
+        let sonic_cyc = (cycles_now() - c0) as f64 / iters as f64;
+
+        let c0 = cycles_now();
+        for _ in 0..iters {
+            let d = unsafe { sonic_rs::get_unchecked(&input, &c.sonic) }
+                .map(|v| v.as_raw_str().len() as u64)
+                .unwrap_or(0);
+            black_box(d);
+        }
+        let unck_cyc = (cycles_now() - c0) as f64 / iters as f64;
+
+        println!(
+            "  [{:<7}] {:<22} {:>12.0} {:>12.0} {:>8.3} {:>10.3}",
+            c.class,
+            c.name,
+            mine_cyc,
+            sonic_cyc,
+            mine_cyc / sonic_cyc,
+            mine_cyc / unck_cyc,
+        );
+    }
+
+    // --- Paired per-sample wall (N samples, BURST gets per sample) ---
+    println!("\n## paired per-sample wall ratio (N={n}, BURST={BURST})");
+    println!(
+        "  {:<32} {:>10} {:>10} {:>8} {:>16}",
+        "case", "mine ns", "sonic ns", "ratio", "ratio 95% CI"
+    );
+    for c in &cases {
+        let mut ratios = Vec::with_capacity(n);
+        let mut mine_ns = Vec::with_capacity(n);
+        let mut sonic_ns = Vec::with_capacity(n);
+        for _ in 0..n {
+            let t = Instant::now();
+            for _ in 0..BURST {
+                black_box(digest_mine(&input, &c.mine));
+            }
+            let m = t.elapsed().as_nanos() as f64 / BURST as f64;
+            let t = Instant::now();
+            for _ in 0..BURST {
+                black_box(digest_sonic(&input, &c.sonic));
+            }
+            let s = t.elapsed().as_nanos() as f64 / BURST as f64;
+            ratios.push(m / s);
+            mine_ns.push(m);
+            sonic_ns.push(s);
+        }
+        let mean = ratios.iter().sum::<f64>() / n as f64;
+        let var = ratios.iter().map(|r| (r - mean).powi(2)).sum::<f64>() / (n as f64 - 1.0);
+        let ci = 1.96 * (var / n as f64).sqrt();
+        println!(
+            "  [{:<7}] {:<22} {:>10.1} {:>10.1} {:>8.3} {:>7.3}±{:.3}",
+            c.class,
+            c.name,
+            median(mine_ns),
+            median(sonic_ns),
+            mean,
+            mean,
+            ci,
+        );
+    }
+
+    // --- Contrast lane: eager tape_pointer (parse full tape THEN pointer) ---
+    println!("\n## contrast: tape_pointer cyc/get (full parse + JsonValue::pointer)");
+    for c in &cases {
+        let c0 = cycles_now();
+        for _ in 0..(iters / 20).max(50) {
+            let root = json::parse(&input).expect("parse");
+            let d = root
+                .value()
+                .pointer(&c.mine)
+                .map(|v| v.span().len() as u64)
+                .unwrap_or(0);
+            black_box(d);
+        }
+        let cyc = (cycles_now() - c0) as f64 / (iters / 20).max(50) as f64;
+        println!("  [{:<7}] {:<22} {:>12.0} cyc  ({:.2} cyc/B full doc)", c.class, c.name, cyc, cyc / nbytes as f64);
+    }
+}
