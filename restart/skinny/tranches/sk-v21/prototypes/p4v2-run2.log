MULTI N=5  cyc/64B=25.047  vs_nibble=1.880x[nibble<multi]  vs_wide=1.454x[wide<multi]
MULTI N=6  cyc/64B=31.274  vs_nibble=2.347x[nibble<multi]  vs_wide=1.815x[wide<multi]
MULTI N=8  cyc/64B=31.748  vs_nibble=2.382x[nibble<multi]  vs_wide=1.842x[wide<multi]
