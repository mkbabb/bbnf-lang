@@ -0,0 +1,109 @@
+//! Prefilter LUT data + scalar reference oracle — the executable specification.
+//!
+//! Ported from the legacy `crates/simd-scan/src/alphabet.rs`
+//! (`NibbleLut`/`WideLut::from_singletons`). The encoding is EXACT: each
+//! singleton `i` occupies its own bit `1 << (i & 7)`, so
+//! `lo[b & 0xf] & hi[b >> 4] != 0` holds iff some singleton equals `b` — no
+//! false positives, no confirm step. Nibble path admits ≤ 8 members (shufti),
+//! wide path lifts the cap to ≤ 16 by splitting into two table pairs (truffle).
+//!
+//! The scalar `find_member`/`classify_block` here are the parity anchors for
+//! the NEON bodies in `aarch64/prefilter.rs` (dav1d checkasm discipline).
+
+/// Shared nibble-LUT pair (lo, hi) for ≤ 8 members — the shufti table.
+#[derive(Debug, Clone, Copy)]
+pub struct NibbleLut {
+    pub lo: [u8; 16],
+    pub hi: [u8; 16],
+}
+
+impl NibbleLut {
+    /// Encode the first ≤ 8 `members` into `(lo, hi)`: `lo[low] |= 1 << i`,
+    /// `hi[high] |= 1 << i` for member `i`. Beyond 8 the shufti bit-encoding
+    /// runs out of lanes; `PrefilterSet` selects a wider backend there and
+    /// never consults this table, so the prefix build is exact when used.
+    pub fn from_members(members: &[u8]) -> Self {
+        let mut lo = [0u8; 16];
+        let mut hi = [0u8; 16];
+        for (i, &b) in members.iter().take(8).enumerate() {
+            let bit = 1u8 << (i & 7);
+            lo[(b & 0x0F) as usize] |= bit;
+            hi[(b >> 4) as usize] |= bit;
+        }
+        Self { lo, hi }
+    }
+}
+
+/// Wide-LUT for 9..=16 members — the truffle table (two paired lookups).
+#[derive(Debug, Clone, Copy)]
+pub struct WideLut {
+    pub lo_lo: [u8; 16],
+    pub hi_lo: [u8; 16],
+    pub lo_hi: [u8; 16],
+    pub hi_hi: [u8; 16],
+}
+
+impl WideLut {
+    /// Build the wide-LUT from the first ≤ 16 members; indices 0..8 land in
+    /// the `*_lo` pair, 8..16 in the `*_hi` pair. Beyond 16, `PrefilterSet`
+    /// falls to the scalar oracle and never consults this table.
+    pub fn from_members(members: &[u8]) -> Self {
+        let mut lo_lo = [0u8; 16];
+        let mut hi_lo = [0u8; 16];
+        let mut lo_hi = [0u8; 16];
+        let mut hi_hi = [0u8; 16];
+        for (i, &b) in members.iter().take(16).enumerate() {
+            let bit = 1u8 << (i & 7);
+            if i < 8 {
+                lo_lo[(b & 0x0F) as usize] |= bit;
+                hi_lo[(b >> 4) as usize] |= bit;
+            } else {
+                lo_hi[(b & 0x0F) as usize] |= bit;
+                hi_hi[(b >> 4) as usize] |= bit;
+            }
+        }
+        Self {
+            lo_lo,
+            hi_lo,
+            lo_hi,
+            hi_hi,
+        }
+    }
+}
+
+/// Build the 256-entry membership table for `members`.
+pub fn membership_table(members: &[u8]) -> [bool; 256] {
+    let mut table = [false; 256];
+    for &b in members {
+        table[b as usize] = true;
+    }
+    table
+}
+
+/// Scalar reference: 64-bit mask, bit `i` set iff `block[i]` is a member.
+/// The parity anchor for the NEON `classify_block_*` kernels.
+#[inline]
+pub fn classify_block_scalar(block: &[u8; 64], membership: &[bool; 256]) -> u64 {
+    let mut mask = 0u64;
+    for i in 0..64 {
+        if membership[block[i] as usize] {
+            mask |= 1u64 << i;
+        }
+    }
+    mask
+}
+
+/// Scalar reference: first index `>= start` where `input[i]` is a member,
+/// else `input.len()`. The executable spec for `PrefilterSet::find_member`.
+#[inline]
+pub fn find_member_scalar(input: &[u8], start: usize, membership: &[bool; 256]) -> usize {
+    let n = input.len();
+    let mut i = start;
+    while i < n {
+        if membership[input[i] as usize] {
+            return i;
+        }
+        i += 1;
+    }
+    n
+}
diff --git a/skinny/crates/bbnf-simd/tests/prefilter_parity.rs b/skinny/crates/bbnf-simd/tests/prefilter_parity.rs
new file mode 100644
index 000000000..5dc5a9a39
--- /dev/null
+++ b/skinny/crates/bbnf-simd/tests/prefilter_parity.rs
@@ -0,0 +1,207 @@
+//! Differential parity for the shufti/truffle prefilter (PROVE-01).
+//!
+//! The scalar oracle `scalar::prefilter::{classify_block_scalar, find_member_scalar}`
+//! is the executable specification; the NEON shufti/truffle block kernels and
+//! the fused GATE=16 `PrefilterSet::find_member` must agree with it bit- and
+//! index-for-bit on every case swept here.
+
+use bbnf_simd::prim::PrefilterSet;
+use bbnf_simd::scalar::prefilter::{classify_block_scalar, find_member_scalar, membership_table};
+
+struct Xorshift64(u64);
+impl Xorshift64 {
+    fn new(seed: u64) -> Self {
+        Self(seed | 1)
+    }
+    fn next_u64(&mut self) -> u64 {
+        let mut s = self.0;
+        s ^= s << 13;
+        s ^= s >> 7;
+        s ^= s << 17;
+        self.0 = s;
+        s
+    }
+    fn fill(&mut self, buf: &mut [u8]) {
+        for b in buf.iter_mut() {
+            *b = (self.next_u64() & 0xFF) as u8;
+        }
+    }
+    fn draw_distinct_set(&mut self, count: usize) -> Vec<u8> {
+        let mut seen = [false; 256];
+        let mut set = Vec::with_capacity(count);
+        while set.len() < count {
+            let c = (self.next_u64() & 0xFF) as u8;
+            if !seen[c as usize] {
+                seen[c as usize] = true;
+                set.push(c);
+            }
+        }
+        set
+    }
+}
+
+const JSON_STRUCTURAL: &[u8] = b"{}[],:\"";
+const CSS_STRUCTURAL: &[u8] = b"{}();:,\"'#.>+~*=[]"; // 18 members → wide/multicmp
+
+/// Block-classify parity: NEON shufti/truffle mask == scalar mask, alignment
+/// swept over a 128-byte adversarial backing buffer, for a set sweep 1..=16.
+#[test]
+fn classify_block_alignment_and_set_sweep() {
+    let mut rng = Xorshift64::new(0xCAFE_F00D_BAAD_F00D);
+    let mut backing = [0u8; 128];
+    rng.fill(&mut backing);
+    // Sprinkle structural bytes so masks are non-trivial.
+    for (k, slot) in backing.iter_mut().enumerate() {
+        if k % 5 == 0 {
+            *slot = JSON_STRUCTURAL[k % JSON_STRUCTURAL.len()];
+        }
+    }
+
+    let mut failures = 0usize;
+    for set_size in 1..=16usize {
+        let set = if set_size <= JSON_STRUCTURAL.len() {
+            JSON_STRUCTURAL[..set_size].to_vec()
+        } else {
+            let mut s = JSON_STRUCTURAL.to_vec();
+            let mut r = Xorshift64::new(0x1234 + set_size as u64);
+            while s.len() < set_size {
+                let c = (r.next_u64() & 0xFF) as u8;
+                if !s.contains(&c) {
+                    s.push(c);
+                }
+            }
+            s
+        };
+        let membership = membership_table(&set);
+        let pf = PrefilterSet::new(&set);
+        for align in 0..64 {
+            let mut window = [0u8; 64];
+            window.copy_from_slice(&backing[align..align + 64]);
+            let reference = classify_block_scalar(&window, &membership);
+            // Direct NEON kernel parity: the shufti/truffle block classify
+            // must equal the scalar mask bit-for-bit.
+            #[cfg(target_arch = "aarch64")]
+            {
+                use bbnf_simd::aarch64::prefilter::{classify_block_nibble, classify_block_wide};
+                use bbnf_simd::scalar::prefilter::{NibbleLut, WideLut};
+                let neon_mask = if set_size <= 8 {
+                    unsafe { classify_block_nibble(window.as_ptr(), &NibbleLut::from_members(&set)) }
+                } else {
+                    unsafe { classify_block_wide(window.as_ptr(), &WideLut::from_members(&set)) }
+                };
+                if neon_mask != reference {
+                    failures += 1;
+                }
+            }
+            // find_member over exactly this window must equal the scalar
+            // first-set-bit derived from the reference mask.
+            let expect_first = if reference == 0 {
+                64
+            } else {
+                reference.trailing_zeros() as usize
+            };
+            let got_first = pf.find_member(&window, 0);
+            if got_first != expect_first {
+                failures += 1;
+            }
+        }
+    }
+    assert_eq!(failures, 0, "classify/find divergences: {failures}");
+}
+
+/// Fused finder parity vs the scalar oracle across random inputs, random start
+/// offsets, and both nibble + wide backends — including all-miss (skip-heavy),
+/// dense, and boundary-straddling cases.
+#[test]
+fn find_member_fused_matches_scalar_oracle() {
+    let mut rng = Xorshift64::new(0xDEAD_BEEF_1234_5678);
+    let mut failures = 0usize;
+
+    for &set in &[JSON_STRUCTURAL, CSS_STRUCTURAL] {
+        let membership = membership_table(set);
+        let pf = PrefilterSet::new(set);
+
+        for len in [0usize, 1, 15, 16, 17, 63, 64, 65, 127, 128, 200, 4096, 70_000] {
+            let mut input = vec![0u8; len];
+            rng.fill(&mut input);
+            // Regime A: dense (member every ~7 bytes).
+            let mut dense = input.clone();
+            for i in (0..len).step_by(7) {
+                dense[i] = set[i % set.len()];
+            }
+            // Regime B: skip-heavy — wipe all members to a non-member, then a
+            // single member near the end.
+            let mut sparse = vec![b'a'; len];
+            if len > 0 {
+                sparse[len - 1] = set[0];
+            }
+
+            for corpus in [&input, &dense, &sparse] {
+                for &start in &[0usize, 1, 8, 16, 33, 64, len.saturating_sub(1)] {
+                    let start = start.min(len);
+                    let want = find_member_scalar(corpus, start, &membership);
+                    let got = pf.find_member(corpus, start);
+                    if want != got {
+                        failures += 1;
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(failures, 0, "fused finder divergences: {failures}");
+}
+
+/// Corpus parity: sweep the fused finder end-to-end across twitter.json,
+/// collecting every structural position, and assert it equals the scalar
+/// oracle's positions exactly.
+#[test]
+fn corpus_parity_twitter_full_scan() {
+    let fixtures = match test_fixtures::load_available_bench_fixtures() {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!("prefilter corpus parity: fixtures unavailable ({e:?}); skipping");
+            return;
+        }
+    };
+    let twitter = match fixtures.iter().find(|f| f.name == "twitter") {
+        Some(f) => f,
+        None => {
+            eprintln!("prefilter corpus parity: twitter fixture missing; skipping");
+            return;
+        }
+    };
+    let bytes = &twitter.bytes;
+    let membership = membership_table(JSON_STRUCTURAL);
+    let pf = PrefilterSet::new(JSON_STRUCTURAL);
+
+    let mut want = Vec::new();
+    let mut i = 0;
+    loop {
+        let p = find_member_scalar(bytes, i, &membership);
+        if p >= bytes.len() {
+            break;
+        }
+        want.push(p);
+        i = p + 1;
+    }
+
+    let mut got = Vec::new();
+    let mut i = 0;
+    loop {
+        let p = pf.find_member(bytes, i);
+        if p >= bytes.len() {
+            break;
+        }
+        got.push(p);
+        i = p + 1;
+    }
+
+    assert_eq!(
+        want.len(),
+        got.len(),
+        "twitter structural count diverged: scalar {} vs fused {}",
+        want.len(),
+        got.len()
+    );
+    assert!(want == got, "twitter structural positions diverged");
+}
