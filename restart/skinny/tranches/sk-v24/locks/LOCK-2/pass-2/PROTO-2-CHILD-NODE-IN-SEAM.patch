@@ -0,0 +1,93 @@
+//! PROTO-2 / PROVE-2-CHILD-NODE-IN-SEAM.
+//!
+//! Faces the child-bearing `BbnfNode` organ at a REAL json rule — json.bbnf's
+//! `value = ws (object | array | string | number | bool | null) ws` — parsed
+//! through the production `grammar` front end into skinny's flat `GrammarIr`.
+//! Asserts: the organ builds over the flat arena (no bbnf-ir DAG), faces ≥2
+//! confluent survivors at the 6-branch Alt, the N-crossover arm picks the
+//! dispatch form (N = 6 > N* = 3), and the whole build→saturate→extract→
+//! teardown organ runs in well under 50µs.
+
+use std::time::Instant;
+
+use passes::backend_egraph_bbnf::probe_child_bearing;
+
+fn load_json_grammar() -> ir::GrammarIr {
+    let path = concat!(env!("CARGO_MANIFEST_DIR"), "/../../grammars/json.bbnf");
+    let source = std::fs::read_to_string(path).expect("read grammars/json.bbnf");
+    grammar::parse_json_grammar(&source).expect("parse json.bbnf into flat GrammarIr")
+}
+
+#[test]
+fn child_node_extraction_faces_two_survivors_at_json_value() {
+    let grammar = load_json_grammar();
+    let value = grammar
+        .rule_by_name("value")
+        .expect("json.bbnf has a `value` rule");
+
+    let report = probe_child_bearing(&grammar, value.body);
+
+    println!(
+        "[CHILD-NODE] rule=value ran={} alt_arity={} survivors={} picked_dispatch={} \
+         total_nodes={} total_classes={} iterations={}",
+        report.ran,
+        report.alt_arity,
+        report.alt_survivors,
+        report.picked_dispatch,
+        report.total_nodes,
+        report.total_classes,
+        report.iterations,
+    );
+
+    // The organ ran over the flat GrammarIr — no bbnf-ir DAG was needed.
+    assert!(report.ran, "organ must build for a rule bearing an Alt");
+    // json's value Alt has exactly 6 branches (object|array|string|number|bool|null).
+    assert_eq!(report.alt_arity, 6, "value dispatch is a 6-branch Alt");
+    // ≥2 confluent survivors: sequential + manufactured dispatch twin.
+    assert!(
+        report.alt_survivors >= 2,
+        "extraction must face ≥2 survivors at the real json value rule; got {}",
+        report.alt_survivors
+    );
+    // N = 6 > N* = 3 ⇒ the N-crossover arm picks the dispatch form.
+    assert!(
+        report.picked_dispatch,
+        "at N=6 the calibrated N-crossover arm must pick the dispatch form"
+    );
+}
+
+#[test]
+fn child_node_organ_runs_under_50us_cold() {
+    let grammar = load_json_grammar();
+    let value = grammar.rule_by_name("value").expect("value rule");
+
+    // Warm the arena caches once (parse is NOT the organ; excluded).
+    let _ = probe_child_bearing(&grammar, value.body);
+
+    // Cold-paired: fresh EGraph build→saturate→extract→teardown each run.
+    let mut samples: Vec<u128> = Vec::with_capacity(200);
+    for _ in 0..200 {
+        let start = Instant::now();
+        let report = probe_child_bearing(&grammar, value.body);
+        let elapsed = start.elapsed().as_nanos();
+        std::hint::black_box(&report);
+        samples.push(elapsed);
+    }
+    samples.sort_unstable();
+    let min_ns = samples[0];
+    let median_ns = samples[samples.len() / 2];
+    let p90_ns = samples[samples.len() * 9 / 10];
+
+    println!(
+        "[CHILD-NODE-ORGAN-US] min={:.3} median={:.3} p90={:.3} (n=200 cold build+saturate+extract+teardown)",
+        min_ns as f64 / 1000.0,
+        median_ns as f64 / 1000.0,
+        p90_ns as f64 / 1000.0,
+    );
+
+    assert!(
+        median_ns < 50_000,
+        "organ median must be < 50µs; got {:.3}µs",
+        median_ns as f64 / 1000.0
+    );
+}
