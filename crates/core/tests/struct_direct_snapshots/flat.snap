// AZ-I.W2.RF — Flat struct-direct snapshot.
//
// Captures the expected `builder.*` call set the Flat-shape emitter
// produces under `EmitStrategy::StructDirect` for JSON's `pair` rule
// (the only Flat-classified rule in JSON's grammar surface). Per the
// W2-EMITTER-REWIRE plan §3 hard gates, the struct-direct body emits
// zero `tape.*` calls; only the typed StructBuilder API is exercised.
//
// Wire contract (JSON `pair = string, colon >> value`, Flat-classified):
//
//   let __pair_layout: ::bbnf_ir::registry::StructLayout = { … };
//   let __pair_handle = builder.begin_compound(&__pair_layout);
//   // p0 — Ref(string) → parse_string_<grammar>_string call
//   //                   (its body emits builder.push_leaf_with_str)
//   // p1 — Literal(":") with surrounding ws skip → byte match,
//   //      no builder push (structural punctuation)
//   // p2 — Ref(value) → parse_wrap_<grammar>_value call
//   //                   (its body emits builder.begin_compound /
//   //                    push_branch_tag / end_compound for the Wrap)
//   builder.end_compound(__pair_handle);
//
// The Pair frame on JsonStructBuilder routes (LayoutKind::Struct,
// "pair") to OpenFrame::Pair { key, value }; the in-frame string key
// push lands as Pair.key, the value-call's deposit lands as Pair.value,
// and end_compound finalises the pair onto the enclosing Object frame's
// `pairs` Vec (runtime/json/builder.rs:60-86).
//
// Source: crates/core/src/backend/rust/emitter/shapes/flat/struct_direct.rs
// Emitted by `emit_parse_flat_struct_direct` for JSON's `pair` rule.

#[inline]
#[allow(non_snake_case, clippy::too_many_arguments, unused_variables, unused_mut)]
pub fn parse_flat_json_pair(
    input: &[u8],
    p: &mut usize,
    state: &mut __shape_support_json::ScanState,
    builder: &mut crate::runtime::JsonStructBuilder<'_>,
) -> ::core::result::Result<
    crate::runtime::tape::TapeOffset,
    crate::runtime::tape::DtaError,
> {
    // Layout literal — built inline from the rule's registered
    // metadata. JsonStructBuilder::begin_compound consults
    // (kind, rule_name) and routes (LayoutKind::Struct, "pair") to
    // OpenFrame::Pair { key, value }.
    let __pair_layout: ::bbnf_ir::registry::StructLayout =
        ::bbnf_ir::registry::StructLayout {
            rule_id: 5u32 as ::bbnf_ir::RuleId,
            rule_name: ::std::string::String::from("pair"),
            kind: ::bbnf_ir::registry::LayoutKind::Struct,
            rule_type: ::bbnf_ir::TypeDesc::Span,
            fields: ::std::vec::Vec::new(),
        };
    let __pair_handle = <
        crate::runtime::JsonStructBuilder<'_> as crate::runtime::StructBuilder
    >::begin_compound(builder, &__pair_layout);

    // p0 — Ref(string). emit_ref_call_tape resolves to
    //   parse_string_<grammar>_string(input, p, state, builder)
    // whose StructDirect body lands the decoded string slice via
    // builder.push_leaf_with_str(slice).
    let _ = ({
        let _ = __shape_support_json::skip_space(input, p, state);
        parse_string_json_string(input, p, state, builder)
    })?;

    // p1 — Literal(":") with surrounding ws skip. Byte-match without
    // builder push (the literal is structural punctuation; the
    // JsonStructBuilder doesn't store `:` between key and value).
    let _ = __shape_support_json::skip_space(input, p, state);
    let at = *p;
    let end = at + 1usize;
    if input.len() < end || input[at..end] != [58u8] {
        return ::core::result::Result::Err(
            crate::runtime::tape::DtaError::Syntax {
                offset: at as u32,
                failing_state: crate::runtime::tape::DtaStateId::NONE,
                failing_rule: crate::runtime::tape::DtaRuleId(u32::MAX),
            },
        );
    }
    *p = end;
    let _ = __shape_support_json::skip_space(input, p, state);

    // p2 — Ref(value). emit_ref_call_tape resolves to
    //   parse_wrap_<grammar>_value(input, p, state, builder)
    // whose StructDirect body opens a Wrap frame, dispatches to the
    // matched branch, and stamps push_branch_tag before closing.
    let _ = ({
        let _ = __shape_support_json::skip_space(input, p, state);
        parse_wrap_json_value(input, p, state, builder)
    })?;

    // Close the Flat compound. JsonStructBuilder's Pair frame
    // finalises onto the enclosing Object frame's pairs Vec; the
    // pair's (key, value) slots have been filled by the per-position
    // pushes above.
    <
        crate::runtime::JsonStructBuilder<'_> as crate::runtime::StructBuilder
    >::end_compound(builder, __pair_handle);

    ::core::result::Result::Ok(crate::runtime::tape::TapeOffset::NONE)
}
