// CSS Semantic Grammar — full during-parse value conversion.
// Numbers → f64, hex colors → u32, unit discriminants → u8.
// Uses -> per-expression mapping for inline conversions.

@ws /(?s)(?:\s|\/\*.*?\*\/)*/ ;
@token propertyName ;

// --- Numeric primitives → f64 via per-expression -> ---
number     = /[-+]?(\d+)?(\.\d+)?([eE][-+]?\d+)?/
    -> |s: ::parse_that::Span| -> f64 { ::fast_float2::parse::<f64, _>(s.as_str()).unwrap_or(0.0) } ;
integer    = /[-+]?\d+/
    -> |s: ::parse_that::Span| -> f64 { ::fast_float2::parse::<f64, _>(s.as_str()).unwrap_or(0.0) } ;
percentage = number , "%" ;

// --- Length units → u8 discriminant ---
lengthUnit = "rem" -> 2u8 | "em" -> 1u8 | "px" -> 0u8
           | "vmin" -> 5u8 | "vmax" -> 6u8 | "vh" -> 3u8 | "vw" -> 4u8
           | "ch" -> 7u8 | "ex" -> 8u8
           | "cm" -> 9u8 | "mm" -> 10u8 | "in" -> 11u8 | "pt" -> 12u8 | "pc" -> 13u8
           | "lh" -> 14u8 | "rlh" -> 15u8
           | "svw" -> 16u8 | "svh" -> 17u8 | "dvw" -> 18u8 | "dvh" -> 19u8
           | "lvw" -> 20u8 | "lvh" -> 21u8
           | "cqw" -> 22u8 | "cqh" -> 23u8 | "cqi" -> 24u8 | "cqb" -> 25u8 ;
length     = number , lengthUnit ;

// --- Angle units → u8 discriminant ---
angleUnit = "deg" -> 0u8
          | "grad" -> 2u8
          | "rad" -> 1u8
          | "turn" -> 3u8 ;
angle = number , angleUnit ;

// --- Time units → u8 discriminant ---
timeUnit = "ms" -> 0u8
         | "s" -> 1u8 ;
time  = number , timeUnit ;

// --- Dimension ---
dimension = length | angle | time | percentage ;

// --- Colors ---
hexDigits  = /[0-9a-fA-F]{3,8}/
    -> |s: ::parse_that::Span| -> u32 { crate::css_types::parse_hex_color(s.as_str()) } ;
hexColor   = "#" , hexDigits ;
namedColor = "transparent" -> 0x00000000u32
           | "currentcolor" -> 0x000000FFu32
           | "inherit" -> 0x000000FFu32
           | "initial" -> 0x000000FFu32
           | "unset" -> 0x000000FFu32 ;

colorArgs  = (number | percentage) , (("," | /\s+/) ?w , (number | percentage)) * ,
             ("/" ?w , (number | percentage)) ? ;
colorFn    = ("rgb" | "rgba" | "hsl" | "hsla" | "hwb" | "oklch" | "oklab") ,
             "(" ?w , colorArgs ?w , ")" ;

color = colorFn | hexColor | namedColor ;

// --- Functions ---
varFunction  = "var" , "(" ?w , /--[\w-]+/ , ("," ?w , /[^)]+/) ? ?w , ")" ;
calcFunction = ("calc" | "min" | "max" | "clamp") , "(" , /[^)]+/ , ")" ;
urlFunction  = "url" , "(" ?w , /[^)]+/ ?w , ")" ;
genericFunction = /[a-zA-Z][\w-]*/ , "(" , /[^)]*/ , ")" ;

// --- Identifiers and strings ---
ident     = /[a-zA-Z_][\w-]*/ ;
cssString = /"(?:[^"\\]|\\[\s\S])*"/ | /'(?:[^'\\]|\\[\s\S])*'/ ;

// --- Value ---
value = varFunction | calcFunction | urlFunction | colorFn
      | genericFunction | hexColor
      | dimension | number | cssString | namedColor | ident ;

// --- Declarations ---
propertyName = /[a-zA-Z_][\w-]*/ | /--[\w-]+/ | /-[a-zA-Z][\w-]*/ ;
declaration  = (propertyName , ":" , (value ?w) * , ("!" ?w , "important") ? , ";" ?) ?w ;

// --- Structure ---
blockContent = ((declaration | ruleItem) ?w) * ;
ruleBlock    = "{" >> blockContent ?w << "}" ;

qualifiedRule = /[^{};]+/ , ruleBlock ?w ;

atRuleBody     = ruleBlock | ";" ;
genericAtRule  = /@[a-zA-Z][\w-]*/ , /[^;{}]*/ , atRuleBody ;
atRule = genericAtRule ;

ruleItem = qualifiedRule | atRule ;
ruleList = (ruleItem ?w) * ;
stylesheet = ruleList ?w ;
