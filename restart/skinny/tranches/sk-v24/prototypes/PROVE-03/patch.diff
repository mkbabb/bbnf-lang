+#![cfg(target_arch = "aarch64")]
+
+//! Parity oracle for the PROVE-03 fused terminal-scan kernel.
+//!
+//! `first_string_terminal` (NEON: OR-fan of compares → `vshrn` nibble-mask →
+//! `trailing_zeros() >> 2`) must return the same first-terminal index as
+//! `first_string_terminal_scalar` for every 16-byte block — it is the
+//! single-pass replacement for the trusted JSON string body's old `memchr2` +
+//! separate control walk.
+
+mod checkasm_common;
+
+use bbnf_simd::aarch64::string_block::{
+    first_string_terminal, first_string_terminal_scalar, NO_TERMINAL,
+};
+use checkasm_common::{guarded_call, Xorshift64};
+
+const TERMINATOR: u8 = b'"';
+const ESCAPE: u8 = b'\\';
+const CONTROL_LIMIT: u8 = 0x20;
+
+fn neon(block: &[u8; 16]) -> u32 {
+    guarded_call(|| unsafe {
+        first_string_terminal(block.as_ptr(), TERMINATOR, ESCAPE, CONTROL_LIMIT)
+    })
+}
+
+fn scalar(block: &[u8; 16]) -> u32 {
+    first_string_terminal_scalar(block, TERMINATOR, ESCAPE, CONTROL_LIMIT)
+}
+
+#[test]
+fn plain_ascii_body_has_no_terminal() {
+    let block = *b"abcdefghijklmnop";
+    assert_eq!(neon(&block), NO_TERMINAL);
+    assert_eq!(neon(&block), scalar(&block));
+}
+
+#[test]
+fn detects_first_of_quote_escape_control() {
+    let mut block = *b"hello world!!!!!";
+    block[7] = b'\\';
+    block[11] = 0x09; // tab is a control byte in JSON string bodies
+    block[3] = b'"';
+    // First terminal is the quote at index 3.
+    assert_eq!(scalar(&block), 3);
+    assert_eq!(neon(&block), 3);
+    // Control-before-quote: inject a control byte earlier than the quote.
+    block[1] = 0x1f;
+    assert_eq!(scalar(&block), 1);
+    assert_eq!(neon(&block), 1);
+}
+
+#[test]
+fn multibyte_utf8_lead_and_continuation_are_not_terminal() {
+    // Emoji + CJK: every byte is >= 0x80, none is quote/escape/control.
+    let mut block = [b' '; 16];
+    let text = "😀水漢字".as_bytes();
+    block[..text.len()].copy_from_slice(text);
+    assert_eq!(scalar(&block), NO_TERMINAL);
+    assert_eq!(neon(&block), scalar(&block));
+}
+
+#[test]
+fn del_byte_is_not_control() {
+    // 0x7f (DEL) is >= 0x20, so it is NOT a JSON control byte.
+    let mut block = [b'a'; 16];
+    block[5] = 0x7f;
+    assert_eq!(scalar(&block), NO_TERMINAL);
+    assert_eq!(neon(&block), NO_TERMINAL);
+}
+
+#[test]
+fn fuzz_neon_matches_scalar_all_blocks() {
+    let mut rng = Xorshift64::new(0x50524f56_45303300); // "PROVE03"
+    let mut block = [0u8; 16];
+    for _ in 0..200_000 {
+        rng.fill(&mut block);
+        // Bias a fraction of lanes toward the interesting bytes so the fuzzer
+        // exercises hits at every index, not just the empty-mask fast path.
+        for lane in block.iter_mut() {
+            match *lane & 0x0f {
+                0 => *lane = b'"',
+                1 => *lane = b'\\',
+                2 => *lane &= 0x1f, // control range
+                _ => {}
+            }
+        }
+        assert_eq!(
+            neon(&block),
+            scalar(&block),
+            "NEON/scalar divergence on block {block:?}"
+        );
+    }
+}
