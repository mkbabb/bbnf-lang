// CSS Property-Aware Declaration Dispatch
// Groups CSS properties by value type for typed parsing.
// Falls back to genericDecl for unlisted properties.
//
// Design: property NAME dispatch gives us the type; value parsing is
// permissive.  Every typed declaration shares the same value list so
// multi-value shorthands, comma-separated lists, calc()/var() nesting,
// and slash-separated values all parse correctly.

@import "css-value-unit.bbnf" ;
@import "css-color.bbnf" ;
@import "css-func-body.bbnf" ;
@import "css-keywords.bbnf" ;

// --- Shared value patterns ---
ident = /[a-zA-Z_][\w-]*/ ;
propertyName = /[a-zA-Z_][\w-]*/ | /--[\w-]+/ | /-[a-zA-Z][\w-]*/ ;
dimension = length | angle | time | frequency | resolution | flex | percentage ;
importantSuffix = ("!" ?w , "important") ? ;

// --- Generic value token — matches any single CSS value token ---
// Property-specific declarations use (value ?w) * for their value lists.
// The property name dispatch gives us the type; values are parsed generously.
cssString = /"(?:[^"\\]|\\[\s\S])*"/ | /'(?:[^'\\]|\\[\s\S])*'/ ;
value = varFunction | calcFunction | urlFunction | colorFn
      | genericFunction | hex
      | dimension | number | cssString | namedColor | globalKeyword
      | "," | "/"
      | ident ;

// --- Property name groups (dispatch keys) ---

colorProps = "color" | "background-color" | "border-color"
           | "border-top-color" | "border-right-color" | "border-bottom-color" | "border-left-color"
           | "outline-color" | "text-decoration-color" | "caret-color" | "accent-color" ;

sizeProps = "width" | "height" | "min-width" | "max-width" | "min-height" | "max-height"
          | "flex-basis" | "block-size" | "inline-size"
          | "min-block-size" | "max-block-size" | "min-inline-size" | "max-inline-size" ;

spacingProps = "margin-top" | "margin-right" | "margin-bottom" | "margin-left" | "margin"
             | "padding-top" | "padding-right" | "padding-bottom" | "padding-left" | "padding"
             | "top" | "right" | "bottom" | "left" | "inset"
             | "gap" | "row-gap" | "column-gap" ;

// --- Typed declarations — all use the same permissive value list ---

colorDecl      = colorProps   , ":" , (value ?w) * , importantSuffix , ";" ? ;
sizeDecl       = sizeProps    , ":" , (value ?w) * , importantSuffix , ";" ? ;
spacingDecl    = spacingProps , ":" , (value ?w) * , importantSuffix , ";" ? ;

displayDecl    = "display"    , ":" , (value ?w) * , importantSuffix , ";" ? ;
positionDecl   = "position"   , ":" , (value ?w) * , importantSuffix , ";" ? ;
overflowDecl   = ("overflow-x" | "overflow-y" | "overflow") , ":" , (value ?w) * , importantSuffix , ";" ? ;
visibilityDecl = "visibility" , ":" , (value ?w) * , importantSuffix , ";" ? ;

flexDirDecl    = "flex-direction" , ":" , (value ?w) * , importantSuffix , ";" ? ;
flexWrapDecl   = "flex-wrap"     , ":" , (value ?w) * , importantSuffix , ";" ? ;
alignDecl      = ("justify-content" | "align-items" | "align-content" | "align-self" | "justify-items" | "justify-self")
                 , ":" , (value ?w) * , importantSuffix , ";" ? ;
flexNumDecl    = ("flex-grow" | "flex-shrink" | "order" | "z-index")
                 , ":" , (value ?w) * , importantSuffix , ";" ? ;

fontSizeDecl   = "font-size"   , ":" , (value ?w) * , importantSuffix , ";" ? ;
fontWeightDecl = "font-weight" , ":" , (value ?w) * , importantSuffix , ";" ? ;
lineHeightDecl = "line-height" , ":" , (value ?w) * , importantSuffix , ";" ? ;

borderWidthDecl  = ("border-top-width" | "border-right-width" | "border-bottom-width" | "border-left-width" | "border-width")
                   , ":" , (value ?w) * , importantSuffix , ";" ? ;
borderStyleDecl  = ("border-top-style" | "border-right-style" | "border-bottom-style" | "border-left-style" | "border-style")
                   , ":" , (value ?w) * , importantSuffix , ";" ? ;
borderRadiusDecl = ("border-top-left-radius" | "border-top-right-radius"
                   | "border-bottom-left-radius" | "border-bottom-right-radius" | "border-radius")
                   , ":" , (value ?w) * , importantSuffix , ";" ? ;

opacityDecl    = "opacity"    , ":" , (value ?w) * , importantSuffix , ";" ? ;
textAlignDecl  = "text-align" , ":" , (value ?w) * , importantSuffix , ";" ? ;
boxSizingDecl  = "box-sizing" , ":" , (value ?w) * , importantSuffix , ";" ? ;
cursorDecl     = "cursor"     , ":" , (value ?w) * , importantSuffix , ";" ? ;

// --- Generic fallback declaration (catches ALL unlisted properties) ---
genericDecl = (propertyName , ":" , (value ?w) * , importantSuffix , ";" ?) ?w ;

// --- Master declaration dispatch ---
// Property-specific rules first, generic fallback last.
// Longer property names must come before shorter prefixes.
declaration = colorDecl | sizeDecl | spacingDecl
            | displayDecl | positionDecl | overflowDecl | visibilityDecl
            | flexDirDecl | flexWrapDecl | alignDecl | flexNumDecl
            | fontSizeDecl | fontWeightDecl | lineHeightDecl
            | borderWidthDecl | borderStyleDecl | borderRadiusDecl
            | opacityDecl | textAlignDecl | boxSizingDecl | cursorDecl
            | genericDecl ;
