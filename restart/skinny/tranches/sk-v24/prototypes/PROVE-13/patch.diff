+// CSV grammar (RFC 4180).
+//
+// A quoted field is a single regex leaf so the emitter's balanced-quote scan
+// consumes it whole — honouring embedded commas / CRLF and doubled-quote (`""`)
+// escapes. An unquoted field is the maximal run of non-delimiter bytes (a
+// negated character class, possibly empty). Records are separated by a run of
+// newline bytes (CR / LF / CRLF).
 
-DQUOTE = "\"" ;
-escaped = DQUOTE >> /[^"]*/ << DQUOTE ;
-textdata = /[^,"\r\n]+/ ;
+quoted   = /"(?:[^"]|"")*"/ ;
+textdata = /[^,"\r\n]*/ ;
 
-field = escaped | textdata ;
+field = quoted | textdata ;
 
 record = field, ( "," >> field ) * ;
 
-csv = record, ( /\r?\n/ >> record ) * ;
+csv = record, ( /[\r\n]+/ >> record ) * ;
