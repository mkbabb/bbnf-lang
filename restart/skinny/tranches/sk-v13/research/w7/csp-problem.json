  "constraints": [
    "selected-active-cost-candidate",
    "parity",
    "recognizer",
    "substrate",
    "simd",
    "capacity"
  ],
  "objective": "minimize deviation from W6 active-cost selected candidate",
  "timeout_ms": 1000,
  "node_budget": 10000,
  "priority_data_role": "evidence-only",
  "priority_hard_prune_status": "not-used",
  "priority_objective_status": "not-used"
}
