+    let cb_bbnf = cb(min_bbnf);
+    let cb_core = cb(min_core);
+    let cb_csv = cb(min_csv);
+    println!("\n=== PROVE-13 CSV parse-only, N={n}, cold per-parse, min-of-N cyc/B ===");
+    println!("corpus_bytes={bytes_len} wall={secs:.1}s loadavg_start={load_start:.2} loadavg_end={load_end:.2}");
+    println!("lane        min_cyc/B    mean_cyc/B   ratio_vs_core");
+    println!("bbnf        {:>9.3}    {:>9.3}    {:.3}x", cb_bbnf, cb(sum_bbnf / n as u64), cb_bbnf / cb_core);
+    println!("csv-core    {:>9.3}    {:>9.3}    {:.3}x", cb_core, cb(sum_core / n as u64), 1.0);
+    println!("csv         {:>9.3}    {:>9.3}    {:.3}x", cb_csv, cb(sum_csv / n as u64), cb_csv / cb_core);
+    println!("\nGATE (bbnf within 2x of csv-core): {}", if cb_bbnf <= 2.0 * cb_core { "MET" } else { "UNMET" });
+    println!("bbnf vs csv-core: {:.3}x   bbnf vs csv(high-level): {:.3}x", cb_bbnf / cb_core, cb_bbnf / cb_csv);
