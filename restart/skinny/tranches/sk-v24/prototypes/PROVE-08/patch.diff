+//! Schema-from-grammar: turn a grammar's `->` projections into the honest,
+//! IR-expressible slice of a `DirectSchemaSet`, with every leaf field `type_ref`
+//! populated from Hindley–Milner inference instead of dropped as `None`.
+//!
+//! The `->` arrows are read from the *real* front-end facts
+//! (`grammar::parse_runtime_source_facts`), not re-parsed ad hoc: this is the
+//! same `RuntimeTypedProjection`/`RuntimeProjection` capture the compiler already
+//! computes and then discards. Each arrow is bound to its owning rule by source
+//! offset, unified by [`hm`], and lowered to a `DirectScalar` / `DirectBuildScalar`.
+
+use crate::direct_schema::{
+    DirectFieldSchema, DirectRootSchema, DirectScalar, DirectSchemaSet, DirectTypeKind,
+    DirectTypeRef, DirectTypeSchema, DuplicatePolicy, PresencePolicy, UnknownFieldPolicy,
+};
+use crate::type_plane::hm::{self, TyCon};
+use grammar::{parse_runtime_source_facts, RuntimeSource};
+use ir::{DirectBuildScalar, GrammarIr};
+
+#[derive(Debug)]
+pub enum DeriveError {
+    Grammar(grammar::GrammarError),
+    Unify(hm::UnifyError),
+    Validate(String),
+}
+
+/// The measured outputs of one derivation.
+pub struct DerivedTypePlane {
+    /// A validated `DirectSchemaSet` — the emitter's input, produced from grammar.
+    pub schema: DirectSchemaSet,
+    /// The per-rule leaf `type_ref`s the materialization plan drops as `None`
+    /// (`DirectBuildField.target`), here populated from the grammar `->` types.
+    pub leaf_type_refs: Vec<(String, DirectBuildScalar)>,
+    /// Inference census: arrows in, rules projected, unifications performed.
+    pub arrow_count: usize,
+    pub projected_rule_count: usize,
+    pub unify_events: usize,
+    /// Sorted `(rule, TyCon)` for reporting/diffing.
+    pub resolved: Vec<(String, TyCon)>,
+}
+
+/// Derive the type plane for `typed_source` (a grammar carrying `->` arrows).
+/// `grammar` is the structural IR of the same grammar (arrows stripped), used
+/// only to confirm the projected names are real rules.
+pub fn derive(grammar: &GrammarIr, typed_source: &str) -> Result<DerivedTypePlane, DeriveError> {
+    let facts = parse_runtime_source_facts(&[RuntimeSource::new("typed.bbnf", typed_source)])
+        .map_err(DeriveError::Grammar)?;
+
+    // Rule-definition offsets in the typed source: `<ident> =` at line start.
+    let defs = rule_defs(typed_source);
+    let owning = |offset: usize| -> Option<String> {
+        defs.iter()
+            .rev()
+            .find(|(start, _)| *start <= offset)
+            .map(|(_, name)| name.clone())
+    };
+
+    // Collect arrows as (rule, target_text, type_text) from the real facts.
+    let mut arrows: Vec<(String, String, Option<String>)> = Vec::new();
+    for p in &facts.frontend.projections {
+        if let Some(rule) = owning(p.offset) {
+            arrows.push((rule, p.target.trim().to_string(), None));
+        }
+    }
+    for p in &facts.frontend.typed_projections {
+        if let Some(rule) = owning(p.offset) {
+            arrows.push((
+                rule,
+                p.target.trim().to_string(),
+                Some(p.type_text.trim().to_string()),
+            ));
+        }
+    }
+    // Keep only arrows whose rule is a real rule in the structural grammar.
+    arrows.retain(|(rule, _, _)| grammar.rules.iter().any(|r| &r.name == rule));
+
+    let inf = hm::infer(&arrows).map_err(DeriveError::Unify)?;
+
+    let mut resolved: Vec<(String, TyCon)> = inf
+        .rule_types
+        .iter()
+        .map(|(k, v)| (k.clone(), *v))
+        .collect();
+    resolved.sort_by(|a, b| a.0.cmp(&b.0));
+
+    // Thread the resolved leaf types into the `DirectBuildScalar` slots that the
+    // materialization plan leaves as `None` — the exact wire R6 flags as dropped.
+    let leaf_type_refs: Vec<(String, DirectBuildScalar)> = resolved
+        .iter()
+        .map(|(rule, ty)| (rule.clone(), build_scalar(*ty)))
+        .collect();
+
+    // Emit the validating, grammar-derived schema slice: one struct gathering the
+    // leaf-projected rules as scalar fields, each field's `ty` bound by HM. Object
+    // maps and the recursive `value` sum are NOT emitted — the struct-only schema
+    // IR cannot express them (see REPORT §walls).
+    let prefix = pascal_case(&grammar.name);
+    let struct_id = format!("{prefix}Leaves");
+    let rust_type = format!("crate::{}::{struct_id}", grammar.name.to_lowercase());
+    let fields: Vec<DirectFieldSchema> = resolved
+        .iter()
+        .map(|(rule, ty)| DirectFieldSchema {
+            key_literal: rule.clone(),
+            rust_field: rule.clone(),
+            ty: DirectTypeRef::Scalar(schema_scalar(*ty)),
+            presence: PresencePolicy::Default,
+            duplicate: DuplicatePolicy::LastWins,
+        })
+        .collect();
+
+    let schema = DirectSchemaSet {
+        module_name: format!("generated_{}_type_plane", grammar.name.to_lowercase()),
+        schema_hash: facts.source_hash.clone(),
+        roots: vec![DirectRootSchema::struct_root(
+            format!("parse_{}", grammar.name.to_lowercase()),
+            rust_type.clone(),
+            struct_id.clone(),
+        )],
+        types: vec![DirectTypeSchema {
+            type_id: struct_id,
+            rust_type,
+            kind: DirectTypeKind::Struct {
+                fields,
+                ignored_fields: Vec::new(),
+                unknown_fields: UnknownFieldPolicy::Skip,
+            },
+        }],
+    };
+    schema.validate().map_err(DeriveError::Validate)?;
+
+    Ok(DerivedTypePlane {
+        schema,
+        leaf_type_refs,
+        arrow_count: inf.arrow_count,
+        projected_rule_count: inf.projected_rule_count,
+        unify_events: inf.unify_events,
+        resolved,
+    })
+}
+
+/// Map an HM leaf to the schema-layer scalar (`DirectScalar`).
+fn schema_scalar(ty: TyCon) -> DirectScalar {
+    match ty {
+        TyCon::Bool => DirectScalar::Bool,
+        TyCon::F64 => DirectScalar::F64,
+        TyCon::StringDecoded => DirectScalar::DecodedJsonString,
+        TyCon::StringSpan => DirectScalar::String,
+        // No U8 in the schema scalar set; the null tag is a u32-width discriminant.
+        TyCon::U8Tag => DirectScalar::U32,
+    }
+}
+
+/// Map an HM leaf to the IR build-scalar (`DirectBuildScalar`) — the `type_ref`
+/// slot the plan drops as `None`.
+fn build_scalar(ty: TyCon) -> DirectBuildScalar {
+    match ty {
+        TyCon::Bool => DirectBuildScalar::Bool,
+        TyCon::F64 => DirectBuildScalar::F64,
+        TyCon::StringDecoded | TyCon::StringSpan => DirectBuildScalar::String,
+        TyCon::U8Tag => DirectBuildScalar::Null,
+    }
+}
+
+/// Byte offsets of `<ident> =` rule definitions, in source order.
+fn rule_defs(source: &str) -> Vec<(usize, String)> {
+    let bytes = source.as_bytes();
+    let mut out = Vec::new();
+    let mut i = 0usize;
+    let mut at_line_start = true;
+    while i < bytes.len() {
+        if at_line_start {
+            // skip leading spaces/tabs
+            let mut j = i;
+            while j < bytes.len() && (bytes[j] == b' ' || bytes[j] == b'\t') {
+                j += 1;
+            }
+            let name_start = j;
+            while j < bytes.len() && (bytes[j].is_ascii_alphanumeric() || bytes[j] == b'_') {
+                j += 1;
+            }
+            if j > name_start {
+                // skip spaces then expect '='
+                let mut k = j;
+                while k < bytes.len() && (bytes[k] == b' ' || bytes[k] == b'\t') {
+                    k += 1;
+                }
+                if k < bytes.len() && bytes[k] == b'=' {
+                    out.push((name_start, source[name_start..j].to_string()));
+                }
+            }
+        }
+        at_line_start = bytes[i] == b'\n';
+        i += 1;
+    }
+    out
+}
+
+fn pascal_case(name: &str) -> String {
+    let mut out = String::new();
+    let mut upper = true;
+    for ch in name.chars() {
+        if ch == '_' || ch == '-' {
+            upper = true;
+        } else if upper {
+            out.extend(ch.to_uppercase());
+            upper = false;
+        } else {
+            out.push(ch);
+        }
+    }
+    out
+}
