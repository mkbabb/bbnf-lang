+#[test]
+fn hostclosure_channel_scale_evaluated_not_forwarded() {
+    // channel_scale(c, 0.5) = round(c * 0.5) clamped to 0..=255.
+    // Includes an over-range input to exercise the clamp branch.
+    for input in ["200", "0", "255", "600", "17"] {
+        let c: f64 = input.parse().unwrap();
+        let core = HostFold::ChannelScale.eval(c, &[0.5]) as u32;
+
+        let pt: u32 = regex("[0-9]+")
+            .map(|s: &str| {
+                let c = s.parse::<f64>().unwrap();
+                (c * 0.5).round().clamp(0.0, 255.0) as u32
+            })
+            .parse(input)
+            .expect("pt parse");
+
+        let (inner, strings) = lit(input);
+        let vm = vm_project(
+            inner,
+            vec![FnDescriptor::HostClosure { kind: HostFold::ChannelScale, coeffs: vec![0.5] }],
+            strings,
+            input,
+        );
+
+        assert!(
+            matches!(vm, Value::U32(_)),
+            "HostClosure was forwarded (got {vm:?}) — the STUB, not the fold"
+        );
+        assert_eq!(as_u32(&vm), core, "VM channel_scale != closure core for {input:?}");
+        assert_eq!(as_u32(&vm), pt, "VM channel_scale != parse-that live .map for {input:?}");
+    }
+}
