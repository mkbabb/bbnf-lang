index 000000000..739043f8f
--- /dev/null
+++ b/skinny/crates/parse-that-regex/src/number/simd.rs
@@ -0,0 +1,106 @@
+//! NEON digit-run kernels for `scan_digit_run` (aarch64 only).
+//!
+//! Re-authored from SK-V23 PROTO-PB-6. Two composed kernels over one
+//! 16-byte block: a *vshrn nibble-domain* leading-digit count, and a
+//! *Mula/Lemire* branchless right-align + pairwise fold that materializes
+//! the counted digits into a `u64` — feeding the `NumberParts` mantissa
+//! straight to Eisel-Lemire, no scalar tail, no per-count branch.
+//!
+//! The scalar 8/4/2/1 SWAR ladder in the parent module remains the
+//! parity oracle (and the non-aarch64 path); these kernels reproduce its
+//! mantissa/count exactly. See `tests/digit_simd_parity.rs`.
+
+/// `10^n` for `n ∈ 0..=16`. `10^16` is the widest a full block contributes
+/// and fits `u64` (`< 2^63`), so `mantissa * POW10[n] + block_value` never
+/// overflows while the caller keeps the running digit count `<= 19`.
+pub(super) const POW10: [u64; 17] = [
+    1,
+    10,
+    100,
+    1_000,
+    10_000,
+    100_000,
+    1_000_000,
+    10_000_000,
+    100_000_000,
+    1_000_000_000,
+    10_000_000_000,
+    100_000_000_000,
+    1_000_000_000_000,
+    10_000_000_000_000,
+    100_000_000_000_000,
+    1_000_000_000_000_000,
+    10_000_000_000_000_000,
+];
+
+/// Count the leading ASCII digits of `input[cursor..]` and materialize
+/// their integer value, over a single 16-byte NEON block.
+///
+/// Returns `(count, value)` where `count ∈ 0..=16` is the number of
+/// leading bytes in `b'0'..=b'9'` and `value` is the base-10 value of
+/// exactly those `count` digits (`0` when `count == 0`).
+///
+/// # Safety
+/// The caller must guarantee `cursor + 16 <= input.len()`.
+#[cfg(target_arch = "aarch64")]
+#[inline]
+pub(super) fn scan_block(input: &[u8], cursor: usize) -> (u32, u64) {
+    use core::arch::aarch64::*;
+
+    // `SHUF[c][j]` right-aligns the first `c` digits into the high byte
+    // lanes: output lane `j` pulls input digit `j - (16 - c)`, valid only
+    // for `j ∈ [16-c, 15]` (indices `0..=c-1`); the low lanes get an
+    // out-of-range index (`>= 16`) so `vqtbl1q_u8` zero-fills them.
+    const fn build_shuf() -> [[u8; 16]; 17] {
+        let mut table = [[0u8; 16]; 17];
+        let mut c = 0;
+        while c <= 16 {
+            let mut j = 0;
+            while j < 16 {
+                let idx = j as i32 - (16 - c as i32);
+                table[c][j] = if idx < 0 { 0xFF } else { idx as u8 };
+                j += 1;
+            }
+            c += 1;
+        }
+        table
+    }
+    const SHUF: [[u8; 16]; 17] = build_shuf();
+
+    // Per-pair / per-group base-10 weights for the pairwise fold.
+    const W8: [u8; 16] = [10, 1, 10, 1, 10, 1, 10, 1, 10, 1, 10, 1, 10, 1, 10, 1];
+    const W16: [u16; 8] = [100, 1, 100, 1, 100, 1, 100, 1];
+    const W32: [u32; 4] = [10_000, 1, 10_000, 1];
+
+    // SAFETY: caller guarantees `cursor + 16 <= input.len()`; all lanes read.
+    unsafe {
+        let chunk = vld1q_u8(input.as_ptr().add(cursor));
+
+        // ── count: vshrn nibble-domain movemask ──────────────────────────
+        // `(b - '0') > 9` (unsigned) ⇒ 0xFF non-digit lanes. `vshrn_n::<4>`
+        // narrows each u16 lane to a nibble, mapping input byte `k` to bit
+        // `4k` of the 64-bit result; the first non-digit ⇒ `tz = 4k ⇒ k`,
+        // all-digit ⇒ `nd == 0 ⇒ tz = 64 ⇒ 16`, branchless. `>> 2` is the
+        // nibble-domain de-scale (raw `tz` counts bit positions, not lanes).
+        let non_digit = vcgtq_u8(vsubq_u8(chunk, vdupq_n_u8(b'0')), vdupq_n_u8(9));
+        let nd = vget_lane_u64::<0>(vreinterpret_u64_u8(vshrn_n_u16::<4>(
+            vreinterpretq_u16_u8(non_digit),
+        )));
+        let count = nd.trailing_zeros() >> 2;
+
+        // ── accumulate: Mula/Lemire right-align + 4-stage fold ───────────
+        let adjusted = vsubq_u8(chunk, vdupq_n_u8(b'0'));
+        let is_digit = vcleq_u8(adjusted, vdupq_n_u8(9)); // 0xFF for digits
+        let digits = vandq_u8(adjusted, is_digit); // non-digit lanes → 0
+        let aligned = vqtbl1q_u8(digits, vld1q_u8(SHUF[count as usize].as_ptr()));
+
+        let t1 = vpaddlq_u8(vmulq_u8(aligned, vld1q_u8(W8.as_ptr()))); // u16 0..99
+        let t2 = vpaddlq_u16(vmulq_u16(t1, vld1q_u16(W16.as_ptr()))); // u32 0..9999
+        let t3 = vpaddlq_u32(vmulq_u32(t2, vld1q_u32(W32.as_ptr()))); // u64 0..1e8
+        let value = vgetq_lane_u64::<0>(t3)
+            .wrapping_mul(100_000_000)
+            .wrapping_add(vgetq_lane_u64::<1>(t3));
+
+        (count, value)
+    }
+}
