+//! Consumer bin = stand-in for parse-that's scan sites. It calls the kernel's
+//! `#[inline]` producer ACROSS the rlib seam. Under fat-LTO cgu=1 the question
+//! Brief 1 gate (3)/(4) asks: does the producer inline (zero in-loop `bl`/`blr`
+//! to the kernel), or does a cross-crate indirect survive?
+use core::arch::aarch64::*;
+use std::hint::black_box;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+/// PRIMARY PROBE — the cross-crate inline seam. `#[no_mangle]`/`inline(never)`
+/// only so otool can find THIS frame; it does not affect whether the kernel
+/// producer inlines INTO it.
+#[no_mangle]
+#[inline(never)]
+pub fn scan_inline_seam(buf: &[u8], needle: u8) -> u64 {
+    unsafe {
+        let n = vdupq_n_u8(needle);
+        let mut acc: u64 = 0;
+        let mut i = 0usize;
+        while i + 16 <= buf.len() {
+            let chunk = vld1q_u8(buf.as_ptr().add(i));
+            // <-- cross-crate call into kernel::classify_chunk (#[inline])
+            acc ^= kernel::classify_chunk(chunk, n);
+            i += 16;
+        }
+        acc
+    }
+}
+
+/// SECONDARY PROBE — reconciliation 2: an intentional OnceLock runtime-dispatch
+/// pointer. Does LLVM devirtualise it at cgu=1 (byte-free of the indirect), or
+/// does the `blr` survive?
+type ScanFn = unsafe fn(uint8x16_t, uint8x16_t) -> u64;
+static DISPATCH: OnceLock<ScanFn> = OnceLock::new();
+fn resolve() -> ScanFn {
+    *DISPATCH.get_or_init(|| kernel::classify_chunk as ScanFn)
+}
+
+#[no_mangle]
+#[inline(never)]
+pub fn scan_via_oncelock(buf: &[u8], needle: u8) -> u64 {
+    unsafe {
+        let f = resolve();
+        let n = vdupq_n_u8(needle);
+        let mut acc: u64 = 0;
+        let mut i = 0usize;
+        while i + 16 <= buf.len() {
+            let chunk = vld1q_u8(buf.as_ptr().add(i));
+            acc ^= f(chunk, n);
+            i += 16;
+        }
+        acc
+    }
+}
+
+/// Local double-`vaddv` scan for the paired timing counterexample only.
+#[no_mangle]
+#[inline(never)]
+pub fn scan_double_vaddv(buf: &[u8], needle: u8) -> u64 {
+    unsafe {
+        let n = vdupq_n_u8(needle);
+        let mut acc: u64 = 0;
+        let mut i = 0usize;
+        while i + 16 <= buf.len() {
+            let chunk = vld1q_u8(buf.as_ptr().add(i));
+            acc ^= kernel::movemask_double_vaddv(vceqq_u8(chunk, n));
+            i += 16;
+        }
+        acc
+    }
+}
+
+fn time_scan(f: fn(&[u8], u8) -> u64, buf: &[u8], iters: u32) -> (u64, f64) {
+    let mut acc = 0u64;
+    let t = Instant::now();
+    for _ in 0..iters {
+        acc ^= f(black_box(buf), black_box(b'{'));
+    }
+    let ns = t.elapsed().as_nanos() as f64 / iters as f64;
+    (acc, ns)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let buf = black_box(vec![b'x'; 1 << 16]);
+
+    // Keep every probed frame reachable so LTO cannot drop it before disasm.
+    let r0 = scan_inline_seam(black_box(&buf), black_box(b'{'));
+    let r1 = scan_via_oncelock(black_box(&buf), black_box(b'{'));
+    let r2 = scan_double_vaddv(black_box(&buf), black_box(b'{'));
+    black_box((r0, r1, r2));
+
+    if args.get(1).map(|s| s.as_str()) == Some("bench") {
+        // Paired cold-ish timing. Arm order alternates per window (opposite order).
+        let iters: u32 = 4000;
+        let window: u32 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1);
+        let (la, lna, lb, lnb);
+        if window % 2 == 1 {
+            let a = time_scan(scan_inline_seam, &buf, iters);
+            let b = time_scan(scan_double_vaddv, &buf, iters);
+            la = a.0; lna = a.1; lb = b.0; lnb = b.1;
+        } else {
+            let b = time_scan(scan_double_vaddv, &buf, iters);
+            let a = time_scan(scan_inline_seam, &buf, iters);
+            lb = b.0; lnb = b.1; la = a.0; lna = a.1;
+        }
+        println!(
+            "window={} LEAN_inline={:.1}ns/scan double_vaddv={:.1}ns/scan ratio_lean_over_vaddv={:.4} (guard {} {})",
+            window, lna, lnb, lna / lnb, la ^ lb, buf.len()
+        );
+    } else {
+        println!("guard {}", r0 ^ r1 ^ r2);
+    }
+}
