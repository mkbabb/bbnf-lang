diff --git a/crates/core/tests/proto2_row_shape.rs b/crates/core/tests/proto2_row_shape.rs
new file mode 100644
index 000000000..a40c35f32
--- /dev/null
+++ b/crates/core/tests/proto2_row_shape.rs
@@ -0,0 +1,133 @@
+//! LOCK-1 pass-2 probe 2 (Open R): row-inference vs hint.
+//!
+//! Question: can record-vs-list be DERIVED by inference from body
+//! structure alone — no `{`/`[` byte match, no per-grammar name gate —
+//! closing the masked fallback?
+//!
+//! Method: compile a bare JSON grammar (zero `->`) and a typed variant
+//! that adds a single `->`-declared key role on the pair's key leg. Run
+//! the engine-neutral `TypeShapeAnalysis` classifier on `object` and
+//! `array` in each. The classifier reads only IR body shape + `ir.types`;
+//! it never inspects a delimiter byte and never gates on a rule name.
+
+use bbnf::backend::driver::analysis::TypeAnalysis;
+use bbnf::pipeline::{compile_grammar, PipelineOptions};
+use bbnf_ir::passes::types::constraint::shape::{classify, derive_collection_type, ShapeClass};
+use bbnf_ir::{GrammarIR, TypeDesc};
+
+// Bare JSON structure — ZERO `->`. `value` is last so it is the entry
+// rule (entry = rules.last()), keeping object/array/pair reachable.
+const BARE: &str = r#"
+string = /"[^"]*"/ ;
+number = /-?[0-9]+/ ;
+comma = "," ?w ;
+colon = ":" ?w ;
+object = "{" >> (( pair << comma ? ) *)?w << "}" ;
+array = "[" >> (( value << comma ? ) *)?w << "]" ;
+pair = string, colon >> value ;
+value = object | array | string | number ;
+"#;
+
+// Typed variant — identical structure to BARE, plus a single
+// `->`-declared key role on the pair's key leg. The role is declared
+// rule-level (`keystr = /.../ -> key`, the canonical `regex -> Type`
+// newtype shape, mirroring `number = /.../ -> f64`) rather than inline
+// `(string -> key)`, which trips the typed-materialization invariant
+// (an arrow applied to a Ref inside a Seq finds no value_expr head).
+// The declared fact is identical: an engine-agnostic `TypeDesc::Named("key")`
+// role on the pair's leading leg. That is the ONLY delta from BARE.
+const TYPED: &str = r#"
+string = /"[^"]*"/ ;
+number = /-?[0-9]+/ ;
+comma = "," ?w ;
+colon = ":" ?w ;
+keystr = /"[^"]*"/ -> input : key ;
+object = "{" >> (( pair << comma ? ) *)?w << "}" ;
+array = "[" >> (( value << comma ? ) *)?w << "]" ;
+pair = keystr, colon >> value ;
+value = object | array | string | number ;
+"#;
+
+fn rule_id(ir: &GrammarIR, name: &str) -> u32 {
+    ir.rules
+        .iter()
+        .find(|r| ir.get_string(r.name) == name)
+        .unwrap_or_else(|| panic!("rule `{name}` not found"))
+        .id
+}
+
+fn dump(tag: &str, ir: &GrammarIR) {
+    eprintln!("── {tag} ──────────────────────────────");
+    eprintln!("rules: {}", ir.rules.len());
+    for r in &ir.rules {
+        let ty = ir
+            .types
+            .iter()
+            .find(|(id, _)| *id == r.id)
+            .map(|(_, t)| format!("{t:?}"))
+            .unwrap_or_else(|| "<none>".into());
+        eprintln!("  {:<8} : {}", ir.get_string(r.name), ty);
+    }
+    for name in ["object", "array"] {
+        let id = rule_id(ir, name);
+        eprintln!("  class({name}) = {:?}", classify(ir, id));
+    }
+}
+
+#[test]
+fn proto2_row_inference_vs_hint() {
+    let opts = PipelineOptions::default();
+
+    let bare = compile_grammar(BARE, &opts).expect("compile bare");
+    dump("BARE (zero ->)", &bare);
+    let typed = compile_grammar(TYPED, &opts).expect("compile typed");
+    dump("TYPED (+ keystr -> key)", &typed);
+
+    // ── Typed variant: structure + declared key role → Row / List ──────
+    let t_obj = rule_id(&typed, "object");
+    let t_arr = rule_id(&typed, "array");
+    let c_obj = classify(&typed, t_obj);
+    let c_arr = classify(&typed, t_arr);
+    eprintln!("TYPED: class(object)={c_obj:?} class(array)={c_arr:?}");
+    assert_eq!(c_obj, ShapeClass::Row, "typed object must derive Row");
+    assert_eq!(c_arr, ShapeClass::List, "typed array must derive List");
+
+    // ── Bare variant: no declared key role → object refuses, not guesses ─
+    let b_obj = rule_id(&bare, "object");
+    let b_arr = rule_id(&bare, "array");
+    let cb_obj = classify(&bare, b_obj);
+    let cb_arr = classify(&bare, b_arr);
+    eprintln!("BARE: class(object)={cb_obj:?} class(array)={cb_arr:?}");
+    assert_eq!(
+        cb_obj,
+        ShapeClass::Unknown,
+        "bare object must honestly refuse (no key role, no brace-guess)"
+    );
+    // array's element is a bare value even in the bare grammar — a
+    // list is unambiguous without any key role.
+    assert_eq!(cb_arr, ShapeClass::List, "bare array is an unambiguous list");
+
+    // ── The derived Row lowers through TypeAnalysis::from_ir ───────────
+    let row_ty = derive_collection_type(&typed, t_obj).expect("object derives a collection type");
+    assert!(
+        matches!(row_ty, TypeDesc::Row(_)),
+        "object lowers to TypeDesc::Row, got {row_ty:?}"
+    );
+    let mut lowered = typed.clone();
+    // Write the structurally-derived Row into the rule's type, then let
+    // the backend snapshot clone it — proving Row survives from_ir with
+    // no runtime/dispatch consultation.
+    if let Some(slot) = lowered.types.iter_mut().find(|(id, _)| *id == t_obj) {
+        slot.1 = row_ty.clone();
+    } else {
+        lowered.types.push((t_obj, row_ty.clone()));
+    }
+    let analysis = TypeAnalysis::from_ir(&lowered);
+    let carried = analysis
+        .rule_types
+        .iter()
+        .any(|(id, t)| *id == t_obj && matches!(t, TypeDesc::Row(_)));
+    assert!(carried, "TypeDesc::Row must survive TypeAnalysis::from_ir");
+
+    eprintln!("VERDICT: object=Row array=List via structure + a `->`-declared key role; bare object refuses. NO per-grammar name hint, NO brace byte.");
+}
