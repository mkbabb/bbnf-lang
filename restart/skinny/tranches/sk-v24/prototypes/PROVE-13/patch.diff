 use std::collections::BTreeSet;
 
+/// A whole-pattern character-class run: `[class]+` or `[class]*` (optionally
+/// negated). This is the leaf shape line-oriented formats (CSV `[^,"\r\n]+`,
+/// the quoted-body `[^"]*`) use; the emitter lowers it to a tight inline scan
+/// loop rather than the generic delimiter-scan `match_leaf`, which is both
+/// correct (honours the actual class) and fast (a single byte-run loop).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ClassRun {
+    pub(crate) negated: bool,
+    /// Inclusive byte ranges comprising the class (unnegated set membership).
+    pub(crate) ranges: Vec<(u8, u8)>,
+    /// Minimum matched bytes: `0` for `*`, `1` for `+`.
+    pub(crate) min: u32,
+}
+
+/// Parse `pattern` iff it is EXACTLY a single character class followed by a
+/// whole-pattern `*` or `+` quantifier (`[..]*` / `[..]+` / `[^..]+`). Returns
+/// `None` for anything else (literals, alternations, quoted spans) so the caller
+/// falls back to `match_leaf`.
+pub(crate) fn class_run(pattern: &str) -> Option<ClassRun> {
+    let trimmed = pattern.trim();
+    let (class, min) = match trimmed.as_bytes().last()? {
+        b'+' => (&trimmed[..trimmed.len() - 1], 1),
+        b'*' => (&trimmed[..trimmed.len() - 1], 0),
+        _ => return None,
+    };
+    let bytes = class.as_bytes();
+    if bytes.first().copied() != Some(b'[') {
+        return None;
+    }
+    // The class must span the entire (pre-quantifier) pattern.
+    if closing_class_index(bytes) != Some(bytes.len() - 1) {
+        return None;
+    }
+    let negated = bytes.get(1).copied() == Some(b'^');
+    let start = if negated { 2 } else { 1 };
+    let end = bytes.len() - 1;
+    let mut ranges = Vec::new();
+    let mut index = start;
+    while index < end {
+        let lo = class_byte(bytes, &mut index, end)?;
+        if index + 1 < end && bytes[index] == b'-' {
+            index += 1;
+            let hi = class_byte(bytes, &mut index, end)?;
+            if lo > hi {
+                return None;
+            }
+            ranges.push((lo, hi));
+        } else {
+            ranges.push((lo, lo));
+        }
+    }
+    if ranges.is_empty() {
+        return None;
+    }
+    Some(ClassRun {
+        negated,
+        ranges,
+        min,
+    })
+}
