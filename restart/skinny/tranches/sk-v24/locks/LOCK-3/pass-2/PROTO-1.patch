index 0133bcc64..d40772ad2 100644
--- a/skinny/crates/passes/src/lib.rs
+++ b/skinny/crates/passes/src/lib.rs
@@ -156,6 +156,42 @@ pub mod layout {
             Ok(infer.facts)
         }
 
+        /// Per-pass parity predicate: every `Project` node that carries a
+        /// declared `->` type (`Project.ty == Some(_)`) must have that
+        /// declaration threaded into `node_types`, and the threaded type must
+        /// differ from the bare body type (proving the arrow was CONSUMED, not
+        /// silently re-derived away). Returns the spans of every projection
+        /// that fails the contract; `Ok(())` iff all declared projections carry
+        /// their type. RED before the `:204` thread, GREEN after.
+        pub fn verify_project_types(
+            grammar: &GrammarIr,
+            facts: &TypeFacts,
+        ) -> Result<(), Vec<SourceSpan>> {
+            let mut offenders = Vec::new();
+            for expr in &grammar.exprs {
+                let ExprKind::Project {
+                    body,
+                    ty: Some(declared),
+                    ..
+                } = &expr.kind
+                else {
+                    continue;
+                };
+                let carries_declared =
+                    matches!(facts.node_types.get(&expr.id), Some(Type::Declared(t)) if t == declared);
+                let differs_from_body = facts.node_types.get(&expr.id)
+                    != facts.node_types.get(body);
+                if !(carries_declared && differs_from_body) {
+                    offenders.push(expr.span);
+                }
+            }
+            if offenders.is_empty() {
+                Ok(())
+            } else {
+                Err(offenders)
+            }
+        }
+
         struct Infer<'a> {
             grammar: &'a GrammarIr,
             facts: TypeFacts,
@@ -201,7 +237,17 @@ pub mod layout {
                         Type::Rule(rule_id)
                     }
                     ExprKind::Annotation { .. } => Type::Builtin(BuiltinTy::Unit),
-                    ExprKind::Project { body, .. } => self.infer_expr(*body)?,
+                    ExprKind::Project { body, ty, .. } => {
+                        // CONSUME the declared `->` type. The body is still
+                        // inferred so its own node_types entry is populated, but
+                        // the projected node's type is the author's declaration
+                        // when present — the arrow is threaded, not dropped.
+                        let body_ty = self.infer_expr(*body)?;
+                        match ty {
+                            Some(declared) => Type::Declared(declared.clone()),
+                            None => body_ty,
+                        }
+                    }
                     ExprKind::Discard { left, right, .. } => {
                         // Both operands are matched; type is Seq-like over the
                         // pair (mirrors transparent Seq lowering).
@@ -240,6 +286,10 @@ pub enum Type {
     List(Box<Type>),
     Option(Box<Type>),
     Rule(ir::RuleId),
+    /// A declared `->` projection type carried verbatim from the grammar
+    /// (`Project.ty`). This is the CONSUME seam: the projected node's type is
+    /// the author's declaration, not a re-derivation of the bare body type.
+    Declared(String),
 }
 
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
diff --git a/skinny/crates/passes/tests/verify_project_types_probe.rs b/skinny/crates/passes/tests/verify_project_types_probe.rs
