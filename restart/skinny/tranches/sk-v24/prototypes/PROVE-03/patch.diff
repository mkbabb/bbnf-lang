diff --git a/skinny/crates/parse-that-regex/tests/prove03_string_kernels.rs b/skinny/crates/parse-that-regex/tests/prove03_string_kernels.rs
new file mode 100644
index 000000000..e7cb526fd
--- /dev/null
+++ b/skinny/crates/parse-that-regex/tests/prove03_string_kernels.rs
@@ -0,0 +1,212 @@
+//! PROVE-03 correctness corpus for the fused string kernels.
+//!
+//! The trusted JSON string body now locates the first terminator / escape /
+//! control byte in a single fused NEON stride (`scan_string_terminal_block`),
+//! replacing the old `memchr2` + separate control walk. This suite is the scalar
+//! parity oracle: an independent byte-by-byte reference cross-checked against the
+//! shipping kernels over a fuzz corpus, plus explicit multibyte, surrogate-escape,
+//! and malformed cases.
+
+use parse_that_regex::{
+    match_string, match_string_at_quote_trusted_utf8, unescape_string, RegexErrorKind, StringMode,
+};
+
+/// Independent scalar reference for a trusted JSON string body: returns the raw
+/// end offset (index past the closing quote) or the byte offset of the first
+/// structural fault. Deliberately written the naive byte-at-a-time way so it
+/// shares no code with the SIMD kernels under test.
+fn ref_scan_trusted(input: &[u8], offset: usize) -> Result<usize, usize> {
+    assert_eq!(input[offset], b'"');
+    let mut cursor = offset + 1;
+    while cursor < input.len() {
+        match input[cursor] {
+            b'"' => return Ok(cursor + 1),
+            b'\\' => {
+                // Skip the escape opener plus one payload byte; `\u` payloads are
+                // additionally validated by the kernel but for terminal-position
+                // parity we only need to step over the escaped byte here.
+                cursor += 1;
+                if cursor >= input.len() {
+                    return Err(offset);
+                }
+                if input[cursor] == b'u' {
+                    cursor += 5;
+                } else {
+                    cursor += 1;
+                }
+            }
+            b if b < 0x20 => return Err(cursor),
+            _ => cursor += 1,
+        }
+    }
+    Err(offset)
+}
+
+fn quote(body: &str) -> Vec<u8> {
+    let mut v = Vec::with_capacity(body.len() + 2);
+    v.push(b'"');
+    v.extend_from_slice(body.as_bytes());
+    v.push(b'"');
+    v
+}
+
+#[test]
+fn plain_and_multibyte_bodies_match_reference() {
+    let bodies = [
+        "",
+        "a",
+        "hello world",
+        "the quick brown fox jumps over the lazy dog many times over",
+        "café résumé naïve",
+        "日本語のテキスト水漢字",
+        "emoji 😀🎉🚀 mixed with ascii and 漢字 CJK content here",
+        "a string that is definitely longer than sixteen bytes to exercise the neon stride",
+        "mix 日本 ascii 😀 more ascii tail padding padding padding padding",
+    ];
+    for body in bodies {
+        let buf = quote(body);
+        let want = ref_scan_trusted(&buf, 0).expect("well-formed");
+        let got = match_string_at_quote_trusted_utf8(&buf, 0).expect("trusted match");
+        assert_eq!(got.raw_end, want, "trusted raw_end mismatch on {body:?}");
+        assert_eq!(got.raw_end, buf.len());
+
+        // The untrusted, UTF-8-validating path must locate the same terminator.
+        let untrusted = match_string(&buf, 0, StringMode::Utf8).expect("utf8 match");
+        assert_eq!(untrusted.raw_end, want, "untrusted raw_end mismatch on {body:?}");
+    }
+}
+
+#[test]
+fn control_byte_position_matches_reference() {
+    // Inject a raw control byte at each position of a multibyte-laced body and
+    // assert the kernel flags exactly the reference offset.
+    let base = b"prefix bytes here \xf0\x9f\x98\x80 more tail bytes to force a stride";
+    for control in [0x00u8, 0x09, 0x1f] {
+        for pos in 0..base.len() {
+            let mut buf = Vec::with_capacity(base.len() + 2);
+            buf.push(b'"');
+            buf.extend_from_slice(base);
+            buf.push(b'"');
+            // Skip positions that fall inside the multibyte sequence so we keep
+            // the buffer valid UTF-8 up to the injected control byte.
+            let inject = 1 + pos;
+            if buf[inject] >= 0x80 {
+                continue;
+            }
+            buf[inject] = control;
+            let want = ref_scan_trusted(&buf, 0);
+            let got = match_string_at_quote_trusted_utf8(&buf, 0);
+            match (want, got) {
+                (Err(off), Err(err)) => {
+                    assert_eq!(err.offset, off, "control offset mismatch");
+                    assert_eq!(err.kind, RegexErrorKind::ControlCharacter);
+                }
+                (Ok(end), Ok(m)) => assert_eq!(m.raw_end, end),
+                other => panic!("reference/kernel disagreement: {other:?}"),
+            }
+        }
+    }
+}
+
+#[test]
+fn unterminated_string_is_flagged() {
+    let buf = b"\"no closing quote here just running off the end of the buffer bytes";
+    let err = match_string_at_quote_trusted_utf8(buf, 0).unwrap_err();
+    assert_eq!(err.kind, RegexErrorKind::UnterminatedString);
+}
+
+#[test]
+fn surrogate_pair_escape_decodes() {
+    // "😀" is the UTF-16 surrogate pair for U+1F600 😀.
+    let raw = "\\uD83D\\uDE00";
+    let decoded = unescape_string(raw).expect("valid surrogate pair");
+    assert_eq!(decoded, "😀");
+
+    // BMP escape.
+    assert_eq!(unescape_string("\\u00e9").expect("é"), "é");
+    // Mixed escapes and literal multibyte content.
+    assert_eq!(
+        unescape_string("tab\\tand newline\\nand 漢字 and \\uD83D\\uDE80").expect("mixed"),
+        "tab\tand newline\nand 漢字 and 🚀"
+    );
+}
+
+#[test]
+fn malformed_escapes_are_rejected() {
+    // Lone high surrogate.
+    assert_eq!(
+        unescape_string("\\uD83D").unwrap_err().kind,
+        RegexErrorKind::InvalidSurrogatePair
+    );
+    // Lone low surrogate.
+    assert_eq!(
+        unescape_string("\\uDE00").unwrap_err().kind,
+        RegexErrorKind::InvalidSurrogatePair
+    );
+    // High surrogate followed by a non-low-surrogate escape.
+    assert_eq!(
+        unescape_string("\\uD83D\\u0041").unwrap_err().kind,
+        RegexErrorKind::InvalidSurrogatePair
+    );
+    // Invalid escape letter.
+    assert_eq!(
+        unescape_string("\\x").unwrap_err().kind,
+        RegexErrorKind::InvalidEscape
+    );
+    // Non-hex in a unicode escape.
+    assert!(unescape_string("\\u00zz").is_err());
+}
+
+#[test]
+fn invalid_utf8_is_rejected_on_untrusted_path() {
+    // Raw bytes that are not valid UTF-8 must be rejected by the validating path.
+    for bad in [
+        &b"\"\xff\""[..],       // stray 0xff
+        &b"\"\xc3\x28\""[..],   // bad continuation
+        &b"\"\xe0\x80\x80\""[..], // overlong
+        &b"\"\xed\xa0\x80\""[..], // surrogate encoded as utf-8
+        &b"\"\xf0\x9f\x98\""[..], // truncated 4-byte sequence before quote
+    ] {
+        let result = match_string(bad, 0, StringMode::Utf8);
+        assert!(
+            matches!(
+                result,
+                Err(ref e) if e.kind == RegexErrorKind::InvalidUtf8
+            ),
+            "expected InvalidUtf8 for {bad:?}, got {result:?}"
+        );
+    }
+}
+
+#[test]
+fn fuzz_trusted_scan_matches_reference() {
+    // Xorshift fuzz: build random valid-UTF-8 string bodies (ascii + multibyte +
+    // escapes) and assert the fused kernel agrees with the byte-at-a-time
+    // reference on the terminal position.
+    let mut state = 0x9e3779b97f4a7c15u64;
+    let mut next = || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    let palette = [
+        "a", "b", " ", "z", "café", "水", "😀", "漢字", "\\n", "\\t", "\\\"", "\\\\",
+        "\\uD83D\\uDE00", "\\u00e9", "long ascii run of plain content here",
+    ];
+    for _ in 0..20_000 {
+        let mut body = String::new();
+        let pieces = (next() % 12) as usize;
+        for _ in 0..pieces {
+            body.push_str(palette[(next() as usize) % palette.len()]);
+        }
+        let buf = quote(&body);
+        let want = ref_scan_trusted(&buf, 0);
+        let got = match_string_at_quote_trusted_utf8(&buf, 0);
+        match (want, got) {
+            (Ok(end), Ok(m)) => assert_eq!(m.raw_end, end, "raw_end mismatch on {body:?}"),
+            (Err(_), Err(_)) => {}
+            other => panic!("reference/kernel disagreement on {body:?}: {other:?}"),
+        }
+    }
+}
