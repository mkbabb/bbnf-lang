@@ -0,0 +1,16 @@
+//! The type plane: derive a `DirectSchemaSet` from a grammar's `->` projections
+//! via Hindley–Milner unification, instead of hand-authoring the schema.
+//!
+//! Two pieces, colocated with their consumer (`direct_schema` / the typed
+//! direct-to-struct emitter):
+//!
+//! - [`hm`]: a compact HM unification core over the grammar's leaf projection
+//!   vocabulary (union-find type vars, per-rule arrow unification).
+//! - [`derive`]: reads the real front-end `->` facts, binds arrows to rules,
+//!   runs [`hm`], and threads the resolved leaf types into the schema's field
+//!   `type_ref`s — the slots the materialization plan otherwise drops as `None`.
+
+pub mod derive;
+pub mod hm;
+
+pub use derive::{derive, DeriveError, DerivedTypePlane};
