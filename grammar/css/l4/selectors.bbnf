// CSS Selectors Level 4 grammar.
// Spec: https://drafts.csswg.org/selectors-4/
//
// Uses selectorIdent for escape-aware identifier matching
// (handles Tailwind \: escapes and vendor -moz- prefixes).

@import "tokens.bbnf" ;

// --- Tokens ---
hash = /#(?:[\w\x80-\xff-]|\\[^\n])+/ ;

// --- Namespace (CSS Namespaces) ---
nsPrefix = (selectorIdent | "*") , "|" ;
wqName   = nsPrefix ? , selectorIdent ;

// --- Simple selectors ---
typeSelector  = wqName | nsPrefix ? , "*" ;
classSelector = "." , selectorIdent ;
idSelector    = hash ;

// --- Attribute selectors ---
// Attribute name with namespace disambiguation: "|" is tried as
// namespace separator (ns|attr) BEFORE falling back to bare ident,
// so "|=" in attrMatcher is never shadowed by a greedy namespace pipe.
// PEG backtracking: "ident | ident" fails on [lang|="en"] because
// the second selectorIdent rejects "=", causing fallback to bare ident,
// letting attrMatcher see "|=".
attrName     = "*|" , selectorIdent
             | selectorIdent , "|" , selectorIdent
             | "|" , selectorIdent
             | selectorIdent ;
attrMatcher  = "~=" | "|=" | "^=" | "$=" | "*=" | "=" ;
attrModifier = /[iIsS]/ ;
attrSelector = "[" ?w , attrName ?w , (attrMatcher ?w , (string | selectorIdent) ?w , attrModifier ?) ? , "]" ;

// --- An+B microsyntax ---
anPlusB = "odd" | "even" | /[-+]?\d*n\s*[+-]\s*\d+/ | /[-+]?\d*n/ | /[-+]?\d+/ ;

// --- Pseudo-classes (all start with :) ---
isPseudo    = ":is" , "(" >> selectorList << ")" ;
wherePseudo = ":where" , "(" >> selectorList << ")" ;
notPseudo   = ":not" , "(" >> selectorList << ")" ;
hasPseudo   = ":has" , "(" >> relativeSelectorList << ")" ;
nthPseudo   = ":" , ("nth-last-of-type" | "nth-last-child" | "nth-of-type" | "nth-child")
              , "(" , anPlusB , ("of" >> selectorList) ? , ")" ;
langPseudo  = ":lang" , "(" >> (selectorIdent , ("," >> selectorIdent) *) << ")" ;
dirPseudo   = ":dir" , "(" >> ("ltr" | "rtl") << ")" ;
simplePseudoClass = ":" , selectorIdent ;

pseudoClass = isPseudo | wherePseudo | notPseudo | hasPseudo
            | nthPseudo | langPseudo | dirPseudo
            | simplePseudoClass ;

// --- Pseudo-elements (all start with ::) ---
partPseudo      = "::part" , "(" >> (selectorIdent , (" " >> selectorIdent) *) << ")" ;
slottedPseudo   = "::slotted" , "(" >> compoundSelector << ")" ;
highlightPseudo = "::highlight" , "(" >> selectorIdent << ")" ;
simplePseudoElement = "::" , selectorIdent ;

pseudoElement = partPseudo | slottedPseudo | highlightPseudo | simplePseudoElement ;

// --- Colon-prefixed selector (factored for dispatch: :: before :) ---
colonSelector = pseudoElement | pseudoClass ;

// --- Compound selector (inline simple selectors for direct dispatch) ---
compoundSelector = (classSelector | idSelector | attrSelector
                   | colonSelector | typeSelector) + ;

// --- Combinators ---
combinator = /\s*>\s*/ | /\s*\+\s*/ | /\s*~\s*/ | /\s+/ ;

// --- Complex selector ---
complexSelector = compoundSelector , (combinator , compoundSelector) * ;

// --- Relative selector (for :has()) ---
relativeSelector = combinator ? , complexSelector ;
relativeSelectorList = relativeSelector , (/\s*,\s*/ >> relativeSelector) * ;

// --- Selector list ---
selectorList = complexSelector , (/\s*,\s*/ >> complexSelector) * ;
