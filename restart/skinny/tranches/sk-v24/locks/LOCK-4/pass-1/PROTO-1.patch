+//! Runtime-analyzable JSON value graph (LOCK-4 pass-1 probe).
+//!
+//! A single enum-dispatched node arena that PRODUCES `JsonValue` (the "value
+//! plane"), retiring the closure tier of `json_value()`. The graph stays
+//! inspectable at runtime — every construct is an enum variant, and value
+//! construction happens through one `Map { f: Box<dyn Fn(Span) -> V> }` node
+//! whose indirect call is exactly the cost this probe measures.
+//!
+//! `nodes[0]` is the value dispatch root; `Array`/`Object` recurse back to it
+//! by index, giving a cyclic value grammar in a flat, analyzable arena.
+
+use std::borrow::Cow;
+
+use crate::span_parser::*;
+use crate::state::{ParserState, Span};
+
+use super::json::JsonValue;
+use super::scan::{STRICT_QUOTED_STRING_CONFIG, scan_number_strict_f64};
+
+type MapFn<'a> = Box<dyn Fn(Span<'a>) -> JsonValue<'a> + 'a>;
+
+pub(crate) enum JsonNode<'a> {
+    /// The value plane: match a span leaf, transform Span -> JsonValue through
+    /// a boxed fn. This is the ONE node the probe adds atop the span core.
+    Map {
+        inner: SpanParser<'a>,
+        f: MapFn<'a>,
+    },
+    /// Number scalar via the strict f64 scanner (span -> f64 -> value).
+    Number,
+    /// `[ value (, value)* ]`; `value` indexes back into the arena.
+    Array {
+        open: SpanParser<'a>,
+        close: SpanParser<'a>,
+        comma: SpanParser<'a>,
+        value: usize,
+    },
+    /// `{ key : value (, key : value)* }`; `value` indexes back into the arena.
+    Object {
+        open: SpanParser<'a>,
+        close: SpanParser<'a>,
+        colon: SpanParser<'a>,
+        comma: SpanParser<'a>,
+        key: SpanParser<'a>,
+        value: usize,
+    },
+    /// First-byte dispatch: byte -> node index (-1 = fail).
+    Dispatch {
+        table: Box<[i16; 256]>,
+    },
+}
+
+pub struct JsonGraph<'a> {
+    nodes: Vec<JsonNode<'a>>,
+}
+
+impl<'a> JsonGraph<'a> {
+    #[inline]
+    fn call(&self, i: usize, state: &mut ParserState<'a>) -> Option<JsonValue<'a>> {
+        match &self.nodes[i] {
+            JsonNode::Map { inner, f } => inner.call(state).map(|s| f(s)),
+
+            JsonNode::Number => scan_number_strict_f64(state).map(JsonValue::Number),
+
+            JsonNode::Array {
+                open,
+                close,
+                comma,
+                value,
+            } => {
+                open.call(state)?;
+                crate::scanners::trim_leading_whitespace_mut(state);
+
+                if close.call(state).is_some() {
+                    return Some(JsonValue::Array(Box::new(Vec::new())));
+                }
+
+                let mut items = Vec::with_capacity(4);
+                loop {
+                    crate::scanners::trim_leading_whitespace_mut(state);
+                    items.push(self.call(*value, state)?);
+                    crate::scanners::trim_leading_whitespace_mut(state);
+                    if comma.call(state).is_none() {
+                        break;
+                    }
+                }
+
+                close.call(state)?;
+                Some(JsonValue::Array(Box::new(items)))
+            }
+
+            JsonNode::Object {
+                open,
+                close,
+                colon,
+                comma,
+                key,
+                value,
+            } => {
+                open.call(state)?;
+                crate::scanners::trim_leading_whitespace_mut(state);
+
+                if close.call(state).is_some() {
+                    return Some(JsonValue::Object(Box::new(Vec::new())));
+                }
+
+                let mut entries = Vec::with_capacity(4);
+                loop {
+                    crate::scanners::trim_leading_whitespace_mut(state);
+                    let k = Cow::Borrowed(key.call(state)?.as_str());
+                    colon.call(state)?;
+                    let v = self.call(*value, state)?;
+                    entries.push((k, v));
+                    crate::scanners::trim_leading_whitespace_mut(state);
+                    if comma.call(state).is_none() {
+                        break;
+                    }
+                }
+
+                close.call(state)?;
+                Some(JsonValue::Object(Box::new(entries)))
+            }
+
+            JsonNode::Dispatch { table } => {
+                let byte = *state.src_bytes.get(state.offset)?;
+                let idx = table[byte as usize];
+                if idx < 0 {
+                    return None;
+                }
+                self.call(idx as usize, state)
+            }
+        }
+    }
+
+    /// Mirror of `json_parser()`: trim leading/trailing whitespace around the
+    /// value dispatch root. No EOF gate (same as the closure `json_parser`).
+    #[inline]
+    pub fn parse(&self, src: &'a str) -> Option<JsonValue<'a>> {
+        let mut state = ParserState::new(src);
+        crate::scanners::trim_leading_whitespace_mut(&mut state);
+        let result = self.call(0, &mut state);
+        if result.is_some() {
+            crate::scanners::trim_leading_whitespace_mut(&mut state);
+        }
+        result
+    }
+}
+
+/// Build the JSON value graph. Node layout (index -> variant):
+/// 0 Dispatch · 1 Object · 2 Array · 3 String · 4 true · 5 false · 6 null · 7 Number.
+pub fn json_graph<'a>() -> JsonGraph<'a> {
+    let mut table = Box::new([-1i16; 256]);
+    table[b'{' as usize] = 1;
+    table[b'[' as usize] = 2;
+    table[b'"' as usize] = 3;
+    table[b't' as usize] = 4;
+    table[b'f' as usize] = 5;
+    table[b'n' as usize] = 6;
+    for &b in b"-0123456789" {
+        table[b as usize] = 7;
+    }
+
+    let nodes = vec![
+        JsonNode::Dispatch { table },
+        JsonNode::Object {
+            open: sp_string("{"),
+            close: sp_string("}"),
+            colon: sp_string(":").trim_whitespace(),
+            comma: sp_string(",").trim_whitespace(),
+            key: sp_quoted_string(&STRICT_QUOTED_STRING_CONFIG),
+            value: 0,
+        },
+        JsonNode::Array {
+            open: sp_string("["),
+            close: sp_string("]"),
+            comma: sp_string(",").trim_whitespace(),
+            value: 0,
+        },
+        JsonNode::Map {
+            inner: sp_quoted_string(&STRICT_QUOTED_STRING_CONFIG),
+            f: Box::new(|s: Span<'a>| JsonValue::String(Cow::Borrowed(s.as_str()))),
+        },
+        JsonNode::Map {
+            inner: sp_string("true"),
+            f: Box::new(|_| JsonValue::Bool(true)),
+        },
+        JsonNode::Map {
+            inner: sp_string("false"),
+            f: Box::new(|_| JsonValue::Bool(false)),
+        },
+        JsonNode::Map {
+            inner: sp_string("null"),
+            f: Box::new(|_| JsonValue::Null),
+        },
+        JsonNode::Number,
+    ];
+
+    JsonGraph { nodes }
+}
