+/// Build the shufti nibble LUTs for a CSS significant set (`fixed` ∪
+/// `delimiters`). `lo_lut[l]` collects a bit per high-nibble that some member
+/// shares low-nibble `l` with; `hi_lut[h]` is `1 << h`. Membership of a byte
+/// `b` is then `lo_lut[b & 0x0f] & hi_lut[b >> 4] != 0` — exact for any ASCII
+/// set (§ `css_significant_shufti_chunk`). Every CSS structural byte is `< 0x80`.
+#[inline]
+fn build_shufti_luts(fixed: &[u8; 9], delimiters: &[u8]) -> ([u8; 16], [u8; 16]) {
+    let mut lo_lut = [0u8; 16];
+    let mut hi_lut = [0u8; 16];
+    for &b in fixed.iter().chain(delimiters.iter()) {
+        debug_assert!(b < 0x80, "CSS significant bytes are ASCII");
+        let lo = (b & 0x0f) as usize;
+        let hi = (b >> 4) as usize;
+        lo_lut[lo] |= 1u8 << hi;
+        hi_lut[hi] = 1u8 << hi;
+    }
+    (lo_lut, hi_lut)
+}
