@@ -97,6 +97,33 @@ fn select_backend(alphabet: &[u8; 64]) -> SelectedBackend {
     SelectedBackend::Scalar
 }
 
+/// Cost-driven kernel shape for the prefilter, selected from member
+/// cardinality — the sibling switch to [`SelectedBackend`]. Shufti (nibble
+/// LUT) admits ≤ 8 members; truffle (wide LUT) lifts the cap to ≤ 16; beyond
+/// that the shufti/truffle bit-encoding runs out of lanes and we fall to the
+/// scalar oracle. Mirrors the legacy `KernelShape::select`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PrefilterBackend {
+    Scalar,
+    #[cfg(target_arch = "aarch64")]
+    NeonNibble,
+    #[cfg(target_arch = "aarch64")]
+    NeonWide,
+}
+
+pub fn select_prefilter_backend(members: &[u8]) -> PrefilterBackend {
+    #[cfg(target_arch = "aarch64")]
+    {
+        match members.len() {
+            1..=8 => return PrefilterBackend::NeonNibble,
+            9..=16 => return PrefilterBackend::NeonWide,
+            _ => {}
+        }
+    }
+    let _ = members;
+    PrefilterBackend::Scalar
+}
+
