--- /dev/null
+++ b/skinny/crates/bbnf-bench/src/bin/prefilter_bench.rs
@@ -0,0 +1,314 @@
+//! PROVE-01 cold paired PMU microbench for the shufti/truffle prefilter.
+//!
+//! Lanes (both real scan consumers producing the identical structural-position
+//! count — parity-asserted before timing):
+//!   * `fused`  — `PrefilterSet::find_member` (fused GATE=16 shufti/truffle).
+//!   * `scalar` — `scalar::prefilter::find_member_scalar` (the oracle).
+//!
+//! Corpora:
+//!   * skip_heavy_shufti / skip_heavy_truffle — synthetic long non-member runs.
+//!   * twitter (dense JSON) / bootstrap (dense CSS) — the ≥0.95× neutrality gate.
+//!
+//! Metric of record: PMU cyc/byte (proc_pid_rusage V5), plus cold paired
+//! per-sample wall ns/byte with a 95% CI on the per-sample ratio. loadavg is
+//! stamped per run. Speedup reported = scalar / fused (>1 ⇒ prefilter faster).
+//!
+//! Usage: `prefilter_bench [N]` (default 200). `PREFILTER_PMU_ITERS` overrides
+//! the PMU inner-loop count (default 400).
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use bbnf_simd::prim::PrefilterSet;
+use bbnf_simd::scalar::prefilter::{find_member_scalar, membership_table};
+
+// --- PMU via proc_pid_rusage V5 (mirrors css_canon_bench.rs) -----------------
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct RusageInfoV5 {
+    ri_uuid: [u8; 16],
+    ri_user_time: u64,
+    ri_system_time: u64,
+    ri_pkg_idle_wkups: u64,
+    ri_interrupt_wkups: u64,
+    ri_pageins: u64,
+    ri_wired_size: u64,
+    ri_resident_size: u64,
+    ri_phys_footprint: u64,
+    ri_proc_start_abstime: u64,
+    ri_proc_exit_abstime: u64,
+    ri_child_user_time: u64,
+    ri_child_system_time: u64,
+    ri_child_pkg_idle_wkups: u64,
+    ri_child_interrupt_wkups: u64,
+    ri_child_pageins: u64,
+    ri_child_elapsed_abstime: u64,
+    ri_diskio_bytesread: u64,
+    ri_diskio_byteswritten: u64,
+    ri_cpu_time_qos_default: u64,
+    ri_cpu_time_qos_maintenance: u64,
+    ri_cpu_time_qos_background: u64,
+    ri_cpu_time_qos_utility: u64,
+    ri_cpu_time_qos_legacy: u64,
+    ri_cpu_time_qos_user_initiated: u64,
+    ri_cpu_time_qos_user_interactive: u64,
+    ri_billed_system_time: u64,
+    ri_serviced_system_time: u64,
+    ri_logical_writes: u64,
+    ri_lifetime_max_phys_footprint: u64,
+    ri_instructions: u64,
+    ri_cycles: u64,
+    ri_billed_energy: u64,
+    ri_serviced_energy: u64,
+    ri_interval_max_phys_footprint: u64,
+    ri_runnable_time: u64,
+    ri_flags: u64,
+}
+const RUSAGE_INFO_V5: i32 = 5;
+extern "C" {
+    fn proc_pid_rusage(pid: libc::pid_t, flavor: i32, buffer: *mut u8) -> i32;
+}
+fn read_rusage_v5() -> RusageInfoV5 {
+    let mut ri = RusageInfoV5::default();
+    let rc = unsafe {
+        proc_pid_rusage(
+            libc::getpid(),
+            RUSAGE_INFO_V5,
+            (&mut ri) as *mut RusageInfoV5 as *mut u8,
+        )
+    };
+    if rc != 0 {
+        panic!("proc_pid_rusage failed rc={rc}");
+    }
+    ri
+}
+
+fn loadavg() -> String {
+    let out = std::process::Command::new("sysctl")
+        .args(["-n", "vm.loadavg"])
+        .output();
+    match out {
+        Ok(o) => String::from_utf8_lossy(&o.stdout).trim().to_string(),
+        Err(_) => "unavailable".to_string(),
+    }
+}
+
+// --- the two scan-all lanes (identical output; parity-checked) ---------------
+
+#[inline]
+fn scan_all_fused(pf: &PrefilterSet, input: &[u8]) -> u64 {
+    let mut count = 0u64;
+    let mut i = 0usize;
+    loop {
+        let p = pf.find_member(input, i);
+        if p >= input.len() {
+            break;
+        }
+        count += 1;
+        i = p + 1;
+    }
+    count
+}
+
+#[inline]
+fn scan_all_scalar(membership: &[bool; 256], input: &[u8]) -> u64 {
+    let mut count = 0u64;
+    let mut i = 0usize;
+    loop {
+        let p = find_member_scalar(input, i, membership);
+        if p >= input.len() {
+            break;
+        }
+        count += 1;
+        i = p + 1;
+    }
+    count
+}
+
+// --- corpora -----------------------------------------------------------------
+
+struct Corpus {
+    name: &'static str,
+    members: Vec<u8>,
+    bytes: Vec<u8>,
+}
+
+/// Long non-member runs with a member every `stride` bytes.
+fn skip_heavy(len: usize, stride: usize, members: &[u8]) -> Vec<u8> {
+    let mut v = vec![b'a'; len]; // 'a' is not in any structural set used here
+    let mut k = 0usize;
+    let mut idx = stride;
+    while idx < len {
+        v[idx] = members[k % members.len()];
+        k += 1;
+        idx += stride;
+    }
+    v
+}
+
+fn load_corpora() -> Vec<Corpus> {
+    let mut corpora = Vec::new();
+
+    // Skip-heavy (shufti — 7 JSON structural members).
+    corpora.push(Corpus {
+        name: "skip_heavy_shufti",
+        members: b"{}[],:\"".to_vec(),
+        bytes: skip_heavy(512 * 1024, 8192, b"{}[],:\""),
+    });
+    // Skip-heavy (truffle — 12 members, forces the wide backend).
+    let wide_members = b"{}[](),:;<>+".to_vec();
+    corpora.push(Corpus {
+        name: "skip_heavy_truffle",
+        bytes: skip_heavy(512 * 1024, 8192, &wide_members),
+        members: wide_members,
+    });
+
+    // Dense JSON — twitter (via test-fixtures).
+    match test_fixtures::load_available_bench_fixtures() {
+        Ok(fixtures) => {
+            if let Some(t) = fixtures.iter().find(|f| f.name == "twitter") {
+                corpora.push(Corpus {
+                    name: "twitter_dense",
+                    members: b"{}[],:\"".to_vec(),
+                    bytes: t.bytes.clone(),
+                });
+            } else {
+                eprintln!("prefilter_bench: twitter fixture missing; skipping dense JSON");
+            }
+        }
+        Err(e) => eprintln!("prefilter_bench: fixtures unavailable ({e:?}); skipping twitter"),
+    }
+
+    // Dense CSS — bootstrap (7 CSS structural members → shufti-capable, gated).
+    let bootstrap = concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../corpora/css-l4-sk-v14/bootstrap-5.3.3.min.css"
+    );
+    match std::fs::read(bootstrap) {
+        Ok(bytes) => corpora.push(Corpus {
+            name: "bootstrap_dense",
+            members: b"{}();:,".to_vec(),
+            bytes,
+        }),
+        Err(e) => eprintln!("prefilter_bench: bootstrap.css unavailable ({e}); skipping dense CSS"),
+    }
+
+    corpora
+}
+
+// --- stats -------------------------------------------------------------------
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let n = v.len();
+    if n == 0 {
+        return 0.0;
+    }
+    if n % 2 == 1 {
+        v[n / 2]
+    } else {
+        (v[n / 2 - 1] + v[n / 2]) / 2.0
+    }
+}
+
+/// mean ± 95% CI (normal approx, sample var n-1).
+fn mean_ci(v: &[f64]) -> (f64, f64) {
+    let n = v.len() as f64;
+    let mean = v.iter().sum::<f64>() / n;
+    let var = v.iter().map(|x| (x - mean).powi(2)).sum::<f64>() / (n - 1.0);
+    (mean, 1.96 * (var / n).sqrt())
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(200);
+    assert!(n >= 50, "cold discipline requires N >= 50");
+    let pmu_iters: usize = std::env::var("PREFILTER_PMU_ITERS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(400);
+
+    let corpora = load_corpora();
+    println!("# PROVE-01 prefilter cold paired PMU microbench");
+    println!("# N={n}  pmu_iters={pmu_iters}  loadavg={}", loadavg());
+    println!(
+        "# lanes: fused=PrefilterSet::find_member (GATE=16 shufti/truffle), scalar=find_member_scalar"
+    );
+    println!("# speedup = scalar / fused  (>1 ⇒ prefilter faster)\n");
+
+    for c in &corpora {
+        let membership = membership_table(&c.members);
+        let pf = PrefilterSet::new(&c.members);
+        let bytes = c.bytes.len();
+
+        // Parity gate before timing.
+        let a = scan_all_fused(&pf, &c.bytes);
+        let b = scan_all_scalar(&membership, &c.bytes);
+        assert_eq!(a, b, "{}: lane output mismatch (fused {a} vs scalar {b})", c.name);
+
+        // Touch the corpus once out of band (page-in).
+        black_box(c.bytes.iter().fold(0u8, |x, &y| x ^ y));
+
+        // Cold paired per-sample wall timing.
+        let mut fused_ns = Vec::with_capacity(n);
+        let mut scalar_ns = Vec::with_capacity(n);
+        let mut ratios = Vec::with_capacity(n);
+        for _ in 0..n {
+            let t0 = Instant::now();
+            black_box(scan_all_fused(&pf, &c.bytes));
+            let f = t0.elapsed().as_nanos() as f64 / bytes as f64;
+            let t1 = Instant::now();
+            black_box(scan_all_scalar(&membership, &c.bytes));
+            let s = t1.elapsed().as_nanos() as f64 / bytes as f64;
+            fused_ns.push(f);
+            scalar_ns.push(s);
+            ratios.push(s / f); // speedup
+        }
+        let (ratio_mean, ratio_ci) = mean_ci(&ratios);
+
+        // PMU cyc/byte, per lane (tight iters loop).
+        let cyc_fused = {
+            let r0 = read_rusage_v5();
+            let mut acc = 0u64;
+            for _ in 0..pmu_iters {
+                acc ^= scan_all_fused(&pf, &c.bytes);
+            }
+            black_box(acc);
+            let r1 = read_rusage_v5();
+            (r1.ri_cycles - r0.ri_cycles) as f64 / (bytes as f64 * pmu_iters as f64)
+        };
+        let cyc_scalar = {
+            let r0 = read_rusage_v5();
+            let mut acc = 0u64;
+            for _ in 0..pmu_iters {
+                acc ^= scan_all_scalar(&membership, &c.bytes);
+            }
+            black_box(acc);
+            let r1 = read_rusage_v5();
+            (r1.ri_cycles - r0.ri_cycles) as f64 / (bytes as f64 * pmu_iters as f64)
+        };
+
+        println!(
+            "{:<18} bytes={:>8} members={:>2} backend={:?} structurals={}",
+            c.name,
+            bytes,
+            c.members.len(),
+            pf.backend(),
+            a
+        );
+        println!(
+            "  wall ns/B (median):  fused={:.4}  scalar={:.4}   paired speedup={:.3}× (±{:.3}, 95% CI, N={})",
+            median(fused_ns.clone()),
+            median(scalar_ns.clone()),
+            ratio_mean,
+            ratio_ci,
+            n
+        );
+        println!(
+            "  PMU cyc/B:           fused={:.4}  scalar={:.4}   cyc speedup={:.3}×\n",
+            cyc_fused,
+            cyc_scalar,
+            cyc_scalar / cyc_fused
+        );
+    }
+}
