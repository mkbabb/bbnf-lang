+// ── (a) back-edge DFS tag ───────────────────────────────────────────────
+fn is_acyclic(dfa: &Dfa) -> bool {
+    let n = dfa.states.len();
+    let k = dfa.num_classes as usize;
+    let mut color = vec![0u8; n]; // 0 white, 1 gray, 2 black
+    // iterative DFS
+    let mut stack: Vec<(usize, usize)> = vec![(0, 0)]; // (state, next class idx)
+    color[0] = 1;
+    while let Some(&(s, ci)) = stack.last() {
+        if ci >= k {
+            color[s] = 2;
+            stack.pop();
+            continue;
+        }
+        stack.last_mut().unwrap().1 += 1;
+        let t = dfa.states[s].transitions[ci];
+        if t == DEAD {
+            continue;
+        }
+        let t = t as usize;
+        match color[t] {
+            1 => return false, // back edge → cycle
+            0 => {
+                color[t] = 1;
+                stack.push((t, 0));
+            }
+            _ => {}
+        }
+    }
+    true
+}
