+/// CSS L4 token-class kernel — shufti nibble-LUT membership.
+///
+/// The `vqtbl4q` lo6 classifier above cannot serve the CSS component scan: the
+/// significant set (`" ' ( ) / : ; [ ] { }`) straddles low-6 collisions
+/// (`;`≡`{`, `:`≡`z`, …), so a lo6 table false-positives on common ident
+/// letters. The shufti idiom (Hyperscan; Lemire "Scanning HTML at Tens of GB/s
+/// on ARM") sidesteps this: two `vqtbl1q_u8` nibble lookups AND-ed give EXACT
+/// membership over an arbitrary ASCII set with zero letter collisions.
+///
+/// LUT construction (caller data, built from the significant set `S`):
+///   `lo_lut[l] = OR over s∈S, (s & 0x0f)==l of (1 << (s >> 4))`
+///   `hi_lut[h] = 1 << h`   (for each high nibble h that occurs in S; else 0)
+/// A byte `b` is a member iff `lo_lut[b & 0x0f] & hi_lut[b >> 4] != 0`. Because
+/// `hi_lut[h]` sets exactly bit `h`, the AND is nonzero only when some `s∈S`
+/// shares both nibbles with `b` — i.e. `s == b`. Requires every `s < 0x80`
+/// (ASCII), which every CSS structural byte satisfies.
+#[inline(always)]
+pub unsafe fn css_significant_shufti_chunk(
+    ptr: *const u8,
+    lo_lut: uint8x16_t,
+    hi_lut: uint8x16_t,
+) -> u16 {
+    let chunk = unsafe { vld1q_u8(ptr) };
+    let lo = unsafe { vandq_u8(chunk, vdupq_n_u8(0x0f)) };
+    let hi = unsafe { vshrq_n_u8::<4>(chunk) };
+    let lo_class = unsafe { vqtbl1q_u8(lo_lut, lo) };
+    let hi_class = unsafe { vqtbl1q_u8(hi_lut, hi) };
+    let member = unsafe { vandq_u8(lo_class, hi_class) };
+    // 0xFF lanes where member != 0 (significant), 0x00 elsewhere.
+    let significant = unsafe { vtstq_u8(member, member) };
+    unsafe { movemask_u8x16(significant) }
+}
+
+/// 64-byte CSS significant-byte mask: bit `i` set iff `src[i]` is a member of
+/// the significant set encoded in `lo_lut`/`hi_lut`. Four 16-byte stripes packed
+/// via the project-wide `movemask_u8x16` convention.
+#[inline(always)]
+pub unsafe fn css_significant_shufti_block_64(
+    ptr: *const u8,
+    lo_lut: uint8x16_t,
+    hi_lut: uint8x16_t,
+) -> u64 {
+    let mut mask = 0u64;
+    for lane in 0..4 {
+        let stripe = unsafe { css_significant_shufti_chunk(ptr.add(lane * 16), lo_lut, hi_lut) };
+        mask |= u64::from(stripe) << (lane * 16);
+    }
+    mask
+}
+
