+//! Shared kernel entry for the 6C R-A NEON-crossing probe.
+//!
+//! One JSON structural alphabet, consumed by both the native
+//! (aarch64 NEON) binary and the wasm32 (SIMD128) cdylib. The wasm
+//! exports below let a JS driver copy a corpus into linear memory
+//! once, then time `scan_structural` node-for-node identically to the
+//! native path.
+
+use simd_scan::alphabet::StructuralAlphabet;
+use simd_scan::scan_structural;
+
+/// JSON structural alphabet: 6 singletons + 1 quote class, 0 digraphs.
+/// Identical to `benches/stage1_throughput.rs::JSON_ALPHABET`.
+pub const JSON: StructuralAlphabet =
+    StructuralAlphabet::from_parts(&[b'{', b'}', b'[', b']', b':', b','], &[], &[b'"']);
+
+/// Scan `input` under the JSON alphabet, returning the structural
+/// index length (returned to defeat dead-code elimination on the
+/// driver side). This is the single measured hot path.
+#[inline]
+pub fn scan_len(input: &[u8]) -> u32 {
+    let idx = scan_structural(input, &JSON);
+    idx.len() as u32
+}
+
+// ---- wasm FFI surface ----------------------------------------------------
+
+#[cfg(target_arch = "wasm32")]
+mod wasm_ffi {
+    use super::scan_len;
+
+    /// Allocate `len` bytes in linear memory and return the pointer.
+    /// The driver writes the corpus here, then passes the same
+    /// `(ptr, len)` to `scan_json`. The buffer is leaked (called once
+    /// per process), so the pointer stays valid for the run.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn walloc(len: usize) -> *mut u8 {
+        let mut v = vec![0u8; len];
+        let p = v.as_mut_ptr();
+        core::mem::forget(v);
+        p
+    }
+
+    /// Scan the buffer at `(ptr, len)` and return the structural
+    /// index length.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn scan_json(ptr: *const u8, len: usize) -> u32 {
+        let input = unsafe { core::slice::from_raw_parts(ptr, len) };
+        scan_len(input)
+    }
+}
