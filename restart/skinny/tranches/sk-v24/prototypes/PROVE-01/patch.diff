diff --git a/skinny/crates/bbnf-simd/src/aarch64/prefilter.rs b/skinny/crates/bbnf-simd/src/aarch64/prefilter.rs
new file mode 100644
index 000000000..f51c80322
--- /dev/null
+++ b/skinny/crates/bbnf-simd/src/aarch64/prefilter.rs
@@ -0,0 +1,126 @@
+//! NEON shufti (nibble) + truffle (wide) prefilter classify kernels.
+//!
+//! Ported from the legacy `crates/simd-scan/src/neon.rs`
+//! (`classify_chunk_nibble` / `classify_chunk_wide`). A 64-byte block is
+//! classified as four `uint8x16_t` stripes; per stripe two `vqtbl1q_u8`
+//! nibble lookups AND'd (shufti) — or four lookups OR'd across a paired
+//! table (truffle) — produce a per-byte match vector, packed to a 64-bit
+//! mask via the in-tree `movemask::movemask_u8x16` (`vshrn_n_u16 #4`).
+//!
+//! The scalar parity anchor is `scalar::prefilter::classify_block_scalar`;
+//! the LUTs are built by `scalar::prefilter::{NibbleLut,WideLut}::from_members`.
+//!
+//! SAFETY (all fns): the caller guarantees `ptr..ptr+64` is in bounds.
+
+use core::arch::aarch64::*;
+
+use super::movemask::movemask_u8x16;
+use crate::scalar::prefilter::{NibbleLut, WideLut};
+
+/// One 16-byte stripe → shufti match vector (`0xFF` where member).
+#[inline(always)]
+unsafe fn match_stripe_nibble(
+    ptr: *const u8,
+    lo_v: uint8x16_t,
+    hi_v: uint8x16_t,
+    lo_mask: uint8x16_t,
+) -> uint8x16_t {
+    let chunk = vld1q_u8(ptr);
+    let lo_n = vandq_u8(chunk, lo_mask);
+    let hi_n = vshrq_n_u8(chunk, 4);
+    let lo_r = vqtbl1q_u8(lo_v, lo_n);
+    let hi_r = vqtbl1q_u8(hi_v, hi_n);
+    let matched = vandq_u8(lo_r, hi_r);
+    vtstq_u8(matched, matched)
+}
+
+/// One 16-byte stripe → truffle match vector (`0xFF` where member).
+#[inline(always)]
+unsafe fn match_stripe_wide(
+    ptr: *const u8,
+    lo_lo: uint8x16_t,
+    hi_lo: uint8x16_t,
+    lo_hi: uint8x16_t,
+    hi_hi: uint8x16_t,
+    lo_mask: uint8x16_t,
+) -> uint8x16_t {
+    let chunk = vld1q_u8(ptr);
+    let lo_n = vandq_u8(chunk, lo_mask);
+    let hi_n = vshrq_n_u8(chunk, 4);
+    let matched_lo = vandq_u8(vqtbl1q_u8(lo_lo, lo_n), vqtbl1q_u8(hi_lo, hi_n));
+    let matched_hi = vandq_u8(vqtbl1q_u8(lo_hi, lo_n), vqtbl1q_u8(hi_hi, hi_n));
+    let matched = vorrq_u8(matched_lo, matched_hi);
+    vtstq_u8(matched, matched)
+}
+
+/// Cheap reject: does the 64-byte block at `ptr` contain ANY member? The four
+/// stripe match-vectors are OR-reduced and tested with a single `vmaxvq_u8` —
+/// no movemask on the all-miss skip path (the prefilter's hot loop; a full
+/// classify runs only on the block that carries a hit, to locate the byte).
+/// SAFETY: `ptr..ptr+64` in bounds.
+#[inline(always)]
+pub unsafe fn any_member_64_nibble(ptr: *const u8, lut: &NibbleLut) -> bool {
+    let lo_v = vld1q_u8(lut.lo.as_ptr());
+    let hi_v = vld1q_u8(lut.hi.as_ptr());
+    let lo_mask = vdupq_n_u8(0x0F);
+    let mut acc = match_stripe_nibble(ptr, lo_v, hi_v, lo_mask);
+    for k in 1..4 {
+        acc = vorrq_u8(acc, match_stripe_nibble(ptr.add(k * 16), lo_v, hi_v, lo_mask));
+    }
+    vmaxvq_u8(acc) != 0
+}
+
+/// Cheap 64-byte reject, truffle (wide) table. SAFETY: `ptr..ptr+64`.
+#[inline(always)]
+pub unsafe fn any_member_64_wide(ptr: *const u8, lut: &WideLut) -> bool {
+    let lo_lo = vld1q_u8(lut.lo_lo.as_ptr());
+    let hi_lo = vld1q_u8(lut.hi_lo.as_ptr());
+    let lo_hi = vld1q_u8(lut.lo_hi.as_ptr());
+    let hi_hi = vld1q_u8(lut.hi_hi.as_ptr());
+    let lo_mask = vdupq_n_u8(0x0F);
+    let mut acc = match_stripe_wide(ptr, lo_lo, hi_lo, lo_hi, hi_hi, lo_mask);
+    for k in 1..4 {
+        acc = vorrq_u8(
+            acc,
+            match_stripe_wide(ptr.add(k * 16), lo_lo, hi_lo, lo_hi, hi_hi, lo_mask),
+        );
+    }
+    vmaxvq_u8(acc) != 0
+}
+
+/// Classify 64 bytes at `ptr` via the shufti (nibble) table → 64-bit mask.
+#[inline(always)]
+pub unsafe fn classify_block_nibble(ptr: *const u8, lut: &NibbleLut) -> u64 {
+    let lo_v = vld1q_u8(lut.lo.as_ptr());
+    let hi_v = vld1q_u8(lut.hi.as_ptr());
+    let lo_mask = vdupq_n_u8(0x0F);
+    let mut mask = 0u64;
+    for k in 0..4 {
+        let m = movemask_u8x16(match_stripe_nibble(ptr.add(k * 16), lo_v, hi_v, lo_mask)) as u64;
+        mask |= m << (k * 16);
+    }
+    mask
+}
+
+/// Classify 64 bytes at `ptr` via the truffle (wide) table → 64-bit mask.
+#[inline(always)]
+pub unsafe fn classify_block_wide(ptr: *const u8, lut: &WideLut) -> u64 {
+    let lo_lo = vld1q_u8(lut.lo_lo.as_ptr());
+    let hi_lo = vld1q_u8(lut.hi_lo.as_ptr());
+    let lo_hi = vld1q_u8(lut.lo_hi.as_ptr());
+    let hi_hi = vld1q_u8(lut.hi_hi.as_ptr());
+    let lo_mask = vdupq_n_u8(0x0F);
+    let mut mask = 0u64;
+    for k in 0..4 {
+        let m = movemask_u8x16(match_stripe_wide(
+            ptr.add(k * 16),
+            lo_lo,
+            hi_lo,
+            lo_hi,
+            hi_hi,
+            lo_mask,
+        )) as u64;
+        mask |= m << (k * 16);
+    }
+    mask
+}
diff --git a/skinny/crates/bbnf-simd/src/dispatch.rs b/skinny/crates/bbnf-simd/src/dispatch.rs
index 0aae829cf..f51056416 100644
