+// ── Clause 3: the NON-STUB HostClosure — EVALUATED, not forwarded ───────────
+
+#[test]
+fn hostclosure_lerp_evaluated_not_forwarded() {
+    // lerp(0, 255, t) — the closure core, run three ways and cross-checked.
+    for input in ["0.5", "0", "1", "0.25", "0.8"] {
+        let t: f64 = input.parse().unwrap();
+
+        // (core) the closure body as a bare fn — ground truth.
+        let core = HostFold::Lerp.eval(t, &[0.0, 255.0]);
+
+        // (b) parse-that LIVE .map running the identical arithmetic.
+        let pt: f64 = regex("[0-9.]+")
+            .map(|s: &str| {
+                let t = s.parse::<f64>().unwrap();
+                0.0 + (255.0 - 0.0) * t // lerp(0, 255, t)
+            })
+            .parse(input)
+            .expect("pt parse");
+
+        // (a) VM Op::ApplyFn EVALUATING the HostClosure descriptor.
+        let (inner, strings) = lit(input);
+        let vm = vm_project(
+            inner,
+            vec![FnDescriptor::HostClosure { kind: HostFold::Lerp, coeffs: vec![0.0, 255.0] }],
+            strings,
+            input,
+        );
+
+        // Discriminating assertion: a forwarded stub would leave a `Span`,
+        // never an `F64`. The VM MUST have evaluated.
+        assert!(
+            matches!(vm, Value::F64(_)),
+            "HostClosure was forwarded (got {vm:?}) — the STUB, not the fold"
+        );
+        assert_eq!(as_f64(&vm), core, "VM lerp != closure core for {input:?}");
+        assert_eq!(as_f64(&vm), pt, "VM lerp != parse-that live .map for {input:?}");
+    }
+}
