@@ -55,4 +55,54 @@ pub enum FnDescriptor {
         expr: MapExpr,
         return_type: Option<TypeDesc>,
     },
+
+    /// A host-side numeric-fold closure, evaluated **inside** the VM rather
+    /// than forwarded. The descriptor carries the fold kind plus the constant
+    /// operands baked into the closure body, so `Op::ApplyFn` computes the
+    /// exact value the equivalent Rust `.map(|t| …)` closure would — the
+    /// closure crosses the language boundary as *data*, not as an opaque body.
+    ///
+    /// This is the concrete, evaluable form of what LOCK-7 generalizes to
+    /// arbitrary host bodies: for the closed set of folds enumerated by
+    /// [`HostFold`] the VM needs no host round-trip at all.
+    HostClosure {
+        /// Which numeric fold this closure computes.
+        kind: HostFold,
+        /// Constant operands baked into the closure (endpoints / scale).
+        coeffs: Vec<f64>,
+    },
+}
+
+/// The closed set of host numeric folds the VM can evaluate directly.
+///
+/// Each maps to a single Rust closure whose free constants live in
+/// `HostClosure::coeffs`; the input value (`t`/`c`) is the parsed child.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Copy)]
+pub enum HostFold {
+    /// `lerp(a, b, t) = a + (b - a) * t` — `coeffs = [a, b]`, `t` = input. → f64.
+    Lerp,
+    /// `channel_scale(c, s) = round(c * s) clamped to 0..=255` —
+    /// `coeffs = [s]`, `c` = input. → u32 (a color channel).
+    ChannelScale,
+}
+
+impl HostFold {
+    /// Evaluate the fold against the parsed input `x` and the baked `coeffs`.
+    /// Returns the raw `f64` payload for [`HostFold::Lerp`] and the integral
+    /// channel value (still `f64`) for [`HostFold::ChannelScale`], letting the
+    /// caller pick the `Value` arm. This *is* the closure core — the exact
+    /// same arithmetic a hand-written `.map(|t| …)` closure runs.
+    pub fn eval(self, x: f64, coeffs: &[f64]) -> f64 {
+        match self {
+            HostFold::Lerp => {
+                let a = coeffs.first().copied().unwrap_or(0.0);
+                let b = coeffs.get(1).copied().unwrap_or(0.0);
+                a + (b - a) * x
+            }
+            HostFold::ChannelScale => {
+                let s = coeffs.first().copied().unwrap_or(1.0);
+                (x * s).round().clamp(0.0, 255.0)
+            }
+        }
+    }
 }
