 "gates": {
  "quantity": "r = ln(t_contestant / t_opponent), wall time per input byte, per ABBA pair of fresh processes (PREREG §1)",
  "estimator": "Hodges-Lehmann of r",
  "interval": {
   "method": "BCa bootstrap",
   "resamples": 10000,
   "level_claim": 0.99,
   "level_reported": [
    0.99,
    0.95
   ]
  },
  "test": "one-sided Wilcoxon signed-rank",
  "multiplicity": {
   "method": "Holm-Bonferroni within each family",
   "fwer": 0.01
  },
  "minimum_effect": {
   "pct": 3.0,
   "delta": "ln(0.97)"
  },
  "verdicts": {
   "WIN": "Holm-adjusted p < 0.01 and CI upper bound < delta",
   "LOSS": "mirror of WIN",
   "TIE": "whole CI inside (delta, -delta)",
   "UNDECIDED": "anything else; never rounded to a win"
  },
  "a12": "PREREG's 3 % margins (COMP-1 WIN, G-S1 at 1.03) stand; a 95 % interval straddling a margin is UNDECIDED and is never re-tested under a wider margin; floors govern goal claims only",
  "g_s1": "non-inferiority on every §8.1 cell: one-sided 99 % BCa upper bound of exp(HL r) < 1.03 (IUT, no multiplicity adjustment); superiority only under Holm FWER 0.01 over the 14 cells",
  "checksum_discard": "a pair whose output checksums differ is discarded; > 1 % discarded makes the cell NOT-COMPARABLE",
  "certification": {
   "pairs_min": 200,
   "invocations_min": 30,
   "records": "QUIET only; a NOISY record never certifies"
  },
  "exploratory": {
   "reps_min_per_side": 10,
   "report": [
    "median",
    "IQR",
    "MAD"
   ]
  },
  "aa_floor_rule": "floor = max(10 %, 3 x A/A noise); A/A noise = larger magnitude of the A/A cell's 99 % BCa interval ends for exp(HL r) - 1 (bench/cb-b0/decide.py aa_noise_pct, proposed_floor_pct)",
  "slow_injection_pct": 15,
  "quiet": {
   "load1_below": 8,
   "thermal": "no warning (pmset -g therm)",
   "lock": "guarded --exclusive bench --cpu-cores 0",
   "qos": "LW2-ORDER §5 reading: QoS is a disclosed host condition; a pair whose arms ran under different QoS accounting is discarded. PREREG §3's fourth QUIET bullet (user-interactive QoS on >= 95 %) is not met on this host (LW1.CON-1); the QoS ruling of record decides between the two, and the G-G2 floor's contingency fixes the effect of either answer."
