// Tranche N regression fixture: a small grammar that exercises
// every codegen path that depended on dependency-graph iteration
// order. The 8 rules form a multi-SCC dependency graph (expr is
// recursive through term and factor; literal/number/identifier
// are independent leaves), so any non-deterministic SCC discovery
// order would surface as a different rule order in the lowered
// IR.

literal = "true" | "false" | "null" ;
identifier = /[a-zA-Z_][a-zA-Z0-9_]*/ ;
number = /[0-9]+/ ;

factor = literal | identifier | number | "(" >> expr << ")" ;
power = factor , ( "^" , factor )* ;
term = power , ( ("*" | "/") , power )* ;
expr = term , ( ("+" | "-") , term )* ;

program = expr ;
