+//! LOCK-2 pass-2 PROVE-2-WIDEN-CONFLUENT probe.
+//!
+//! The master gate the whole graph-engine lock hangs on: does a
+//! *registered* widening rewrite (`ManufactureDispatchAlt`), fired
+//! through `CspScheduler` alongside the shipping all-narrowing rule
+//! set, manufacture ≥2 semantically-distinct survivors at a
+//! child-bearing node, stay confluent (the narrowing set does not
+//! collapse the twin), terminate, and let cost-guided extraction pick
+//! differently under two weight vectors?
+//!
+//! Built on a JSON-`value`-shaped alternation — six sentinel-prefixed
+//! branches `Seq([Literal(b), Ref(rule)])` with pairwise-disjoint FIRST
+//! bytes `{ [ " t f n`, exactly the dispatch scenario a real fleet
+//! grammar presents.
+
+use bbnf_ir::egraph::node::GrammarENode;
+use bbnf_ir::egraph::rules::{
+    CommonSuffixFactor, DeduplicateAltBranches, FuseAltRegexBranches, ManufactureDispatchAlt,
+    SupersetAbsorbAlt, UnionMergeAlt,
+};
+use bbnf_ir::egraph::{GrammarCostModel, SharedStrings};
+use bbnf_ir::GrammarIR;
+use egraph::{
+    CostWeights, CspScheduler, EGraph, Extractor, Id, NoAnalysis, RewriteFn, Scheduler,
+    CALIBRATED_WEIGHTS,
+};
+
+/// Build the JSON-`value` alternation and return `(egraph, pool, root)`.
+fn build_value_alt() -> (EGraph<GrammarENode, NoAnalysis>, SharedStrings, Id) {
+    let pool = SharedStrings::from_ir(&GrammarIR::default());
+    let mut eg: EGraph<GrammarENode, NoAnalysis> = EGraph::new();
+
+    // Six sentinel bytes with pairwise-disjoint FIRST sets.
+    let sentinels = ["{", "[", "\"", "t", "f", "n"];
+    let mut branches: Vec<Id> = Vec::new();
+    for (i, s) in sentinels.iter().enumerate() {
+        let sid = pool.intern(s);
+        let lit = eg.add(GrammarENode::Literal(sid));
+        // Distinct downstream rule per branch (object/array/string/…).
+        let rest = eg.add(GrammarENode::Ref(i as u32 + 1));
+        let seq = eg.add(GrammarENode::Seq(Box::new([lit, rest])));
+        branches.push(seq);
+    }
+    let root = eg.add(GrammarENode::Alt(branches.into_boxed_slice(), None));
+    eg.rebuild();
+    (eg, pool, root)
+}
+
+/// The shipping all-narrowing set plus the widening rule under test.
+/// Ownership is held by the caller; the returned trait-object refs
+/// borrow from the boxes.
+fn rule_boxes(pool: &SharedStrings) -> Vec<Box<dyn RewriteFn<GrammarENode, NoAnalysis>>> {
+    vec![
+        Box::new(DeduplicateAltBranches),
+        Box::new(SupersetAbsorbAlt::new(pool.clone())),
+        Box::new(UnionMergeAlt::new(pool.clone())),
+        Box::new(FuseAltRegexBranches::new(pool.clone())),
+        Box::new(CommonSuffixFactor),
+        // The widening dual — registered LAST so the narrowing set gets
+        // first crack at collapsing anything it can each iteration.
+        Box::new(ManufactureDispatchAlt::new(pool.clone())),
+    ]
+}
+
+/// Count the distinct `Alt` e-nodes carried by `root`'s class, split by
+/// dispatch presence.
+fn alt_forms(eg: &EGraph<GrammarENode, NoAnalysis>, root: Id) -> (usize, usize) {
+    let canon = eg.find_ref(root);
+    let mut none_forms = 0;
+    let mut some_forms = 0;
+    for n in eg.class(canon).iter() {
+        if let GrammarENode::Alt(_, dispatch) = n {
+            if dispatch.is_some() {
+                some_forms += 1;
+            } else {
+                none_forms += 1;
+            }
+        }
+    }
+    (none_forms, some_forms)
+}
+
+/// (a) ≥2 distinct survivors, (b) confluence, (c) termination — one run.
+#[test]
+fn widen_confluent_manufactures_confluent_terminating_twin() {
+    let (mut eg, pool, root) = build_value_alt();
+
+    let boxes = rule_boxes(&pool);
+    let rules: Vec<&dyn RewriteFn<GrammarENode, NoAnalysis>> =
+        boxes.iter().map(|b| b.as_ref()).collect();
+
+    let scheduler = CspScheduler::default();
+    let report = scheduler.run(&mut eg, &rules);
+
+    eprintln!(
+        "[PROBE] saturated={} iters={}/{} final_nodes={}/{} final_classes={} total_applied={}",
+        report.saturated,
+        report.iterations,
+        scheduler.iter_limit,
+        report.final_nodes,
+        scheduler.node_limit,
+        report.final_classes,
+        report.total_applied,
+    );
+    eprintln!("[PROBE] per_rule = {:?}", report.per_rule);
+
+    // ── (c) termination — fixpoint with margin ─────────────────────
+    assert!(
+        report.saturated,
+        "widening rule must saturate, not hit a limit: {report:?}"
+    );
+    assert!(
+        !report.iter_limit_hit && !report.growth_limit_hit,
+        "must terminate under both limits with margin: {report:?}"
+    );
+    assert!(
+        report.iterations + 2 <= scheduler.iter_limit,
+        "iteration margin too thin: {} of {}",
+        report.iterations,
+        scheduler.iter_limit
+    );
+    assert!(
+        report.final_nodes * 2 < scheduler.node_limit,
+        "node margin too thin: {} of {}",
+        report.final_nodes,
+        scheduler.node_limit
+    );
+
+    // ── (a) ≥2 semantically-distinct survivors at a child-bearing node ─
+    let (none_forms, some_forms) = alt_forms(&eg, root);
+    assert_eq!(
+        none_forms, 1,
+        "the original sequential-trial Alt must survive"
+    );
+    assert_eq!(
+        some_forms, 1,
+        "the manufactured dispatch-table Alt must survive"
+    );
+    assert!(
+        none_forms + some_forms >= 2,
+        "child-bearing Alt class must hold ≥2 distinct forms"
+    );
+
+    // The widening rule reported real work through the scheduler
+    // (it was fired, not hand-unioned).
+    let widen_work = report
+        .per_rule
+        .iter()
+        .find(|(name, _)| name == "manufacture-dispatch-alt")
+        .map(|(_, w)| *w)
+        .unwrap_or(0);
+    assert!(
+        widen_work > 0,
+        "ManufactureDispatchAlt must have done work via CspScheduler: {:?}",
+        report.per_rule
+    );
+
+    // ── (b) confluence — the narrowing set did NOT delete the twin ──
+    // DeduplicateAltBranches is in the set and ran every iteration; the
+    // dispatch-carrying Alt is still present. Prove the branch set was
+    // untouched (dedup keys on branches, not dispatch presence).
+    let canon = eg.find_ref(root);
+    let some_branch_len = eg.class(canon).iter().find_map(|n| match n {
+        GrammarENode::Alt(cs, Some(_)) => Some(cs.len()),
+        _ => None,
+    });
+    assert_eq!(
+        some_branch_len,
+        Some(6),
+        "confluence: dedup must not have collapsed the 6-branch dispatch twin"
+    );
+}
+
+/// Build a `GrammarCostModel` with the given shared weights.
+fn cost_model(weights: CostWeights) -> GrammarCostModel {
+    let mut cm = GrammarCostModel::default();
+    cm.weights = weights;
+    cm
+}
+
+/// Extraction discrimination: W1 (calibrated) vs every non-sign-flip
+/// calibrated variant vs the forbidden sign-flip.
+#[test]
+fn widen_confluent_extraction_discriminates_only_on_dispatch_bonus_sign() {
+    let (mut eg, pool, root) = build_value_alt();
+    let boxes = rule_boxes(&pool);
+    let rules: Vec<&dyn RewriteFn<GrammarENode, NoAnalysis>> =
+        boxes.iter().map(|b| b.as_ref()).collect();
+    CspScheduler::default().run(&mut eg, &rules);
+
+    // Pick the extracted root form under a full grammar cost model.
+    let picks_dispatch = |cm: GrammarCostModel| -> bool {
+        let ext = Extractor::new(&eg, &cm);
+        let root_cost = ext.best_cost(root);
+        let picked_some =
+            matches!(ext.best_node(root), Some(GrammarENode::Alt(_, Some(_))));
+        eprintln!(
+            "[PROBE-EXTRACT] dispatch_bonus={:+.1} alt_per_branch={} -> picked={} best_cost={:?}",
+            cm.weights.dispatch_bonus,
+            cm.weights.alt_per_branch,
+            if picked_some { "DISPATCH" } else { "SEQUENTIAL" },
+            root_cost,
+        );
+        picked_some
+    };
+
+    // W1 — the project's shipping calibrated vector. dispatch_bonus =
+    // -2.0 rewards the dispatch form.
+    assert!(
+        picks_dispatch(cost_model(CALIBRATED_WEIGHTS)),
+        "W1 (CALIBRATED_WEIGHTS) must extract the dispatch-table form"
+    );
+
+    // W2-family — vary EVERY other knob hard (shared weights AND the
+    // grammar-specific ref_cost / seq_per_child), but keep the
+    // dispatch_bonus sign fixed. None of these flips the pick: the
+    // dispatch bonus is the model's ONLY lever that distinguishes the
+    // two Alt forms (both share children, branch count, alt penalty).
+    let mut w2 = CALIBRATED_WEIGHTS;
+    w2.alt_per_branch = 8.0;
+    w2.structural = 5.0;
+    w2.dispatch_table = 100.0; // GrammarCostModel::cost ignores this for Alt
+    w2.dispatch_branch = 50.0; // …and this too
+    let mut cm2 = cost_model(w2);
+    cm2.ref_cost = 25.0;
+    cm2.seq_per_child = 12.0;
+    cm2.literal_cost = 30.0;
+    assert!(
+        picks_dispatch(cm2),
+        "W2 (all non-bonus knobs maxed, bonus sign kept) must STILL pick dispatch"
+    );
+
+    // The ONLY way to flip the pick is to cross dispatch_bonus through
+    // zero — the synthetic sign-flip the brief forbids as evidence.
+    let mut w_flip = CALIBRATED_WEIGHTS;
+    w_flip.dispatch_bonus = 2.0;
+    assert!(
+        !picks_dispatch(cost_model(w_flip)),
+        "sign-flipped bonus (+2.0) picks sequential — the forbidden move"
+    );
+}
