+//! PROVE-08: schema-from-grammar via HM. Drives the type-plane derivation on a
+//! typed JSON grammar and asserts the measured census + leaf bindings, then
+//! prints the derived schema for the report (`-- --nocapture`).
+
+use codegen::direct_schema::{DirectScalar, DirectTypeKind, DirectTypeRef};
+use codegen::type_plane;
+use ir::DirectBuildScalar;
+use std::collections::HashMap;
+
+/// Typed variant of json.bbnf: the four leaf rules carry `->` projections.
+const TYPED: &str = r#"null   = "null" -> 0u8 ;
+bool   = "true" -> true | "false" -> false ;
+number = /-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?/ -> f64 ;
+string = /"(?:[^"\\]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/ -> decode_json_string_to_arena(input) : String ;
+ws     = /[ \t\n\r]*/ ;
+comma  = "," ws ;
+colon  = ":" ws ;
+value  = ws (object | array | string | number | bool | null) ws ;
+pair   = string ws colon value ;
+member = pair (comma pair)* ;
+members = member? ;
+elements = (value (comma value)*)? ;
+array  = "[" ws elements "]" ;
+object = "{" ws members "}" ;
+json   = ws value ws ;
+"#;
+
+/// Structural twin (arrows stripped) — the grammar the compiler parses today.
+const STRUCTURAL: &str = r#"null   = "null" ;
+bool   = "true" | "false" ;
+number = /-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?/ ;
+string = /"(?:[^"\\]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/ ;
+ws     = /[ \t\n\r]*/ ;
+comma  = "," ws ;
+colon  = ":" ws ;
+value  = ws (object | array | string | number | bool | null) ws ;
+pair   = string ws colon value ;
+member = pair (comma pair)* ;
+members = member? ;
+elements = (value (comma value)*)? ;
+array  = "[" ws elements "]" ;
+object = "{" ws members "}" ;
+json   = ws value ws ;
+"#;
+
+#[test]
+fn derives_schema_from_grammar_projections() {
+    let grammar = grammar::parse_grammar("json", STRUCTURAL).expect("structural grammar parses");
+
+    let t0 = std::time::Instant::now();
+    let plane = type_plane::derive(&grammar, TYPED).expect("type plane derives");
+    let elapsed = t0.elapsed();
+
+    // --- Census (the SK-V21 P6 invariant: arrows == projections resolved) ---
+    // Arrows: null(0u8), bool(true), bool(false), number(f64), string(String) = 5.
+    assert_eq!(plane.arrow_count, 5, "five `->` arrows across the grammar");
+    // Projected rules: null, bool, number, string = 4 (bool carries two arrows).
+    assert_eq!(plane.projected_rule_count, 4, "four projected rules");
+    // The two `bool` arrows reconcile via one unify event.
+    assert_eq!(plane.unify_events, 1, "bool's two arrows unify to one Bool");
+
+    // --- Resolved leaf types are grammar-derived, not hardcoded ---
+    let by_rule: HashMap<_, _> = plane
+        .leaf_type_refs
+        .iter()
+        .map(|(r, s)| (r.as_str(), *s))
+        .collect();
+    assert_eq!(by_rule["bool"], DirectBuildScalar::Bool);
+    assert_eq!(by_rule["number"], DirectBuildScalar::F64);
+    assert_eq!(by_rule["string"], DirectBuildScalar::String);
+    assert_eq!(by_rule["null"], DirectBuildScalar::Null);
+
+    // --- The derived schema validates and threads types into field `ty` ---
+    plane.schema.validate().expect("derived schema validates");
+    let leaves = &plane.schema.types[0];
+    let DirectTypeKind::Struct { fields, .. } = &leaves.kind;
+    let field_ty: HashMap<_, _> = fields
+        .iter()
+        .map(|f| (f.rust_field.as_str(), &f.ty))
+        .collect();
+    assert!(matches!(
+        field_ty["number"],
+        DirectTypeRef::Scalar(DirectScalar::F64)
+    ));
+    assert!(matches!(
+        field_ty["string"],
+        DirectTypeRef::Scalar(DirectScalar::DecodedJsonString)
+    ));
+    assert!(matches!(
+        field_ty["bool"],
+        DirectTypeRef::Scalar(DirectScalar::Bool)
+    ));
+
+    // --- Report artifact ---
+    println!("\n=== PROVE-08 derived type plane ===");
+    println!(
+        "arrows={} projected_rules={} unify_events={} derive_wall={:?}",
+        plane.arrow_count, plane.projected_rule_count, plane.unify_events, elapsed
+    );
+    println!("resolved leaf types (from grammar `->`):");
+    for (rule, ty) in &plane.resolved {
+        println!("  {rule:<8} -> {ty:?}");
+    }
+    println!("schema.type_ref (DirectBuild None-slot fill):");
+    for (rule, scalar) in &plane.leaf_type_refs {
+        println!("  {rule:<8} -> {scalar:?}");
+    }
+    println!("derived DirectSchemaSet:\n{:#?}", plane.schema);
+}
