MULTI N=5  cyc/64B=25.295  vs_nibble=1.828x[nibble<multi]  vs_wide=1.388x[wide<multi]
MULTI N=6  cyc/64B=32.642  vs_nibble=2.359x[nibble<multi]  vs_wide=1.791x[wide<multi]
MULTI N=8  cyc/64B=31.985  vs_nibble=2.311x[nibble<multi]  vs_wide=1.755x[wide<multi]
