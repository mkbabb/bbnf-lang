// BBNF — Better Backus-Naur Form
// Self-hosted grammar definition.

@import { value_expr, type_annotation } from "expressions" ;

// ─── Terminals ──────────────────────────────────────────────────────────────

identifier = /[_a-zA-Z][_a-zA-Z0-9-]*/ ;

literal = "\"" , /(\\.|[^"\\])*/  , "\""
        | "'"  , /(\\.|[^'\\])*/  , "'"
        | "`"  , /(\\.|[^`\\])*/  , "`" ;

regex = "/" , /(\\.|[^\/])+/ , "/" ;

big_comment = ( "/*" , /[^\*]*/ , "*/" ) ?w ;
comment = ( "//" , /.*/ ) ?w ;

// ─── Expressions ────────────────────────────────────────────────────────────

lhs = identifier ;

term = "ε" | "epsilon"
     | identifier , ( "(" , rhs ?w , ( "," ?w , rhs ?w ) * , ")" ) ?
     | literal
     | regex
     | "(" , rhs ?w , ")"
     | "[" , rhs ?w , "]"
     | "{" , rhs ?w , "}" ;

modifier = "?w" | "?" | "*" | "+" ;

modifier = "?w" | "?" | "*" | "+" ;
factor = big_comment ? , term ?w , modifier ? , big_comment ? ;

// Map syntax: factor -> value_expr : type
mapped_factor = factor , ( "->" ?w , ( value_expr , type_annotation ? ) ) ? ;

binary_operators = "<<" | ">>" | "-" ;
binary_factor = mapped_factor , ( binary_operators ?w , mapped_factor ) * ;

concatenation = ( binary_factor ?w , "," ? ) + ;
alternation = ( concatenation ?w , "|" ? ) + ;

// Closures at rule level: |params| rhs (grammar functions)
closure = "|" , identifier , ( "," ?w , identifier ) * , "|" ?w , rhs ;
rhs = closure | alternation ;

// ─── Rules and Directives ───────────────────────────────────────────────────

rule = lhs , "=" ?w , rhs ?w , ( ";" | "." ) ;

import_path = "\"" , /(\\.|[^"\\])*/ , "\"" ;
import_items = "{" ?w , identifier , ( "," ?w , identifier ) * , "}" ;
import_directive = "@import" ?w , (
      import_items ?w , "from" ?w , import_path
    | import_path
) , ( ";" | "." ) ? ;

recover_directive = "@recover" ?w , identifier ?w , rhs ?w , ( ";" | "." ) ? ;

pretty_hint = identifier ;
pretty_directive = "@pretty" ?w , ( "*" | identifier ) ?w , (pretty_hint+) ?w , ( ";" | "." ) ? ;

ws_directive = "@ws" ?w , regex ?w , ( ";" | "." ) ? ;
token_directive = "@token" ?w , identifier ?w , ( ";" | "." ) ? ;
debug_directive = "@debug" ?w , ( "*" | identifier ) ?w , ( ";" | "." ) ? ;
host_directive = "@host" ?w , identifier ?w , ( ";" | "." ) ? ;

directive = import_directive
          | recover_directive
          | pretty_directive
          | ws_directive
          | token_directive
          | debug_directive
          | host_directive ;

// Grammar: sequence of comments, directives, and rules in any order.
grammar = ( comment ? , ( directive | rule ) ?w , comment ? ) * ;

@pretty grammar block ;
@pretty rule group ;
@pretty alternation group ;
