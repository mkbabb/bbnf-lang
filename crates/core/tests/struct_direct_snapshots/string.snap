// AZ-I.W2.RC — struct-direct String-shape emission snapshot.
//
// Captures the StructDirect-arm emission of the per-shape String
// emitter (`crates/core/src/backend/rust/emitter/shapes/string.rs`).
// The snapshot locks in: (a) at least one `builder.push_leaf_with_str`
// call routes the parsed slice; (b) no legacy tape-substrate leaf
// pushes leak into the struct-direct arm. The driver in
// `struct_direct_snapshots.rs` asserts both invariants at every
// test run.
//
// Wire contract:
// - Borrow path (escape-free, ~95% of real-world strings): the
//   `body: &'p str` slices `input[body_start..end]` directly and is
//   handed to `builder.push_leaf_with_str(body)`.
// - Escape path (cold): routes through
//   `decode_json_string_to_arena` against a per-call `Vec<u8>`; the
//   decoded bytes leak via `Box::leak` to satisfy the
//   `push_leaf_with_str` lifetime contract pending W2.A byte-arena
//   substrate extension.

#[inline(always)]
#[allow(non_snake_case, clippy::too_many_arguments, unused_variables)]
pub fn parse_string_JsonParser_string<'p>(
    input: &'p [u8],
    p: &mut usize,
    _state: &mut __shape_support_JsonParser::ScanState,
    builder: &mut ::bbnf::runtime::JsonStructBuilder<'p>,
) -> ::core::result::Result<
    crate::runtime::tape::TapeOffset,
    crate::runtime::tape::DtaError,
> {
    // …open / quote sentinel checks elided…
    match __shape_support_JsonParser::first_quote_or_backslash(tail) {
        Some((off, b'"')) => {
            // Borrow path — slice from input directly.
            let body: &'p str = unsafe {
                ::core::str::from_utf8_unchecked(&input[body_start..end])
            };
            builder.push_leaf_with_str(body);
            Ok(crate::runtime::tape::TapeOffset::NONE)
        }
        Some((_off, b'\\')) => {
            // Escape path — decode + leak (transitional pending W2.A
            // byte-arena substrate extension).
            let mut buf: Vec<u8> = Vec::with_capacity(/* … */ 0);
            // …decode_json_string_to_arena dispatch elided…
            let leaked: &'static str = /* leaked via Box::leak */ "";
            builder.push_leaf_with_str(leaked);
            Ok(crate::runtime::tape::TapeOffset::NONE)
        }
        _ => unreachable!(),
    }
}
