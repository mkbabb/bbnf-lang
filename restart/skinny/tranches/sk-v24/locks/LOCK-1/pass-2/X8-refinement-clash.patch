diff --git a/crates/ir/tests/type_clash_arm.rs b/crates/ir/tests/type_clash_arm.rs
new file mode 100644
index 000000000..15b728d44
--- /dev/null
+++ b/crates/ir/tests/type_clash_arm.rs
@@ -0,0 +1,131 @@
+//! X8 — the refinement-aware assignment clash arm.
+//!
+//! Proves the two halves of the arm's contract that the production
+//! `project_types_*` byte-identity tests cannot show on their own,
+//! because a well-formed grammar never drives a fully-ground
+//! disagreement onto a single type variable:
+//!
+//! 1. **Clash detection fires** — two disagreeing *fully-ground*
+//!    concretes (`F64` vs `U8`) pushed at the same type variable
+//!    surface exactly one `TypeObligation::TypeClash`, and the
+//!    incumbent is kept (the overwrite is refused, so the fixed point
+//!    stays stable rather than oscillating).
+//!
+//! 2. **Refinement is NOT frozen** — an under-narrowed incumbent
+//!    (`BoxedEnum`) overwritten by a structural type (`F64`) is
+//!    permitted and records no clash. This is the ~69 `BoxedEnum →
+//!    structural` refinements the four grammars depend on, in miniature.
+
+use bbnf_ir::passes::types::constraint::TypeVarId;
+use bbnf_ir::passes::types::constraint::domain::TypeDomain;
+use bbnf_ir::passes::types::constraint::grounds::GroundConstraint;
+use bbnf_ir::passes::types::constraint::revise::record_domain_clashes;
+use bbnf_ir::passes::types::{ObligationSink, TypeObligation};
+use bbnf_ir::TypeDesc;
+use csp_solver::Csp;
+
+/// Drive two disagreeing fully-ground grounds onto one variable and
+/// harvest the obligation stream. Both are persistent GroundConstraints;
+/// because the clash arm *refuses* a fully-ground overwrite, the fixed
+/// point settles on the incumbent instead of oscillating.
+fn clash_stream(a: TypeDesc, b: TypeDesc) -> Vec<TypeObligation> {
+    let mut csp: Csp<TypeDomain> = Csp::new();
+    let var = csp.add_variable(TypeDomain::unsolved());
+    csp.add_constraint(GroundConstraint::new(var, a));
+    csp.add_constraint(GroundConstraint::new(var, b));
+    let _ = csp.propagate();
+
+    let sink = ObligationSink::new();
+    // No node map in this unit fixture — clash carries `node: None`.
+    record_domain_clashes(csp.variables(), &sink, |_: TypeVarId| None);
+    sink.drain()
+}
+
+/// Drive a single monotonic refinement: seed the variable's incumbent
+/// to `from`, then let one GroundConstraint overwrite it with `to`.
+/// One constraint only — nothing re-asserts `from`, so the fixed point
+/// converges (a refinement never refuses, so a second persistent ground
+/// of a *different* type would oscillate; that is why real refinements
+/// are monotonic, single-writer moves, and why this fixture models them
+/// with a seeded incumbent rather than two competing grounds).
+fn refine_stream(from: TypeDesc, to: TypeDesc) -> Vec<TypeObligation> {
+    let mut csp: Csp<TypeDomain> = Csp::new();
+    let var = csp.add_variable(TypeDomain::ground(from));
+    csp.add_constraint(GroundConstraint::new(var, to));
+    let _ = csp.propagate();
+
+    let sink = ObligationSink::new();
+    record_domain_clashes(csp.variables(), &sink, |_: TypeVarId| None);
+    sink.drain()
+}
+
+#[test]
+fn concrete_vs_concrete_emits_exactly_one_type_clash() {
+    let stream = clash_stream(TypeDesc::F64, TypeDesc::U8);
+
+    assert_eq!(
+        stream.len(),
+        1,
+        "a single fully-ground disagreement must emit exactly one obligation; got {stream:?}",
+    );
+
+    match &stream[0] {
+        TypeObligation::TypeClash { node, lhs, rhs } => {
+            assert_eq!(*node, None, "unit fixture has no tree position");
+            // Order depends on which ground fired first; the pair must
+            // be the F64/U8 disagreement either way.
+            let pair = (lhs.clone(), rhs.clone());
+            assert!(
+                pair == (TypeDesc::F64, TypeDesc::U8)
+                    || pair == (TypeDesc::U8, TypeDesc::F64),
+                "clash must record the F64/U8 disagreement; got {pair:?}",
+            );
+            assert_ne!(lhs, rhs, "a clash is by definition a disagreement");
+        }
+        other => panic!("expected TypeObligation::TypeClash, got {other:?}"),
+    }
+}
+
+#[test]
+fn boxed_enum_refinement_records_no_clash() {
+    // BoxedEnum is under-narrowed: overwriting it with a structural
+    // scalar is a lattice refinement, never a clash.
+    let stream = refine_stream(TypeDesc::BoxedEnum, TypeDesc::F64);
+    assert!(
+        stream.is_empty(),
+        "BoxedEnum -> F64 is a legal refinement and must NOT surface a clash; got {stream:?}",
+    );
+
+    // The compound refinement the four grammars actually exercise:
+    // Tuple([BoxedEnum, U8]) -> Tuple([F64, U8]). The incumbent carries
+    // an under-narrowed child, so the whole tuple is non-ground and the
+    // overwrite is permitted with no clash.
+    let compound = refine_stream(
+        TypeDesc::Tuple(vec![TypeDesc::BoxedEnum, TypeDesc::U8]),
+        TypeDesc::Tuple(vec![TypeDesc::F64, TypeDesc::U8]),
+    );
+    assert!(
+        compound.is_empty(),
+        "Tuple([BoxedEnum,U8]) -> Tuple([F64,U8]) is a refinement, not a clash; got {compound:?}",
+    );
+
+    // HeterogeneousAltJoin is likewise under-narrowed.
+    let het = refine_stream(
+        TypeDesc::HeterogeneousAltJoin(vec![TypeDesc::F64, TypeDesc::U8]),
+        TypeDesc::F64,
+    );
+    assert!(
+        het.is_empty(),
+        "HeterogeneousAltJoin -> F64 is a refinement, not a clash; got {het:?}",
+    );
+}
+
+#[test]
+fn identical_grounds_record_no_clash() {
+    // Same type twice is a no-op, not a disagreement.
+    let stream = clash_stream(TypeDesc::F64, TypeDesc::F64);
+    assert!(
+        stream.is_empty(),
+        "identical grounds are a no-op, not a clash; got {stream:?}",
+    );
+}
