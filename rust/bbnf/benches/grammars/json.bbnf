null = "null" -> 0u8 ;
bool = "true" -> true | "false" -> false ;

number = /-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?/ -> f64 ;

comma = "," ?w ;
colon = ":" ?w ;

string = /"(?:[^"\\]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/ ;
array = "[" >> (( value << comma ? ) *)?w << "]" ;

pair = string, colon >> value ;
object = "{" >> (( pair << comma ? ) *)?w << "}" ;

value = object | array | string | number | bool | null ;

@pretty object group ;
@pretty array group ;
@pretty pair group ;