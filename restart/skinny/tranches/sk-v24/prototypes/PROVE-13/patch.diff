+fn generate_corpus(target: usize) -> String {
+    let mut s = String::with_capacity(target + 4096);
+    let mut seed = 0x9e3779b97f4a7c15u64;
+    let mut next = || {
+        seed ^= seed << 13;
+        seed ^= seed >> 7;
+        seed ^= seed << 17;
+        seed
+    };
