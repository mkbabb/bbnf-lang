// CSS Property-Aware Declaration Dispatch
// Groups CSS properties by value type for typed parsing.
// Falls back to genericDecl for unlisted properties.
//
// Design: property NAME dispatch gives us the type; value parsing is
// permissive.  Every typed declaration shares the same value list so
// multi-value shorthands, comma-separated lists, calc()/var() nesting,
// and slash-separated values all parse correctly.
//
// Per-declaration keyword wiring: each typed declaration has its specific
// keyword set as first-priority in the value Alt (displayKeyword | value).

@import "value-unit.bbnf" ;
@import "color.bbnf" ;
@import "func-body.bbnf" ;
@import "keywords.bbnf" ;

// --- Shared value patterns ---
ident = /[a-zA-Z_][\w-]*/ ;
propertyName = /--[\w-]+/ | /-?[a-zA-Z_][\w-]*/ ;

// --- !important ---
importantSuffix = ("!" ?w , "important") ? ;

// --- Dimension: typed per-unit dispatch via valueUnit ---
// AU.2.5: each typed dimension rule (length/angle/time/frequency/
// resolution/flex/percentage/unitless) composes (number, unit) into a
// distinct `(f64, u8)` aggregate site; the seven non-unitless branches
// reach `push_leaf_with_aggregate` once `number -> f64` is restored.
// Wiring through `valueUnit` makes those typed rules reachable from
// the stylesheet entry; without this reference `prune_unreachable`
// removed every dimension type from compiled codegen.
dimension = valueUnit ;

// --- Generic value token — matches any single CSS value token ---
cssString = /"(?:[^"\\]|\\[\s\S])*"/ | /'(?:[^'\\]|\\[\s\S])*'/ ;
// Dash-prefixed identifiers for vendor prefixes (-apple-system, -moz-*, etc.)
dashIdent = /-[a-zA-Z][\w-]*/ ;
value = varFunction | calcFunction | urlFunction | colorFn
      | genericFunction | hex
      | dimension | number | cssString | namedColor | globalKeyword
      | "," | "/"
      | dashIdent | ident ;

// --- Property name groups (dispatch keys) ---
// u8 discriminant per property name. Within each group, tags are assigned
// by declaration order; each *Props group is a disjoint namespace — codegen
// projects the group identifier to the typed declaration variant, so
// per-property tags drive lightningcss-equivalent PropertyId dispatch.
// TODO typed-aggregate (AU.2.6): full PropertyId enum with longhand/shorthand
// payload parity requires per-variant-payload codegen (W2).

colorProps = "color"                  -> 0u8
           | "background-color"       -> 1u8
           | "border-top-color"       -> 3u8
           | "border-right-color"     -> 4u8
           | "border-bottom-color"    -> 5u8
           | "border-left-color"      -> 6u8
           | "border-color"           -> 2u8
           | "outline-color"          -> 7u8
           | "text-decoration-color"  -> 8u8
           | "caret-color"            -> 9u8
           | "accent-color"           -> 10u8 ;

sizeProps = "min-width"       -> 2u8
          | "max-width"       -> 3u8
          | "min-height"      -> 4u8
          | "max-height"      -> 5u8
          | "min-block-size"  -> 9u8
          | "max-block-size"  -> 10u8
          | "min-inline-size" -> 11u8
          | "max-inline-size" -> 12u8
          | "width"           -> 0u8
          | "height"          -> 1u8
          | "flex-basis"      -> 6u8
          | "block-size"      -> 7u8
          | "inline-size"     -> 8u8 ;

spacingProps = "margin-top"    -> 1u8
             | "margin-right"  -> 2u8
             | "margin-bottom" -> 3u8
             | "margin-left"   -> 4u8
             | "margin"        -> 0u8
             | "padding-top"    -> 6u8
             | "padding-right"  -> 7u8
             | "padding-bottom" -> 8u8
             | "padding-left"   -> 9u8
             | "padding"        -> 5u8
             | "top"    -> 10u8
             | "right"  -> 11u8
             | "bottom" -> 12u8
             | "left"   -> 13u8
             | "inset"  -> 14u8
             | "row-gap"    -> 16u8
             | "column-gap" -> 17u8
             | "gap"        -> 15u8 ;

fontProps = "font-family"   -> 0u8
          | "font-style"    -> 1u8
          | "font-variant"  -> 2u8
          | "font"          -> 3u8
          | "text-transform" -> 4u8
          | "text-decoration-line"      -> 6u8
          | "text-decoration-style"     -> 7u8
          | "text-decoration-thickness" -> 8u8
          | "text-decoration"           -> 5u8
          | "letter-spacing" -> 9u8
          | "word-spacing"   -> 10u8
          | "white-space"    -> 11u8
          | "text-indent"    -> 12u8
          | "text-overflow"  -> 13u8
          | "word-break"     -> 14u8
          | "overflow-wrap"  -> 15u8
          | "hyphens"        -> 16u8 ;

bgProps = "background-image"       -> 1u8
        | "background-position"    -> 2u8
        | "background-size"        -> 3u8
        | "background-repeat"      -> 4u8
        | "background-attachment"  -> 5u8
        | "background-clip"        -> 6u8
        | "background-origin"      -> 7u8
        | "background-blend-mode"  -> 8u8
        | "background"             -> 0u8 ;

transformProps = "transform-origin"    -> 1u8
               | "transform-style"     -> 2u8
               | "transform"           -> 0u8
               | "perspective-origin"  -> 4u8
               | "perspective"         -> 3u8
               | "backface-visibility" -> 5u8 ;

transitionProps = "transition-property"           -> 1u8
                | "transition-duration"           -> 2u8
                | "transition-timing-function"    -> 3u8
                | "transition-delay"              -> 4u8
                | "transition"                    -> 0u8
                | "animation-name"                -> 6u8
                | "animation-duration"            -> 7u8
                | "animation-timing-function"     -> 8u8
                | "animation-delay"               -> 9u8
                | "animation-iteration-count"     -> 10u8
                | "animation-direction"           -> 11u8
                | "animation-fill-mode"           -> 12u8
                | "animation-play-state"          -> 13u8
                | "animation"                     -> 5u8 ;

listTableProps = "list-style-type"     -> 1u8
               | "list-style-position" -> 2u8
               | "list-style-image"    -> 3u8
               | "list-style"          -> 0u8
               | "table-layout"    -> 4u8
               | "border-collapse" -> 5u8
               | "border-spacing"  -> 6u8
               | "caption-side"    -> 7u8
               | "empty-cells"     -> 8u8
               | "vertical-align"  -> 9u8 ;

// --- Typed declarations with per-declaration keyword wiring ---

colorDecl      = colorProps   , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
sizeDecl       = sizeProps    , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
spacingDecl    = spacingProps , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
fontDecl       = fontProps    , ":" ?w , ((fontWeightKeyword | value) ?w) * , importantSuffix , ";" ? ;
bgDecl         = bgProps      , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
transformDecl  = transformProps , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
transitionDecl = transitionProps , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
listTableDecl  = listTableProps , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;

displayDecl    = "display"    , ":" ?w , ((displayKeyword | value) ?w) * , importantSuffix , ";" ? ;
positionDecl   = "position"   , ":" ?w , ((positionKeyword | value) ?w) * , importantSuffix , ";" ? ;
overflowDecl   = ("overflow-x" | "overflow-y" | "overflow") , ":" ?w , ((overflowKeyword | value) ?w) * , importantSuffix , ";" ? ;
visibilityDecl = "visibility" , ":" ?w , ((visibilityKeyword | value) ?w) * , importantSuffix , ";" ? ;

flexDirDecl    = "flex-direction" , ":" ?w , ((flexDirKeyword | value) ?w) * , importantSuffix , ";" ? ;
flexWrapDecl   = "flex-wrap"     , ":" ?w , ((flexWrapKeyword | value) ?w) * , importantSuffix , ";" ? ;
alignDecl      = ("justify-content" | "align-items" | "align-content" | "align-self" | "justify-items" | "justify-self")
                 , ":" ?w , ((alignKeyword | value) ?w) * , importantSuffix , ";" ? ;
flexNumDecl    = ("flex-grow" | "flex-shrink" | "order" | "z-index")
                 , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;

fontSizeDecl   = "font-size"   , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
fontWeightDecl = "font-weight" , ":" ?w , ((fontWeightKeyword | value) ?w) * , importantSuffix , ";" ? ;
lineHeightDecl = "line-height" , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;

borderWidthDecl  = ("border-top-width" | "border-right-width" | "border-bottom-width" | "border-left-width" | "border-width")
                   , ":" ?w , ((borderWidthKeyword | value) ?w) * , importantSuffix , ";" ? ;
borderStyleDecl  = ("border-top-style" | "border-right-style" | "border-bottom-style" | "border-left-style" | "border-style")
                   , ":" ?w , ((borderStyleKeyword | value) ?w) * , importantSuffix , ";" ? ;
borderRadiusDecl = ("border-top-left-radius" | "border-top-right-radius"
                   | "border-bottom-left-radius" | "border-bottom-right-radius" | "border-radius")
                   , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;

opacityDecl    = "opacity"    , ":" ?w , (value ?w) * , importantSuffix , ";" ? ;
textAlignDecl  = "text-align" , ":" ?w , ((textAlignKeyword | value) ?w) * , importantSuffix , ";" ? ;
boxSizingDecl  = "box-sizing" , ":" ?w , ((boxSizingKeyword | value) ?w) * , importantSuffix , ";" ? ;
cursorDecl     = "cursor"     , ":" ?w , ((cursorKeyword | value) ?w) * , importantSuffix , ";" ? ;

// --- Custom property declaration (CSS Variables, --prefix) ---
customPropertyDecl = /--[\w-]+/ , ":" ?w , /[^;!}]*/ , importantSuffix , ";" ? ;

// --- Generic fallback declaration (catches ALL unlisted properties) ---
// Uses raw value pattern to handle any CSS value syntax (negative values,
// calc expressions, complex shorthand values, etc.) that the typed value
// grammar doesn't cover.
genericDecl = (propertyName , ":" ?w , /[^;!}]*/ , importantSuffix , ";" ?) ?w ;

// --- Master declaration dispatch ---
declaration = customPropertyDecl
            | colorDecl | sizeDecl | spacingDecl
            | fontDecl | bgDecl | transformDecl | transitionDecl | listTableDecl
            | displayDecl | positionDecl | overflowDecl | visibilityDecl
            | flexDirDecl | flexWrapDecl | alignDecl | flexNumDecl
            | fontSizeDecl | fontWeightDecl | lineHeightDecl
            | borderWidthDecl | borderStyleDecl | borderRadiusDecl
            | opacityDecl | textAlignDecl | boxSizingDecl | cursorDecl
            | genericDecl ;
