@@ -0,0 +1,211 @@
+//! PROVE-04 microbench: single-block vs 2×64B software-pipelined structural/quote
+//! scan. Cold-per-parse, paired per-sample interleaving, PMU cyc/byte via
+//! `proc_pid_rusage(RUSAGE_INFO_V5).ri_cycles` (per-process → load-robust).
+//!
+//! Run: `cargo test --release -p bbnf-simd --test structural_scan_bench -- --nocapture`
+//! Env: `SCAN_BENCH_N` (samples, default 200), `SCAN_BENCH_ITERS` (per sample, default 8).
+
+#![cfg(target_arch = "aarch64")]
+
+use std::hint::black_box;
+use std::path::PathBuf;
+
+use bbnf_simd::aarch64::structural_scan::{
+    classify_fold_pipelined, classify_fold_single, scan_pipelined, scan_scalar_ref, scan_single,
+};
+
+// --- PMU via proc_pid_rusage V5 (cycles), mirrors css_canon_bench.rs:44-102 ---
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct RusageInfoV5 {
+    ri_uuid: [u8; 16],
+    ri_user_time: u64,
+    ri_system_time: u64,
+    ri_pkg_idle_wkups: u64,
+    ri_interrupt_wkups: u64,
+    ri_pageins: u64,
+    ri_wired_size: u64,
+    ri_resident_size: u64,
+    ri_phys_footprint: u64,
+    ri_proc_start_abstime: u64,
+    ri_proc_exit_abstime: u64,
+    ri_child_user_time: u64,
+    ri_child_system_time: u64,
+    ri_child_pkg_idle_wkups: u64,
+    ri_child_interrupt_wkups: u64,
+    ri_child_pageins: u64,
+    ri_child_elapsed_abstime: u64,
+    ri_diskio_bytesread: u64,
+    ri_diskio_byteswritten: u64,
+    ri_cpu_time_qos_default: u64,
+    ri_cpu_time_qos_maintenance: u64,
+    ri_cpu_time_qos_background: u64,
+    ri_cpu_time_qos_utility: u64,
+    ri_cpu_time_qos_legacy: u64,
+    ri_cpu_time_qos_user_initiated: u64,
+    ri_cpu_time_qos_user_interactive: u64,
+    ri_billed_system_time: u64,
+    ri_serviced_system_time: u64,
+    ri_logical_writes: u64,
+    ri_lifetime_max_phys_footprint: u64,
+    ri_instructions: u64,
+    ri_cycles: u64,
+    ri_billed_energy: u64,
+    ri_serviced_energy: u64,
+    ri_interval_max_phys_footprint: u64,
+    ri_runnable_time: u64,
+    ri_flags: u64,
+}
+const RUSAGE_INFO_V5: i32 = 5;
+extern "C" {
+    fn proc_pid_rusage(pid: libc::pid_t, flavor: i32, buffer: *mut u8) -> i32;
+}
+fn cycles_now() -> u64 {
+    let mut ri = RusageInfoV5::default();
+    let rc = unsafe {
+        proc_pid_rusage(
+            libc::getpid(),
+            RUSAGE_INFO_V5,
+            (&mut ri) as *mut RusageInfoV5 as *mut u8,
+        )
+    };
+    assert_eq!(rc, 0, "proc_pid_rusage failed");
+    ri.ri_cycles
+}
+
+fn loadavg() -> [f64; 3] {
+    let mut la = [0.0f64; 3];
+    unsafe { libc::getloadavg(la.as_mut_ptr(), 3) };
+    la
+}
+
+fn corpus(name: &str) -> Vec<u8> {
+    let mut p = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    p.push("../test-fixtures/corpus/json");
+    p.push(format!("{name}.json"));
+    std::fs::read(&p).unwrap_or_else(|e| panic!("read {}: {e}", p.display()))
+}
+
+/// Measure cycles for `iters` runs of a scan lane over `input`.
+#[inline(never)]
+fn measure_cycles(lane: fn(&[u8]) -> Vec<u32>, input: &[u8], iters: u32) -> u64 {
+    let c0 = cycles_now();
+    for _ in 0..iters {
+        black_box(lane(black_box(input)));
+    }
+    cycles_now() - c0
+}
+
+#[inline(never)]
+fn measure_cycles_fold(lane: fn(&[u8]) -> u64, input: &[u8], iters: u32) -> u64 {
+    let c0 = cycles_now();
+    for _ in 0..iters {
+        black_box(lane(black_box(input)));
+    }
+    cycles_now() - c0
+}
+
+fn median(v: &mut [f64]) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+/// mean and 95% CI (normal approx) of per-sample ratios.
+fn ratio_stats(ratios: &[f64]) -> (f64, f64) {
+    let n = ratios.len() as f64;
+    let mean = ratios.iter().sum::<f64>() / n;
+    let var = ratios.iter().map(|r| (r - mean).powi(2)).sum::<f64>() / (n - 1.0);
+    (mean, 1.96 * (var / n).sqrt())
+}
+
+#[test]
+fn prove04_pipelined_scan() {
+    let corpora = ["twitter", "citm_catalog", "canada"];
+    let n: u32 = std::env::var("SCAN_BENCH_N")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(200);
+    let iters: u32 = std::env::var("SCAN_BENCH_ITERS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(8);
+
+    let la = loadavg();
+    println!("\n=== PROVE-04: 2x64B software-pipelined structural/quote scan ===");
+    println!(
+        "host=aarch64  N={n}  iters/sample={iters}  loadavg={:.2}/{:.2}/{:.2}",
+        la[0], la[1], la[2]
+    );
+    println!(
+        "{:<14} {:>10} {:>12} {:>12} {:>12} {:>10} {:>18}",
+        "corpus", "bytes", "lane", "single c/B", "pipe c/B", "ratio", "95% CI (single/pipe)"
+    );
+
+    for name in corpora {
+        let input = corpus(name);
+        let bytes = input.len() as f64;
+
+        // --- parity: scalar oracle == neon single == neon pipelined ---
+        let oracle = scan_scalar_ref(&input);
+        let single_pos = scan_single(&input);
+        let pipe_pos = scan_pipelined(&input);
+        assert_eq!(oracle, single_pos, "{name}: neon single != scalar oracle");
+        assert_eq!(oracle, pipe_pos, "{name}: neon pipelined != scalar oracle");
+        assert_eq!(
+            classify_fold_single(&input),
+            classify_fold_pipelined(&input),
+            "{name}: classify fold mismatch"
+        );
+        let structural = oracle.len();
+
+        // --- full scan (classify + carry + compaction) ---
+        let mut single_cpb = Vec::with_capacity(n as usize);
+        let mut pipe_cpb = Vec::with_capacity(n as usize);
+        let mut ratios = Vec::with_capacity(n as usize);
+        for _ in 0..n {
+            let cs = measure_cycles(scan_single, &input, iters);
+            let cp = measure_cycles(scan_pipelined, &input, iters);
+            single_cpb.push(cs as f64 / (bytes * iters as f64));
+            pipe_cpb.push(cp as f64 / (bytes * iters as f64));
+            ratios.push(cs as f64 / cp as f64);
+        }
+        let (rm, rci) = ratio_stats(&ratios);
+        println!(
+            "{:<14} {:>10} {:>12} {:>12.4} {:>12.4} {:>10.4} {:>10.4} +/-{:.4}",
+            name,
+            input.len(),
+            "full-scan",
+            median(&mut single_cpb),
+            median(&mut pipe_cpb),
+            rm,
+            rm,
+            rci
+        );
+
+        // --- classify-only fold (isolates the classify-stage pipeline) ---
+        let mut fs_cpb = Vec::with_capacity(n as usize);
+        let mut fp_cpb = Vec::with_capacity(n as usize);
+        let mut fratios = Vec::with_capacity(n as usize);
+        for _ in 0..n {
+            let cs = measure_cycles_fold(classify_fold_single, &input, iters);
+            let cp = measure_cycles_fold(classify_fold_pipelined, &input, iters);
+            fs_cpb.push(cs as f64 / (bytes * iters as f64));
+            fp_cpb.push(cp as f64 / (bytes * iters as f64));
+            fratios.push(cs as f64 / cp as f64);
+        }
+        let (frm, frci) = ratio_stats(&fratios);
+        println!(
+            "{:<14} {:>10} {:>12} {:>12.4} {:>12.4} {:>10.4} {:>10.4} +/-{:.4}  ({} structural)",
+            name,
+            input.len(),
+            "classify",
+            median(&mut fs_cpb),
+            median(&mut fp_cpb),
+            frm,
+            frm,
+            frci,
+            structural
+        );
+    }
+    println!();
+}
