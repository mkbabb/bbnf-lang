+fn name_host_clause(msg: &str) -> &'static str {
+    if msg.contains("repetition bound") {
+        "host.rs::parse_braced_quantifier (via lower_quantifier) — bounded {n,m}: span carries the braces, num_part parse fails"
+    } else if msg.contains("hex") || msg.contains("unicode") || msg.contains("codepoint") {
+        "host.rs::lower_escape"
+    } else if msg.contains("Unicode property") {
+        "host.rs::lower_escape (\\p{...})"
+    } else {
+        "host.rs (unnamed) — inspect"
+    }
+}
