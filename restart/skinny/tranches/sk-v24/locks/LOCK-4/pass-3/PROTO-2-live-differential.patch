@@ -0,0 +1,308 @@
+//! LOCK-4 PROTO-2 — the 4C VM value plane (`Op::ApplyFn`) oracle.
+//!
+//! Oracle A (value plane): a hand-built projection-dense GrammarIR is compiled
+//! to bytecode and run; the VM's projected `Value` tree is asserted
+//! byte-identical to an independently specified golden. Exercises all four new
+//! `Value` arms (F64 / U32 / Str / Variant) and every `FnDescriptor` evaluator
+//! path (NumberConvert, HexConvert, EnumWrap, Expr{MapExpr arithmetic/FnCall}).
+//!
+//! Also emits the cross-language crossing artifacts (Oracle B, clause A + the
+//! projection-grammar Value tree) to the scratch dir for the TS decoder, and
+//! checks encode∘decode∘encode idempotence on the live `BytecodeProgram`.
+
+use bbnf_ir::bytecode::{BytecodeProgram, Op};
+use bbnf_ir::compiler::compile;
+use bbnf_ir::interpreter::{Interpreter, Value};
+use bbnf_ir::{FnDescriptor, GrammarIR, IrNode, IrRule, MapBinOp, MapExpr, RuleMeta};
+
+fn rule(id: u32, name: u32, body: IrNode) -> IrRule {
+    IrRule { id, name, body, meta: RuleMeta::default(), source_span: None }
+}
+
+/// Build a single-rule projection grammar: entry rule 0 maps `inner` through
+/// `fns[0]`. `strings` holds the interned table.
+fn ir1(inner: IrNode, fns: Vec<FnDescriptor>, strings: Vec<String>) -> GrammarIR {
+    GrammarIR {
+        entry: 0,
+        rules: vec![rule(0, 0, IrNode::Map { inner: Box::new(inner), fn_id: 0 })],
+        strings,
+        fns,
+        ..Default::default()
+    }
+}
+
+/// Strip the rule's `MakeTagged` wrapper, returning the single projected child.
+fn projected(v: &Value) -> &Value {
+    match v {
+        Value::Tagged { children, .. } => {
+            assert_eq!(children.len(), 1, "expected exactly one projected child");
+            &children[0]
+        }
+        other => other,
+    }
+}
+
+fn run(ir: &GrammarIR, input: &str) -> Value {
+    let program = compile(ir);
+    let mut interp = Interpreter::new(&program, input);
+    let r = interp.run();
+    assert!(r.success, "parse failed for {input:?}");
+    r.value.expect("no value produced")
+}
+
+// ── Oracle A: byte-identical projected Value trees ──────────────────────────
+
+#[test]
+fn oracle_a_number_convert_f64() {
+    // "3.5" -> f64
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::NumberConvert { allow_leading_dot: false }],
+        vec!["root".into(), "3.5".into()]);
+    let v = run(&ir, "3.5");
+    assert_eq!(*projected(&v), Value::F64(3.5), "NumberConvert must yield F64(3.5)");
+}
+
+#[test]
+fn oracle_a_hex_convert_u32() {
+    // "ff" -> parse_hex : u32
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::HexConvert { fn_path: 0 }],
+        vec!["root".into(), "ff".into()]);
+    let v = run(&ir, "ff");
+    assert_eq!(*projected(&v), Value::U32(255), "HexConvert must yield U32(255)");
+}
+
+#[test]
+fn oracle_a_enum_wrap_variant() {
+    // "px" -> Unit::wrap
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::EnumWrap { variant: 2 }],
+        vec!["root".into(), "px".into(), "Unit".into()]);
+    let v = run(&ir, "px");
+    let expected = Value::Variant { tag: 2, child: Box::new(Value::Span(0, 2)) };
+    assert_eq!(*projected(&v), expected, "EnumWrap must yield Variant wrapping the span");
+}
+
+#[test]
+fn oracle_a_mapexpr_arithmetic_u32() {
+    // "10" -> (input * 2) + 1  == 21
+    let expr = MapExpr::BinOp {
+        op: MapBinOp::Add,
+        lhs: Box::new(MapExpr::BinOp {
+            op: MapBinOp::Mul,
+            lhs: Box::new(MapExpr::Input),
+            rhs: Box::new(MapExpr::IntLit(2)),
+        }),
+        rhs: Box::new(MapExpr::IntLit(1)),
+    };
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::Expr { expr, return_type: None }],
+        vec!["root".into(), "10".into()]);
+    let v = run(&ir, "10");
+    assert_eq!(*projected(&v), Value::U32(21), "MapExpr (input*2)+1 must yield U32(21)");
+}
+
+#[test]
+fn oracle_a_mapexpr_floatlit_f64() {
+    // "x" -> input * 1.5  (input coerces "2" ... but here literal * float)
+    let expr = MapExpr::BinOp {
+        op: MapBinOp::Mul,
+        lhs: Box::new(MapExpr::Input),
+        rhs: Box::new(MapExpr::FloatLit(1.5)),
+    };
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::Expr { expr, return_type: None }],
+        vec!["root".into(), "4".into()]);
+    let v = run(&ir, "4");
+    assert_eq!(*projected(&v), Value::F64(6.0), "input(4)*1.5 must yield F64(6.0)");
+}
+
+#[test]
+fn oracle_a_mapexpr_stringlit_str() {
+    // "hi" -> "HELLO"  (constant string projection)
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::Expr { expr: MapExpr::StringLit(2), return_type: None }],
+        vec!["root".into(), "hi".into(), "HELLO".into()]);
+    let v = run(&ir, "hi");
+    assert_eq!(*projected(&v), Value::Str("HELLO".into()), "StringLit must yield Str(HELLO)");
+}
+
+// ── Idempotence: encode ∘ decode ∘ encode == encode, Op tags pinned ─────────
+
+#[test]
+fn oracle_b_serde_idempotence() {
+    let expr = MapExpr::BinOp {
+        op: MapBinOp::Add,
+        lhs: Box::new(MapExpr::Input),
+        rhs: Box::new(MapExpr::IntLit(1)),
+    };
+    let ir = ir1(IrNode::Literal(1), vec![FnDescriptor::Expr { expr, return_type: None }],
+        vec!["root".into(), "9".into()]);
+    let program = compile(&ir);
+
+    // encode
+    let json1 = serde_json::to_string(&program).unwrap();
+    // decode
+    let decoded: BytecodeProgram = serde_json::from_str(&json1).unwrap();
+    // re-encode
+    let json2 = serde_json::to_string(&decoded).unwrap();
+    assert_eq!(json1, json2, "encode∘decode∘encode must be identical (wire idempotence)");
+
+    // Op tag pin: ApplyFn must be present and externally tagged.
+    assert!(json1.contains("\"ApplyFn\""), "ApplyFn opcode must be in the wire stream");
+
+    // Decoded program still runs and still projects.
+    let mut interp = Interpreter::new(&decoded, "9");
+    let r = interp.run();
+    assert!(r.success);
+    assert_eq!(*projected(&r.value.unwrap()), Value::U32(10), "decoded program must still project");
+}
+
+// ── Oracle B artifact emission for the TS decoder ───────────────────────────
+
+/// Canonicalize a `Value` tree to the JSON shape the TS interpreter emits,
+/// so node-for-node identity is a string compare.
+fn value_json(v: &Value) -> serde_json::Value {
+    use serde_json::json;
+    match v {
+        Value::Span(s, e) => json!({"Span": [s, e]}),
+        Value::Nil => json!("Nil"),
+        Value::F64(f) => json!({"F64": f}),
+        Value::U32(u) => json!({"U32": u}),
+        Value::Str(s) => json!({"Str": s.as_ref()}),
+        Value::Variant { tag, child } => json!({"Variant": {"tag": tag, "child": value_json(child)}}),
+        Value::Array(items) => json!({"Array": items.iter().map(value_json).collect::<Vec<_>>()}),
+        Value::Tagged { tag, span, children } => json!({
+            "Tagged": {"tag": tag, "span": [span.0, span.1],
+                       "children": children.iter().map(value_json).collect::<Vec<_>>()}
+        }),
+    }
+}
+
+#[test]
+fn emit_ts_crossing_artifacts() {
+    let dir = std::path::Path::new(
+        "/private/tmp/claude-504/-Users-mkbabb-Programming-bbnf-lang/67d0543b-e7c7-48da-9c77-0a9635fd4b0d/scratchpad/xlang",
+    );
+    std::fs::create_dir_all(dir).unwrap();
+
+    // A no-regex projection grammar the TS interpreter can run byte-for-byte:
+    // entry `pair` = num ("," num)?  where num = /digit-literal/ -> (input+100)
+    // Built by hand so the bytecode uses only MatchString/ApplyFn/Repeat/MakeArray/MakeTagged.
+    // rule 0 = entry `doc`: Repeat { num, 1.. }
+    // rule 1 = `num`: Alt over fixed digit literals, each -> input + 100
+    let plus100 = |sid_unused: u32| FnDescriptor::Expr {
+        expr: MapExpr::BinOp {
+            op: MapBinOp::Add,
+            lhs: Box::new(MapExpr::Input),
+            rhs: Box::new(MapExpr::IntLit(100)),
+        },
+        return_type: None,
+    };
+    let _ = plus100;
+
+    // strings: 0 doc, 1 num, 2 "1", 3 "2", 4 "3"
+    let strings: Vec<String> = ["doc", "num", "1", "2", "3"].iter().map(|s| s.to_string()).collect();
+    let num_body = IrNode::Map {
+        inner: Box::new(IrNode::Alt(
+            vec![
+                bbnf_ir::AltBranch { node: IrNode::Literal(2), first_set: None },
+                bbnf_ir::AltBranch { node: IrNode::Literal(3), first_set: None },
+                bbnf_ir::AltBranch { node: IrNode::Literal(4), first_set: None },
+            ],
+            None,
+        )),
+        fn_id: 0,
+    };
+    let doc_body = IrNode::Repeat { inner: Box::new(IrNode::Ref(1)), lo: 1, hi: u32::MAX };
+    let ir = GrammarIR {
+        entry: 0,
+        rules: vec![rule(0, 0, doc_body), rule(1, 1, num_body)],
+        strings,
+        fns: vec![FnDescriptor::Expr {
+            expr: MapExpr::BinOp {
+                op: MapBinOp::Add,
+                lhs: Box::new(MapExpr::Input),
+                rhs: Box::new(MapExpr::IntLit(100)),
+            },
+            return_type: None,
+        }],
+        ..Default::default()
+    };
+    let program = compile(&ir);
+
+    // Clause A: live golden opcode stream (externally-tagged serde JSON).
+    let prog_json = serde_json::to_string_pretty(&program).unwrap();
+    std::fs::write(dir.join("projection_program.json"), &prog_json).unwrap();
+
+    // Clause B: run six varied inputs, dump input + Rust Value tree JSON.
+    let inputs = ["1", "12", "123", "321", "231", "132"];
+    let mut cases = Vec::new();
+    for inp in inputs {
+        let mut interp = Interpreter::new(&program, inp);
+        let r = interp.run();
+        assert!(r.success, "projection grammar failed on {inp:?}");
+        cases.push(serde_json::json!({
+            "input": inp,
+            "value": value_json(&r.value.unwrap()),
+        }));
+    }
+    std::fs::write(dir.join("projection_cases.json"),
+        serde_json::to_string_pretty(&cases).unwrap()).unwrap();
+
+    eprintln!("EMITTED xlang artifacts to {}", dir.display());
+    eprintln!("projection program opcodes: {}", program.code.len());
+}
+
+#[test]
+fn emit_valueplane_crossing() {
+    // The value-plane crossing (4C/4D): the SAME serialized `FnDescriptor`
+    // (+ interned strings + input span) is evaluated on both sides; the
+    // projected `Value` must be node-for-node identical. This is the axis
+    // with zero prior running evidence. Each case is authored, run through
+    // the live Rust VM, and dumped with its exact projected result.
+    let dir = std::path::Path::new(
+        "/private/tmp/claude-504/-Users-mkbabb-Programming-bbnf-lang/67d0543b-e7c7-48da-9c77-0a9635fd4b0d/scratchpad/xlang",
+    );
+    std::fs::create_dir_all(dir).unwrap();
+
+    // (label, FnDescriptor, strings, input)
+    let cases: Vec<(&str, FnDescriptor, Vec<String>, &str)> = vec![
+        ("NumberConvert", FnDescriptor::NumberConvert { allow_leading_dot: false },
+            vec!["r".into(), "3.5".into()], "3.5"),
+        ("NumberConvert_int", FnDescriptor::NumberConvert { allow_leading_dot: false },
+            vec!["r".into(), "42".into()], "42"),
+        ("HexConvert", FnDescriptor::HexConvert { fn_path: 0 },
+            vec!["r".into(), "ff".into()], "ff"),
+        ("EnumWrap", FnDescriptor::EnumWrap { variant: 2 },
+            vec!["r".into(), "px".into(), "Unit".into()], "px"),
+        ("Expr_arith", FnDescriptor::Expr {
+            expr: MapExpr::BinOp { op: MapBinOp::Add,
+                lhs: Box::new(MapExpr::BinOp { op: MapBinOp::Mul,
+                    lhs: Box::new(MapExpr::Input), rhs: Box::new(MapExpr::IntLit(2)) }),
+                rhs: Box::new(MapExpr::IntLit(1)) },
+            return_type: None }, vec!["r".into(), "10".into()], "10"),
+        ("Expr_floatmul", FnDescriptor::Expr {
+            expr: MapExpr::BinOp { op: MapBinOp::Mul,
+                lhs: Box::new(MapExpr::Input), rhs: Box::new(MapExpr::FloatLit(1.5)) },
+            return_type: None }, vec!["r".into(), "4".into()], "4"),
+        ("Expr_stringlit", FnDescriptor::Expr { expr: MapExpr::StringLit(2), return_type: None },
+            vec!["r".into(), "hi".into(), "HELLO".into()], "hi"),
+        ("Expr_fncall_hex", FnDescriptor::Expr {
+            expr: MapExpr::FnCall { name: 2, args: vec![MapExpr::Input] }, return_type: None },
+            vec!["r".into(), "1a".into(), "parse_hex".into()], "1a"),
+        ("Expr_inputlen", FnDescriptor::Expr {
+            expr: MapExpr::InputProp { prop: 2 }, return_type: None },
+            vec!["r".into(), "hello".into(), "len".into()], "hello"),
+    ];
+
+    let mut out = Vec::new();
+    for (label, desc, strings, input) in cases {
+        let ir = ir1(IrNode::Literal(1), vec![desc.clone()], strings.clone());
+        let v = run(&ir, input);
+        out.push(serde_json::json!({
+            "label": label,
+            "desc": desc,
+            "strings": strings,
+            "input": input,
+            "result": value_json(projected(&v)),
+        }));
+    }
+    std::fs::write(dir.join("valueplane_crossing.json"),
+        serde_json::to_string_pretty(&out).unwrap()).unwrap();
+    eprintln!("EMITTED valueplane_crossing.json ({} cases)", out.len());
+}
