+//! LOCK-4 pass-1 VALUE-PLANE-SURVIVAL probe.
+//!
+//! Paired-interleaved cold per-parse bench: the closure value core
+//! (`json_parser` -> `Parser<JsonValue>`) vs the runtime-analyzable value
+//! graph (`json_graph` -> enum-dispatched arena producing `JsonValue`).
+//! Two adjacent benches per corpus so both arms see the same machine state;
+//! divan medians over many cold samples cancel adjacency ordering bias.
+
+#[global_allocator]
+static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;
+
+use std::path::Path;
+
+use divan::counter::BytesCount;
+use divan::{Bencher, black_box};
+
+use parse_that::json::json_parser;
+use parse_that::json_graph::json_graph;
+
+fn data_dir() -> std::path::PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data/json")
+}
+
+fn read(filepath: &str) -> String {
+    let filepath = data_dir().join(filepath);
+    std::fs::read_to_string(&filepath)
+        .unwrap_or_else(|e| panic!("Failed to read {}: {}", filepath.display(), e))
+}
+
+fn bench_closure(b: Bencher, filepath: &str) {
+    let data = read(filepath);
+    let parser = json_parser();
+    b.counter(BytesCount::new(data.len())).bench_local(|| {
+        let buf = black_box(&data);
+        parser.parse(buf).unwrap()
+    });
+}
+
+fn bench_graph(b: Bencher, filepath: &str) {
+    let data = read(filepath);
+    let graph = json_graph();
+    b.counter(BytesCount::new(data.len())).bench_local(|| {
+        let buf = black_box(&data);
+        graph.parse(buf).unwrap()
+    });
+}
+
+// ── apache-builds ──────────────────────────────────────────────
+#[divan::bench]
+fn apache_builds_closure(b: Bencher) {
+    bench_closure(b, "apache-builds.json")
+}
+#[divan::bench]
+fn apache_builds_graph(b: Bencher) {
+    bench_graph(b, "apache-builds.json")
+}
+
+// ── canada ─────────────────────────────────────────────────────
+#[divan::bench]
+fn canada_closure(b: Bencher) {
+    bench_closure(b, "canada.json")
+}
+#[divan::bench]
+fn canada_graph(b: Bencher) {
+    bench_graph(b, "canada.json")
+}
+
+// ── citm_catalog ───────────────────────────────────────────────
+#[divan::bench]
+fn citm_catalog_closure(b: Bencher) {
+    bench_closure(b, "citm_catalog.json")
+}
+#[divan::bench]
+fn citm_catalog_graph(b: Bencher) {
+    bench_graph(b, "citm_catalog.json")
+}
+
+// ── data ───────────────────────────────────────────────────────
+#[divan::bench]
+fn data_closure(b: Bencher) {
+    bench_closure(b, "data.json")
+}
+#[divan::bench]
+fn data_graph(b: Bencher) {
+    bench_graph(b, "data.json")
+}
+
+// ── data_xl ────────────────────────────────────────────────────
+#[divan::bench]
+fn data_xl_closure(b: Bencher) {
+    bench_closure(b, "data-xl.json")
+}
+#[divan::bench]
+fn data_xl_graph(b: Bencher) {
+    bench_graph(b, "data-xl.json")
+}
+
+// ── twitter ────────────────────────────────────────────────────
+#[divan::bench]
+fn twitter_closure(b: Bencher) {
+    bench_closure(b, "twitter.json")
+}
+#[divan::bench]
+fn twitter_graph(b: Bencher) {
+    bench_graph(b, "twitter.json")
+}
+
+fn main() {
+    divan::main();
+}
--- a/rust/parse_that/tests/json_graph_parity_test.rs
+++ b/rust/parse_that/tests/json_graph_parity_test.rs
@@ -0,0 +1,77 @@
+//! LOCK-4 pass-1 hard gate: byte-identical typed output.
+//!
+//! The value graph (`json_graph`) must produce a `JsonValue` structurally
+//! equal (`PartialEq`) to the closure core (`json_parser`) on every corpus and
+//! on the edge inputs the 37 JSON tests exercise. If the closure passes those
+//! tests and graph == closure here, the graph inherits parity.
+
+use std::path::Path;
+
+use parse_that::json::json_parser;
+use parse_that::json_graph::json_graph;
+
+fn data_path(name: &str) -> std::path::PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../data/json")
+        .join(name)
+}
+
+fn assert_parity(src: &str, ctx: &str) {
+    let closure = json_parser().parse(src);
+    let graph = json_graph().parse(src);
+    assert_eq!(
+        closure, graph,
+        "value-plane divergence on {ctx}: closure != graph"
+    );
+}
+
+#[test]
+fn parity_corpora() {
+    for name in [
+        "apache-builds.json",
+        "canada.json",
+        "citm_catalog.json",
+        "data.json",
+        "data-xl.json",
+        "twitter.json",
+    ] {
+        let src = std::fs::read_to_string(data_path(name))
+            .unwrap_or_else(|e| panic!("read {name}: {e}"));
+        // Both must succeed AND be equal.
+        let closure = json_parser().parse(&src);
+        let graph = json_graph().parse(&src);
+        assert!(closure.is_some(), "closure failed on {name}");
+        assert!(graph.is_some(), "graph failed on {name}");
+        assert_eq!(closure, graph, "value-plane divergence on {name}");
+    }
+}
+
+#[test]
+fn parity_edges() {
+    // Mirrors the shapes the 37 json_test cases probe: escapes, unicode,
+    // empties, nesting, numbers, literals, whitespace.
+    let cases = [
+        r#"{"a": 1, "b": 2, "c": 3}"#,
+        r#""hello\nworld""#,
+        r#""A""#,
+        r#""""#,
+        r#""a\"b\\c\/d""#,
+        r#""\t\n\r\b\f""#,
+        r#"[]"#,
+        r#"{}"#,
+        r#"[1, 2, [3, [4, 5]], {"x": [null, true, false]}]"#,
+        r#"-0.5e10"#,
+        r#"123456789"#,
+        r#"1.5E-3"#,
+        r#"true"#,
+        r#"false"#,
+        r#"null"#,
+        "  \n\t [ 1 , 2 ,\n 3 ]  \n",
+        r#"{"nested": {"deep": {"deeper": [1, {"k": "v"}]}}}"#,
+        r#"[-1, -2.5, 0, 100, 3.14159]"#,
+        r#"{"unicode": "éè", "mix": "a\tb"}"#,
+    ];
+    for (i, c) in cases.iter().enumerate() {
+        assert_parity(c, &format!("edge#{i}: {c}"));
+    }
+}
