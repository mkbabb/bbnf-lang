@@ -0,0 +1,61 @@
+//! LOCK-3 pass-2 probe 1: the CONSUME contract on `Project.ty`.
+//!
+//! Parses the sole `->` witness (google-sheets.bbnf), runs type inference, and
+//! prints whether `verify_project_types` reads RED or GREEN. Run with
+//! `--nocapture` to see the verdict + offending spans. The sheets grammar is
+//! the only corpus carrying declared `-> _ : Span` projections; json.bbnf has
+//! none, so the predicate is vacuously GREEN there (asserted below).
+
+use passes::layout::types::{infer, verify_project_types};
+
+fn sheets_source() -> String {
+    let path = concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../../grammar/google-sheets/google-sheets.bbnf"
+    );
+    std::fs::read_to_string(path).expect("read sheets grammar")
+}
+
+fn json_source() -> String {
+    let path = concat!(env!("CARGO_MANIFEST_DIR"), "/../../grammars/json.bbnf");
+    std::fs::read_to_string(path).expect("read json grammar")
+}
+
+#[test]
+fn sheets_projection_types_verdict() {
+    let source = sheets_source();
+    let grammar = grammar::parse_grammar("google_sheets", &source).expect("parse sheets");
+    let facts = infer(&grammar).expect("infer sheets");
+
+    // Count the declared-ty projections in the corpus for the record.
+    let declared: usize = grammar
+        .exprs
+        .iter()
+        .filter(|e| {
+            matches!(
+                &e.kind,
+                ir::ExprKind::Project { ty: Some(_), .. }
+            )
+        })
+        .count();
+
+    match verify_project_types(&grammar, &facts) {
+        Ok(()) => println!(
+            "VERIFY-PROJECT-TYPES: GREEN (all {declared} declared projections carry their type)"
+        ),
+        Err(spans) => println!(
+            "VERIFY-PROJECT-TYPES: RED ({} of {declared} declared projections drop their type; spans={:?})",
+            spans.len(),
+            spans
+        ),
+    }
+
+    // json.bbnf has zero declared projections -> vacuously GREEN, always.
+    let json = json_source();
+    let jg = grammar::parse_grammar("json", &json).expect("parse json");
+    let jf = infer(&jg).expect("infer json");
+    assert!(
+        verify_project_types(&jg, &jf).is_ok(),
+        "json has no declared projections; must be vacuously GREEN"
+    );
+}
