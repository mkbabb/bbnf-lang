@@ -0,0 +1,221 @@
+//! A small Hindley–Milner unification core for the grammar type plane.
+//!
+//! Re-authored from the SK-V21 PROTO-P6 spike (189-LOC bidirectional synth/check
+//! + union-find). The job here is narrow and honest: the grammar's `->` arrows
+//! carry leaf projection texts (`true`, `false`, `f64`, `0u8`, `: String`); this
+//! core lexes each arrow to a monotype and *unifies* the arrows that land on the
+//! same rule. Unification is load-bearing, not decorative: `bool = "true" -> true
+//! | "false" -> false` yields TWO arrows on one rule that must reconcile to a
+//! single `Bool`; a rule whose arrows disagree is a type error the core rejects.
+//!
+//! `TyCon` is the closed leaf vocabulary a JSON-shaped grammar can name. Composite
+//! shapes (object/array/the `value` sum) live in the schema layer, not here — this
+//! core resolves *leaf* projections, the atoms the schema's field `type_ref`s bind.
+
+use std::collections::HashMap;
+
+/// A leaf type constructor — the closed vocabulary a `->` projection can name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TyCon {
+    Bool,
+    F64,
+    /// An unsigned tag (`0u8` in `null -> 0u8`); the u8 discriminant leaf.
+    U8Tag,
+    /// A decoded, arena-owned string (`-> decode_...(input) : String`).
+    StringDecoded,
+    /// A borrowed string span (`-> input : String` / bare string leaf).
+    StringSpan,
+}
+
+/// A monotype: either an unresolved variable or a resolved leaf constructor.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ty {
+    Var(u32),
+    Con(TyCon),
+}
+
+/// Union-find over type variables with a monotype binding per root.
+#[derive(Default)]
+pub struct Unifier {
+    parent: Vec<u32>,
+    /// Resolved constructor bound to a root variable, once known.
+    con: Vec<Option<TyCon>>,
+}
+
+/// A unification failure: two incompatible constructors met on one variable.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct UnifyError {
+    pub lhs: TyCon,
+    pub rhs: TyCon,
+}
+
+impl Unifier {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Mint a fresh, unbound type variable.
+    pub fn fresh(&mut self) -> Ty {
+        let id = self.parent.len() as u32;
+        self.parent.push(id);
+        self.con.push(None);
+        Ty::Var(id)
+    }
+
+    fn find(&mut self, mut v: u32) -> u32 {
+        while self.parent[v as usize] != v {
+            let g = self.parent[self.parent[v as usize] as usize];
+            self.parent[v as usize] = g; // path halving
+            v = g;
+        }
+        v
+    }
+
+    /// Unify two monotypes. Variables absorb constructors; two distinct
+    /// constructors that meet are a type error (the honest HM clash).
+    pub fn unify(&mut self, a: Ty, b: Ty) -> Result<(), UnifyError> {
+        match (a, b) {
+            (Ty::Con(x), Ty::Con(y)) => {
+                if x == y {
+                    Ok(())
+                } else {
+                    Err(UnifyError { lhs: x, rhs: y })
+                }
+            }
+            (Ty::Var(v), Ty::Con(c)) | (Ty::Con(c), Ty::Var(v)) => self.bind(v, c),
+            (Ty::Var(x), Ty::Var(y)) => {
+                let (rx, ry) = (self.find(x), self.find(y));
+                if rx == ry {
+                    return Ok(());
+                }
+                match (self.con[rx as usize], self.con[ry as usize]) {
+                    (Some(cx), Some(cy)) if cx != cy => Err(UnifyError { lhs: cx, rhs: cy }),
+                    (_, Some(cy)) => {
+                        self.parent[ry as usize] = rx;
+                        self.con[rx as usize] = Some(cy);
+                        Ok(())
+                    }
+                    (Some(cx), _) => {
+                        self.parent[rx as usize] = ry;
+                        self.con[ry as usize] = Some(cx);
+                        Ok(())
+                    }
+                    (None, None) => {
+                        self.parent[ry as usize] = rx;
+                        Ok(())
+                    }
+                }
+            }
+        }
+    }
+
+    fn bind(&mut self, v: u32, c: TyCon) -> Result<(), UnifyError> {
+        let r = self.find(v);
+        match self.con[r as usize] {
+            Some(existing) if existing != c => Err(UnifyError { lhs: existing, rhs: c }),
+            _ => {
+                self.con[r as usize] = Some(c);
+                Ok(())
+            }
+        }
+    }
+
+    /// Zonk: resolve a monotype to its constructor, if determined.
+    pub fn resolve(&mut self, t: Ty) -> Option<TyCon> {
+        match t {
+            Ty::Con(c) => Some(c),
+            Ty::Var(v) => {
+                let r = self.find(v);
+                self.con[r as usize]
+            }
+        }
+    }
+}
+
+/// Lex one `->` arrow RHS (target text + optional `: Type` ascription) into a
+/// leaf monotype. This is the bidirectional-check leaf: an ascription `: T`
+/// *checks against* the named type; a bare target *synthesizes* from its literal
+/// shape (`true`/`false` → Bool, digit-run with `u8` suffix → U8Tag, `f64` → F64).
+pub fn classify_arrow(target_text: &str, type_text: Option<&str>) -> TyCon {
+    if let Some(ascription) = type_text {
+        let named = ascription.trim();
+        if named.eq_ignore_ascii_case("string") {
+            // decode_*(...) : String owns into the arena; a bare span : String borrows.
+            return if target_text.contains("decode") {
+                TyCon::StringDecoded
+            } else {
+                TyCon::StringSpan
+            };
+        }
+        if named.eq_ignore_ascii_case("f64") || named.eq_ignore_ascii_case("f32") {
+            return TyCon::F64;
+        }
+        if named.eq_ignore_ascii_case("bool") {
+            return TyCon::Bool;
+        }
+    }
+    let t = target_text.trim();
+    if t == "true" || t == "false" {
+        return TyCon::Bool;
+    }
+    if t == "f64" || t == "f32" {
+        return TyCon::F64;
+    }
+    if let Some(stripped) = t.strip_suffix("u8") {
+        if stripped.bytes().all(|b| b.is_ascii_digit()) && !stripped.is_empty() {
+            return TyCon::U8Tag;
+        }
+    }
+    // Fallback: a bare identifier ascription-less target is treated as a span string.
+    TyCon::StringSpan
+}
+
+/// The whole-grammar inference result: one resolved leaf type per projected rule,
+/// plus the invariant counts the SK-V21 P6 spike certified (`arrows == projections`).
+pub struct Inference {
+    /// rule name -> resolved leaf constructor.
+    pub rule_types: HashMap<String, TyCon>,
+    /// total `->` arrows seen across the grammar.
+    pub arrow_count: usize,
+    /// distinct rules that carry at least one arrow (the projected rules).
+    pub projected_rule_count: usize,
+    /// arrows that reconciled with a sibling arrow on the same rule via unify.
+    pub unify_events: usize,
+}
+
+/// Run HM over `(rule, target_text, type_text)` arrows: one fresh var per rule,
+/// every arrow of a rule unified into that var, then zonked to a leaf. Returns the
+/// per-rule leaf types or the first clash. This is the pass that would replace the
+/// dropped `Project.ty` thread — arrows in, resolved leaves out.
+pub fn infer(arrows: &[(String, String, Option<String>)]) -> Result<Inference, UnifyError> {
+    let mut u = Unifier::new();
+    let mut vars: HashMap<String, Ty> = HashMap::new();
+    let mut unify_events = 0usize;
+    for (rule, target, ty) in arrows {
+        let leaf = Ty::Con(classify_arrow(target, ty.as_deref()));
+        match vars.get(rule).copied() {
+            Some(v) => {
+                u.unify(v, leaf)?;
+                unify_events += 1;
+            }
+            None => {
+                let v = u.fresh();
+                u.unify(v, leaf)?;
+                vars.insert(rule.clone(), v);
+            }
+        }
+    }
+    let projected_rule_count = vars.len();
+    let mut rule_types = HashMap::new();
+    for (rule, v) in &vars {
+        if let Some(c) = u.resolve(*v) {
+            rule_types.insert(rule.clone(), c);
+        }
+    }
+    Ok(Inference {
+        rule_types,
+        arrow_count: arrows.len(),
+        projected_rule_count,
+        unify_events,
+    })
+}
