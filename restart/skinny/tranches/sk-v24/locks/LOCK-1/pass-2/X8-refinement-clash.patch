 /// Assign a type to a variable's domain. Returns true if the type changed.
+///
+/// X8 — refinement-aware overwrite. The projection CSP converges by
+/// letting a variable's domain move *down* the type lattice: an
+/// under-narrowed placeholder (`BoxedEnum`, `HeterogeneousAltJoin`, or
+/// a compound still carrying one of those inside it) legitimately
+/// refines to a more specific structural type as the target rules and
+/// child nodes resolve — that is the ~69 `BoxedEnum → structural`
+/// refinements the four production grammars depend on, and every such
+/// move is permitted unconditionally.
+///
+/// The one transition that is *not* a refinement is two **fully-ground**
+/// types that disagree: both sides are settled concretes (no
+/// under-narrowed layout anywhere inside them) yet differ. A naive
+/// "refuse every overwrite" rule would freeze the legal refinements
+/// along with the genuine clashes; instead this arm refuses *only* the
+/// fully-ground disagreement, keeps the incumbent so the fixed point
+/// stays stable, and stashes the pair on the domain's `clash`
+/// side-channel. The driver harvests those into
+/// [`TypeObligation::TypeClash`] after propagation converges, so the
+/// refusal surfaces as a named diagnostic instead of a silent freeze.
 pub(super) fn assign(vars: &mut [Variable<TypeDomain>], var: TypeVarId, ty: TypeDesc) -> bool {
-    let slot = &mut vars[var as usize].domain.solved;
-    if slot.as_ref() == Some(&ty) {
-        false
-    } else {
-        *slot = Some(ty);
-        true
+    let domain = &mut vars[var as usize].domain;
+    match &domain.solved {
+        Some(existing) if *existing == ty => false,
+        Some(existing) if is_fully_ground(existing) && is_fully_ground(&ty) => {
+            // Two settled concretes that disagree: a genuine clash, not
+            // a refinement. Refuse the overwrite (keep the incumbent so
+            // the fixed point does not oscillate) and record the pair
+            // for the post-propagation obligation harvest.
+            domain.clash = Some(Box::new((existing.clone(), ty)));
+            false
+        }
+        _ => {
+            // First assignment, or a refinement (the incumbent or the
+            // newcomer still carries an under-narrowed layout). Permit —
+            // this is byte-for-byte the historical last-writer-wins move.
+            domain.solved = Some(ty);
+            true
+        }
+    }
+}
+
+/// True when a type is a *settled concrete*: it carries no
+/// `BoxedEnum` / `HeterogeneousAltJoin` under-narrowed layout at any
+/// nesting depth, so the projection CSP can never refine it further.
+///
+/// `Enum` and `Named` are deliberately treated as **non**-ground: the
+/// solver assigns `Enum` to vec-context Ref slots and `Named` to custom
+/// map results, and those slots are bridged by `EqualConstraint` to
+/// variables that may legitimately settle on a scalar. Excluding them
+/// keeps the clash arm from misreading those legal bridges as
+/// disagreements — only pure scalar / `Span` grounds (and tuples /
+/// options / vecs built entirely from them) participate in clash
+/// detection.
+fn is_fully_ground(ty: &TypeDesc) -> bool {
+    match ty {
+        TypeDesc::BoxedEnum
+        | TypeDesc::HeterogeneousAltJoin(_)
+        | TypeDesc::Enum
+        | TypeDesc::Named(_) => false,
+        TypeDesc::Option(inner) | TypeDesc::Vec(inner) => is_fully_ground(inner),
+        TypeDesc::Tuple(elems) => !elems.is_empty() && elems.iter().all(is_fully_ground),
+        // Scalars and Span: settled, non-refinable.
+        _ => true,
+    }
+}
+
+/// Harvest every stashed refinement clash into the shared obligation
+/// sink once propagation has converged. `node_of` recovers the owning
+/// `NodeId` for a type variable (the projection driver inverts its
+/// `NodeId → TypeVarId` map; callers with no tree context pass `|_|
+/// None`). One obligation per clashing variable — the domain stash
+/// already collapses repeated refusals on the same variable to a single
+/// pair, so no additional dedup is needed here.
+pub fn record_domain_clashes(
+    vars: &[Variable<TypeDomain>],
+    sink: &ObligationSink,
+    node_of: impl Fn(TypeVarId) -> Option<NodeId>,
+) {
+    for (idx, v) in vars.iter().enumerate() {
+        if let Some(pair) = &v.domain.clash {
+            let (lhs, rhs) = pair.as_ref();
+            sink.record(TypeObligation::TypeClash {
+                node: node_of(idx as TypeVarId),
+                lhs: lhs.clone(),
+                rhs: rhs.clone(),
+            });
+        }
     }
 }
 
