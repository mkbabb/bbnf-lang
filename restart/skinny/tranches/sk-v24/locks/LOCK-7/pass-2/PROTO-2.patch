+// ── ORACLE_REL_V1 :  N = R1 ∘ R2 ∘ R3  (R2 by construction) ───────────────
+/// Bottom-up unit-collapse to a fixpoint (R1) + field-for-field structural
+/// preservation (R3). One bottom-up pass reaches the fixpoint; `norm` is
+/// idempotent (verified by re-application in `assert_idempotent`).
+fn norm(h: &Hir) -> Hir {
+    match h {
+        Hir::Concat(items) => {
+            let mut v: Vec<Hir> = items.iter().map(norm).collect();
+            match v.len() {
+                0 => Hir::Empty,          // R1: Concat([]) ≡ Empty
+                1 => v.pop().unwrap(),    // R1: Concat([x]) ≡ x
+                _ => Hir::Concat(v),      // R3: order preserved field-for-field
+            }
+        }
+        Hir::Alternation(items) => {
+            let mut v: Vec<Hir> = items.iter().map(norm).collect();
+            match v.len() {
+                0 => Hir::Empty,          // R1: Alt([]) ≡ Empty
+                1 => v.pop().unwrap(),    // R1: Alt([x]) ≡ x
+                _ => Hir::Alternation(v), // R3: arm order + count preserved (M4 relies on this)
+            }
+        }
+        // R3 — group nesting preserved (NOT collapsed).
+        Hir::Group(inner) => Hir::Group(Box::new(norm(inner))),
+        // R3 — quantifier fields preserved (min/max/greedy) (M1 relies on this).
+        Hir::Repetition(r) => Hir::Repetition(Repetition {
+            sub: Box::new(norm(&r.sub)),
+            min: r.min,
+            max: r.max,
+            greedy: r.greedy,
+        }),
+        // Leaves — Empty / Literal / Class / Look — field-for-field (R3).
+        other => other.clone(),
+    }
+}
+
+fn oracle_eq(a: &Hir, b: &Hir) -> bool {
+    norm(a) == norm(b)
+}
