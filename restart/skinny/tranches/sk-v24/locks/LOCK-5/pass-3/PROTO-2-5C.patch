+// ── unminimized DFA build ───────────────────────────────────────────────
+fn build_unmin(pattern: &str) -> Option<Dfa> {
+    let opts = DfaOptions {
+        state_limit: 8192,
+        minimize: false,
+        unicode: true,
+    };
+    Dfa::compile_with(pattern, &opts)
+}
