/// AW-V.W3.2 — per-grammar Scalar-shape parse function
/// (single-literal body).
#[inline(always)]
#[allow(non_snake_case, clippy::too_many_arguments)]
pub fn parse_scalar_JsonFixture_comma(
    input: &[u8],
    p: &mut usize,
    _state: &mut __shape_support_JsonFixture::ScanState,
    builder: &mut crate::runtime::tape::Tape<()>,
) -> ::core::result::Result<
    crate::runtime::tape::TapeOffset,
    crate::runtime::tape::DtaError,
> {
    let at = *p;
    let end = at + 1usize;
    if input.len() < end || input[at..end] != [44u8] {
        return Err(crate::runtime::tape::DtaError::Syntax {
            offset: at as u32,
            failing_state: crate::runtime::tape::DtaStateId::NONE,
            failing_rule: crate::runtime::tape::DtaRuleId(u32::MAX),
        });
    }
    *p = end;
    let off = builder
        .push_leaf(
            crate::runtime::tape::TapeKind::Literal,
            at as u32,
            end as u32,
            3u8,
            0,
        );
    Ok(off)
}