{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbnf.dev/contracts/w3-grammar-instance.schema.json",
  "title": "BBNF W3 grammar instance",
  "description": "Strict external representation of bbnf.grammar-instance.v1. The compiler additionally enforces that an infix right binding power is either equal to its left binding power (right associative) or exactly one greater (left associative), plus all grammar-dependent resolution and consumption laws.",
  "type": "object",
  "required": [
    "schema",
    "logical_path",
    "entry",
    "trivia_regex",
    "pratt_tables"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bbnf.grammar-instance.v1"
    },
    "logical_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "entry": {
      "$ref": "#/$defs/identifier"
    },
    "trivia_regex": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pratt_tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pratt_table"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "binding_power": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "pratt_table": {
      "type": "object",
      "required": [
        "site_rule",
        "atom_rule",
        "operators"
      ],
      "additionalProperties": false,
      "properties": {
        "site_rule": {
          "$ref": "#/$defs/identifier"
        },
        "atom_rule": {
          "$ref": "#/$defs/identifier"
        },
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pratt_operator"
          }
        }
      }
    },
    "pratt_operator": {
      "oneOf": [
        {
          "$ref": "#/$defs/prefix_operator"
        },
        {
          "$ref": "#/$defs/postfix_operator"
        },
        {
          "$ref": "#/$defs/infix_operator"
        }
      ]
    },
    "prefix_operator": {
      "type": "object",
      "required": [
        "matcher_rule",
        "fixity",
        "left_binding_power",
        "right_binding_power"
      ],
      "additionalProperties": false,
      "properties": {
        "matcher_rule": {
          "$ref": "#/$defs/identifier"
        },
        "fixity": {
          "const": "prefix"
        },
        "left_binding_power": {
          "type": "null"
        },
        "right_binding_power": {
          "$ref": "#/$defs/binding_power"
        }
      }
    },
    "postfix_operator": {
      "type": "object",
      "required": [
        "matcher_rule",
        "fixity",
        "left_binding_power",
        "right_binding_power"
      ],
      "additionalProperties": false,
      "properties": {
        "matcher_rule": {
          "$ref": "#/$defs/identifier"
        },
        "fixity": {
          "const": "postfix"
        },
        "left_binding_power": {
          "$ref": "#/$defs/binding_power"
        },
        "right_binding_power": {
          "type": "null"
        }
      }
    },
    "infix_operator": {
      "type": "object",
      "description": "Both powers are present. The compiler requires right_binding_power == left_binding_power or right_binding_power == left_binding_power + 1.",
      "required": [
        "matcher_rule",
        "fixity",
        "left_binding_power",
        "right_binding_power"
      ],
      "additionalProperties": false,
      "properties": {
        "matcher_rule": {
          "$ref": "#/$defs/identifier"
        },
        "fixity": {
          "const": "infix"
        },
        "left_binding_power": {
          "$ref": "#/$defs/binding_power"
        },
        "right_binding_power": {
          "$ref": "#/$defs/binding_power"
        }
      }
    }
  }
}
