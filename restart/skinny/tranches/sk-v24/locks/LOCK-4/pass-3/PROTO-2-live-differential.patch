+// ── Clause 2: TREE differential — repeated projection, node-for-node ─────────
+
+/// Recursively collect projected `U32` leaves in traversal order.
+fn collect_u32(v: &Value, out: &mut Vec<u32>) {
+    match v {
+        Value::U32(u) => out.push(*u),
+        Value::Array(items) => items.iter().for_each(|c| collect_u32(c, out)),
+        Value::Tagged { children, .. } => children.iter().for_each(|c| collect_u32(c, out)),
+        Value::Variant { child, .. } => collect_u32(child, out),
+        _ => {}
+    }
+}
+
+#[test]
+fn diff_repeated_projection_tree() {
+    // doc = num+ ; num = ("1"|"2"|"3") -> input + 100.
+    // A projection-dense tree: every leaf carries a `.map`, wrapped in a Repeat.
+    for input in ["1", "123", "321", "231", "132", "213"] {
+        // (b) parse-that LIVE .map under `.many`.
+        let pt: Vec<u32> = one_of(vec![string("1"), string("2"), string("3")])
+            .map(|s: &str| s.parse::<u32>().unwrap() + 100)
+            .many(1..)
+            .parse(input)
+            .expect("pt parse");
+
+        // (a) VM: Repeat over a Ref to a projecting rule.
+        let strings: Vec<String> =
+            ["doc", "num", "1", "2", "3"].iter().map(|s| s.to_string()).collect();
+        let num_body = IrNode::Map {
+            inner: Box::new(IrNode::Alt(
+                vec![
+                    AltBranch { node: IrNode::Literal(2), first_set: None },
+                    AltBranch { node: IrNode::Literal(3), first_set: None },
+                    AltBranch { node: IrNode::Literal(4), first_set: None },
+                ],
+                None,
+            )),
+            fn_id: 0,
+        };
+        let doc_body = IrNode::Repeat { inner: Box::new(IrNode::Ref(1)), lo: 1, hi: u32::MAX };
+        let ir = GrammarIR {
+            entry: 0,
+            rules: vec![rule(0, 0, doc_body), rule(1, 1, num_body)],
+            strings,
+            fns: vec![FnDescriptor::Expr {
+                expr: MapExpr::BinOp {
+                    op: MapBinOp::Add,
+                    lhs: Box::new(MapExpr::Input),
+                    rhs: Box::new(MapExpr::IntLit(100)),
+                },
+                return_type: None,
+            }],
+            ..Default::default()
+        };
+        let program = compile(&ir);
+        let mut interp = Interpreter::new(&program, input);
+        let r = interp.run();
+        assert!(r.success, "VM repeat parse failed for {input:?}");
+        let mut vm = Vec::new();
+        collect_u32(&r.value.unwrap(), &mut vm);
+
+        assert_eq!(vm, pt, "repeated-projection tree diverged for {input:?}");
+    }
+}
