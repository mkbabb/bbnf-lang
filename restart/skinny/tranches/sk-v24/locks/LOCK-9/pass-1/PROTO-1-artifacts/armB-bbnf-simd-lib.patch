+
+/// LOCK-9 probe arm B (counterfactual): direct #[cfg]-selected entry to the
+/// same kernel body, WITHOUT the `dispatch::primitive_kernels()` OnceLock
+/// fn-pointer table. On aarch64 this calls the NEON body directly (which in
+/// this crate delegates to the scalar bit-twiddle); the point is that the
+/// callee is statically known, so a cross-crate LTO caller can inline it and
+/// emit zero indirect branches.
+#[inline(always)]
+pub fn prefix_xor_64_direct(mask: u64, carry_in: bool) -> u64 {
+    #[cfg(target_arch = "aarch64")]
+    {
+        return crate::aarch64::bitmap_prefix_xor_64::bitmap_prefix_xor_64_neon(mask, carry_in);
+    }
+    #[allow(unreachable_code)]
+    {
+        crate::scalar::bitmap_prefix_xor_64::bitmap_prefix_xor_64_scalar(mask, carry_in)
+    }
 }
 
