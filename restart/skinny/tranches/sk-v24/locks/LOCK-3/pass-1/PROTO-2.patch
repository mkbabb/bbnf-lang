+/// Binding-time (stage) of an IR expression node — STEP 1 of the STAGED-RESIDUAL
+/// (family 3D) probe: the monotone dual of `nullability`, annotating every expr
+/// with the earliest stage at which its value is bound.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum Stage {
+    /// S0 — comptime. Value fully determined by the grammar alone (a delimiter
+    /// literal, a regex pattern, an annotation). Residualizable at generation time.
+    Comptime,
+    /// S1 — runtime. Reads the input cursor (a rule invocation or a scan loop);
+    /// cannot be evaluated at generation time.
+    Runtime,
+}
+
+impl Stage {
+    /// The lattice join: S1 dominates. Comptime only when BOTH sides are Comptime.
+    #[inline]
+    pub fn join(self, other: Stage) -> Stage {
+        match (self, other) {
+            (Stage::Comptime, Stage::Comptime) => Stage::Comptime,
+            _ => Stage::Runtime,
+        }
+    }
+}
+
+/// A binding-time leak: a node hard-pinned to S0 (a grammar-constant leaf) that
+/// the fixpoint found to depend on the S1 cursor. Raised, never silently demoted
+/// to S1 (no-silent-epsilon) — a comptime island that structurally consumes the
+/// runtime cursor is an authoring error, not a stage to swallow.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageLeak {
+    pub expr: ExprId,
+}
+
+/// Binding-time analysis — the same monotone `Changed`-flag fixpoint as
+/// `nullability`. Seeds the grammar-constant leaves (`Literal` / `Regex` /
+/// `Annotation`) at S0 (Comptime) and the cursor-binding spine (`Ref` invocation,
+/// `Repeat` scan) at S1 (Runtime); every combinator joins its operands. Monotone
+/// toward Runtime (S0 -> S1 only, never back).
+pub fn binding_times(grammar: &GrammarIr) -> Vec<Stage> {
+    let mut stage = vec![Stage::Comptime; grammar.exprs.len()];
+    loop {
+        let mut changed = false;
+        for expr in &grammar.exprs {
+            let next = match &expr.kind {
+                // S0 leaves: pure grammar constants (the delimiter island lives here).
+                ExprKind::Literal { .. }
+                | ExprKind::Regex { .. }
+                | ExprKind::Annotation { .. } => Stage::Comptime,
+                // S1 spine: the cursor-binding constructs.
+                ExprKind::Ref { .. } => Stage::Runtime,
+                ExprKind::Repeat { body, .. } => Stage::Runtime.join(stage[body.0]),
+                // Combinators: join operand stages (Comptime iff every operand is).
+                ExprKind::Seq(children) => children
+                    .iter()
+                    .fold(Stage::Comptime, |acc, c| acc.join(stage[c.0])),
+                ExprKind::Alt { branches, .. } => branches
+                    .iter()
+                    .fold(Stage::Comptime, |acc, b| acc.join(stage[b.0])),
+                ExprKind::Optional(inner) => stage[inner.0],
+            };
+            // Monotone: a node only ever rises toward Runtime.
+            let raised = stage[expr.id.0].join(next);
+            if raised != stage[expr.id.0] {
+                stage[expr.id.0] = raised;
+                changed = true;
+            }
+        }
+        if !changed {
+            return stage;
+        }
+    }
+}
+
+/// The child operands of an expression (for island / leak traversal).
+fn expr_operands(kind: &ExprKind) -> Vec<ExprId> {
+    match kind {
+        ExprKind::Seq(children) => children.clone(),
+        ExprKind::Alt { branches, .. } => branches.clone(),
+        ExprKind::Repeat { body, .. } => vec![*body],
+        ExprKind::Optional(inner) => vec![*inner],
+        ExprKind::Literal { .. } | ExprKind::Regex { .. } | ExprKind::Ref { .. } | ExprKind::Annotation { .. } => {
+            Vec::new()
+        }
+    }
+}
+
+/// The residual S0 islands: each is the root of a maximal comptime subtree
+/// spliced directly into the S1 spine (a Comptime operand of a Runtime node).
+/// These are exactly the delimiter/STOP-set constants a split emitter would lift
+/// out of the runtime scan loop. The count is the residual-count artifact.
+pub fn residual_islands(grammar: &GrammarIr, stage: &[Stage]) -> Vec<ExprId> {
+    let mut islands = std::collections::BTreeSet::new();
+    for expr in &grammar.exprs {
+        if stage[expr.id.0] == Stage::Runtime {
+            for child in expr_operands(&expr.kind) {
+                if stage[child.0] == Stage::Comptime {
+                    islands.insert(child.0);
+                }
+            }
+        }
+    }
+    islands.into_iter().map(ExprId).collect()
+}
+
+/// The binding-time leaks (no-silent-epsilon guard): a grammar-constant leaf
+/// (`Literal` / `Regex` / `Annotation`) the fixpoint raised to Runtime. Empty on
+/// a well-staged grammar — the S0 leaves are childless constants, so a clean
+/// delimiter island never leaks.
+pub fn stage_leaks(grammar: &GrammarIr, stage: &[Stage]) -> Vec<StageLeak> {
+    grammar
+        .exprs
+        .iter()
+        .filter(|expr| {
+            matches!(
+                expr.kind,
+                ExprKind::Literal { .. } | ExprKind::Regex { .. } | ExprKind::Annotation { .. }
+            ) && stage[expr.id.0] == Stage::Runtime
+        })
+        .map(|expr| StageLeak { expr: expr.id })
+        .collect()
+}
+
