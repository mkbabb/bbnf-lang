+// ── Summary emitter: dumps the measured divergence census to the scratch dir ─
+
+#[test]
+fn emit_differential_census() {
+    // Re-runs every clause's cases and tallies (vm, pt) pairs + divergences,
+    // writing a machine-checkable census the report cites verbatim.
+    let dir = std::path::Path::new(
+        "/private/tmp/claude-504/-Users-mkbabb-Programming-bbnf-lang/\
+         67d0543b-e7c7-48da-9c77-0a9635fd4b0d/scratchpad/xlang",
+    );
+    std::fs::create_dir_all(dir).ok();
+
+    let mut rows: Vec<serde_json::Value> = Vec::new();
+    let mut divergences = 0u32;
+    let mut push = |label: &str, input: &str, vm: String, pt: String, div: &mut u32| {
+        if vm != pt {
+            *div += 1;
+        }
+        rows.push(serde_json::json!({
+            "clause": label, "input": input, "vm": vm, "pt": pt, "equal": vm == pt
+        }));
+    };
+
+    for input in ["3.5", "42", "255"] {
+        let pt = regex("[0-9]+\\.?[0-9]*").map(|s: &str| s.parse::<f64>().unwrap())
+            .parse(input).unwrap();
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::NumberConvert { allow_leading_dot: false }],
+            strings, input);
+        push("number_convert", input, format!("{}", as_f64(&vm)), format!("{pt}"), &mut divergences);
+    }
+    for input in ["ff", "1a", "80"] {
+        let pt = regex("[0-9a-fA-F]+").map(|s: &str| u32::from_str_radix(s, 16).unwrap())
+            .parse(input).unwrap();
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner, vec![FnDescriptor::HexConvert { fn_path: 0 }], strings, input);
+        push("hex_convert", input, format!("{}", as_u32(&vm)), format!("{pt}"), &mut divergences);
+    }
+    for input in ["0.5", "0.25", "0.8"] {
+        let pt = regex("[0-9.]+").map(|s: &str| { let t = s.parse::<f64>().unwrap(); 0.0 + 255.0 * t })
+            .parse(input).unwrap();
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner,
+            vec![FnDescriptor::HostClosure { kind: HostFold::Lerp, coeffs: vec![0.0, 255.0] }],
+            strings, input);
+        push("hostclosure_lerp", input, format!("{}", as_f64(&vm)), format!("{pt}"), &mut divergences);
+    }
+    for input in ["200", "600", "17"] {
+        let pt = regex("[0-9]+").map(|s: &str| { let c = s.parse::<f64>().unwrap();
+            (c * 0.5).round().clamp(0.0, 255.0) as u32 }).parse(input).unwrap();
+        let (inner, strings) = lit(input);
+        let vm = vm_project(inner,
+            vec![FnDescriptor::HostClosure { kind: HostFold::ChannelScale, coeffs: vec![0.5] }],
+            strings, input);
+        push("hostclosure_channel_scale", input, format!("{}", as_u32(&vm)), format!("{pt}"),
+            &mut divergences);
+    }
+
+    let census = serde_json::json!({
+        "probe": "LOCK-4 PROTO-2 pass-3 probe-2 — VM ApplyFn vs parse-that live .map",
+        "total_pairs": rows.len(),
+        "divergences": divergences,
+        "rows": rows,
+    });
+    std::fs::write(dir.join("live_differential_census.json"),
+        serde_json::to_string_pretty(&census).unwrap()).ok();
+    eprintln!("DIFFERENTIAL CENSUS: {} pairs, {} divergences", census["total_pairs"], divergences);
+    assert_eq!(divergences, 0, "live differential found divergences");
+}
