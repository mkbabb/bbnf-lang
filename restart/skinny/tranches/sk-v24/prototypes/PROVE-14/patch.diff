+// PROVE-14 (F4): byte-exact layout parity. Walk the decoded tape and a JSON.parse
+// tree node-for-node; both produce the SAME structural digest via shared hash
+// primitives (tape.mjs). Also cross-check the digest counts against the Rust-side
+// meta and assert the payload arena stayed empty (offset-only tape invariant).
+//
+// usage: node verify.mjs   (env TAPE_DIR points at the dump)
+
+import { readRaw, decodeTape } from "./load.mjs";
+import { walkJs, emptyDigest, finalizeDigest, digestsEqual } from "./tape.mjs";
+import { tapeGet, jsonGet } from "./pointer.mjs";
+
+const dir = process.env.TAPE_DIR;
+const raw = readRaw(dir);
+
+// tape lane
+const doc = decodeTape(raw);
+const dt = emptyDigest();
+finalizeDigest(dt, doc.walk(0, dt));
+
+// reference lane
+const v = JSON.parse(raw.sourceBuf.toString("utf8"));
+const dj = emptyDigest();
+finalizeDigest(dj, walkJs(v, dj));
+
+const fields = ["objects", "arrays", "strings", "numbers", "bools", "nulls", "codeUnits", "fp"];
+console.log("field         tape            json.parse");
+for (const f of fields) {
+  const a = dt[f] >>> 0;
+  const b = dj[f] >>> 0;
+  const mark = a === b ? "  ok" : "  MISMATCH";
+  console.log(`${f.padEnd(12)}  ${String(dt[f]).padEnd(14)}  ${String(dj[f]).padEnd(14)}${mark}`);
+}
+
+const ok = digestsEqual(dt, dj);
+
+// partial-access (stop-early) parity: statuses[0]'s three leaves
+const pt = tapeGet(doc);
+const pj = jsonGet(v);
+const partialOk = pt.fp === pj.fp && pt.codeUnits === pj.codeUnits;
+console.log("");
+console.log(`partial get (statuses[0]): tape fp=${pt.fp >>> 0} json fp=${pj.fp >>> 0} codeUnits ${pt.codeUnits}/${pj.codeUnits} -> ${partialOk ? "PASS" : "FAIL"}`);
+
+// cross-checks vs the Rust dumper meta
+const m = raw.meta;
+const payloadEmpty = m.payload_bytes === 0;
+const srcMatches = m.source_bytes === raw.sourceBuf.length;
+const flagMatches = m.flag_count === raw.flagValuesBuf.length;
+console.log("");
+console.log(`meta: source_bytes=${m.source_bytes} offset_count=${m.offset_count} flag_count=${m.flag_count} payload_bytes=${m.payload_bytes}`);
+console.log(`offset_plane_bytes=${m.offset_plane_bytes} flag_plane_bytes=${m.flag_plane_bytes} (tape total=${m.offset_plane_bytes + m.flag_plane_bytes}, source=${m.source_bytes})`);
+console.log(`payload arena empty: ${payloadEmpty}   source size match: ${srcMatches}   flag plane paired: ${flagMatches}`);
+console.log("");
+console.log(`DIGEST PARITY: ${ok ? "PASS" : "FAIL"} (node-for-node structural walk equivalence)`);
+
+if (!(ok && partialOk && payloadEmpty && srcMatches && flagMatches)) process.exit(1);
