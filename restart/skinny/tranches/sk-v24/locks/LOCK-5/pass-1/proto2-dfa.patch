+/// (2A) Hopcroft worklist partition refinement — no global restart.
+pub fn worklist_partition(dfa: &Dfa) -> (Vec<usize>, usize) {
+    let n = dfa.states.len();
+    let k = dfa.num_classes as usize;
+    if n == 0 { return (vec![], 0); }
+    if n == 1 { return (vec![0], 1); }
+    let mut preds: Vec<Vec<Vec<u32>>> = vec![vec![Vec::new(); n]; k];
+    let mut preds_dead: Vec<Vec<u32>> = vec![Vec::new(); k];
+    for s in 0..n {
+        for c in 0..k {
+            let t = dfa.states[s].transitions[c];
+            if t == DEAD { preds_dead[c].push(s as u32); } else { preds[c][t as usize].push(s as u32); }
+        }
+    }
+    let mut block_of = vec![0usize; n];
+    let mut block_members: Vec<Vec<u32>> = Vec::new();
+    let (mut nonacc, mut acc): (Vec<u32>, Vec<u32>) = (Vec::new(), Vec::new());
+    for s in 0..n {
+        if dfa.states[s].is_accept { acc.push(s as u32); } else { nonacc.push(s as u32); }
+    }
+    for members in [nonacc, acc] {
+        if members.is_empty() { continue; }
+        let bid = block_members.len();
+        for &s in &members { block_of[s as usize] = bid; }
+        block_members.push(members);
+    }
+    let mut num_blocks = block_members.len();
+    let mut in_work: Vec<Vec<bool>> = vec![vec![false; k]; num_blocks];
+    let mut work: VecDeque<(usize, usize)> = VecDeque::new();
+    for b in 0..num_blocks { for c in 0..k { in_work[b][c] = true; work.push_back((b, c)); } }
+    for c in 0..k { work.push_back((DEAD_BLOCK, c)); }
+    while let Some((sb, c)) = work.pop_front() {
+        if sb != DEAD_BLOCK { in_work[sb][c] = false; }
+        let x: Vec<u32> = if sb == DEAD_BLOCK {
+            preds_dead[c].clone()
+        } else {
+            let mut v = Vec::new();
+            for &t in &block_members[sb] { v.extend_from_slice(&preds[c][t as usize]); }
+            v
+        };
+        if x.is_empty() { continue; }
+        let mut touched: HashMap<usize, Vec<u32>> = HashMap::new();
+        for &s in &x { touched.entry(block_of[s as usize]).or_default().push(s); }
+        for (yb, inx) in touched {
+            let ysize = block_members[yb].len();
+            if inx.len() == ysize { continue; }
+            let nb = num_blocks; num_blocks += 1;
+            let inx_set: HashSet<u32> = inx.iter().copied().collect();
+            for &s in &inx { block_of[s as usize] = nb; }
+            let old = std::mem::take(&mut block_members[yb]);
+            block_members[yb] = old.into_iter().filter(|s| !inx_set.contains(s)).collect();
+            block_members.push(inx);
+            in_work.push(vec![false; k]);
+            for cc in 0..k {
+                if in_work[yb][cc] {
+                    in_work[nb][cc] = true; work.push_back((nb, cc));
+                } else if block_members[yb].len() <= block_members[nb].len() {
+                    in_work[yb][cc] = true; work.push_back((yb, cc));
+                } else {
+                    in_work[nb][cc] = true; work.push_back((nb, cc));
+                }
+            }
+        }
     }
+    (block_of, num_blocks)
 }
+
+pub fn worklist_minimize(dfa: &Dfa) -> Dfa {
+    if dfa.states.len() <= 1 { return dfa.clone(); }
+    let (partition, num_blocks) = worklist_partition(dfa);
+    rebuild_from_partition(dfa, &partition, num_blocks)
+}
+
+pub fn is_acyclic(dfa: &Dfa) -> bool {
+    let n = dfa.states.len();
+    let k = dfa.num_classes as usize;
+    let mut color = vec![0u8; n];
+    for root in 0..n {
+        if color[root] != 0 { continue; }
+        let mut stack: Vec<(usize, usize)> = vec![(root, 0)];
+        color[root] = 1;
+        while let Some(&(u, ci)) = stack.last() {
+            if ci < k {
+                stack.last_mut().unwrap().1 += 1;
+                let t = dfa.states[u].transitions[ci];
+                if t == DEAD { continue; }
+                let t = t as usize;
+                if color[t] == 1 { return false; }
+                if color[t] == 0 { color[t] = 1; stack.push((t, 0)); }
+            } else {
+                color[u] = 2;
+                stack.pop();
+            }
+        }
+    }
+    true
+}
