+#[test]
+fn e3_oracle_is_green_on_the_shipping_map_over_all_arms() {
+    // (a) Reproduce the digest floor: the shipping E3 map corresponds arm-for-arm on every witness.
+    // Zero-witness arms cannot exist here — the census supplies one per arm (G-3A-b: unverified
+    // becomes impossible by construction for this corpus).
+    let corpus = arm_corpus();
+    assert_eq!(corpus.len(), 13, "census must cover all 13 BackendExpr arms");
+    for (name, node) in &corpus {
+        let sink = lower_expr_probe(node);
+        let mism = e3_correspond(node, &sink, name);
+        assert!(mism.is_empty(), "arm {name}: shipping map must correspond, got {mism:?}");
+    }
+}
+
+#[test]
+fn e3_map_fault_is_localized_to_its_arm_never_merely_a_failure() {
+    let corpus = arm_corpus();
+    // (arm expected to be flagged, fault) — the localization matrix.
+    let cases: &[(&str, Fault)] = &[
+        ("ByteLiteral", Fault::ByteLiteralToReturn),
+        ("RegexProgram", Fault::RegexSpanFlip),
+        ("Alt", Fault::AltDropLastBranch),
+        ("ValueProject", Fault::ValueProjectTarget),
+        ("Seq", Fault::SeqReverse),
+    ];
+    let clean_forest: Vec<SinkOnlyExpr> =
+        corpus.iter().map(|(_, n)| lower_expr_probe(n)).collect();
+    let clean_dg = forest_digest(&clean_forest);
+
+    for (expect_arm, fault) in cases {
+        // Which corpus witnesses contain the faulted arm? Those are the ONLY ones that may flag.
+        let mut flagged_arms: Vec<String> = Vec::new();
+        let mut mutant_forest: Vec<SinkOnlyExpr> = Vec::new();
+        for (name, node) in &corpus {
+            let mutant = lower_mutant(node, *fault);
+            mutant_forest.push(mutant.clone());
+            let mism = e3_correspond(node, &mutant, name);
+            if !mism.is_empty() {
+                flagged_arms.push((*name).to_string());
+                // Localization: the mismatch text must name the faulted arm somewhere in the path.
+                assert!(
+                    mism.iter().any(|m| m.contains(expect_arm)),
+                    "fault {expect_arm}: witness {name} flagged but path does not name the arm: {mism:?}"
+                );
+            }
+        }
+        // The E3 oracle flagged AT LEAST the arm's own witness — a localized name, not a bare bool.
+        assert!(
+            flagged_arms.iter().any(|a| a == expect_arm),
+            "fault {expect_arm}: E3 oracle failed to flag the arm witness (flagged={flagged_arms:?})"
+        );
+        // Every flagged witness genuinely CONTAINS the faulted arm (no false localization).
+        for a in &flagged_arms {
+            let (_, node) = corpus.iter().find(|(n, _)| n == a).unwrap();
+            assert!(
+                contains_backend_arm(node, expect_arm),
+                "fault {expect_arm}: falsely localized to witness {a} that lacks the arm"
+            );
+        }
+        // The terminal digest ALSO breaks — a coarse end-to-end check DETECTS but does not localize.
+        let mut_dg = forest_digest(&mutant_forest);
+        assert_ne!(clean_dg, mut_dg, "fault {expect_arm}: terminal digest must break");
+        eprintln!(
+            "LOCALIZE fault@{expect_arm}: E3 flagged {} witness(es) {:?}; terminal_digest {:016x}->{:016x} (broke)",
+            flagged_arms.len(),
+            flagged_arms,
+            clean_dg,
+            mut_dg
+        );
+    }
+}
+
+fn contains_backend_arm(b: &BackendExpr, arm: &str) -> bool {
+    if backend_tag(b) == arm {
+        return true;
+    }
+    match b {
+        BackendExpr::Entry(i) | BackendExpr::OptionalBranch(i) => contains_backend_arm(i, arm),
+        BackendExpr::Seq(cs) => cs.iter().any(|c| contains_backend_arm(c, arm)),
+        BackendExpr::Alt { branches, .. } => branches.iter().any(|c| contains_backend_arm(c, arm)),
+        BackendExpr::RepeatLoop { body, .. } | BackendExpr::ValueProject { body, .. } => {
+            contains_backend_arm(body, arm)
+        }
+        _ => false,
+    }
+}
+
+#[test]
+fn e2_input_fault_trips_e2_oracle_while_e3_stays_green() {
+    // The distinguishing result: an upstream (E2 / materialize) fault corrupts the *input* IR.
+    // The shipping E3 map faithfully lowers the corrupt input, so the E3 correspondence oracle is
+    // GREEN (the map is correct); the E2 structural-contract oracle O2 catches it — LOCALIZED to
+    // E2, not misattributed to E3. This is why "differential per edge" ≠ "a single terminal bool".
+    let good = BackendExpr::DirectBuild {
+        shape: "JsonString".into(),
+        fields: vec![DirectBuildField {
+            name: "k".into(),
+            source: DirectBuildSource::Span { label: "s".into() },
+            target: None,
+        }],
+    };
+    let corrupt = BackendExpr::DirectBuild {
+        shape: String::new(), // E2 fault: materialize emitted an empty shape
+        fields: vec![DirectBuildField {
+            name: "k".into(),
+            source: DirectBuildSource::Span { label: "s".into() },
+            target: None,
+        }],
+    };
+
+    // E2 oracle: GREEN on good input, RED (localized) on corrupt input.
+    assert!(o2_materialize_contract(&good, "good").is_empty());
+    let e2 = o2_materialize_contract(&corrupt, "corrupt");
+    assert!(
+        e2.iter().any(|m| m.contains("empty shape")),
+        "E2 oracle must localize the empty-shape fault, got {e2:?}"
+    );
+
+    // E3 correspondence over the corrupt input with the SHIPPING map: GREEN (faithful lowering).
+    let sink = lower_expr_probe(&corrupt);
+    let e3 = e3_correspond(&corrupt, &sink, "corrupt");
+    assert!(
+        e3.is_empty(),
+        "E3 oracle must stay GREEN under an upstream E2 fault (map is faithful), got {e3:?}"
+    );
+
+    // Terminal digest DOES change (good vs corrupt) — detection without localization.
+    assert_ne!(
+        forest_digest(&[lower_expr_probe(&good)]),
+        forest_digest(&[sink]),
+        "terminal digest should register the corruption"
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Live grounding: run the REAL json pipeline (grammar -> passes::compile -> BackendIr) and prove
+// the SHIPPING E3 map corresponds arm-for-arm on live IR (E3 oracle GREEN on the real corpus).
+// Records E1 (node_types) and E2 (backend_ir) reference digests the fault matrix leaves invariant.
+// ---------------------------------------------------------------------------------------------
+fn hash64<T: Hash>(t: &T) -> u64 {
+    let mut h = DefaultHasher::new();
+    t.hash(&mut h);
+    h.finish()
+}
+
+#[test]
+fn e3_oracle_green_on_live_json_backend_ir() {
+    let path = concat!(env!("CARGO_MANIFEST_DIR"), "/../../grammars/json.bbnf");
+    let source = std::fs::read_to_string(path).expect("read json.bbnf");
+    let grammar = grammar::parse_grammar("json", &source).expect("parse json grammar");
+    let out = passes::compile(&grammar).expect("compile json");
+
+    // E1 reference digest (infer output) and E2 reference digest (materialize output).
+    // These are computed upstream of E3; a pure E3-map fault leaves both byte-identical.
+    let mut e1_keys: Vec<(usize, u64)> = out
+        .layout_facts
+        .node_types
+        .iter()
+        .map(|(k, v)| (k.0, hash64(&format!("{v:?}"))))
+        .collect();
+    e1_keys.sort();
+    let e1_digest = hash64(&e1_keys);
+    let e2_digest = hash64(&format!("{:?}", out.backend_ir.rules));
+    assert!(e1_digest != 0 && e2_digest != 0);
+
+    // E3 oracle over every rule of the live BackendIr: the shipping map must correspond.
+    let mut rule_count = 0usize;
+    let mut node_count = 0usize;
+    for rule in &out.backend_ir.rules {
+        rule_count += 1;
+        node_count += count_nodes(&rule.expr);
+        let sink = lower_expr_probe(&rule.expr);
+        let mism = e3_correspond(&rule.expr, &sink, &rule.name);
+        assert!(
+            mism.is_empty(),
+            "live rule {}: shipping E3 map must correspond, got {mism:?}",
+            rule.name
+        );
+    }
+    eprintln!(
+        "LIVE json: rules={rule_count} backend_nodes={node_count} \
+         E1_digest={e1_digest:016x} E2_digest={e2_digest:016x} E3=GREEN"
+    );
+    assert!(rule_count > 0 && node_count > rule_count);
+}
+
+fn count_nodes(b: &BackendExpr) -> usize {
+    1 + match b {
+        BackendExpr::Entry(i) | BackendExpr::OptionalBranch(i) => count_nodes(i),
+        BackendExpr::Seq(cs) => cs.iter().map(count_nodes).sum(),
+        BackendExpr::Alt { branches, .. } => branches.iter().map(count_nodes).sum(),
+        BackendExpr::RepeatLoop { body, .. } | BackendExpr::ValueProject { body, .. } => {
+            count_nodes(body)
+        }
+        _ => 0,
+    }
+}
