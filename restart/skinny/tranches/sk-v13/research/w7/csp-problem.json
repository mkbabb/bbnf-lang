{
  "schema_version": "sk-v13-decision-csp-problem-v1",
  "wave_id": "SK-V13-W7",
  "solver_source": "csp_solver::Csp<CostFiniteDomain>",
  "solver_version": "0.1.0",
  "grammar_scope": [
    "json",
    "css_l4_declaration_values",
    "sheets_witness",
    "bbnf_self_witness"
  ],
  "variables": [
