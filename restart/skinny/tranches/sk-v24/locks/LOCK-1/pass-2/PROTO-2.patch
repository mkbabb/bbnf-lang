diff --git a/crates/ir/src/passes/types/constraint/shape.rs b/crates/ir/src/passes/types/constraint/shape.rs
new file mode 100644
index 000000000..909d0aee3
--- /dev/null
+++ b/crates/ir/src/passes/types/constraint/shape.rs
@@ -0,0 +1,270 @@
+//! `TypeShapeAnalysis` — engine-neutral structural classifier for the
+//! record-vs-list axis.
+//!
+//! LOCK-1 pass-2 probe 2 (Open R). Answers: can a collection rule be
+//! classified as a **record** ([`ShapeClass::Row`]) or a **list**
+//! ([`ShapeClass::List`]) purely from the shape of its IR body and the
+//! types its own `->` annotations declare — with **no** delimiter-byte
+//! peek and **no** per-grammar rule-name gate?
+//!
+//! The classifier reads three facts, all engine-agnostic:
+//!
+//! 1. **A repetition spine** — a `Repeat { hi > 1 }` reachable from the
+//!    rule body (`X *`). A rule with no such spine is not a collection;
+//!    the analysis refuses ([`ShapeClass::Unknown`]).
+//! 2. **The repeated element's projected type** — resolved through the
+//!    element's `Ref` into `ir.types`. No byte of the element's literal
+//!    surface is ever inspected.
+//! 3. **A key role on the element** — a `->`-declared type fact. When the
+//!    repeated element carries a leg whose projected type is the reserved
+//!    engine-agnostic key role (`TypeDesc::Named("key")`), the collection
+//!    is a record. The role is declared in the grammar's own type
+//!    vocabulary; every backend resolves it to its native key type.
+//!
+//! The discriminator is therefore **structure + declared type**, never
+//! an open-brace-vs-open-bracket byte peek and never a `rule.name` gate.
+//! Where the declared key fact is absent (a bare grammar with a two-leg
+//! element and no `->`),
+//! the analysis honestly refuses rather than brace-guessing: a repeated
+//! two-tuple is indistinguishable from a record without the key role.
+
+use crate::types::{IrNode, RuleId, TypeDesc};
+use crate::GrammarIR;
+
+/// The reserved engine-agnostic type role marking a record key. A
+/// `->`-declared fact in the grammar's own type vocabulary — not a
+/// rule name, not a byte. Backends resolve it to their native key type
+/// (Rust `&str`/owned key, TS `string` index, WASM key span).
+pub const KEY_ROLE: &str = "key";
+
+/// Structural class derived for a collection rule's body.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ShapeClass {
+    /// Record / associative map — the repeated element carries a
+    /// `->`-declared key role. Lowers to [`TypeDesc::Row`].
+    Row,
+    /// List — the repeated element is a bare single value. Lowers to
+    /// [`TypeDesc::Vec`].
+    List,
+    /// Refused. Either no repetition spine, or a repeated composite
+    /// element with no declared key role (a bare two-tuple that could be
+    /// a list-of-pairs just as well as a record). The analysis does not
+    /// brace-guess.
+    Unknown,
+}
+
+impl ShapeClass {
+    /// True for [`ShapeClass::Row`].
+    pub fn is_row(self) -> bool {
+        matches!(self, ShapeClass::Row)
+    }
+
+    /// True for [`ShapeClass::List`].
+    pub fn is_list(self) -> bool {
+        matches!(self, ShapeClass::List)
+    }
+}
+
+/// Classify a rule's body on the record-vs-list axis.
+///
+/// Reads only the IR body shape and `ir.types`; never a delimiter byte,
+/// never `rule.name`.
+pub fn classify(ir: &GrammarIR, rule_id: RuleId) -> ShapeClass {
+    let Some(rule) = ir.rules.iter().find(|r| r.id == rule_id) else {
+        return ShapeClass::Unknown;
+    };
+
+    // Fact 1: a repetition spine. No spine → not a collection.
+    let Some(spine_inner) = find_repeat_spine(&rule.body) else {
+        return ShapeClass::Unknown;
+    };
+
+    // The repeated element's semantic core, delimiter scaffolding
+    // (`Skip`/`Next`/`OptionalWhitespace`/`Map`/nested `Repeat`) stripped
+    // by *shape*, without reading any literal's bytes.
+    let element = element_core(spine_inner);
+    let element_rid = match element {
+        IrNode::Ref(target) => Some(*target),
+        _ => None,
+    };
+
+    // Fact 3: a declared key role reachable from the element → record.
+    //
+    // The element rule's *projected* tuple collapses referenced sub-rules
+    // to `BoxedEnum` (the Seq/Ref projection erases a `Named` role behind
+    // a `Ref`), so the key role is sought where it survives: on the
+    // element rule's own type AND on the types of the rules its body legs
+    // reference (`keystr : Named("key")`).
+    let has_key = match element_rid {
+        Some(rid) => rule_carries_key_role(ir, rid),
+        None => element_type(ir, element).is_some_and(|t| contains_key_role(ir, t)),
+    };
+    if has_key {
+        return ShapeClass::Row;
+    }
+
+    // Fact 2: the element's projected type. A composite element (a tuple
+    // of >= 2 legs) with no declared key role is ambiguous — a
+    // list-of-tuples reads identically — so refuse. A bare single value
+    // is an unambiguous list. No resolvable type → refuse.
+    let element_ty = element_rid
+        .and_then(|rid| rule_type(ir, rid))
+        .or_else(|| element_type(ir, element));
+    match element_ty {
+        Some(ty) if is_composite(ty) => ShapeClass::Unknown,
+        Some(_) => ShapeClass::List,
+        None => ShapeClass::Unknown,
+    }
+}
+
+/// True if a `->`-declared key role is reachable from a rule: on the
+/// rule's own projected type, or on the type of any rule its body legs
+/// reference (one level — the projection collapses referenced `Named`
+/// roles to `BoxedEnum`, so the role is recovered from the referent's
+/// own type, not the collapsed tuple).
+fn rule_carries_key_role(ir: &GrammarIR, rule_id: RuleId) -> bool {
+    if rule_type(ir, rule_id).is_some_and(|t| contains_key_role(ir, t)) {
+        return true;
+    }
+    let Some(rule) = ir.rules.iter().find(|r| r.id == rule_id) else {
+        return false;
+    };
+    let mut refs = Vec::new();
+    collect_refs(&rule.body, &mut refs);
+    refs.iter()
+        .any(|rid| rule_type(ir, *rid).is_some_and(|t| contains_key_role(ir, t)))
+}
+
+/// A rule's own projected type from `ir.types`.
+fn rule_type(ir: &GrammarIR, rule_id: RuleId) -> Option<&TypeDesc> {
+    ir.types.iter().find(|(id, _)| *id == rule_id).map(|(_, t)| t)
+}
+
+/// Collect every `Ref` target reachable in a body tree (this rule's tree
+/// only — never crosses into another rule). Reads Copy `RuleId`s; no
+/// borrow escapes, so `for_each_child` recursion is sound here.
+fn collect_refs(node: &IrNode, out: &mut Vec<RuleId>) {
+    if let IrNode::Ref(target) = node {
+        out.push(*target);
+    }
+    node.for_each_child(&mut |child| collect_refs(child, out));
+}
+
+/// Lower a classified rule to its engine-agnostic collection type.
+///
+/// - [`ShapeClass::Row`] → [`TypeDesc::Row`] over the element's value leg.
+/// - [`ShapeClass::List`] → [`TypeDesc::Vec`] over the element type.
+/// - [`ShapeClass::Unknown`] → `None` (the rule keeps its inferred type).
+pub fn derive_collection_type(ir: &GrammarIR, rule_id: RuleId) -> Option<TypeDesc> {
+    match classify(ir, rule_id) {
+        ShapeClass::Row => {
+            let value = row_value_type(ir, rule_id).unwrap_or(TypeDesc::Enum);
+            Some(TypeDesc::Row(Box::new(value)))
+        }
+        ShapeClass::List => {
+            let value = list_element_type(ir, rule_id).unwrap_or(TypeDesc::Enum);
+            Some(TypeDesc::Vec(Box::new(value)))
+        }
+        ShapeClass::Unknown => None,
+    }
+}
+
+// ── Structural walkers (shape only — never a literal byte) ───────────────
+
+/// Find the collection spine: the inner node of the first reachable
+/// `Repeat { hi > 1 }` (a `*` / `+`). Optional repeats (`?`, `hi == 1`)
+/// are skipped so a trailing `comma ?` never masquerades as the spine.
+fn find_repeat_spine(node: &IrNode) -> Option<&IrNode> {
+    match node {
+        IrNode::Repeat { inner, hi, .. } if *hi > 1 => Some(inner),
+        IrNode::Repeat { inner, .. }
+        | IrNode::Negate(inner)
+        | IrNode::OptionalWhitespace(inner)
+        | IrNode::Map { inner, .. } => find_repeat_spine(inner),
+        IrNode::Seq(children) => children.iter().find_map(find_repeat_spine),
+        IrNode::Alt(branches, _) => branches.iter().find_map(|b| find_repeat_spine(&b.node)),
+        IrNode::Skip(a, b) | IrNode::Next(a, b) | IrNode::Minus(a, b) => {
+            find_repeat_spine(a).or_else(|| find_repeat_spine(b))
+        }
+        IrNode::TokenDispatch {
+            token,
+            arms,
+            fallback,
+        } => find_repeat_spine(token)
+            .or_else(|| arms.iter().find_map(|arm| find_repeat_spine(&arm.continuation)))
+            .or_else(|| find_repeat_spine(fallback)),
+        IrNode::Literal(_) | IrNode::Regex(_) | IrNode::Epsilon | IrNode::Ref(_) => None,
+    }
+}
+
+/// Strip delimiter scaffolding from a repeated element down to its
+/// semantic core. `Skip(a, _)` keeps `a`; `Next(_, b)` keeps `b`;
+/// `OptionalWhitespace`/`Map`/nested `Repeat` unwrap. Stops at the first
+/// `Ref`/leaf/`Seq`/`Alt`. Purely shape-directed.
+fn element_core(node: &IrNode) -> &IrNode {
+    match node {
+        IrNode::Skip(a, _) => element_core(a),
+        IrNode::Next(_, b) => element_core(b),
+        IrNode::OptionalWhitespace(inner)
+        | IrNode::Map { inner, .. }
+        | IrNode::Repeat { inner, .. } => element_core(inner),
+        other => other,
+    }
+}
+
+/// The element's projected type, resolved through a `Ref` into
+/// `ir.types`. A non-`Ref` element has no rule-level type to consult.
+fn element_type<'a>(ir: &'a GrammarIR, element: &IrNode) -> Option<&'a TypeDesc> {
+    match element {
+        IrNode::Ref(target) => ir.types.iter().find(|(id, _)| id == target).map(|(_, t)| t),
+        _ => None,
+    }
+}
+
+// ── Type-level predicates (declared facts — never a rule name) ───────────
+
+/// True if a declared key role (`Named("key")`) appears anywhere in the
+/// type, at any nesting depth.
+fn contains_key_role(ir: &GrammarIR, ty: &TypeDesc) -> bool {
+    match ty {
+        TypeDesc::Named(sid) => ir.get_string(*sid) == KEY_ROLE,
+        TypeDesc::Option(inner) | TypeDesc::Vec(inner) | TypeDesc::Row(inner) => {
+            contains_key_role(ir, inner)
+        }
+        TypeDesc::Tuple(parts) | TypeDesc::HeterogeneousAltJoin(parts) => {
+            parts.iter().any(|p| contains_key_role(ir, p))
+        }
+        _ => false,
+    }
+}
+
+/// True if the type is a composite element (a tuple of >= 2 legs) — a
+/// key/value-shaped pair whose record-ness cannot be decided without a
+/// declared key role.
+fn is_composite(ty: &TypeDesc) -> bool {
+    matches!(ty, TypeDesc::Tuple(parts) if parts.len() >= 2)
+}
+
+/// The value leg of a record's key→value element: the last tuple leg
+/// (the leg following the key). Falls back to the whole element type.
+fn row_value_type(ir: &GrammarIR, rule_id: RuleId) -> Option<TypeDesc> {
+    let element = collection_element(ir, rule_id)?;
+    match element_type(ir, element)? {
+        TypeDesc::Tuple(parts) => parts.last().cloned(),
+        other => Some(other.clone()),
+    }
+}
+
+/// The element type of a list.
+fn list_element_type(ir: &GrammarIR, rule_id: RuleId) -> Option<TypeDesc> {
+    let element = collection_element(ir, rule_id)?;
+    element_type(ir, element).cloned()
+}
+
+/// The semantic core of a rule's repeated element, or `None` if the rule
+/// has no repetition spine.
+fn collection_element<'a>(ir: &'a GrammarIR, rule_id: RuleId) -> Option<&'a IrNode> {
+    let rule = ir.rules.iter().find(|r| r.id == rule_id)?;
+    let spine = find_repeat_spine(&rule.body)?;
+    Some(element_core(spine))
+}
