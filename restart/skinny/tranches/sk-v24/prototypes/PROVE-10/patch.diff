--- /dev/null
+++ b/rust/regex/src/automata/prefilter.rs
@@ -0,0 +1,97 @@
+//! Start-state prefilter — skip runs of bytes that cannot begin a match.
+//!
+//! A compiled DFA can only *begin* a match at a byte on which its start state
+//! has a non-dead transition. When that entry set has 1–3 members, an
+//! unanchored search skips the intervening bytes with `memchr`/`memchr2`/
+//! `memchr3` — which classify at memory bandwidth on aarch64 NEON — instead of
+//! stepping the transition table one byte at a time. This is the memchr /
+//! rare-byte tier of the meta-engine prefilter ladder, applied at match
+//! *entry* rather than at a self-loop state; it mirrors the Memchr1/2/3
+//! vocabulary of [`super::accel::AccelStrategy`].
+//!
+//! The prefilter is a pure accelerator: it decides *where* to attempt an
+//! anchored match, never *whether* one succeeds. The DFA is unchanged, so
+//! matches are byte-for-byte identical to a byte-by-byte scan.
+
+use smallvec::SmallVec;
+
+use super::dfa::Dfa;
+use super::nfa::DEAD;
+
+/// Strategy for locating the next byte that could start a match.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Prefilter {
+    /// Entry set is empty, universal, or larger than 3 bytes — no skipping.
+    #[default]
+    None,
+    /// One entry byte → `memchr::memchr`.
+    Byte1(u8),
+    /// Two entry bytes → `memchr::memchr2`.
+    Byte2(u8, u8),
+    /// Three entry bytes → `memchr::memchr3`.
+    Byte3(u8, u8, u8),
+}
+
+impl Prefilter {
+    /// Derive the entry-byte prefilter from a compiled DFA.
+    ///
+    /// The entry set is every byte whose equivalence class has a non-dead
+    /// transition out of the start state (state 0). If the start state already
+    /// accepts, the empty string matches at every position, so no prefilter is
+    /// possible.
+    pub fn from_dfa(dfa: &Dfa) -> Self {
+        if dfa.states.is_empty() || dfa.states[0].is_accept {
+            return Prefilter::None;
+        }
+        let num_cls = dfa.num_classes as usize;
+        // The start-state transition row is the first `num_cls` entries of the
+        // flat table. A byte can begin a match iff its class transitions live.
+        let row = &dfa.flat_transitions[..num_cls];
+        let mut bytes: SmallVec<[u8; 4]> = SmallVec::new();
+        for b in 0u16..256 {
+            let cls = dfa.byte_classes[b as usize] as usize;
+            if row[cls] != DEAD {
+                if bytes.len() == 3 {
+                    return Prefilter::None; // >3 entry bytes: not worth a scan
+                }
+                bytes.push(b as u8);
+            }
+        }
+        match bytes.as_slice() {
+            [a] => Prefilter::Byte1(*a),
+            [a, b] => Prefilter::Byte2(*a, *b),
+            [a, b, c] => Prefilter::Byte3(*a, *b, *c),
+            _ => Prefilter::None, // empty entry set (dead start) — no candidates
+        }
+    }
+
+    /// Whether this prefilter skips any bytes.
+    #[inline]
+    pub fn is_active(&self) -> bool {
+        !matches!(self, Prefilter::None)
+    }
+
+    /// Byte offset of the next candidate match start at or after `from`.
+    ///
+    /// Returns `None` only for an active prefilter that finds no further
+    /// candidate. [`Prefilter::None`] never skips: it yields `from` verbatim so
+    /// the caller steps one byte at a time (identical to the un-prefiltered
+    /// scan).
+    #[inline]
+    pub fn next_candidate(&self, bytes: &[u8], from: usize) -> Option<usize> {
+        if from >= bytes.len() {
+            return match self {
+                Prefilter::None => Some(from),
+                _ => None,
+            };
+        }
+        let hay = &bytes[from..];
+        let off = match *self {
+            Prefilter::None => return Some(from),
+            Prefilter::Byte1(a) => memchr::memchr(a, hay)?,
+            Prefilter::Byte2(a, b) => memchr::memchr2(a, b, hay)?,
+            Prefilter::Byte3(a, b, c) => memchr::memchr3(a, b, c, hay)?,
+        };
+        Some(from + off)
+    }
+}
