+// ── L0 incumbent (verbatim dfa.rs:291) ──────────────────────────────────
+fn min_incumbent(dfa: &Dfa) -> Dfa {
+    let n = dfa.states.len();
+    let num_cls = dfa.num_classes as usize;
+    if n <= 1 {
+        return clone_dfa(dfa);
+    }
+    let mut partition: Vec<usize> = vec![0; n];
+    let mut num_blocks: usize = 1;
+    let has_accept = dfa.states.iter().any(|s| s.is_accept);
+    let has_non = dfa.states.iter().any(|s| !s.is_accept);
+    if has_accept && has_non {
+        num_blocks = 2;
+        for (i, st) in dfa.states.iter().enumerate() {
+            partition[i] = if st.is_accept { 0 } else { 1 };
+        }
+    }
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for block_id in 0..num_blocks {
+            let members: Vec<usize> = (0..n).filter(|&s| partition[s] == block_id).collect();
+            if members.len() <= 1 {
+                continue;
+            }
+            for cls in 0..num_cls {
+                let first = members[0];
+                let ft = dfa.states[first].transitions[cls];
+                let ftb = if ft == DEAD { usize::MAX } else { partition[ft as usize] };
+                let mut splitters: Vec<usize> = Vec::new();
+                for &m in &members[1..] {
+                    let t = dfa.states[m].transitions[cls];
+                    let tb = if t == DEAD { usize::MAX } else { partition[t as usize] };
+                    if tb != ftb {
+                        splitters.push(m);
+                    }
+                }
+                if !splitters.is_empty() {
+                    let nb = num_blocks;
+                    num_blocks += 1;
+                    for &s in &splitters {
+                        partition[s] = nb;
+                    }
+                    changed = true;
+                    break; // restart refinement from the beginning
+                }
+            }
+            if changed {
+                break;
+            }
+        }
+    }
+    build_from_partition(dfa, &partition, num_blocks)
+}
