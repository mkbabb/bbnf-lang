+fn cold_paired_perf(corpus: &[&str], opts: &ParseOptions) {
+    const REPS: usize = 3000;
+    let mut hand_us: Vec<f64> = Vec::with_capacity(REPS);
+    let mut gen_us: Vec<f64> = Vec::with_capacity(REPS);
+
+    // Untimed prime (icache/branch predictor) — NOT result caching; every parse
+    // still allocates a fresh Hir, so every timed pass is COLD.
+    for _ in 0..50 {
+        for &p in corpus {
+            black_box(regex::parse_with(black_box(p), opts)).ok();
+            black_box(regex::parse_generated_with(black_box(p), opts)).ok();
+        }
+    }
+    for _ in 0..REPS {
+        let t0 = Instant::now();
+        for &p in corpus {
+            black_box(regex::parse_with(black_box(p), opts)).ok();
+        }
+        hand_us.push(t0.elapsed().as_nanos() as f64 / 1000.0);
+
+        let t1 = Instant::now();
+        for &p in corpus {
+            black_box(regex::parse_generated_with(black_box(p), opts)).ok();
+        }
+        gen_us.push(t1.elapsed().as_nanos() as f64 / 1000.0);
+    }
+    let hm = median(hand_us);
+    let gm = median(gen_us);
+    println!("=== COLD PAIRED PERF (release -O3, {} reps, per corpus-pass) ===", REPS);
+    println!("HAND  parse_with            median: {:.3} us/pass", hm);
+    println!("GEN   parse_generated_with  median: {:.3} us/pass", gm);
+    println!(
+        "perf_ratio GEN/HAND         : {:.3}x  ({})",
+        gm / hm,
+        if gm <= hm {
+            "perf gate PASS (<=1.0)"
+        } else {
+            "perf gate FAIL (>1.0) -> ORACLE-ONLY lawful"
+        }
+    );
+}
