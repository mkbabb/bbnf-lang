+impl<'doc, 'input: 'doc> JsonValue<'doc, 'input> {
+    /// Navigate a JSON pointer over the already-built tape (the eager-parse
+    /// lane), reusing the lazy `ValueRef`/`Cursor` seam via `get`/`values`.
+    /// Contrast `super::path::get`, the stop-early lane that never builds a tape.
+    pub fn pointer(self, path: &[super::path::Seg<'_>]) -> Option<JsonValue<'doc, 'input>> {
+        let mut current = self;
+        for seg in path {
+            current = match (current, seg) {
+                (JsonValue::Object(object), super::path::Seg::Key(key)) => object.get(key)?,
+                (JsonValue::Array(array), super::path::Seg::Idx(index)) => {
+                    array.values().nth(*index)?
+                }
+                _ => return None,
+            };
+        }
+        Some(current)
+    }
+}
