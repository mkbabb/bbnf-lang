// CSS Function Body & Math Expressions
// Provides balanced-paren function body scanning and typed calc/min/max/clamp.
// Spec: CSS Values and Units Level 4 §10

@import "value-unit.bbnf" ;

// --- Balanced function body ---
// Handles nested (), "", '' — used for generic function args and var() fallback.
// Cyclic: funcBody references itself for nested parens.
string = /"(?:[^"\\]|\\[\s\S])*"/ | /'(?:[^'\\]|\\[\s\S])*'/ ;
funcBody = (/[^()"']+/ | "(" , funcBody , ")" | string) * ;

// --- Math expressions (calc/min/max/clamp) ---
// Recursive with correct precedence: * / before + -
// TODO typed-aggregate (AU.2.6): mathExpr is a recursive tagged union
// (BinaryOp | Value). calc/min/max/clamp variant payloads compose
// through arena-backed refs. Outer-function variant dispatch is
// presently by rule alternation; variant-tag u8 codegen for
// per-rule (not keyword) disambiguation lands with AU.6.7.

mathFunctionName = "calc"  -> 0u8
                 | "clamp" -> 3u8
                 | "min"   -> 1u8
                 | "max"   -> 2u8 ;

// Binary operator tag used by mathProduct/mathExpr walkers.
mathProductOp = "*" -> 0u8 | "/" -> 1u8 ;
mathSumOp     = "+" -> 0u8 | "-" -> 1u8 ;

mathValue = calcFunction
          | minFunction
          | maxFunction
          | clampFunction
          | varFunction
          | envFunction
          | dimension
          | number
          | "(" >> mathExpr << ")" ;

mathProduct = mathValue , (mathProductOp >> mathValue) * ;
mathExpr    = mathProduct , (mathSumOp >> mathProduct) * ;

calcFunction  = "calc" , "(" >> mathExpr << ")" ;
minFunction   = "min" , "(" >> (mathExpr , ("," >> mathExpr) +) << ")" ;
maxFunction   = "max" , "(" >> (mathExpr , ("," >> mathExpr) +) << ")" ;
clampFunction = "clamp" , "(" >> mathExpr , "," >> mathExpr , "," >> mathExpr << ")" ;

// --- var() and env() ---
dashed = /--[\w-]+/ ;
varFallback = funcBody ;
varFunction = "var" , "(" >> dashed , ("," >> varFallback) ? << ")" ;
envFunction = "env" , "(" >> /[a-zA-Z_][\w-]*/ , ("," >> varFallback) ? << ")" ;

// --- url() ---
urlFunction = "url" , "(" >> (string | /[^)"'\s]+/) << ")" ;

// --- Generic function (balanced body) ---
genericFunction = /[a-zA-Z][\w-]*/ , "(" , funcBody , ")" ;
