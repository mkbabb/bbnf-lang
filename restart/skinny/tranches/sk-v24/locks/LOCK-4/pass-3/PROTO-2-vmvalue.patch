index 000000000..a85a8c17d
--- /dev/null
+++ b/crates/ir/src/vm/interpreter/apply_fn.rs
@@ -0,0 +1,193 @@
+//! `Op::ApplyFn` — the VM value plane (`.map`).
+//!
+//! Turns the recognizer into a *combinator core*: after the inner subtree
+//! matches and leaves a value on the stack, `ApplyFn(fn_id)` pops that value,
+//! evaluates `program.fns[fn_id]` (a [`FnDescriptor`]) against it, and pushes
+//! the projected scalar/variant. The descriptor — including any `MapExpr`
+//! tree — is data serialized inside the `BytecodeProgram`, so the identical
+//! evaluation runs on both the Rust and the TS interpreter from the same
+//! bytes. This is the point at which `->` projections stop being dropped.
+
+use super::Interpreter;
+use super::value::Value;
+use crate::{FnDescriptor, MapBinOp, MapExpr, MapUnaryOp};
+
+/// Intermediate numeric/textual value during `MapExpr` evaluation.
+#[derive(Clone, Debug)]
+enum Eval {
+    F(f64),
+    I(i64),
+    B(bool),
+    S(String),
+}
+
+impl Eval {
+    fn as_f64(&self) -> f64 {
+        match self {
+            Eval::F(f) => *f,
+            Eval::I(i) => *i as f64,
+            Eval::B(b) => *b as i64 as f64,
+            Eval::S(s) => s.parse::<f64>().unwrap_or(f64::NAN),
+        }
+    }
+    fn as_i64(&self) -> i64 {
+        match self {
+            Eval::F(f) => *f as i64,
+            Eval::I(i) => *i,
+            Eval::B(b) => *b as i64,
+            Eval::S(s) => s.parse::<i64>().unwrap_or(0),
+        }
+    }
+    fn is_float(&self) -> bool {
+        matches!(self, Eval::F(_))
+    }
+    fn into_value(self) -> Value {
+        match self {
+            Eval::F(f) => Value::F64(f),
+            Eval::I(i) => Value::U32(i as u32),
+            Eval::B(b) => Value::U32(b as u32),
+            Eval::S(s) => Value::Str(s.into_boxed_str()),
+        }
+    }
+}
+
+impl<'prog> Interpreter<'prog> {
+    /// Execute `Op::ApplyFn(fn_id)`: project the top value through `fns[fn_id]`.
+    pub(super) fn exec_apply_fn(&mut self, fn_id: u32) {
+        // A failed inner subtree leaves nothing to project — propagate.
+        if self.is_error {
+            self.pc += 1;
+            return;
+        }
+
+        // `program` is a shared `&'prog` reference (Copy) — decouples the
+        // side-table borrow from the `&mut self` value-stack mutation.
+        let program = self.program;
+        let Some(child) = self.values.pop() else {
+            self.is_error = true;
+            self.pc += 1;
+            return;
+        };
+
+        let projected = match program.fns.get(fn_id as usize) {
+            Some(FnDescriptor::Expr { expr, .. }) => {
+                self.eval_map_expr(expr, &child).into_value()
+            }
+            Some(FnDescriptor::NumberConvert { .. }) => {
+                Value::F64(self.value_text(&child).and_then(|t| t.parse().ok()).unwrap_or(f64::NAN))
+            }
+            Some(FnDescriptor::HexConvert { .. }) => {
+                let n = self
+                    .value_text(&child)
+                    .and_then(|t| u32::from_str_radix(t.trim_start_matches("0x"), 16).ok())
+                    .unwrap_or(0);
+                Value::U32(n)
+            }
+            Some(FnDescriptor::EnumWrap { variant }) => Value::Variant {
+                tag: *variant,
+                child: Box::new(child),
+            },
+            // Box is a codegen concept; SpanCapture already yields a span;
+            // HostClosure's body is opaque to the VM (LOCK-7 territory) —
+            // all three pass the child value through unchanged.
+            Some(FnDescriptor::BoxWrap)
+            | Some(FnDescriptor::SpanCapture)
+            | Some(FnDescriptor::HostClosure { .. }) => child,
+            None => child,
+        };
+
+        self.values.push(projected);
+        self.pc += 1;
+    }
+
+    /// Resolve a value's textual form (span slice of the input) if it has one.
+    fn value_text(&self, v: &Value) -> Option<String> {
+        match v {
+            Value::Span(s, e) => Some(self.input[*s as usize..*e as usize].to_string()),
+            Value::Str(s) => Some(s.to_string()),
+            _ => None,
+        }
+    }
+
+    /// Evaluate a `MapExpr` tree against the child value (`input`).
+    fn eval_map_expr(&self, expr: &MapExpr, input: &Value) -> Eval {
+        match expr {
+            MapExpr::IntLit(i) => Eval::I(*i),
+            MapExpr::FloatLit(f) => Eval::F(*f),
+            MapExpr::BoolLit(b) => Eval::B(*b),
+            MapExpr::StringLit(sid) => Eval::S(self.program.strings[*sid as usize].clone()),
+            MapExpr::Input => match self.value_text(input) {
+                Some(t) => Eval::S(t),
+                None => match input {
+                    Value::F64(f) => Eval::F(*f),
+                    Value::U32(u) => Eval::I(*u as i64),
+                    _ => Eval::I(0),
+                },
+            },
+            MapExpr::InputProp { prop } => {
+                let name = &self.program.strings[*prop as usize];
+                match name.as_str() {
+                    "len" => Eval::I(self.value_text(input).map_or(0, |t| t.len() as i64)),
+                    _ => Eval::I(0),
+                }
+            }
+            MapExpr::FnCall { name, args } => {
+                let fname = &self.program.strings[*name as usize];
+                let a0 = args.first().map(|a| self.eval_map_expr(a, input));
+                match (fname.as_str(), a0) {
+                    ("parse_int" | "int", Some(v)) => Eval::I(v.as_i64()),
+                    ("parse_float" | "float", Some(v)) => Eval::F(v.as_f64()),
+                    ("parse_hex", Some(v)) => {
+                        let s = if let Eval::S(s) = &v { s.clone() } else { String::new() };
+                        Eval::I(u32::from_str_radix(s.trim_start_matches("0x"), 16).unwrap_or(0) as i64)
+                    }
+                    ("len", Some(Eval::S(s))) => Eval::I(s.len() as i64),
+                    // Unknown host fn: identity on first arg (VM cannot inline
+                    // an opaque body — LOCK-7 resolution required).
+                    (_, Some(v)) => v,
+                    (_, None) => Eval::I(0),
+                }
+            }
+            MapExpr::BinOp { op, lhs, rhs } => {
+                let l = self.eval_map_expr(lhs, input);
+                let r = self.eval_map_expr(rhs, input);
+                self.eval_binop(*op, l, r)
+            }
+            MapExpr::UnaryOp { op, inner } => {
+                let v = self.eval_map_expr(inner, input);
+                match op {
+                    MapUnaryOp::Neg if v.is_float() => Eval::F(-v.as_f64()),
+                    MapUnaryOp::Neg => Eval::I(-v.as_i64()),
+                    MapUnaryOp::Not => Eval::B(v.as_i64() == 0),
+                }
+            }
+        }
+    }
+
+    fn eval_binop(&self, op: MapBinOp, l: Eval, r: Eval) -> Eval {
+        let float = l.is_float() || r.is_float();
+        match op {
+            MapBinOp::Add if float => Eval::F(l.as_f64() + r.as_f64()),
+            MapBinOp::Sub if float => Eval::F(l.as_f64() - r.as_f64()),
+            MapBinOp::Mul if float => Eval::F(l.as_f64() * r.as_f64()),
+            MapBinOp::Div if float => Eval::F(l.as_f64() / r.as_f64()),
+            MapBinOp::Add => Eval::I(l.as_i64().wrapping_add(r.as_i64())),
+            MapBinOp::Sub => Eval::I(l.as_i64().wrapping_sub(r.as_i64())),
+            MapBinOp::Mul => Eval::I(l.as_i64().wrapping_mul(r.as_i64())),
+            MapBinOp::Div => Eval::I(l.as_i64().checked_div(r.as_i64()).unwrap_or(0)),
+            MapBinOp::Mod => Eval::I(l.as_i64().checked_rem(r.as_i64()).unwrap_or(0)),
+            MapBinOp::Eq => Eval::B((l.as_f64() - r.as_f64()).abs() < f64::EPSILON),
+            MapBinOp::Ne => Eval::B((l.as_f64() - r.as_f64()).abs() >= f64::EPSILON),
+            MapBinOp::Lt => Eval::B(l.as_f64() < r.as_f64()),
+            MapBinOp::Gt => Eval::B(l.as_f64() > r.as_f64()),
+            MapBinOp::Le => Eval::B(l.as_f64() <= r.as_f64()),
+            MapBinOp::Ge => Eval::B(l.as_f64() >= r.as_f64()),
+            MapBinOp::And => Eval::B(l.as_i64() != 0 && r.as_i64() != 0),
+            MapBinOp::Or => Eval::B(l.as_i64() != 0 || r.as_i64() != 0),
+            MapBinOp::BitAnd => Eval::I(l.as_i64() & r.as_i64()),
+            MapBinOp::BitOr => Eval::I(l.as_i64() | r.as_i64()),
+            MapBinOp::Shl => Eval::I(l.as_i64() << r.as_i64()),
+            MapBinOp::Shr => Eval::I(l.as_i64() >> r.as_i64()),
+        }
+    }
+}
