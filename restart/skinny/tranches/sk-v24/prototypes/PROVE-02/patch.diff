+//! Float / integer byte-parity oracle for the NEON digit-run kernel
+//! (`number::simd::scan_block`, re-authored from SK-V23 PROTO-PB-6).
+//!
+//! The kernel is exercised transparently through the public
+//! `match_number_span` + `materialize_*` surface (on aarch64 that path
+//! runs the NEON block). Ground truth is libstd's own `FromStr` — the
+//! canonical correctly-rounded oracle — so agreement here is end-to-end
+//! byte-parity, strictly stronger than kernel-vs-scalar count checks.
+
+use parse_that_regex::number::{
+    match_number_span, materialize_f64, materialize_i64, materialize_u64,
+};
+
+/// `s` followed by a `,` delimiter and enough trailing non-digit padding
+/// that every leading-digit run has a full 16-byte block in bounds — this
+/// is what forces the NEON `scan_block` path (guarded by `cursor + 16 <=
+/// len`) to actually fire on short synthetic inputs.
+fn padded(s: &str) -> Vec<u8> {
+    let mut buf = s.as_bytes().to_vec();
+    buf.push(b',');
+    while buf.len() < s.len() + 20 {
+        buf.push(b',');
+    }
+    buf
+}
+
+/// Materialize `s` through the scan+Eisel-Lemire path and assert its f64
+/// bits equal libstd's `f64::from_str`.
+fn assert_f64_parity(s: &str) {
+    let buf = padded(s);
+    let span = match_number_span(&buf, 0)
+        .unwrap_or_else(|| panic!("scan rejected {s:?}"));
+    let got = materialize_f64(&buf, &span)
+        .unwrap_or_else(|_| panic!("materialize_f64 failed for {s:?}"));
+    let want = s.parse::<f64>().unwrap();
+    assert_eq!(
+        got.to_bits(),
+        want.to_bits(),
+        "float bits diverge for {s:?}: got {got:?} want {want:?}"
+    );
+    // The span's end must land exactly on the delimiter we appended.
+    assert_eq!(span.end, s.len(), "span end diverges for {s:?}");
+}
+
+#[test]
+fn integer_widths_1_through_20() {
+    // Every integer width drives a distinct leading-digit count through the
+    // kernel (counts 1..=16 in one block, >16 via block + SWAR tail).
+    for width in 1..=20u32 {
+        // 1, 12, 123, ... and 9, 98, 987, ...
+        let ascending: String = (0..width).map(|k| char::from(b'1' + (k % 9) as u8)).collect();
+        let descending: String = (0..width).map(|k| char::from(b'9' - (k % 9) as u8)).collect();
+        for s in [ascending, descending] {
+            let mut buf = s.as_bytes().to_vec();
+            buf.push(b',');
+            let span = match_number_span(&buf, 0).unwrap();
+            assert_eq!(span.digit_count, width, "digit_count for {s:?}");
+            if width <= 19 {
+                let want = s.parse::<u64>().unwrap();
+                assert_eq!(materialize_u64(&buf, &span).unwrap(), want, "u64 {s:?}");
+                assert_eq!(span.mantissa, want, "mantissa {s:?}");
+            }
+            // signed round-trip for the ones that fit i64
+            if let Ok(want) = format!("-{s}").parse::<i64>() {
+                let neg = format!("-{s},");
+                let nspan = match_number_span(neg.as_bytes(), 0).unwrap();
+                assert_eq!(materialize_i64(neg.as_bytes(), &nspan).unwrap(), want, "i64 -{s}");
+            }
+        }
+    }
+}
+
+#[test]
+fn fractional_counts_and_representative_floats() {
+    // Fractional runs of every length 1..=17 (canada's coordinate shape),
+    // plus exponents, leading zeros, and IEEE edge magnitudes.
+    let mut cases: Vec<String> = Vec::new();
+    for frac_len in 1..=17usize {
+        let frac: String = (0..frac_len).map(|k| char::from(b'0' + (k % 10) as u8)).collect();
+        cases.push(format!("43.{frac}"));
+        cases.push(format!("-65.{frac}"));
+        cases.push(format!("0.{frac}"));
+    }
+    cases.extend(
+        [
+            "0.0", "-0.0", "1.0", "1e0", "5e-324", "2.2250738585072014e-308",
+            "1.7976931348623157e308", "43.474709000000125", "6.02214076e23",
+            "-65.613616999999977", "43.420273000000009", "123456789.123456789",
+            "9007199254740993", "9999999999999999.9", "1.5e-10", "3.14159265358979",
+        ]
+        .iter()
+        .map(|s| s.to_string()),
+    );
+    for s in &cases {
+        assert_f64_parity(s);
+    }
+}
+
+/// Walk the raw bytes of a JSON corpus, skipping string literals, and run
+/// every numeric token through the kernel — the real-data float oracle.
+fn sweep_corpus(name: &str) -> usize {
+    let manifest = env!("CARGO_MANIFEST_DIR");
+    let path = format!("{manifest}/../test-fixtures/corpus/json/{name}.json");
+    let bytes = match std::fs::read(&path) {
+        Ok(b) => b,
+        Err(_) => return 0, // fixture absent in this checkout — skip, not fail
+    };
+    let n = bytes.len();
+    let mut i = 0usize;
+    let mut checked = 0usize;
+    while i < n {
+        match bytes[i] {
+            b'"' => {
+                // skip the string literal, honoring backslash escapes
+                i += 1;
+                while i < n {
+                    match bytes[i] {
+                        b'\\' => i += 2,
+                        b'"' => {
+                            i += 1;
+                            break;
+                        }
+                        _ => i += 1,
+                    }
+                }
+            }
+            b'-' | b'0'..=b'9' => {
+                let span = match_number_span(&bytes, i)
+                    .unwrap_or_else(|| panic!("{name}: scan rejected at byte {i}"));
+                let text = std::str::from_utf8(&bytes[span.start..span.end]).unwrap();
+                let want = text.parse::<f64>().unwrap();
+                let got = materialize_f64(&bytes, &span).unwrap();
+                assert_eq!(
+                    got.to_bits(),
+                    want.to_bits(),
+                    "{name}: float bits diverge for {text:?} at byte {i}"
+                );
+                checked += 1;
+                i = span.end;
+            }
+            _ => i += 1,
+        }
+    }
+    checked
+}
+
+#[test]
+fn canada_corpus_byte_parity() {
+    let checked = sweep_corpus("canada");
+    // canada is coordinate-heavy: ~111k float tokens when present.
+    if checked > 0 {
+        assert!(checked > 100_000, "expected >100k canada numbers, got {checked}");
+    }
+}
+
+#[test]
+fn twitter_and_citm_corpus_byte_parity() {
+    sweep_corpus("twitter");
+    sweep_corpus("citm_catalog");
+}
